{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "start-dev-deps",
      "type": "shell",
      "command": "docker-compose",
      "args": [
        "-f",
        "docker-compose.dev.yaml",
        "up",
        "postgres",
        "keycloak",
        "-d"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always"
      }
    },
    {
      "label": "stop-dev-deps",
      "type": "shell",
      "command": "docker-compose",
      "args": [
        "-f",
        "docker-compose.dev.yaml",
        "down"
      ],
      "problemMatcher": []
    },
    {
      "label": "apply-server-patches",
      "type": "shell",
      "command": "./scripts/apply-patches.sh",
      "args": ["jellyfin"],
      "problemMatcher": []
    },
    {
      "label": "clean-submodules",
      "type": "shell",
      "command": "./scripts/clean-submodules.sh",
      "problemMatcher": []
    },
    {
      "label": "build-server",
      "type": "shell",
      "command": "dotnet",
      "args": [
        "build",
        "--configuration=Debug",
        "${workspaceFolder}/jellyfin/Jellyfin.Server/Jellyfin.Server.csproj",
        "/property:TreatWarningsAsErrors=false",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary"
      ],
      "group": "build",
      "presentation": {
        "reveal": "silent"
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "build",
      "type": "shell",
      "command": "dotnet",
      "args": [
        "publish",
        "--configuration=Debug",
        "${workspaceFolder}/${config:pluginName}/${config:pluginName}.csproj",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary"
      ],
      "group": "build",
      "presentation": {
        "reveal": "silent"
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "make-plugin-dir",
      "type": "shell",
      "command": "mkdir",
      "args": [
        "-p",
        "${config:jellyfinLinuxDataDir}/plugins/PostgreSQL/",
        "${config:jellyfinLinuxDataDir}/plugins/${config:pluginName}/"
      ]
    },
    {
      "label": "copy-dll",
      "type": "shell",
      "command": "sh",
      "args": [
        "-c",
        "cp -r ./${config:pluginName}/bin/Debug/net10.0/publish/* ${config:jellyfinLinuxDataDir}/plugins/PostgreSQL/ && cp -r ./${config:pluginName}/bin/Debug/net10.0/publish/* ${config:jellyfinLinuxDataDir}/plugins/${config:pluginName}/"
      ]
    },
    {
      "label": "build-and-copy",
      "dependsOrder": "sequence",
      "dependsOn": [
        "apply-server-patches",
        "build-server",
        "build",
        "make-plugin-dir",
        "copy-dll"
      ]
    },
    {
      "label": "start-web-dev",
      "type": "shell",
      "command": "npm",
      "args": ["start"],
      "options": {
        "cwd": "${workspaceFolder}/jellyfin-web"
      },
      "problemMatcher": []
    },
    {
      "label": "test-backend",
      "type": "shell",
      "command": "sh",
      "args": [
        "-c",
        "./scripts/apply-patches.sh jellyfin && dotnet test Jellyfin.Plugin.Pgsql.sln"
      ],
      "group": "test",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "test-web",
      "type": "shell",
      "command": "npm",
      "args": ["test"],
      "options": {
        "cwd": "${workspaceFolder}/jellyfin-web"
      },
      "group": "test",
      "problemMatcher": []
    }
  ]
}
