{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "prepare-server-debug",
      "dependsOrder": "sequence",
      "dependsOn": [
        "start-dev-deps",
        "apply-server-patches",
        "sync-dev-plugins",
        "build-ui-next",
        "build-server"
      ]
    },
    {
      "label": "start-dev-deps",
      "type": "shell",
      "command": "docker-compose",
      "args": ["-f", "docker-compose.dev.yaml", "up", "postgres", "keycloak", "-d"],
      "presentation": { "reveal": "silent" },
      "problemMatcher": []
    },
    {
      "label": "stop-dev-deps",
      "type": "shell",
      "command": "docker-compose",
      "args": ["-f", "docker-compose.dev.yaml", "down"],
      "problemMatcher": []
    },
    {
      "label": "apply-server-patches",
      "type": "shell",
      "command": "./scripts/apply-patches.sh",
      "args": ["jellyfin"],
      "problemMatcher": []
    },
    {
      "label": "clean-submodules",
      "type": "shell",
      "command": "./scripts/clean-submodules.sh",
      "problemMatcher": []
    },
    {
      "label": "sync-dev-plugins",
      "type": "shell",
      "command": "./scripts/sync-dev-plugins.sh",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "build-ui-next",
      "type": "shell",
      "command": "npm",
      "args": ["run", "build"],
      "options": { "cwd": "${workspaceFolder}/ui-next" },
      "problemMatcher": []
    },
    {
      "label": "build-server",
      "type": "shell",
      "command": "dotnet",
      "args": [
        "build",
        "--configuration=Debug",
        "${workspaceFolder}/jellyfin/Jellyfin.Server/Jellyfin.Server.csproj",
        "/property:TreatWarningsAsErrors=false",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary"
      ],
      "group": "build",
      "presentation": { "reveal": "silent" },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "start-server",
      "type": "shell",
      "command": "./scripts/dev-backend.sh",
      "problemMatcher": []
    },
    {
      "label": "start-ui-next-dev",
      "type": "shell",
      "command": "npm",
      "args": ["run", "dev"],
      "options": { "cwd": "${workspaceFolder}/ui-next" },
      "problemMatcher": []
    },
    {
      "label": "test-backend",
      "type": "shell",
      "command": "sh",
      "args": ["-c", "./scripts/apply-patches.sh jellyfin && dotnet test Jellyfin.Plugin.Pgsql.sln"],
      "group": "test",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "test-ui-next",
      "type": "shell",
      "command": "npm",
      "args": ["test"],
      "options": { "cwd": "${workspaceFolder}/ui-next" },
      "group": "test",
      "problemMatcher": []
    }
  ]
}
