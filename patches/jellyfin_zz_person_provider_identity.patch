+using System;
+using System.Collections.Generic;
+using MediaBrowser.Controller.Entities;
+using MediaBrowser.Model.Entities;
+using Xunit;
+
+namespace Jellyfin.Controller.Tests.Entities;
+
+public class PersonIdentityTests
+{
+    [Fact]
+    public void TryGetProviderKey_PrefersTmdbOverImdb()
+    {
+        var ids = new Dictionary<string, string>
+        {
+            [MetadataProvider.Imdb.ToString()] = "nm123",
+            [MetadataProvider.Tmdb.ToString()] = "1248"
+        };
+
+        Assert.True(PersonIdentity.TryGetProviderKey(ids, out var key));
+        Assert.Equal("Tmdb:1248", key);
+    }
+
+    [Fact]
+    public void HasConflictingProviderIds_DetectsDifferentTmdbIds()
+    {
+        var first = new Dictionary<string, string> { [MetadataProvider.Tmdb.ToString()] = "1248" };
+        var second = new Dictionary<string, string> { [MetadataProvider.Tmdb.ToString()] = "224290" };
+
+        Assert.True(PersonIdentity.HasConflictingProviderIds(first, second));
+    }
+
+    [Fact]
+    public void HasConflictingProviderIds_AllowsComplementaryProviders()
+    {
+        var first = new Dictionary<string, string> { [MetadataProvider.Tmdb.ToString()] = "1248" };
+        var second = new Dictionary<string, string> { [MetadataProvider.Imdb.ToString()] = "nm0000001" };
+
+        Assert.False(PersonIdentity.HasConflictingProviderIds(first, second));
+    }
+
+    [Fact]
