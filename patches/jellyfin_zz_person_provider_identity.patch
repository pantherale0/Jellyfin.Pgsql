+using System.Collections.Generic;
+using Jellyfin.Data.Enums;
+using MediaBrowser.Controller.Entities;
+using MediaBrowser.Model.Entities;
+using Xunit;
+
+namespace Jellyfin.Controller.Tests.Entities;
+
+public class PeopleHelperTests
+{
+    [Fact]
+    public void AddPerson_DoesNotMergeConflictingProviderIds()
+    {
+        var people = new List<PersonInfo>();
+        var actor = new PersonInfo { Name = "Brian Cox", Type = PersonKind.Actor };
+        actor.SetProviderId(MetadataProvider.Tmdb, "1248");
+        var presenter = new PersonInfo { Name = "Brian Cox", Type = PersonKind.Actor };
+        presenter.SetProviderId(MetadataProvider.Tmdb, "224290");
+
+        PeopleHelper.AddPerson(people, actor);
+        PeopleHelper.AddPerson(people, presenter);
+
+        Assert.Equal(2, people.Count);
+    }
+
+    [Fact]
+    public void AddPerson_MergesSameProviderId()
+    {
+        var people = new List<PersonInfo>();
+        var first = new PersonInfo { Name = "Brian Cox", Type = PersonKind.Actor, Role = "Ryan" };
+        first.SetProviderId(MetadataProvider.Tmdb, "1248");
+        var second = new PersonInfo { Name = "Brian Cox", Type = PersonKind.Actor };
+        second.SetProviderId(MetadataProvider.Tmdb, "1248");
+
+        PeopleHelper.AddPerson(people, first);
+        PeopleHelper.AddPerson(people, second);
+
+        Assert.Single(people);
+        Assert.Equal("Ryan", people[0].Role);
+        Assert.Equal("1248", people[0].GetProviderId(MetadataProvider.Tmdb));
+    }
+
+    [Fact]
+    public void AddPerson_MergesNameOnlyIntoKeyedPerson()
+    {
+        var people = new List<PersonInfo>();
+        var keyed = new PersonInfo { Name = "Brian Cox", Type = PersonKind.Actor };
+        keyed.SetProviderId(MetadataProvider.Tmdb, "1248");
+        var nameOnly = new PersonInfo { Name = "Brian Cox", Type = PersonKind.Actor, Role = "Himself" };
+
+        PeopleHelper.AddPerson(people, keyed);
+        PeopleHelper.AddPerson(people, nameOnly);
+
+        Assert.Single(people);
+        Assert.Equal("Himself", people[0].Role);
+        Assert.Equal("1248", people[0].GetProviderId(MetadataProvider.Tmdb));
+    }
+}
