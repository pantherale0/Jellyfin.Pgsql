diff --git a/MediaBrowser.Controller/Entities/PersonIdentity.cs b/MediaBrowser.Controller/Entities/PersonIdentity.cs
new file mode 100644
index 0000000000..98f6e5e00a
--- /dev/null
+++ b/MediaBrowser.Controller/Entities/PersonIdentity.cs
@@ -0,0 +1,230 @@
+using System;
+using System.Collections.Generic;
+using System.IO;
+using MediaBrowser.Model.Entities;
+
+namespace MediaBrowser.Controller.Entities;
+
+/// <summary>
+/// Resolves stable person identity from metadata provider ids, with name-only fallback.
+/// </summary>
+public static class PersonIdentity
+{
+    private static readonly MetadataProvider[] PreferredProviders =
+    [
+        MetadataProvider.Tmdb,
+        MetadataProvider.Imdb,
+        MetadataProvider.Tvdb
+    ];
+
+    /// <summary>
+    /// Tries to get the preferred provider key for a person (e.g. <c>Tmdb:1248</c>).
+    /// </summary>
+    /// <param name="providerIds">Provider id map.</param>
+    /// <param name="providerKey">The resolved key when found.</param>
+    /// <returns><c>true</c> when a preferred provider id is present.</returns>
+    public static bool TryGetProviderKey(IReadOnlyDictionary<string, string>? providerIds, out string? providerKey)
+    {
+        providerKey = null;
+        if (providerIds is null || providerIds.Count == 0)
+        {
+            return false;
+        }
+
+        foreach (var provider in PreferredProviders)
+        {
+            var name = provider.ToString();
+            if (providerIds.TryGetValue(name, out var value)
+                && !string.IsNullOrWhiteSpace(value))
+            {
+                providerKey = FormatProviderKey(name, value);
+                return true;
+            }
+        }
+
+        // Case-insensitive fallback for dictionaries that were not created with OrdinalIgnoreCase.
+        foreach (var provider in PreferredProviders)
+        {
+            var name = provider.ToString();
+            foreach (var pair in providerIds)
+            {
+                if (string.Equals(pair.Key, name, StringComparison.OrdinalIgnoreCase)
+                    && !string.IsNullOrWhiteSpace(pair.Value))
+                {
+                    providerKey = FormatProviderKey(name, pair.Value);
+                    return true;
+                }
+            }
+        }
+
+        return false;
+    }
+
+    /// <summary>
+    /// Tries to get the preferred provider key from an <see cref="IHasProviderIds"/> instance.
+    /// </summary>
+    /// <param name="hasProviderIds">Object with provider ids.</param>
+    /// <param name="providerKey">The resolved key when found.</param>
+    /// <returns><c>true</c> when a preferred provider id is present.</returns>
+    public static bool TryGetProviderKey(IHasProviderIds? hasProviderIds, out string? providerKey)
+    {
+        providerKey = null;
+        return hasProviderIds is not null && TryGetProviderKey(hasProviderIds.ProviderIds, out providerKey);
+    }
+
+    /// <summary>
+    /// Formats a provider key string.
+    /// </summary>
+    /// <param name="providerName">Provider name (e.g. Tmdb).</param>
+    /// <param name="providerValue">Provider value.</param>
+    /// <returns>Normalized key.</returns>
+    public static string FormatProviderKey(string providerName, string providerValue)
+        => $"{providerName}:{providerValue.Trim()}";
+
+    /// <summary>
+    /// Parses a provider key into name and value.
+    /// </summary>
+    /// <param name="providerKey">Key in <c>Provider:Value</c> form.</param>
+    /// <param name="providerName">Provider name.</param>
+    /// <param name="providerValue">Provider value.</param>
+    /// <returns><c>true</c> when parsing succeeds.</returns>
+    public static bool TryParseProviderKey(string? providerKey, out string providerName, out string providerValue)
+    {
+        providerName = string.Empty;
+        providerValue = string.Empty;
+        if (string.IsNullOrWhiteSpace(providerKey))
+        {
+            return false;
+        }
+
+        var separator = providerKey.IndexOf(':', StringComparison.Ordinal);
+        if (separator <= 0 || separator >= providerKey.Length - 1)
+        {
+            return false;
+        }
+
+        providerName = providerKey[..separator];
+        providerValue = providerKey[(separator + 1)..];
+        return !string.IsNullOrWhiteSpace(providerName) && !string.IsNullOrWhiteSpace(providerValue);
+    }
+
+    /// <summary>
+    /// Builds a filesystem-safe folder name suffix for a provider key (e.g. <c>tmdb-1248</c>).
+    /// </summary>
+    /// <param name="providerKey">Provider key.</param>
+    /// <returns>Path suffix without brackets.</returns>
+    public static string GetPathSuffix(string providerKey)
+    {
+        if (!TryParseProviderKey(providerKey, out var providerName, out var providerValue))
+        {
+            return providerKey;
+        }
+
+        var safeValue = providerValue.Trim();
+        foreach (var c in Path.GetInvalidFileNameChars())
+        {
+            safeValue = safeValue.Replace(c, '_');
+        }
+
+        return $"{providerName.ToLowerInvariant()}-{safeValue}";
+    }
+
+    /// <summary>
+    /// Gets a selection key used to dedupe people within an item update.
+    /// </summary>
+    /// <param name="name">Person name.</param>
+    /// <param name="personType">Person type string.</param>
+    /// <param name="providerKey">Optional provider key.</param>
+    /// <returns>Selection key.</returns>
+    public static string GetSelectionKey(string name, string? personType, string? providerKey)
+    {
+        var typePart = personType ?? string.Empty;
+        if (!string.IsNullOrEmpty(providerKey))
+        {
+            return providerKey + "\0" + typePart;
+        }
+
+        return name.ToLowerInvariant() + "\0" + typePart;
+    }
+
+    /// <summary>
+    /// Returns whether two provider-id maps conflict (same provider, different values).
+    /// </summary>
+    /// <param name="first">First map.</param>
+    /// <param name="second">Second map.</param>
+    /// <returns><c>true</c> when a conflict exists.</returns>
+    public static bool HasConflictingProviderIds(
+        IReadOnlyDictionary<string, string>? first,
+        IReadOnlyDictionary<string, string>? second)
+    {
+        if (first is null || second is null || first.Count == 0 || second.Count == 0)
+        {
+            return false;
+        }
+
+        foreach (var provider in PreferredProviders)
+        {
+            var name = provider.ToString();
+            var firstValue = GetProviderValue(first, name);
+            var secondValue = GetProviderValue(second, name);
+            if (firstValue is not null
+                && secondValue is not null
+                && !string.Equals(firstValue, secondValue, StringComparison.OrdinalIgnoreCase))
+            {
+                return true;
+            }
+        }
+
+        return false;
+    }
+
+    /// <summary>
+    /// Returns whether two provider-id maps share at least one preferred provider value.
+    /// </summary>
+    /// <param name="first">First map.</param>
+    /// <param name="second">Second map.</param>
+    /// <returns><c>true</c> when they share an id.</returns>
+    public static bool SharesProviderId(
+        IReadOnlyDictionary<string, string>? first,
+        IReadOnlyDictionary<string, string>? second)
+    {
+        if (first is null || second is null || first.Count == 0 || second.Count == 0)
+        {
+            return false;
+        }
+
+        foreach (var provider in PreferredProviders)
+        {
+            var name = provider.ToString();
+            var firstValue = GetProviderValue(first, name);
+            var secondValue = GetProviderValue(second, name);
+            if (firstValue is not null
+                && secondValue is not null
+                && string.Equals(firstValue, secondValue, StringComparison.OrdinalIgnoreCase))
+            {
+                return true;
+            }
+        }
+
+        return false;
+    }
+
+    private static string? GetProviderValue(IReadOnlyDictionary<string, string> providerIds, string name)
+    {
+        if (providerIds.TryGetValue(name, out var value) && !string.IsNullOrWhiteSpace(value))
+        {
+            return value.Trim();
+        }
+
+        foreach (var pair in providerIds)
+        {
+            if (string.Equals(pair.Key, name, StringComparison.OrdinalIgnoreCase)
+                && !string.IsNullOrWhiteSpace(pair.Value))
+            {
+                return pair.Value.Trim();
+            }
+        }
+
+        return null;
+    }
+}
