+/**
+ * Soft sign-out for shared-device profile switching.
+ * Keeps remembered profile tokens valid (does not call server logout).
+ */
+export function switchUser() {
+    const apiClient = window.ApiClient;
+    const finish = (serverId) => {
+        queryClient.clear();
+        viewContainer.reset();
+        const loginUrl = serverId
+            ? `login?serverid=${encodeURIComponent(serverId)}&switchUser=1`
+            : 'login?switchUser=1';
+        return navigate(loginUrl);
+    };
+
+    if (!apiClient) {
+        return Promise.resolve(finish());
+    }
+
+    const serverId = apiClient.serverId();
+    const accessToken = apiClient.accessToken();
+
+    return apiClient.getCurrentUser().then((user) => {
+        upsertRememberedUser(serverId, {
+            userId: user.Id,
+            name: user.Name,
+            primaryImageTag: user.PrimaryImageTag,
+            accessToken,
+            hasPassword: user.HasPassword
+        });
+    }).catch(() => {
+        const userId = apiClient.getCurrentUserId();
+        if (userId) {
+            upsertRememberedUser(serverId, {
+                userId,
+                name: userId,
+                accessToken
+            });
+        }
+    }).then(() => {
+        const server = apiClient.serverInfo() || {};
+        server.UserId = null;
+        server.AccessToken = null;
+        server.ExchangeToken = null;
+
+        const credentialProvider = ServerConnections.credentialProvider();
+        const credentials = credentialProvider.credentials();
+        credentialProvider.addOrUpdateServer(credentials.Servers, server);
+        credentialProvider.credentials(credentials);
+
+        apiClient.setAuthenticationInfo(null, null);
+        setUserInfo(null, null);
+
+        return finish(serverId);
+    });
+}
