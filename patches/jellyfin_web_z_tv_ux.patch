diff --git a/src/scripts/infiniteScrollHelper.js b/src/scripts/infiniteScrollHelper.js
new file mode 100644
index 0000000000..d6b3192fe8
--- /dev/null
+++ b/src/scripts/infiniteScrollHelper.js
@@ -0,0 +1,101 @@
+import browser from './browser';
+import * as userSettings from './settings/userSettings';
+
+/**
+ * Minimum page size for infinite scroll. TVs need larger chunks to avoid
+ * frequent DOM updates on slow Chromium builds (e.g. webOS 5).
+ * @param {number} desktopMin
+ * @returns {number}
+ */
+export function getInfiniteScrollLimit(desktopMin = 40) {
+    const pageSize = userSettings.libraryPageSize();
+    const minLimit = (browser.tv || browser.slow) ? 100 : desktopMin;
+
+    if (userSettings.enableInfiniteScroll()) {
+        if (!pageSize || pageSize < minLimit) {
+            return minLimit;
+        }
+    }
+
+    return pageSize;
+}
+
+/**
+ * @returns {number} percent of scroll height at which to prefetch
+ */
+export function getScrollPrefetchThreshold() {
+    return (browser.tv || browser.slow) ? 70 : 95;
+}
+
+/**
+ * @param {number} [threshold]
+ * @returns {boolean}
+ */
+export function isNearScrollBottom(threshold = getScrollPrefetchThreshold()) {
+    const scrollTop = window.scrollY || window.pageYOffset;
+    const scrollHeight = document.documentElement.scrollHeight || document.body.scrollHeight;
+    const clientHeight = document.documentElement.clientHeight || window.innerHeight;
+    const denom = scrollHeight - clientHeight;
+    if (denom <= 0) {
+        return false;
+    }
+
+    return ((scrollTop / denom) * 100) >= threshold;
+}
+
+/**
+ * Bind window scroll + focus-near-end listeners for infinite scroll.
+ * @param {{
+ *   view: Element,
+ *   tabElement?: Element,
+ *   itemsContainer: Element,
+ *   scrollController: AbortController,
+ *   shouldLoadMore: () => boolean,
+ *   onLoadMore: () => void
+ * }} options
+ */
+export function bindInfiniteScroll(options) {
+    const {
+        view,
+        tabElement,
+        itemsContainer,
+        scrollController,
+        shouldLoadMore,
+        onLoadMore
+    } = options;
+
+    view.addEventListener('viewdestroy', () => {
+        scrollController.abort();
+    }, { signal: scrollController.signal });
+
+    const maybeLoad = () => {
+        if (!shouldLoadMore()) {
+            return;
+        }
+
+        if (tabElement && !tabElement.classList.contains('is-active')) {
+            return;
+        }
+
+        onLoadMore();
+    };
+
+    window.addEventListener('scroll', () => {
+        if (isNearScrollBottom()) {
+            maybeLoad();
+        }
+    }, { signal: scrollController.signal, passive: true });
+
+    itemsContainer.addEventListener('focusin', (e) => {
+        const cards = itemsContainer.querySelectorAll('[data-id]');
+        if (!cards.length) {
+            return;
+        }
+
+        const lookback = Math.min(12, cards.length);
+        const lastCards = Array.from(cards).slice(-lookback);
+        if (lastCards.some(card => card === e.target || card.contains(e.target))) {
+            maybeLoad();
+        }
+    }, { signal: scrollController.signal });
+}
