diff --git a/src/scripts/settings/rememberedUsers.js b/src/scripts/settings/rememberedUsers.js
new file mode 100644
index 0000000000..285da85792
--- /dev/null
+++ b/src/scripts/settings/rememberedUsers.js
@@ -0,0 +1,114 @@
+const STORAGE_KEY = 'jellyfin_remembered_users';
+const MAX_USERS_PER_SERVER = 8;
+
+function readStore() {
+    try {
+        const raw = localStorage.getItem(STORAGE_KEY);
+        if (!raw) {
+            return {};
+        }
+
+        const parsed = JSON.parse(raw);
+        return parsed && typeof parsed === 'object' ? parsed : {};
+    } catch {
+        return {};
+    }
+}
+
+function writeStore(store) {
+    localStorage.setItem(STORAGE_KEY, JSON.stringify(store));
+}
+
+function normalizeServerId(serverId) {
+    return serverId || '_default';
+}
+
+/**
+ * @param {string} serverId
+ * @returns {Array<{userId: string, name: string, primaryImageTag?: string, lastSignedIn: number, accessToken?: string, hasPassword?: boolean}>}
+ */
+export function getRememberedUsers(serverId) {
+    const list = readStore()[normalizeServerId(serverId)] || [];
+    return list
+        .slice()
+        .sort((a, b) => (b.lastSignedIn || 0) - (a.lastSignedIn || 0));
+}
+
+/**
+ * Upsert a remembered profile for a server.
+ * @param {string} serverId
+ * @param {{userId: string, name: string, primaryImageTag?: string, accessToken?: string|null, hasPassword?: boolean}} profile
+ * @param {{persistToken?: boolean}} [options]
+ */
+export function upsertRememberedUser(serverId, profile, options = {}) {
+    if (!profile?.userId || !profile?.name) {
+        return;
+    }
+
+    const key = normalizeServerId(serverId);
+    const store = readStore();
+    const list = store[key] || [];
+    const existing = list.find(u => u.userId === profile.userId);
+    const persistToken = options.persistToken !== false;
+
+    const next = {
+        userId: profile.userId,
+        name: profile.name,
+        primaryImageTag: profile.primaryImageTag || existing?.primaryImageTag,
+        hasPassword: profile.hasPassword ?? existing?.hasPassword ?? true,
+        lastSignedIn: Date.now()
+    };
+
+    if (profile.accessToken === null) {
+        // Explicitly drop token.
+    } else if (persistToken && profile.accessToken) {
+        next.accessToken = profile.accessToken;
+    } else if (persistToken && existing?.accessToken) {
+        next.accessToken = existing.accessToken;
+    }
+
+    const filtered = list.filter(u => u.userId !== profile.userId);
+    filtered.unshift(next);
+    store[key] = filtered.slice(0, MAX_USERS_PER_SERVER);
+    writeStore(store);
+}
+
+/**
+ * Clear only the stored access token for a user (keeps picker entry).
+ * @param {string} serverId
+ * @param {string} userId
+ */
+export function clearRememberedUserToken(serverId, userId) {
+    const key = normalizeServerId(serverId);
+    const store = readStore();
+    const list = store[key];
+    if (!list) {
+        return;
+    }
+
+    store[key] = list.map(u => {
+        if (u.userId !== userId) {
+            return u;
+        }
+
+        const copy = { ...u };
+        delete copy.accessToken;
+        return copy;
+    });
+    writeStore(store);
+}
+
+/**
+ * @param {string} serverId
+ * @param {string} userId
+ */
+export function getRememberedUser(serverId, userId) {
+    return getRememberedUsers(serverId).find(u => u.userId === userId) || null;
+}
+
+export default {
+    getRememberedUsers,
+    getRememberedUser,
+    upsertRememberedUser,
+    clearRememberedUserToken
+};
