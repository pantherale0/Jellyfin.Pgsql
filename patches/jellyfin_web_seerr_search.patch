+import { useQuery } from '@tanstack/react-query';
+import type { ApiClient } from 'jellyfin-apiclient';
+import { useApi } from 'hooks/useApi';
+import type { SeerrSearchResponse, SeerrStatusResponse } from './seerrTypes';
+import { isSeerrEnabled } from './seerrTypes';
+
+const CamelCaseAccept = 'application/json; profile="CamelCase"';
+
+const fetchSeerrStatus = async (apiClient: ApiClient): Promise<SeerrStatusResponse> => {
+    return apiClient.ajax({
+        type: 'GET',
+        url: apiClient.getUrl('Seerr/Status'),
+        dataType: 'json',
+        headers: { accept: CamelCaseAccept }
+    });
+};
+
+const fetchSeerrSearch = async (
+    apiClient: ApiClient,
+    query: string
+): Promise<SeerrSearchResponse> => {
+    return apiClient.ajax({
+        type: 'GET',
+        url: apiClient.getUrl('Seerr/Search', { query }),
+        dataType: 'json',
+        headers: { accept: CamelCaseAccept }
+    });
+};
+
+export const useSeerrStatus = () => {
+    const { __legacyApiClient__: apiClient } = useApi();
+
+    return useQuery({
+        queryKey: ['Seerr', 'Status'],
+        queryFn: () => fetchSeerrStatus(apiClient!),
+        enabled: !!apiClient,
+        staleTime: 60_000,
+        retry: false
+    });
+};
+
+export const useSeerrSearch = (searchTerm?: string) => {
+    const { __legacyApiClient__: apiClient } = useApi();
+    const { data: status } = useSeerrStatus();
+    const query = searchTerm?.trim();
+
+    return useQuery({
+        queryKey: ['Seerr', 'Search', query],
+        queryFn: () => fetchSeerrSearch(apiClient!, query!),
+        enabled: !!apiClient && isSeerrEnabled(status) && !!query,
+        retry: false
+    });
+};
+
+export const requestSeerrMedia = async (
+    apiClient: ApiClient,
+    mediaType: string,
+    mediaId: number
+) => {
+    return apiClient.ajax({
+        type: 'POST',
+        url: apiClient.getUrl('Seerr/Request'),
+        data: JSON.stringify({ mediaType, mediaId }),
+        contentType: 'application/json',
+        dataType: 'json',
+        headers: { accept: CamelCaseAccept }
+    });
+};
