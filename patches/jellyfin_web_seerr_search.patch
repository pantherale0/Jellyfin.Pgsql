@@ -0,0 +1,117 @@
+import React, { type FC, useCallback, useState } from 'react';
+import globalize from 'lib/globalize';
+import toast from 'components/toast/toast';
+import { useApi } from 'hooks/useApi';
+import { requestSeerrMedia } from '../api/useSeerrSearch';
+import type { NormalizedSeerrSearchItem } from '../api/seerrTypes';
+import './seerrRequestResults.scss';
+
+interface SeerrRequestResultsProps {
+    items: NormalizedSeerrSearchItem[];
+}
+
+const SeerrRequestResults: FC<SeerrRequestResultsProps> = ({ items }) => {
+    const { __legacyApiClient__: apiClient } = useApi();
+    const [requestedIds, setRequestedIds] = useState<Set<string>>(new Set());
+    const [pendingIds, setPendingIds] = useState<Set<string>>(new Set());
+
+    const onRequest = useCallback(async (item: NormalizedSeerrSearchItem) => {
+        if (!apiClient) {
+            return;
+        }
+
+        const key = `${item.mediaType}:${item.mediaId}`;
+        setPendingIds(prev => new Set(prev).add(key));
+
+        try {
+            await requestSeerrMedia(apiClient, item.mediaType, item.mediaId);
+            setRequestedIds(prev => new Set(prev).add(key));
+            toast(globalize.translate('SeerrRequestSuccess', item.title));
+        } catch (err: unknown) {
+            let message = globalize.translate('SeerrRequestFailed');
+            const response = err as { responseText?: string; statusText?: string };
+            if (response?.responseText) {
+                try {
+                    const parsed = JSON.parse(response.responseText) as {
+                        message?: string;
+                        Message?: string;
+                    };
+                    if (parsed.message || parsed.Message) {
+                        message = parsed.message || parsed.Message || message;
+                    }
+                } catch {
+                    // Keep default message.
+                }
+            }
+            toast(message);
+        } finally {
+            setPendingIds(prev => {
+                const next = new Set(prev);
+                next.delete(key);
+                return next;
+            });
+        }
+    }, [apiClient]);
+
+    if (!items.length) {
+        return null;
+    }
+
+    return (
+        <div className='seerrRequestResults padded-left padded-right verticalSection'>
+            <h2 className='sectionTitle sectionTitle-cards'>
+                {globalize.translate('HeaderSeerrRequests')}
+            </h2>
+            <div className='seerrRequestList'>
+                {items.map(item => {
+                    const key = `${item.mediaType}:${item.mediaId}`;
+                    const isRequested = requestedIds.has(key) || !item.canRequest;
+                    const isPending = pendingIds.has(key);
+                    const mediaLabel = item.mediaType === 'tv'
+                        ? globalize.translate('Series')
+                        : globalize.translate('Movie');
+                    const meta = [item.year, mediaLabel]
+                        .filter(Boolean)
+                        .join(' · ');
+
+                    return (
+                        <div className='seerrRequestCard' key={key}>
+                            <div className='seerrRequestPoster'>
+                                {item.posterUrl ? (
+                                    <img src={item.posterUrl} alt='' loading='lazy' />
+                                ) : (
+                                    <div className='seerrRequestPosterPlaceholder' />
+                                )}
+                            </div>
+                            <div className='seerrRequestBody'>
+                                <div className='seerrRequestTitle'>{item.title}</div>
+                                {meta && <div className='seerrRequestMeta secondaryText'>{meta}</div>}
+                                {item.overview && (
+                                    <div className='seerrRequestOverview secondaryText'>{item.overview}</div>
+                                )}
+                            </div>
+                            <div className='seerrRequestActions'>
+                                <button
+                                    type='button'
+                                    className='emby-button raised button-submit'
+                                    disabled={isRequested || isPending}
+                                    onClick={() => {
+                                        void onRequest(item);
+                                    }}
+                                >
+                                    {isRequested
+                                        ? globalize.translate('SeerrRequested')
+                                        : isPending
+                                            ? globalize.translate('SeerrRequesting')
+                                            : globalize.translate('ButtonRequest')}
+                                </button>
+                            </div>
+                        </div>
+                    );
+                })}
+            </div>
+        </div>
+    );
+};
+
+export default SeerrRequestResults;
