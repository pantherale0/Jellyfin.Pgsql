+.seerrRequestList {
+    display: flex;
+    flex-direction: column;
+    gap: 0.75rem;
+}
+
+.seerrRequestCard {
+    display: flex;
+    align-items: flex-start;
+    gap: 1rem;
+    padding: 0.75rem 0;
+}
+
+.seerrRequestPoster {
+    flex: 0 0 4.5rem;
+    width: 4.5rem;
+    height: 6.75rem;
+    overflow: hidden;
+    border-radius: 0.25rem;
+    background: rgba(255, 255, 255, 0.08);
+}
+
+.seerrRequestPoster img {
+    width: 100%;
+    height: 100%;
+    object-fit: cover;
+    display: block;
+}
+
+.seerrRequestPosterPlaceholder {
+    width: 100%;
+    height: 100%;
+}
+
+.seerrRequestBody {
+    flex: 1 1 auto;
+    min-width: 0;
+}
+
+.seerrRequestTitle {
+    font-weight: 600;
+    margin-bottom: 0.25rem;
+}
+
+.seerrRequestMeta {
+    font-size: 0.9em;
+    margin-bottom: 0.35rem;
+}
+
+.seerrRequestOverview {
+    font-size: 0.9em;
+    display: -webkit-box;
+    -webkit-line-clamp: 2;
+    -webkit-box-orient: vertical;
+    overflow: hidden;
+}
+
+.seerrRequestActions {
+    flex: 0 0 auto;
+    align-self: center;
+}
+
+@media (max-width: 600px) {
+    .seerrRequestCard {
+        flex-wrap: wrap;
+    }
+
+    .seerrRequestActions {
+        width: 100%;
+    }
+
+    .seerrRequestActions .emby-button {
+        width: 100%;
+    }
+}
