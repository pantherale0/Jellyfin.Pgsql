+export type SeerrMediaStatus =
+    | 'Unknown'
+    | 'Pending'
+    | 'Processing'
+    | 'PartiallyAvailable'
+    | 'Available'
+    | 'Blocklisted'
+    | 'Deleted'
+    | number;
+
+/** CamelCase fields preferred; PascalCase accepted for legacy Accept: application/json. */
+export interface SeerrStatusResponse {
+    enabled?: boolean;
+    Enabled?: boolean;
+}
+
+export interface SeerrSearchItem {
+    mediaType?: 'movie' | 'tv' | string;
+    MediaType?: string;
+    mediaId?: number;
+    MediaId?: number;
+    title?: string;
+    Title?: string;
+    year?: number | null;
+    Year?: number | null;
+    overview?: string | null;
+    Overview?: string | null;
+    posterUrl?: string | null;
+    PosterUrl?: string | null;
+    status?: SeerrMediaStatus;
+    Status?: SeerrMediaStatus;
+    canRequest?: boolean;
+    CanRequest?: boolean;
+}
+
+export interface SeerrSearchResponse {
+    items?: SeerrSearchItem[];
+    Items?: SeerrSearchItem[];
+}
+
+export interface SeerrRequestResponse {
+    requestId?: number | null;
+    RequestId?: number | null;
+    message?: string;
+    Message?: string;
+}
+
+export interface NormalizedSeerrSearchItem {
+    mediaType: 'movie' | 'tv' | string;
+    mediaId: number;
+    title: string;
+    year?: number | null;
+    overview?: string | null;
+    posterUrl?: string | null;
+    status: SeerrMediaStatus;
+    canRequest: boolean;
+}
+
+export const isSeerrEnabled = (status?: SeerrStatusResponse | null): boolean =>
+    !!(status?.enabled ?? status?.Enabled);
+
+export const normalizeSeerrSearchItem = (item: SeerrSearchItem): NormalizedSeerrSearchItem => ({
+    mediaType: item.mediaType ?? item.MediaType ?? 'movie',
+    mediaId: item.mediaId ?? item.MediaId ?? 0,
+    title: item.title ?? item.Title ?? 'Untitled',
+    year: item.year ?? item.Year,
+    overview: item.overview ?? item.Overview,
+    posterUrl: item.posterUrl ?? item.PosterUrl,
+    status: item.status ?? item.Status ?? 'Unknown',
+    canRequest: !!(item.canRequest ?? item.CanRequest)
+});
+
+export const getSeerrSearchItems = (data?: SeerrSearchResponse | null): NormalizedSeerrSearchItem[] =>
+    (data?.items ?? data?.Items ?? []).map(normalizeSeerrSearchItem);
