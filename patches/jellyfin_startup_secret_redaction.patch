+using Jellyfin.Server.Helpers;
+using Xunit;
+
+namespace Jellyfin.Server.Tests.Helpers;
+
+public class StartupHelpersTests
+{
+    [Theory]
+    [InlineData("JELLYFIN_SSO_OIDC_CLIENT_SECRET", true)]
+    [InlineData("JELLYFIN_API_TOKEN", true)]
+    [InlineData("JELLYFIN_REDIS_CONNECTION_STRING", true)]
+    [InlineData("JELLYFIN_CACHE_DIR", false)]
+    [InlineData("JELLYFIN_PublishedServerUrl", false)]
+    public void IsSensitiveEnvironmentVariable_ClassifiesNames(string name, bool expected)
+    {
+        Assert.Equal(expected, StartupHelpers.IsSensitiveEnvironmentVariable(name));
+    }
+}
