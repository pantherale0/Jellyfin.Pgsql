diff --git a/MediaBrowser.Controller/LiveTv/LiveTvParentalAccess.cs b/MediaBrowser.Controller/LiveTv/LiveTvParentalAccess.cs
new file mode 100644
index 0000000000..ae12d1426f
--- /dev/null
+++ b/MediaBrowser.Controller/LiveTv/LiveTvParentalAccess.cs
@@ -0,0 +1,170 @@
+#nullable enable
+
+using System;
+using System.Collections.Generic;
+using System.Linq;
+using Jellyfin.Database.Implementations.Entities;
+using Jellyfin.Database.Implementations.Enums;
+using Jellyfin.Extensions;
+using MediaBrowser.Controller.Entities;
+
+namespace MediaBrowser.Controller.LiveTv;
+
+/// <summary>
+/// Helpers for SSO/RBAC Live TV allowlists that bypass block-unrated and AllowedTags.
+/// </summary>
+public static class LiveTvParentalAccess
+{
+    /// <summary>
+    /// Tag prefix used to index M3U/playlist channel groups for SQL filtering.
+    /// </summary>
+    public const string ChannelGroupTagPrefix = "ChannelGroup:";
+
+    /// <summary>
+    /// Well-known EPG category tags that can be selected as Live TV categories.
+    /// </summary>
+    public static readonly string[] EpgCategoryTags = ["Kids", "Sports", "News"];
+
+    /// <summary>
+    /// Syncs the <see cref="ChannelGroupTagPrefix"/> tag on a channel from its <see cref="LiveTvChannel.ChannelGroup"/>.
+    /// </summary>
+    /// <param name="channel">The channel.</param>
+    public static void SyncChannelGroupTag(LiveTvChannel channel)
+    {
+        ArgumentNullException.ThrowIfNull(channel);
+
+        var tags = channel.Tags?.ToList() ?? [];
+        tags.RemoveAll(t => t.StartsWith(ChannelGroupTagPrefix, StringComparison.OrdinalIgnoreCase));
+        if (!string.IsNullOrWhiteSpace(channel.ChannelGroup))
+        {
+            tags.Add(ChannelGroupTagPrefix + channel.ChannelGroup.Trim());
+        }
+
+        channel.Tags = tags;
+    }
+
+    /// <summary>
+    /// Builds cleaned tag values used to match allowlisted categories in SQL.
+    /// </summary>
+    /// <param name="categories">Category names (M3U groups and/or Kids/Sports/News).</param>
+    /// <returns>Cleaned tag values.</returns>
+    public static string[] GetCategoryMatchTags(IEnumerable<string> categories)
+    {
+        return categories
+            .Where(c => !string.IsNullOrWhiteSpace(c))
+            .SelectMany(c =>
+            {
+                var trimmed = c.Trim();
+                return new[]
+                {
+                    (ChannelGroupTagPrefix + trimmed).GetCleanValue(),
+                    trimmed.GetCleanValue()
+                };
+            })
+            .Distinct(StringComparer.Ordinal)
+            .ToArray();
+    }
+
+    /// <summary>
+    /// Returns whether the user has any Live TV allowlist preferences.
+    /// </summary>
+    /// <param name="user">The user.</param>
+    /// <returns><c>true</c> if allowlists are configured.</returns>
+    public static bool HasAllowlist(User user)
+    {
+        ArgumentNullException.ThrowIfNull(user);
+        return user.GetPreferenceValues<Guid>(PreferenceKind.AllowedLiveTvChannels).Length > 0
+            || user.GetPreference(PreferenceKind.AllowedLiveTvCategories).Length > 0;
+    }
+
+    /// <summary>
+    /// Returns whether a Live TV channel is on the user's allowlist.
+    /// </summary>
+    /// <param name="channel">The channel.</param>
+    /// <param name="user">The user.</param>
+    /// <returns><c>true</c> if allowlisted.</returns>
+    public static bool IsChannelWhitelisted(LiveTvChannel channel, User user)
+    {
+        ArgumentNullException.ThrowIfNull(channel);
+        ArgumentNullException.ThrowIfNull(user);
+
+        var allowedIds = user.GetPreferenceValues<Guid>(PreferenceKind.AllowedLiveTvChannels);
+        if (allowedIds.Contains(channel.Id))
+        {
+            return true;
+        }
+
+        var categories = user.GetPreference(PreferenceKind.AllowedLiveTvCategories);
+        if (categories.Length == 0)
+        {
+            return false;
+        }
+
+        if (!string.IsNullOrWhiteSpace(channel.ChannelGroup)
+            && categories.Any(c => string.Equals(c, channel.ChannelGroup, StringComparison.OrdinalIgnoreCase)))
+        {
+            return true;
+        }
+
+        foreach (var category in categories)
+        {
+            if (string.IsNullOrWhiteSpace(category))
+            {
+                continue;
+            }
+
+            if (channel.Tags.Contains(category.Trim(), StringComparison.OrdinalIgnoreCase))
+            {
+                return true;
+            }
+        }
+
+        return false;
+    }
+
+    /// <summary>
+    /// Returns whether a Live TV program's parent channel is on the user's allowlist.
+    /// </summary>
+    /// <param name="program">The program.</param>
+    /// <param name="user">The user.</param>
+    /// <returns><c>true</c> if allowlisted.</returns>
+    public static bool IsProgramWhitelisted(LiveTvProgram program, User user)
+    {
+        ArgumentNullException.ThrowIfNull(program);
+        ArgumentNullException.ThrowIfNull(user);
+
+        if (program.ChannelId.Equals(default))
+        {
+            return false;
+        }
+
+        var allowedIds = user.GetPreferenceValues<Guid>(PreferenceKind.AllowedLiveTvChannels);
+        if (allowedIds.Contains(program.ChannelId))
+        {
+            return true;
+        }
+
+        if (BaseItem.LibraryManager?.GetItemById(program.ChannelId) is LiveTvChannel channel)
+        {
+            return IsChannelWhitelisted(channel, user);
+        }
+
+        return false;
+    }
+
+    /// <summary>
+    /// Returns whether a base item is a whitelisted Live TV channel or program.
+    /// </summary>
+    /// <param name="item">The item.</param>
+    /// <param name="user">The user.</param>
+    /// <returns><c>true</c> if allowlisted.</returns>
+    public static bool IsWhitelisted(BaseItem item, User user)
+    {
+        return item switch
+        {
+            LiveTvChannel channel => IsChannelWhitelisted(channel, user),
+            LiveTvProgram program => IsProgramWhitelisted(program, user),
+            _ => false
+        };
+    }
+}
