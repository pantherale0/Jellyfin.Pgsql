+    /// <summary>
+    /// Expands Live TV channel/category allowlist preferences into concrete channel IDs.
+    /// </summary>
+    private static Guid[] ExpandAllowedLiveTvChannelIds(JellyfinDbContext context, User? user)
+    {
+        if (user is null)
+        {
+            return [];
+        }
+
+        var explicitIds = user.GetPreferenceValues<Guid>(PreferenceKind.AllowedLiveTvChannels);
+        var categories = user.GetPreference(PreferenceKind.AllowedLiveTvCategories);
+        if (explicitIds.Length == 0 && categories.Length == 0)
+        {
+            return [];
+        }
+
+        var allowed = new HashSet<Guid>(explicitIds);
+        if (categories.Length == 0)
+        {
+            return allowed.ToArray();
+        }
+
+        var matchTags = LiveTvParentalAccess.GetCategoryMatchTags(categories);
+        if (matchTags.Length == 0)
+        {
+            return allowed.ToArray();
+        }
+
+        var liveTvChannelUnrated = UnratedItem.LiveTvChannel.ToString();
+        var categoryChannelIds = context.BaseItems
+            .AsNoTracking()
+            .Where(e => e.UnratedType == liveTvChannelUnrated)
+            .Where(e => e.ItemValues!.Any(iv =>
+                iv.ItemValue.Type == ItemValueType.Tags && matchTags.Contains(iv.ItemValue.CleanValue)))
+            .Select(e => e.Id);
+
+        foreach (var id in categoryChannelIds)
+        {
+            allowed.Add(id);
+        }
+
+        return allowed.ToArray();
+    }
+
