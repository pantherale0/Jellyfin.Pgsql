diff --git a/src/components/playback/playbackError.ts b/src/components/playback/playbackError.ts
new file mode 100644
index 0000000000..27b595b369
--- /dev/null
+++ b/src/components/playback/playbackError.ts
@@ -0,0 +1,206 @@
+import dialog from 'components/dialog/dialog';
+import { appRouter } from 'components/router/appRouter';
+import globalize from 'lib/globalize';
+import { MediaError } from 'types/mediaError';
+
+export type PlaybackErrorAction = 'close' | 'retry' | 'retryTranscode';
+
+export interface PlaybackErrorContext {
+    item?: { Id?: string; ServerId?: string; Name?: string };
+    playOptions?: Record<string, unknown>;
+    httpStatus?: number;
+    directPlayEnabled?: boolean;
+}
+
+export interface PlaybackErrorPresentation {
+    titleKey: string;
+    messageKey: string;
+    tipKey?: string;
+    actions: PlaybackErrorAction[];
+}
+
+const SERVER_ERROR_CODES = new Set([
+    'NotAllowed',
+    'NoCompatibleStream',
+    'RateLimitExceeded',
+    'TranscodeFailed',
+    'TranscodeNotAllowed',
+    'StreamUnavailable',
+    'LiveStreamFenced'
+]);
+
+const TRANSCODE_COMPAT_CODES = new Set([
+    'NoCompatibleStream',
+    'MEDIA_DECODE_ERROR',
+    'MEDIA_NOT_SUPPORTED',
+    'FATAL_HLS_ERROR',
+    'PLAYER_ERROR',
+    'TranscodeFailed'
+]);
+
+function stripPlaybackErrorPrefix(code: string): string {
+    return code.startsWith('PlaybackError.') ? code.slice('PlaybackError.'.length) : code;
+}
+
+function normalizeCode(code: string): string {
+    const stripped = stripPlaybackErrorPrefix(code);
+
+    if (stripped === 'PlaybackErrorNoCompatibleStream') {
+        return 'NoCompatibleStream';
+    }
+
+    if (stripped === 'PlaybackErrorPlaceHolder') {
+        return 'PlaceHolder';
+    }
+
+    if (SERVER_ERROR_CODES.has(stripped)) {
+        return stripped;
+    }
+
+    if (Object.values(MediaError).includes(stripped as MediaError)) {
+        return stripped;
+    }
+
+    if (stripped === 'ErrorDefault' || stripped === 'ErrorPlayerNotFound') {
+        return stripped;
+    }
+
+    if (stripped === 'HlsNotSupported') {
+        return stripped;
+    }
+
+    return stripped;
+}
+
+export function resolvePlaybackError(code: string, context: PlaybackErrorContext = {}): PlaybackErrorPresentation {
+    const normalized = normalizeCode(code);
+    const friendlyBase = `PlaybackErrorFriendly.${normalized}`;
+    const legacyMessageKey = normalized === 'NoCompatibleStream'
+        ? 'PlaybackErrorNoCompatibleStream'
+        : normalized === 'PlaceHolder'
+            ? 'PlaybackErrorPlaceHolder'
+            : `PlaybackError.${normalized}`;
+
+    const messageKey = globalize.translate(friendlyBase + '.Message') !== friendlyBase + '.Message'
+        ? friendlyBase + '.Message'
+        : legacyMessageKey;
+
+    const tipTranslation = globalize.translate(friendlyBase + '.Tip');
+    const tipKey = tipTranslation !== friendlyBase + '.Tip' ? friendlyBase + '.Tip' : undefined;
+
+    const actions: PlaybackErrorAction[] = ['close'];
+
+    if (context.item) {
+        actions.unshift('retry');
+    }
+
+    if (context.item && context.directPlayEnabled !== false && TRANSCODE_COMPAT_CODES.has(normalized)) {
+        actions.unshift('retryTranscode');
+    }
+
+    if (normalized === 'LiveStreamFenced' && context.item) {
+        return {
+            titleKey: 'HeaderPlaybackCouldntPlay',
+            messageKey,
+            tipKey,
+            actions: ['retry', 'close']
+        };
+    }
+
+    return {
+        titleKey: 'HeaderPlaybackCouldntPlay',
+        messageKey,
+        tipKey,
+        actions
+    };
+}
+
+export async function showPlaybackError(
+    code: string,
+    context: PlaybackErrorContext = {}
+): Promise<PlaybackErrorAction> {
+    const presentation = resolvePlaybackError(code, context);
+    const title = globalize.translate(presentation.titleKey);
+    const message = globalize.translate(presentation.messageKey);
+    const tip = presentation.tipKey ? globalize.translate(presentation.tipKey) : '';
+    const text = tip ? `${message}\n\n${tip}` : message;
+
+    const buttons = presentation.actions.map((action) => {
+        switch (action) {
+            case 'retry':
+                return {
+                    name: globalize.translate('ButtonTryAgain'),
+                    id: 'retry',
+                    type: 'submit'
+                };
+            case 'retryTranscode':
+                return {
+                    name: globalize.translate('ButtonTryWithTranscoding'),
+                    id: 'retryTranscode',
+                    type: 'submit'
+                };
+            default:
+                return {
+                    name: globalize.translate('ButtonGotIt'),
+                    id: 'close',
+                    type: 'cancel'
+                };
+        }
+    });
+
+    await appRouter.ready();
+
+    const result = await dialog.show({
+        title,
+        text,
+        buttons
+    });
+
+    if (result === 'retry' || result === 'retryTranscode' || result === 'close') {
+        return result;
+    }
+
+    return 'close';
+}
+
+export async function parsePlaybackErrorFromResponse(response: Response): Promise<string | null> {
+    const headerCode = response.headers?.get('X-Playback-Error-Code')
+        || response.headers?.get('x-playback-error-code');
+
+    if (headerCode) {
+        return headerCode;
+    }
+
+    try {
+        const contentType = response.headers?.get('content-type') || '';
+        if (contentType.includes('application/json')) {
+            const body = await response.clone().json();
+            if (body?.ErrorCode) {
+                return body.ErrorCode;
+            }
+            if (body?.errorCode) {
+                return body.errorCode;
+            }
+        }
+    } catch (err) {
+        console.debug('[playbackError] failed to parse playback error response', err);
+    }
+
+    return null;
+}
+
+export function getPlaybackErrorCodeFromHlsResponse(response: { headers?: Record<string, string> | Headers } | undefined): string | null {
+    if (!response?.headers) {
+        return null;
+    }
+
+    const headers = response.headers;
+
+    if (typeof (headers as Headers).get === 'function') {
+        return (headers as Headers).get('x-playback-error-code')
+            || (headers as Headers).get('X-Playback-Error-Code');
+    }
+
+    const record = headers as Record<string, string>;
+    return record['x-playback-error-code'] || record['X-Playback-Error-Code'] || null;
+}
