+using System;
+using System.Collections.Generic;
+using System.IO;
+using System.Reflection;
+using System.Threading;
+using System.Threading.Tasks;
+using Jellyfin.Api.Controllers;
+using MediaBrowser.Common.Configuration;
+using MediaBrowser.Common.Extensions;
+using MediaBrowser.Controller.Library;
+using MediaBrowser.Controller.MediaEncoding;
+using MediaBrowser.Controller.Streaming;
+using MediaBrowser.Model.Configuration;
+using MediaBrowser.Model.Dlna;
+using MediaBrowser.Model.Dto;
+using MediaBrowser.Model.IO;
+using Microsoft.AspNetCore.Http;
+using Microsoft.AspNetCore.Http.Features;
+using Microsoft.AspNetCore.Mvc;
+using Microsoft.Extensions.Logging.Abstractions;
+using Moq;
+using Xunit;
+
+namespace Jellyfin.Api.Tests.Controllers;
+
+public sealed class HlsSegmentReadinessTests : IDisposable
+{
+    private readonly string _directory = Path.Combine(Path.GetTempPath(), Guid.NewGuid().ToString("N"));
+    private readonly Mock<ITranscodeManager> _manager = new();
+    private readonly DynamicHlsController _controller;
+    private readonly StreamState _state;
+
+    public HlsSegmentReadinessTests()
+    {
+        Directory.CreateDirectory(_directory);
+        _manager.Setup(m => m.OnTranscodeEndRequest(It.IsAny<TranscodingJob>()))
+            .Callback<TranscodingJob>(job => job.DecrementActiveRequestCount());
+        _controller = new DynamicHlsController(
+            null!,
+            null!,
+            null!,
+            null!,
+            null!,
+            null!,
+            _manager.Object,
+            NullLogger<DynamicHlsController>.Instance,
+            null!,
+            null!,
+            null!,
+            null!,
+            null!)
+        {
+            ControllerContext = new ControllerContext { HttpContext = new DefaultHttpContext() }
+        };
+        _state = new StreamState(Mock.Of<IMediaSourceManager>(), TranscodingJobType.Hls, _manager.Object)
+        {
+            Request = new VideoRequestDto { SegmentContainer = "mp4" },
+            MediaSource = new MediaSourceInfo(),
+            EffectiveEncodingOptions = new EncodingOptions()
+        };
+    }
+
+    [Fact]
+    public async Task MissingSegment_WithLaterOutput_FailsInsteadOfWaitingForAnImpossibleFile()
+    {
+        using var job = new TranscodingJob(NullLogger<TranscodingJob>.Instance) { ActiveRequestCount = 1 };
+        await File.WriteAllTextAsync(Path.Combine(_directory, "stream831.mp4"), "later segment", TestContext.Current.CancellationToken);
+        using var cancellation = new CancellationTokenSource(TimeSpan.FromSeconds(2));
+
+        var error = await Assert.ThrowsAsync<PlaybackFailedException>(() => GetSegment(job, cancellation.Token));
+
+        Assert.Equal(PlaybackErrorCode.StreamUnavailable, error.ErrorCode);
+        Assert.Equal(0, job.ActiveRequestCount);
+    }
+
+    [Fact]
+    public async Task CancelledSegmentWait_ReleasesTheActiveRequest()
+    {
+        using var job = new TranscodingJob(NullLogger<TranscodingJob>.Instance) { ActiveRequestCount = 1 };
+        using var cancellation = new CancellationTokenSource();
+        var waiting = GetSegment(job, cancellation.Token);
+
+        await cancellation.CancelAsync();
+        await Assert.ThrowsAnyAsync<OperationCanceledException>(() => waiting);
+
+        Assert.Equal(0, job.ActiveRequestCount);
+    }
+
+    [Fact]
+    public async Task AbortedSegmentResponse_ReleasesOnceWithoutRecordingADownload()
+    {
+        using var job = new TranscodingJob(NullLogger<TranscodingJob>.Instance) { ActiveRequestCount = 1 };
+        using var aborted = new CancellationTokenSource();
+        _controller.HttpContext.RequestAborted = aborted.Token;
+        var response = new CompletingResponseFeature();
+        _controller.HttpContext.Features.Set<IHttpResponseFeature>(response);
+        await File.WriteAllTextAsync(Path.Combine(_directory, "stream830.mp4"), "segment", TestContext.Current.CancellationToken);
+        await File.WriteAllTextAsync(Path.Combine(_directory, "stream831.mp4"), "next", TestContext.Current.CancellationToken);
+
+        var result = await GetSegment(job, CancellationToken.None);
+        Assert.IsAssignableFrom<FileResult>(result);
+        await aborted.CancelAsync();
+        Assert.Equal(0, job.ActiveRequestCount);
+        await response.Complete();
+
+        Assert.Equal(0, job.ActiveRequestCount);
+        Assert.Null(job.DownloadPositionTicks);
+    }
+
+    [Theory]
+    [InlineData(200, true)]
+    [InlineData(404, false)]
+    public async Task CompletedSegmentResponse_RecordsOnlySuccessfulDownloadsAndReleasesOnce(int statusCode, bool downloaded)
+    {
+        using var job = new TranscodingJob(NullLogger<TranscodingJob>.Instance) { ActiveRequestCount = 1 };
+        using var aborted = new CancellationTokenSource();
+        _controller.HttpContext.RequestAborted = aborted.Token;
+        _state.Request.CurrentRuntimeTicks = TimeSpan.FromSeconds(10).Ticks;
+        _state.Request.ActualSegmentLengthTicks = TimeSpan.FromSeconds(10).Ticks;
+        var response = new CompletingResponseFeature();
+        _controller.HttpContext.Features.Set<IHttpResponseFeature>(response);
+        _controller.Response.StatusCode = statusCode;
+        await File.WriteAllTextAsync(Path.Combine(_directory, "stream830.mp4"), "segment", TestContext.Current.CancellationToken);
+        await File.WriteAllTextAsync(Path.Combine(_directory, "stream831.mp4"), "next", TestContext.Current.CancellationToken);
+
+        await GetSegment(job, CancellationToken.None);
+        await response.Complete();
+        await aborted.CancelAsync();
+
+        Assert.Equal(0, job.ActiveRequestCount);
+        Assert.Equal(downloaded ? TimeSpan.FromSeconds(20).Ticks : (long?)null, job.DownloadPositionTicks);
+    }
+
+    [Fact]
+    public async Task StalledSegmentWait_TimesOutAndReleasesTheActiveRequest()
+    {
+        using var job = new TranscodingJob(NullLogger<TranscodingJob>.Instance) { ActiveRequestCount = 1 };
+        using var cancellation = new CancellationTokenSource(TimeSpan.FromSeconds(35));
+
+        var error = await Assert.ThrowsAsync<PlaybackFailedException>(() => GetSegment(job, cancellation.Token));
+
+        Assert.Equal(PlaybackErrorCode.StreamUnavailable, error.ErrorCode);
+        Assert.Equal(0, job.ActiveRequestCount);
+    }
+
+    [Fact]
+    public async Task InitSegment_IsReadyWhenFirstMediaSegmentExists()
+    {
+        using var job = new TranscodingJob(NullLogger<TranscodingJob>.Instance) { ActiveRequestCount = 1 };
+        using var cleaner = new TranscodingSegmentCleaner(
+            job,
+            NullLogger<TranscodingSegmentCleaner>.Instance,
+            Mock.Of<IConfigurationManager>(),
+            Mock.Of<IFileSystem>(),
+            Mock.Of<IMediaEncoder>(),
+            6);
+        job.TranscodingSegmentCleaner = cleaner;
+        job.EffectiveEncodingOptions = new EncodingOptions { EnableSegmentDeletion = true };
+        var response = new CompletingResponseFeature();
+        _controller.HttpContext.Features.Set<IHttpResponseFeature>(response);
+        await File.WriteAllTextAsync(Path.Combine(_directory, "stream-1.mp4"), "initialization", TestContext.Current.CancellationToken);
+        await File.WriteAllTextAsync(Path.Combine(_directory, "stream0.mp4"), "first media segment", TestContext.Current.CancellationToken);
+        using var cancellation = new CancellationTokenSource(TimeSpan.FromSeconds(2));
+
+        var result = await GetSegment(job, cancellation.Token, -1);
+        await response.Complete();
+
+        Assert.IsAssignableFrom<FileResult>(result);
+        Assert.Equal(0, job.ActiveRequestCount);
+        Assert.Null(job.GetHighestServedSegmentIndexEndingAtOrBefore(long.MaxValue));
+    }
+
+    public void Dispose()
+    {
+        _state.Dispose();
+        Directory.Delete(_directory, true);
+    }
+
+    private Task<ActionResult> GetSegment(TranscodingJob job, CancellationToken cancellationToken, int segmentIndex = 830)
+    {
+        var method = typeof(DynamicHlsController).GetMethod(
+            "GetSegmentResult",
+            BindingFlags.Instance | BindingFlags.NonPublic,
+            new[] { typeof(StreamState), typeof(string), typeof(string), typeof(string), typeof(int), typeof(TranscodingJob), typeof(CancellationToken) })!;
+        return (Task<ActionResult>)method.Invoke(_controller, new object[]
+        {
+            _state, Path.Combine(_directory, "stream.m3u8"), Path.Combine(_directory, FormattableString.Invariant($"stream{segmentIndex}.mp4")), ".mp4", segmentIndex, job, cancellationToken
+        })!;
+    }
+
+    private sealed class CompletingResponseFeature : HttpResponseFeature
+    {
+        private readonly List<(Func<object, Task> Callback, object State)> _completed = new();
+
+        public override void OnCompleted(Func<object, Task> callback, object state) => _completed.Add((callback, state));
+
+        public async Task Complete()
+        {
+            foreach (var (callback, state) in _completed)
+            {
+                await callback(state);
+            }
+        }
+    }
+}
