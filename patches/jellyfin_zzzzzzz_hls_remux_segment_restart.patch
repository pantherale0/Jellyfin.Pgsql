+using MediaBrowser.Controller.Configuration;
+using MediaBrowser.Controller.Library;
+using MediaBrowser.Controller.MediaEncoding;
+using MediaBrowser.Controller.Session;
+using MediaBrowser.Controller.Streaming;
+using MediaBrowser.MediaEncoding.Transcoding;
+using MediaBrowser.Model.Configuration;
+using MediaBrowser.Model.Dto;
+using MediaBrowser.Model.IO;
+using Microsoft.Extensions.Logging.Abstractions;
+using Moq;
+using Xunit;
+
+namespace Jellyfin.MediaEncoding.Tests.Transcoding;
+
+public sealed class TranscodingLifecycleTests : IDisposable
+{
+    private readonly string _directory = Path.Combine(Path.GetTempPath(), Guid.NewGuid().ToString("N"));
+    private readonly Mock<IFileSystem> _fileSystem = new();
+    private readonly Mock<IServerConfigurationManager> _config = new();
+    private readonly Mock<IMediaEncoder> _encoder = new();
+    private readonly TranscodeManager _manager;
+
+    public TranscodingLifecycleTests()
+    {
+        Directory.CreateDirectory(_directory);
+        var paths = new Mock<IApplicationPaths>();
+        var serverPaths = new Mock<IServerApplicationPaths>();
+        serverPaths.SetupGet(p => p.LogDirectoryPath).Returns(_directory);
+        _config.SetupGet(c => c.ApplicationPaths).Returns(serverPaths.Object);
+        _config.SetupGet(c => c.CommonApplicationPaths).Returns(paths.Object);
+        _config.Setup(c => c.GetConfiguration("encoding")).Returns(new EncodingOptions { TranscodingTempPath = _directory });
+        _fileSystem.Setup(f => f.GetFilePaths(It.IsAny<string>(), It.IsAny<bool>()))
+            .Returns((string path, bool recursive) => Directory.GetFiles(path));
+        _fileSystem.Setup(f => f.DeleteFile(It.IsAny<string>())).Callback<string>(File.Delete);
+        _manager = new TranscodeManager(
+            NullLoggerFactory.Instance,
+            _fileSystem.Object,
+            paths.Object,
+            _config.Object,
+            Mock.Of<IUserManager>(),
+            Mock.Of<ISessionManager>(),
+            null!,
+            _encoder.Object,
+            Mock.Of<IMediaSourceManager>(),
+            Mock.Of<IAttachmentExtractor>(),
+            Mock.Of<ITranscodingPipelineProbe>());
+    }
+
+    [Fact]
+    public async Task StopCleanup_PreservesReplacementOutput()
+    {
+        using var oldJob = RegisterJob();
+        var output = Path.ChangeExtension(oldJob.Path!, "0.mp4");
+        await File.WriteAllTextAsync(output, "old", TestContext.Current.CancellationToken);
+
+        var stopping = _manager.KillTranscodingJobAndCleanupAsync(oldJob, true);
+        Assert.Null(_manager.GetTranscodingJob(oldJob.Path!, TranscodingJobType.Hls));
+        using var replacement = RegisterJob();
+        await File.WriteAllTextAsync(output, "replacement", TestContext.Current.CancellationToken);
+        await stopping;
+
+        Assert.True(File.Exists(output));
+        Assert.Equal("replacement", await File.ReadAllTextAsync(output, TestContext.Current.CancellationToken));
+        Assert.Same(replacement, _manager.GetTranscodingJob(oldJob.Path!, TranscodingJobType.Hls));
+    }
+
+    [Fact]
+    public async Task DuplicateStop_DoesNotDeleteNewGeneration()
+    {
+        using var oldJob = RegisterJob();
+        await _manager.KillTranscodingJobAndCleanupAsync(oldJob, false);
+        using var replacement = RegisterJob();
+        var output = Path.ChangeExtension(oldJob.Path!, "0.mp4");
+        await File.WriteAllTextAsync(output, "replacement", TestContext.Current.CancellationToken);
+
+        await _manager.KillTranscodingJobAndCleanupAsync(oldJob, true);
+
+        Assert.True(File.Exists(output));
+        Assert.Same(replacement, _manager.GetTranscodingJob(oldJob.Path!, TranscodingJobType.Hls));
+    }
+
+    [Fact]
+    public async Task StopCleanup_DeletesOnlyItsOwnArtifacts()
+    {
+        using var job = RegisterJob();
+        var output = Path.ChangeExtension(job.Path!, "0.mp4");
+        var otherOutput = Path.Combine(_directory, "other0.mp4");
+        await File.WriteAllTextAsync(output, "old", TestContext.Current.CancellationToken);
+        await File.WriteAllTextAsync(otherOutput, "other", TestContext.Current.CancellationToken);
+
+        await _manager.KillTranscodingJobAndCleanupAsync(job, true);
+
+        Assert.False(File.Exists(output));
+        Assert.True(File.Exists(otherOutput));
+    }
+
+    [Fact]
+    public async Task Startup_WaitsUntilArtifactDeletionFinishes()
+    {
+        using var oldJob = RegisterJob();
+        var output = Path.Combine(_directory, "stream0.mp4");
+        await File.WriteAllTextAsync(output, "old", TestContext.Current.CancellationToken);
+        var deleting = new TaskCompletionSource(TaskCreationOptions.RunContinuationsAsynchronously);
+        using var releaseDeletion = new ManualResetEventSlim();
+        _fileSystem.Setup(f => f.DeleteFile(output)).Callback(() =>
+        {
+            deleting.SetResult();
+            releaseDeletion.Wait(TestContext.Current.CancellationToken);
+            File.Delete(output);
+        });
+        _encoder.SetupGet(e => e.EncoderPath).Returns(Path.Combine(_directory, "missing-ffmpeg"));
+        using var cancellation = new CancellationTokenSource();
+        using var state = new StreamState(Mock.Of<IMediaSourceManager>(), TranscodingJobType.Hls, _manager)
+        {
+            Request = new StreamingRequestDto { PlaySessionId = "session", DeviceId = "device" },
+            MediaSource = new MediaSourceInfo(),
+            EffectiveEncodingOptions = new EncodingOptions()
+        };
+        var stopping = _manager.KillTranscodingJobAndCleanupAsync(oldJob, true);
+        await deleting.Task.WaitAsync(TimeSpan.FromSeconds(5), TestContext.Current.CancellationToken);
+        var starting = _manager.StartFfMpegAttempt(state, oldJob.Path!, string.Empty, Guid.Empty, TranscodingJobType.Hls, cancellation);
+        try
+        {
+            Assert.False(starting.IsCompleted);
+            Assert.Null(_manager.GetTranscodingJob(oldJob.Path!, TranscodingJobType.Hls));
+        }
+        finally
+        {
+            releaseDeletion.Set();
+            await stopping;
+        }
+
+        await Assert.ThrowsAsync<Win32Exception>(() => starting);
+        Assert.Null(_manager.GetTranscodingJob(oldJob.Path!, TranscodingJobType.Hls));
+    }
+
+    [Fact]
+    public async Task SegmentCleaner_StopPreventsQueuedDeletion()
+    {
+        using var job = RegisterJob();
+        job.HasExited = false;
+        using var cleaner = new TranscodingSegmentCleaner(
+            job,
+            NullLogger<TranscodingSegmentCleaner>.Instance,
+            _config.Object,
+            _fileSystem.Object,
+            Mock.Of<IMediaEncoder>(),
+            6);
+        job.TranscodingSegmentCleaner = cleaner;
+        job.EffectiveEncodingOptions = new EncodingOptions { EnableSegmentDeletion = true };
+        job.ReportSegmentDownloaded(1, TimeSpan.FromSeconds(30).Ticks);
+        var output = Path.Combine(_directory, "stream1.mp4");
+        await File.WriteAllTextAsync(output, "replacement", TestContext.Current.CancellationToken);
+        var method = typeof(TranscodingSegmentCleaner).GetMethod("DeleteSegmentFiles", BindingFlags.Instance | BindingFlags.NonPublic)!;
+        var pending = (Task)method.Invoke(cleaner, new object[] { job, 0L, 1L, 100 })!;
+
+        cleaner.Stop();
+        await pending;
+
+        Assert.True(File.Exists(output));
+    }
+
+    [Fact]
+    public async Task SegmentCleaner_VariableDurations_PreservesSegmentsInsideRetentionWindow()
+    {
+        using var job = RegisterJob();
+        job.HasExited = false;
+        job.DownloadPositionTicks = TimeSpan.FromSeconds(60).Ticks;
+        _config.Setup(c => c.GetConfiguration("encoding")).Returns(new EncodingOptions
+        {
+            EnableSegmentDeletion = true,
+            SegmentKeepSeconds = 20
+        });
+        using var cleaner = new TranscodingSegmentCleaner(
+            job,
+            NullLogger<TranscodingSegmentCleaner>.Instance,
+            _config.Object,
+            _fileSystem.Object,
+            Mock.Of<IMediaEncoder>(),
+            6);
+        job.TranscodingSegmentCleaner = cleaner;
+        job.EffectiveEncodingOptions = new EncodingOptions { EnableSegmentDeletion = true };
+        job.ReportSegmentDownloaded(3, TimeSpan.FromSeconds(40).Ticks);
+        job.ReportSegmentDownloaded(5, TimeSpan.FromSeconds(60).Ticks);
+        var keep = Path.Combine(_directory, "stream5.mp4");
+        var expired = Path.Combine(_directory, "stream3.mp4");
+        await File.WriteAllTextAsync(expired, "segment ends at retention boundary", TestContext.Current.CancellationToken);
+        await File.WriteAllTextAsync(keep, "segment covers 50 to 60 seconds", TestContext.Current.CancellationToken);
+        var method = typeof(TranscodingSegmentCleaner).GetMethod("TimerCallback", BindingFlags.Instance | BindingFlags.NonPublic)!;
+        method.Invoke(cleaner, new object?[] { null });
+        await Task.Delay(1700, TestContext.Current.CancellationToken);
+
+        Assert.True(File.Exists(keep));
+        Assert.False(File.Exists(expired));
+    }
+
+    public void Dispose()
+    {
+        _manager.Dispose();
+        Directory.Delete(_directory, true);
+    }
+
+    private TranscodingJob RegisterJob()
+    {
+        // Seed an exited encoder generation without requiring an external FFmpeg process.
+        var job = new TranscodingJob(NullLogger<TranscodingJob>.Instance)
+        {
+            Path = Path.Combine(_directory, "stream.m3u8"),
+            PlaySessionId = "session",
+            Type = TranscodingJobType.Hls,
+            HasExited = true
+        };
+        var jobs = (List<TranscodingJob>)typeof(TranscodeManager)
+            .GetField("_activeTranscodingJobs", BindingFlags.Instance | BindingFlags.NonPublic)!.GetValue(_manager)!;
+        lock (jobs)
+        {
+            jobs.Add(job);
+        }
+
+        return job;
+    }
+}
