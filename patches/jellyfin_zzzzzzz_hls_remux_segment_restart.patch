+        if (markerIndex < 0)
+        {
+            return null;
+        }
+
+        var value = commandLineArguments.AsSpan(markerIndex + Marker.Length);
+        var separatorIndex = value.IndexOf(' ');
+        if (separatorIndex >= 0)
+        {
+            value = value[..separatorIndex];
+        }
+
+        return int.TryParse(value, NumberStyles.None, CultureInfo.InvariantCulture, out var startSegmentIndex)
+            ? startSegmentIndex
+            : null;
+    }
