+    private static FileSystemMetadata? GetFirstTranscodingFile(string playlist, string segmentExtension, IFileSystem fileSystem)
+    {
+        var folder = Path.GetDirectoryName(playlist) ?? throw new ArgumentException("Path can't be a root directory.", nameof(playlist));
+
+        var filePrefix = Path.GetFileNameWithoutExtension(playlist);
+
+        try
+        {
+            // Exclude fMP4 init segments (index -1) so backward-seek detection uses real media segments.
+            return fileSystem.GetFiles(folder, new[] { segmentExtension }, true, false)
+                .Where(i => Path.GetFileNameWithoutExtension(i.Name).StartsWith(filePrefix, StringComparison.OrdinalIgnoreCase))
+                .Where(i => (TryParseSegmentIndex(playlist, i.Name) ?? -1) >= 0)
+                .MinBy(i => TryParseSegmentIndex(playlist, i.Name) ?? int.MaxValue);
+        }
+        catch (IOException)
+        {
+            return null;
+        }
+    }
