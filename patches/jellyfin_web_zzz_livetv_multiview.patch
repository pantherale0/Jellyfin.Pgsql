+import toast from '../toast/toast';
+import { ServerConnections } from 'lib/jellyfin-apiclient';
+import { playbackManager } from '../playback/playbackmanager';
+import Hls from 'hls.js';
+import layoutManager from '../layoutManager';
+import { isTvClient } from 'scripts/isTvClient';
+import showChannelPicker, { escapeHtml } from './channelPickerModal';
+import './multiview.scss';
+
+/** Multiview is desktop/mobile only — never on webOS / TV clients. */
+export function isMultiviewSupported() {
+    return !isTvClient() && !layoutManager.tv;
+}
+
+class MultiviewManager {
+    constructor() {
+        this.active = false;
+        this.layout = 'skytv'; // 'skytv' | 'quad' | 'dual'
+        this.slots = [null, null, null, null]; // Max 4 slots
+        this.hlsInstances = [null, null, null, null];
+        this.slotGenerations = [0, 0, 0, 0];
+        this.activeAudioIndex = 0;
+        this.container = null;
+        this.gridElement = null;
+    }
+
+    toggle(options = {}) {
+        if (this.active) {
+            this.close();
+        } else {
+            this.open(options);
+        }
+    }
+
+    open(options = {}) {
+        if (!isMultiviewSupported()) {
+            return;
+        }
+        if (this.active) return;
+        this.active = true;
+        this.layout = 'skytv';
+
+        this.renderContainer();
+
+        const currentItem = options.currentItem;
+        const existingMediaSource = options.existingMediaSource;
+
+        if (currentItem) {
+            this.setSlotChannel(0, currentItem, existingMediaSource);
+        }
+    }
+
+    close() {
+        if (!this.active) return;
+        this.active = false;
+
+        // Clean up all play sessions and video elements
+        for (let i = 0; i < 4; i++) {
+            this.clearSlot(i);
+        }
+
+        // Clean up any background single player sessions
+        try {
+            playbackManager.stop();
+        } catch (e) {
+            // Ignore if no player running
+        }
+
+        if (this.container && this.container.parentNode) {
+            this.container.parentNode.removeChild(this.container);
+        }
+        this.container = null;
+        this.gridElement = null;
+    }
+
+    renderContainer() {
+        this.container = document.createElement('div');
+        this.container.className = 'multiviewOverlayContainer';
+
+        this.container.innerHTML = `
+            <div class="multiviewHeader">
+                <div class="multiviewTitle">
+                    <span class="material-icons" style="color: var(--theme-primary-color, #00a4dc);">grid_view</span>
+                    <span>Live TV Multiview</span>
+                    <span class="multiviewBadge">Sky TV Mode</span>
+                </div>
+                <div class="multiviewControls">
+                    <button type="button" class="btnLayoutSkyTv ${this.layout === 'skytv' ? 'activeMode' : ''}" title="Sky TV Mode (1 Main + 3 Side)">
+                        <span class="material-icons">view_quilt</span> Sky TV
+                    </button>
+                    <button type="button" class="btnLayoutQuad ${this.layout === 'quad' ? 'activeMode' : ''}" title="Quad Grid (2x2)">
+                        <span class="material-icons">grid_on</span> Quad
+                    </button>
+                    <button type="button" class="btnLayoutDual ${this.layout === 'dual' ? 'activeMode' : ''}" title="Dual View (Side-by-Side)">
+                        <span class="material-icons">view_column</span> Dual
+                    </button>
+                    <button type="button" class="btnCloseMultiview" title="Close Multiview" style="background: rgba(220, 53, 69, 0.2); color: #ff6b6b; border-color: rgba(220, 53, 69, 0.4);">
+                        <span class="material-icons">close</span> Exit
+                    </button>
+                </div>
+            </div>
+            <div class="multiviewGrid mode-${this.layout}">
+                ${[0, 1, 2, 3].map(i => this.renderSlotHtml(i)).join('')}
+            </div>
+        `;
+
+        document.body.appendChild(this.container);
+        this.gridElement = this.container.querySelector('.multiviewGrid');
+
+        // Bind layout mode buttons
+        this.container.querySelector('.btnLayoutSkyTv').addEventListener('click', () => this.setLayout('skytv'));
+        this.container.querySelector('.btnLayoutQuad').addEventListener('click', () => this.setLayout('quad'));
+        this.container.querySelector('.btnLayoutDual').addEventListener('click', () => this.setLayout('dual'));
+        this.container.querySelector('.btnCloseMultiview').addEventListener('click', () => this.close());
+
+        // Bind slot action events
+        this.bindSlotEvents();
+    }
+
+    renderSlotHtml(index) {
+        return `
+            <div class="multiviewSlot ${index === this.activeAudioIndex ? 'activeAudio' : ''}" data-slot="${index}">
+                <button type="button" class="emptySlotBtn" data-slot="${index}">
+                    <span class="material-icons">add_circle_outline</span>
+                    <span>Select Channel (${index === 0 ? 'Main' : `Slot ${index + 1}`})</span>
+                </button>
+            </div>
+        `;
+    }
+
+    setLayout(mode) {
+        this.layout = mode;
+        if (!this.gridElement) return;
+
+        this.gridElement.className = `multiviewGrid mode-${mode}`;
+
+        const badge = this.container.querySelector('.multiviewBadge');
+        if (badge) {
+            badge.textContent = mode === 'skytv' ? 'Sky TV Mode' : (mode === 'quad' ? 'Quad Grid' : 'Dual View');
+        }
+
+        this.container.querySelectorAll('.multiviewControls button').forEach(btn => btn.classList.remove('activeMode'));
+        if (mode === 'skytv') this.container.querySelector('.btnLayoutSkyTv')?.classList.add('activeMode');
+        if (mode === 'quad') this.container.querySelector('.btnLayoutQuad')?.classList.add('activeMode');
+        if (mode === 'dual') this.container.querySelector('.btnLayoutDual')?.classList.add('activeMode');
+
+        // Dual only shows slots 0–1; release tuners on hidden tiles
+        if (mode === 'dual') {
+            this.clearSlot(2);
+            this.clearSlot(3);
+        }
+    }
+
+    bindSlotEvents() {
+        if (!this.gridElement) return;
+
+        this.gridElement.addEventListener('click', async (e) => {
+            const slotBtn = e.target.closest('.emptySlotBtn');
+            if (slotBtn) {
+                const index = parseInt(slotBtn.getAttribute('data-slot'), 10);
+                this.promptAddChannel(index);
+                return;
+            }
+
+            const actionBtn = e.target.closest('button[data-action]');
+            if (actionBtn) {
+                const action = actionBtn.getAttribute('data-action');
+                const index = parseInt(actionBtn.getAttribute('data-slot'), 10);
+
+                if (action === 'audio') {
+                    this.setAudioFocus(index);
+                } else if (action === 'swap') {
+                    this.swapSlots(index, 0);
+                } else if (action === 'replace') {
+                    this.promptAddChannel(index);
+                } else if (action === 'close') {
+                    this.clearSlot(index);
+                }
+            }
+        });
+    }
+
+    async promptAddChannel(slotIndex) {
+        const activeIds = this.slots.filter(s => s && s.item).map(s => s.item.Id);
+        const channel = await showChannelPicker(activeIds);
+        if (channel) {
+            this.setSlotChannel(slotIndex, channel);
+        }
+    }
+
+    bumpSlotGeneration(slotIndex) {
+        this.slotGenerations[slotIndex] = (this.slotGenerations[slotIndex] || 0) + 1;
+        return this.slotGenerations[slotIndex];
+    }
+
+    isSlotGenerationCurrent(slotIndex, generation) {
+        return this.active && this.slotGenerations[slotIndex] === generation;
+    }
+
+    buildAdoptedStreamUrl(apiClient, targetItem, existingMediaSource, playSessionId) {
+        if (!existingMediaSource || !(existingMediaSource.LiveStreamId || existingMediaSource.Path)) {
+            return { url: '', liveStreamId: null };
+        }
+
+        const liveStreamId = existingMediaSource.LiveStreamId || null;
+        if (existingMediaSource.Path && (existingMediaSource.Path.startsWith('http://') || existingMediaSource.Path.startsWith('https://'))) {
+            return { url: existingMediaSource.Path, liveStreamId };
+        }
+
+        if (liveStreamId) {
+            return {
+                url: apiClient.getUrl(`/Videos/${targetItem.Id}/stream.m3u8`, {
+                    LiveStreamId: liveStreamId,
+                    PlaySessionId: playSessionId,
+                    static: true
+                }),
+                liveStreamId
+            };
+        }
+
+        return { url: '', liveStreamId: null };
+    }
+
+    showSlotBuffering(slotElem, label) {
+        if (!slotElem) return null;
+
+        let buffering = slotElem.querySelector('.slotBuffering');
+        if (!buffering) {
+            buffering = document.createElement('div');
+            buffering.className = 'slotBuffering';
+            buffering.setAttribute('aria-live', 'polite');
+            buffering.innerHTML = `
+                <div class="slotBufferingSpinner" aria-hidden="true"></div>
+                <div class="slotBufferingLabel"></div>
+            `;
+            slotElem.appendChild(buffering);
+        }
+
+        const labelEl = buffering.querySelector('.slotBufferingLabel');
+        if (labelEl) {
+            labelEl.textContent = label || 'Loading…';
+        }
+
+        buffering.classList.remove('hide');
+        return buffering;
+    }
+
+    hideSlotBuffering(slotElem) {
+        const buffering = slotElem?.querySelector('.slotBuffering');
+        if (buffering) {
+            buffering.classList.add('hide');
+        }
+    }
+
+    bindVideoBufferingIndicator(video, slotElem, generation, slotIndex, channelLabel) {
+        const show = (label) => {
+            if (!this.isSlotGenerationCurrent(slotIndex, generation)) return;
+            this.showSlotBuffering(slotElem, label || 'Buffering…');
+        };
+        const hide = () => {
+            if (!this.isSlotGenerationCurrent(slotIndex, generation)) return;
+            this.hideSlotBuffering(slotElem);
+        };
+
+        video.addEventListener('loadstart', () => show(channelLabel || 'Loading…'));
+        video.addEventListener('waiting', () => show('Buffering…'));
+        video.addEventListener('stalled', () => show('Buffering…'));
+        video.addEventListener('playing', hide);
+        video.addEventListener('canplay', hide);
+    }
+
+    async setSlotChannel(slotIndex, item, existingMediaSource = null) {
+        const generation = this.bumpSlotGeneration(slotIndex);
+        this.clearSlot(slotIndex, { bumpGeneration: false, closeLiveStream: true });
+
+        const slotElem = this.gridElement?.querySelector(`.multiviewSlot[data-slot="${slotIndex}"]`);
+        if (!slotElem) return;
+
+        const channelLabel = item?.Name || item?.ChannelName || 'Loading…';
+        // Immediate feedback while PlaybackInfo / HLS starts (can take several seconds)
+        slotElem.innerHTML = '';
+        this.showSlotBuffering(slotElem, channelLabel);
+
+        try {
+            const apiClient = item?.ServerId ? ServerConnections.getApiClient(item.ServerId) : ServerConnections.currentApiClient();
+            if (!apiClient) {
+                toast('Cannot connect to server for Live TV Multiview.');
+                this.clearSlot(slotIndex);
+                return;
+            }
+
+            const targetItem = {
+                ...item,
+                Id: item.ChannelId || item.Id,
+                ServerId: item.ServerId || apiClient.serverId(),
+                MediaType: item.MediaType || 'Video'
+            };
+
+            const playSessionId = 'mv_' + Date.now() + '_' + slotIndex;
+            let liveStreamId = null;
+            let finalStreamUrl = '';
+
+            // Prefer adopting an existing running LiveStream (OSD handoff)
+            const adopted = this.buildAdoptedStreamUrl(apiClient, targetItem, existingMediaSource, playSessionId);
+            finalStreamUrl = adopted.url;
+            liveStreamId = adopted.liveStreamId;
+
+            // Fresh open: getPlaybackInfo returns stream info { url, mediaSource, liveStreamId }
+            if (!finalStreamUrl) {
+                const streamInfo = await playbackManager.getPlaybackInfo(targetItem, { mediaType: 'Video' });
+
+                if (!this.isSlotGenerationCurrent(slotIndex, generation)) {
+                    // Stale async completion — close any LiveStream we just opened
+                    const staleLiveStreamId = streamInfo?.liveStreamId || streamInfo?.mediaSource?.LiveStreamId;
+                    if (staleLiveStreamId) {
+                        this.closeLiveStream(apiClient, staleLiveStreamId);
+                    }
+                    return;
+                }
+
+                finalStreamUrl = streamInfo?.url || '';
+                liveStreamId = streamInfo?.liveStreamId || streamInfo?.mediaSource?.LiveStreamId || null;
+
+                if (!finalStreamUrl) {
+                    toast('Cannot load Live TV channel media source.');
+                    this.clearSlot(slotIndex);
+                    return;
+                }
+            }
+
+            if (!this.isSlotGenerationCurrent(slotIndex, generation)) {
+                if (liveStreamId && !existingMediaSource) {
+                    this.closeLiveStream(apiClient, liveStreamId);
+                }
+                return;
+            }
+
+            const video = document.createElement('video');
+            video.autoplay = true;
+            video.playsInline = true;
+            video.muted = (slotIndex !== this.activeAudioIndex);
+
+            if (Hls.isSupported()) {
+                const hls = new Hls({
+                    enableWorker: true,
+                    lowLatencyMode: true
+                });
+                hls.loadSource(finalStreamUrl);
+                hls.attachMedia(video);
+                this.bindHlsRetryHandler(hls, slotIndex, item, generation);
+                this.hlsInstances[slotIndex] = hls;
+            } else if (video.canPlayType('application/vnd.apple.mpegurl')) {
+                video.src = finalStreamUrl;
+            } else {
+                toast('HLS playback is not supported in this browser.');
+                this.clearSlot(slotIndex);
+                return;
+            }
+
+            if (!this.isSlotGenerationCurrent(slotIndex, generation)) {
+                if (this.hlsInstances[slotIndex]) {
+                    this.hlsInstances[slotIndex].destroy();
+                    this.hlsInstances[slotIndex] = null;
+                }
+                if (liveStreamId && !existingMediaSource) {
+                    this.closeLiveStream(apiClient, liveStreamId);
+                }
+                return;
+            }
+
+            // Keep spinner; rebuild slot with video underneath
+            slotElem.innerHTML = '';
+            slotElem.appendChild(video);
+            this.showSlotBuffering(slotElem, channelLabel);
+            this.bindVideoBufferingIndicator(video, slotElem, generation, slotIndex, channelLabel);
+
+            // Add Audio focus badge if this slot is active audio
+            if (slotIndex === this.activeAudioIndex) {
+                const badge = document.createElement('div');
+                badge.className = 'audioBadge';
+                badge.innerHTML = '<span class="material-icons" style="font-size: 1rem;">volume_up</span> AUDIO FOCUS';
+                slotElem.appendChild(badge);
+            }
+
+            // Overlay controls on hover
+            const title = escapeHtml(item.Name || item.ChannelName || 'Live Channel');
+            const overlay = document.createElement('div');
+            overlay.className = 'slotOverlay';
+            overlay.innerHTML = `
+                <div class="slotOverlayHeader">
+                    <div class="slotTitle">${title}</div>
+                </div>
+                <div class="slotOverlayFooter">
+                    <div class="slotActions">
+                        <button type="button" data-action="audio" data-slot="${slotIndex}" title="Focus Audio">
+                            <span class="material-icons">${slotIndex === this.activeAudioIndex ? 'volume_up' : 'volume_off'}</span>
+                        </button>
+                        ${slotIndex !== 0 ? `
+                        <button type="button" data-action="swap" data-slot="${slotIndex}" title="Swap with Main Screen">
+                            <span class="material-icons">swap_horiz</span>
+                        </button>` : ''}
+                        <button type="button" data-action="replace" data-slot="${slotIndex}" title="Change Channel">
+                            <span class="material-icons">find_replace</span>
+                        </button>
+                        <button type="button" data-action="close" data-slot="${slotIndex}" title="Close Channel">
+                            <span class="material-icons">close</span>
+                        </button>
+                    </div>
+                </div>
+            `;
+            slotElem.appendChild(overlay);
+
+            this.slots[slotIndex] = {
+                item: targetItem,
+                video,
+                playSessionId,
+                liveStreamId,
+                generation
+            };
+        } catch (err) {
+            if (!this.isSlotGenerationCurrent(slotIndex, generation)) return;
+            console.error('[Multiview] Tuner stream error:', err);
+            toast('Live TV stream capacity reached or failed to open.');
+            this.clearSlot(slotIndex);
+        }
+    }
+
+    setAudioFocus(slotIndex) {
+        this.activeAudioIndex = slotIndex;
+
+        for (let i = 0; i < 4; i++) {
+            const slotData = this.slots[i];
+            const slotElem = this.gridElement?.querySelector(`.multiviewSlot[data-slot="${i}"]`);
+
+            if (slotData && slotData.video) {
+                slotData.video.muted = (i !== slotIndex);
+            }
+
+            if (slotElem) {
+                if (i === slotIndex) {
+                    slotElem.classList.add('activeAudio');
+                    if (!slotElem.querySelector('.audioBadge')) {
+                        const badge = document.createElement('div');
+                        badge.className = 'audioBadge';
+                        badge.innerHTML = '<span class="material-icons" style="font-size: 1rem;">volume_up</span> AUDIO FOCUS';
+                        slotElem.appendChild(badge);
+                    }
+                } else {
+                    slotElem.classList.remove('activeAudio');
+                    const badge = slotElem.querySelector('.audioBadge');
+                    if (badge) badge.remove();
+                }
+            }
+        }
+
+        // Refresh volume icons on overlays without tearing down streams
+        this.refreshSlotActionIcons();
+    }
+
+    refreshSlotActionIcons() {
+        if (!this.gridElement) return;
+
+        for (let i = 0; i < 4; i++) {
+            const slotElem = this.gridElement.querySelector(`.multiviewSlot[data-slot="${i}"]`);
+            const audioBtn = slotElem?.querySelector('button[data-action="audio"] .material-icons');
+            if (audioBtn) {
+                audioBtn.textContent = i === this.activeAudioIndex ? 'volume_up' : 'volume_off';
+            }
+        }
+    }
+
+    bindHlsRetryHandler(hls, slotIndex, item, generation) {
+        if (!hls) return;
+
+        let retried = false;
+        hls.on(Hls.Events.ERROR, (event, data) => {
+            if (!data.fatal) return;
+            if (!this.isSlotGenerationCurrent(slotIndex, generation)) return;
+
+            console.error('[Multiview] HLS stream error:', data);
+            if (!retried) {
+                retried = true;
+                console.log('[Multiview] Retrying slot stream with fresh playback info...');
+                try {
+                    hls.destroy();
+                } catch (e) {
+                    // ignore
+                }
+                setTimeout(() => {
+                    if (!this.isSlotGenerationCurrent(slotIndex, generation)) return;
+                    this.setSlotChannel(slotIndex, item, null);
+                }, 500);
+            } else {
+                toast('Live TV stream playback error.');
+                this.clearSlot(slotIndex);
+            }
+        });
+    }
+
+    /**
+     * Swap two slots in-place (DOM + state + HLS refs) without closing LiveStreams.
+     */
+    swapSlots(idxA, idxB) {
+        if (idxA === idxB) return;
+
+        const slotA = this.slots[idxA];
+        const slotB = this.slots[idxB];
+        const hlsA = this.hlsInstances[idxA];
+        const hlsB = this.hlsInstances[idxB];
+
+        const elemA = this.gridElement?.querySelector(`.multiviewSlot[data-slot="${idxA}"]`);
+        const elemB = this.gridElement?.querySelector(`.multiviewSlot[data-slot="${idxB}"]`);
+
+        if (!elemA || !elemB) return;
+
+        // Invalidate prior HLS error closures tied to old slot indices
+        const newGenA = this.bumpSlotGeneration(idxA);
+        const newGenB = this.bumpSlotGeneration(idxB);
+
+        // Swap DOM contents
+        const fragA = document.createDocumentFragment();
+        const fragB = document.createDocumentFragment();
+        while (elemA.firstChild) fragA.appendChild(elemA.firstChild);
+        while (elemB.firstChild) fragB.appendChild(elemB.firstChild);
+        elemA.appendChild(fragB);
+        elemB.appendChild(fragA);
+
+        // Swap state (streams move with DOM; no LiveStream close/reopen)
+        this.slots[idxA] = slotB ? { ...slotB, generation: newGenA } : null;
+        this.slots[idxB] = slotA ? { ...slotA, generation: newGenB } : null;
+        this.hlsInstances[idxA] = hlsB;
+        this.hlsInstances[idxB] = hlsA;
+
+        // Rebind retry handlers for the new slot ownership
+        if (hlsB && slotB?.item) {
+            this.bindHlsRetryHandler(hlsB, idxA, slotB.item, newGenA);
+        }
+        if (hlsA && slotA?.item) {
+            this.bindHlsRetryHandler(hlsA, idxB, slotA.item, newGenB);
+        }
+
+        // Update data-slot attributes on action buttons inside each slot
+        this.retagSlotActions(elemA, idxA);
+        this.retagSlotActions(elemB, idxB);
+
+        // Keep audio focus on main after swap-to-main UX
+        this.setAudioFocus(0);
+    }
+
+    retagSlotActions(slotElem, slotIndex) {
+        if (!slotElem) return;
+
+        slotElem.querySelectorAll('button[data-slot]').forEach((btn) => {
+            btn.setAttribute('data-slot', String(slotIndex));
+        });
+
+        // Swap button only on non-main slots
+        const swapBtn = slotElem.querySelector('button[data-action="swap"]');
+        if (slotIndex === 0) {
+            if (swapBtn) swapBtn.remove();
+        } else if (!swapBtn) {
+            const actions = slotElem.querySelector('.slotActions');
+            const replaceBtn = actions?.querySelector('button[data-action="replace"]');
+            if (actions && replaceBtn) {
+                const btn = document.createElement('button');
+                btn.type = 'button';
+                btn.setAttribute('data-action', 'swap');
+                btn.setAttribute('data-slot', String(slotIndex));
+                btn.title = 'Swap with Main Screen';
+                btn.innerHTML = '<span class="material-icons">swap_horiz</span>';
+                actions.insertBefore(btn, replaceBtn);
+            }
+        }
+    }
+
+    closeLiveStream(apiClient, liveStreamId) {
+        if (!apiClient || !liveStreamId) return;
+        try {
+            apiClient.ajax({
+                type: 'POST',
+                url: apiClient.getUrl('LiveStreams/Close', {
+                    LiveStreamId: liveStreamId
+                })
+            });
+        } catch (e) {
+            console.error('[Multiview] Error closing LiveStream:', e);
+        }
+    }
+
+    /**
+     * @param {number} index
+     * @param {{ bumpGeneration?: boolean, closeLiveStream?: boolean }} [options]
+     */
+    clearSlot(index, options = {}) {
+        const bumpGeneration = options.bumpGeneration !== false;
+        const closeLiveStream = options.closeLiveStream !== false;
+
+        if (bumpGeneration) {
+            this.bumpSlotGeneration(index);
+        }
+
+        if (this.hlsInstances[index]) {
+            try {
+                this.hlsInstances[index].destroy();
+            } catch (e) {
+                // ignore destroy errors
+            }
+            this.hlsInstances[index] = null;
+        }
+
+        const slotData = this.slots[index];
+        if (slotData) {
+            if (slotData.video) {
+                slotData.video.pause();
+                slotData.video.removeAttribute('src');
+                slotData.video.load();
+            }
+
+            if (closeLiveStream && slotData.liveStreamId) {
+                const apiClient = slotData.item?.ServerId
+                    ? ServerConnections.getApiClient(slotData.item.ServerId)
+                    : ServerConnections.currentApiClient();
+                this.closeLiveStream(apiClient, slotData.liveStreamId);
+            }
+
+            this.slots[index] = null;
+        }
+
+        const slotElem = this.gridElement?.querySelector(`.multiviewSlot[data-slot="${index}"]`);
+        if (slotElem) {
+            slotElem.classList.remove('activeAudio');
+            slotElem.innerHTML = `
+                <button type="button" class="emptySlotBtn" data-slot="${index}">
+                    <span class="material-icons">add_circle_outline</span>
+                    <span>Select Channel (${index === 0 ? 'Main' : `Slot ${index + 1}`})</span>
+                </button>
+            `;
+        }
+    }
+}
+
+const multiviewManager = new MultiviewManager();
+export default multiviewManager;
