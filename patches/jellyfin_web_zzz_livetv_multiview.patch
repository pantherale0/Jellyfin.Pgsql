diff --git a/src/components/multiview/channelPickerModal.js b/src/components/multiview/channelPickerModal.js
new file mode 100644
index 0000000000..7856f08b42
--- /dev/null
+++ b/src/components/multiview/channelPickerModal.js
@@ -0,0 +1,74 @@
+import dialogHelper from '../dialogHelper/dialogHelper';
+import ServerConnections from '../../lib/jellyfin-apiclient/serverConnections';
+
+export default function showChannelPicker(activeChannelIds = []) {
+    return new Promise((resolve) => {
+        const apiClient = ServerConnections.getApiClient();
+        const user = ServerConnections.getCurrentUser();
+
+        apiClient.getLiveTvChannels({ userId: user?.Id }).then((result) => {
+            const channels = (result.Items || []).filter(c => !activeChannelIds.includes(c.Id));
+
+            if (channels.length === 0) {
+                resolve(null);
+                return;
+            }
+
+            const dialogOptions = {
+                removeOnClose: true,
+                size: 'small'
+            };
+
+            const dlg = dialogHelper.createDialog(dialogOptions);
+            dlg.classList.add('formDialog');
+
+            let html = `
+                <div class="dialogHeader">
+                    <button is="paper-icon-button-light" class="btnCancel autoSize" tabindex="-1">
+                        <span class="material-icons arrow_back"></span>
+                    </button>
+                    <h2 class="dialogHeaderTitle">Add Channel to Multiview</h2>
+                </div>
+            `;
+            html += `<div class="dialogContent" style="max-height: 60vh; overflow-y: auto; padding: 0 16px 16px;"><div class="paperList">`;
+
+            channels.forEach((channel) => {
+                const channelName = channel.Name || 'Channel';
+                const channelNum = channel.ChannelNumber ? `Ch. ${channel.ChannelNumber} - ` : '';
+                const currentProgram = channel.CurrentProgram?.Name ? `<div style="font-size: 0.85em; opacity: 0.7;">${channel.CurrentProgram.Name}</div>` : '';
+
+                html += `
+                    <button type="button" class="paper-icon-item-button channelPickerItem" data-id="${channel.Id}" style="width: 100%; text-align: left; padding: 14px 16px; display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid rgba(255,255,255,0.08); background: none; color: inherit; cursor: pointer; border-radius: 4px;">
+                        <div>
+                            <div style="font-weight: 600; font-size: 1rem;">${channelNum}${channelName}</div>
+                            ${currentProgram}
+                        </div>
+                        <span class="material-icons play_arrow" style="color: var(--theme-primary-color, #00a4dc);"></span>
+                    </button>
+                `;
+            });
+
+            html += `</div></div>`;
+            dlg.innerHTML = html;
+
+            dlg.querySelector('.btnCancel').addEventListener('click', () => {
+                dialogHelper.close(dlg);
+                resolve(null);
+            });
+
+            dlg.querySelectorAll('.channelPickerItem').forEach((btn) => {
+                btn.addEventListener('click', (e) => {
+                    const channelId = e.currentTarget.getAttribute('data-id');
+                    const selectedChannel = channels.find(c => c.Id === channelId);
+                    dialogHelper.close(dlg);
+                    resolve(selectedChannel);
+                });
+            });
+
+            dialogHelper.open(dlg);
+        }).catch((err) => {
+            console.error('[Multiview] Failed to load channels:', err);
+            resolve(null);
+        });
+    });
+}
diff --git a/src/components/multiview/multiview.scss b/src/components/multiview/multiview.scss
new file mode 100644
index 0000000000..e480011791
