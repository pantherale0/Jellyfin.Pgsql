diff --git a/Jellyfin.Api/Middleware/LeaderEpochMiddleware.cs b/Jellyfin.Api/Middleware/LeaderEpochMiddleware.cs
new file mode 100644
index 0000000000..39eeaed162
--- /dev/null
+++ b/Jellyfin.Api/Middleware/LeaderEpochMiddleware.cs
@@ -0,0 +1,46 @@
+using System.Globalization;
+using System.Threading.Tasks;
+using MediaBrowser.Controller;
+using Microsoft.AspNetCore.Http;
+
+namespace Jellyfin.Api.Middleware;
+
+/// <summary>
+/// Adds HA leadership headers so clients can detect a failover on the next request.
+/// </summary>
+public class LeaderEpochMiddleware
+{
+    private readonly RequestDelegate _next;
+
+    /// <summary>
+    /// Initializes a new instance of the <see cref="LeaderEpochMiddleware"/> class.
+    /// </summary>
+    /// <param name="next">Next request delegate.</param>
+    public LeaderEpochMiddleware(RequestDelegate next)
+    {
+        _next = next;
+    }
+
+    /// <summary>
+    /// Invoke request.
+    /// </summary>
+    /// <param name="context">Request context.</param>
+    /// <param name="leadership">Instance leadership.</param>
+    /// <returns>A <see cref="Task"/> representing the asynchronous operation.</returns>
+    public Task Invoke(HttpContext context, IInstanceLeadership leadership)
+    {
+        context.Response.OnStarting(() =>
+        {
+            var role = !leadership.IsHaEnabled
+                ? "single"
+                : leadership.IsLeader ? "leader" : "standby";
+
+            context.Response.Headers["X-Jellyfin-Leader-Epoch"] =
+                leadership.Epoch.ToString(CultureInfo.InvariantCulture);
+            context.Response.Headers["X-Jellyfin-Ha-Role"] = role;
+            return Task.CompletedTask;
+        });
+
+        return _next(context);
+    }
+}
