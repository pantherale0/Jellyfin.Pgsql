+namespace Jellyfin.Server.HealthChecks;
+
+/// <summary>
+/// Readiness: core startup is complete and this process is allowed to receive traffic.
+/// </summary>
+public sealed class LeaderReadinessHealthCheck : IHealthCheck
+{
+    private readonly IServerApplicationHost _appHost;
+    private readonly IInstanceLeadership _leadership;
+
+    /// <summary>
+    /// Initializes a new instance of the <see cref="LeaderReadinessHealthCheck"/> class.
+    /// </summary>
+    /// <param name="appHost">The application host.</param>
+    /// <param name="leadership">Instance leadership.</param>
+    public LeaderReadinessHealthCheck(IServerApplicationHost appHost, IInstanceLeadership leadership)
+    {
+        _appHost = appHost;
+        _leadership = leadership;
+    }
+
+    /// <inheritdoc />
+    public Task<HealthCheckResult> CheckHealthAsync(HealthCheckContext context, CancellationToken cancellationToken = default)
+    {
+        if (!_appHost.CoreStartupHasCompleted)
+        {
+            return Task.FromResult(HealthCheckResult.Unhealthy("Server is still starting up."));
+        }
+
+        if (_leadership.IsHaEnabled && !_leadership.IsLeader)
+        {
+            return Task.FromResult(HealthCheckResult.Unhealthy("Standby instance is not the HA leader."));
+        }
+
+        return Task.FromResult(HealthCheckResult.Healthy());
+    }
+}
