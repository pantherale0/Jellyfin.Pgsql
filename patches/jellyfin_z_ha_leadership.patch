+using System;
+using MediaBrowser.Controller.Library;
+
+namespace Emby.Server.Implementations.Ha;
+
+/// <summary>
+/// No-op playback progress overlay used when HA Redis is not configured.
+/// </summary>
+public sealed class NullPlaybackProgressCache : IPlaybackProgressCache
+{
+    /// <inheritdoc />
+    public void Set(Guid userId, Guid itemId, long positionTicks)
+    {
+    }
+
+    /// <inheritdoc />
+    public bool TryGet(Guid userId, Guid itemId, out long positionTicks)
+    {
+        positionTicks = 0;
+        return false;
+    }
+}
