@@ -0,0 +1,26 @@
+using System;
+using MediaBrowser.Controller;
+
+namespace Emby.Server.Implementations.Ha;
+
+/// <summary>
+/// Default leadership: HA is off and this process is always the writer.
+/// </summary>
+public sealed class AlwaysLeaderInstanceLeadership : IInstanceLeadership
+{
+    /// <inheritdoc />
+    public event EventHandler<LeadershipChangedEventArgs>? LeadershipChanged
+    {
+        add { }
+        remove { }
+    }
+
+    /// <inheritdoc />
+    public bool IsHaEnabled => false;
+
+    /// <inheritdoc />
+    public bool IsLeader => true;
+
+    /// <inheritdoc />
+    public long Epoch => 0;
+}
