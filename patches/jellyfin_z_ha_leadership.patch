+using System;
+
+namespace MediaBrowser.Common.Extensions;
+
+/// <summary>
+/// Thrown when a Live TV stream id is not open on this process (typical after HA failover).
+/// </summary>
+public class LiveStreamFencedException : Exception
+{
+    /// <summary>
+    /// Stable error code returned to API clients.
+    /// </summary>
+    public const string ErrorCode = "LiveStreamFenced";
+
+    /// <summary>
+    /// Default user-facing message.
+    /// </summary>
+    public const string DefaultMessage =
+        "Pardon the gremlins, looks like we had a hiccup. Restart playback and things should work.";
+
+    /// <summary>
+    /// Initializes a new instance of the <see cref="LiveStreamFencedException"/> class.
+    /// </summary>
+    public LiveStreamFencedException()
+        : base(DefaultMessage)
+    {
+    }
+
+    /// <summary>
+    /// Initializes a new instance of the <see cref="LiveStreamFencedException"/> class.
+    /// </summary>
+    /// <param name="message">The message.</param>
+    public LiveStreamFencedException(string message)
+        : base(message)
+    {
+    }
+}
diff --git a/MediaBrowser.Controller/IInstanceLeadership.cs b/MediaBrowser.Controller/IInstanceLeadership.cs
new file mode 100644
index 0000000000..c9120208e7
--- /dev/null
+++ b/MediaBrowser.Controller/IInstanceLeadership.cs
@@ -0,0 +1,57 @@
+using System;
+
+namespace MediaBrowser.Controller;
+
+/// <summary>
+/// Coordinates single-writer active-standby leadership for a Jellyfin process.
+/// </summary>
+public interface IInstanceLeadership
+{
+    /// <summary>
+    /// Raised after this process acquires or loses leadership.
+    /// </summary>
+    event EventHandler<LeadershipChangedEventArgs>? LeadershipChanged;
+
+    /// <summary>
+    /// Gets a value indicating whether active-standby HA is enabled for this process.
+    /// </summary>
+    bool IsHaEnabled { get; }
+
+    /// <summary>
+    /// Gets a value indicating whether this process currently holds the writer lock.
+    /// When HA is disabled this is always <c>true</c>.
+    /// </summary>
+    bool IsLeader { get; }
+
+    /// <summary>
+    /// Gets a monotonic epoch incremented each time this process becomes leader.
+    /// </summary>
+    long Epoch { get; }
+}
+
+/// <summary>
+/// Arguments for <see cref="IInstanceLeadership.LeadershipChanged"/>.
+/// </summary>
+public sealed class LeadershipChangedEventArgs : EventArgs
+{
+    /// <summary>
+    /// Initializes a new instance of the <see cref="LeadershipChangedEventArgs"/> class.
+    /// </summary>
+    /// <param name="isLeader">Whether this process is now the leader.</param>
+    /// <param name="epoch">The current leadership epoch.</param>
+    public LeadershipChangedEventArgs(bool isLeader, long epoch)
+    {
+        IsLeader = isLeader;
+        Epoch = epoch;
+    }
+
+    /// <summary>
+    /// Gets a value indicating whether this process is the leader.
+    /// </summary>
+    public bool IsLeader { get; }
+
+    /// <summary>
+    /// Gets the leadership epoch.
+    /// </summary>
+    public long Epoch { get; }
+}
