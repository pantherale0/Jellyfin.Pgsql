+using System;
+
+namespace Jellyfin.Database.Implementations.Entities;
+
+/// <summary>
+/// Records that a For You recommendation was served to a user (impression).
+/// </summary>
+public class UserTasteRecommendationImpression
+{
+    /// <summary>
+    /// Gets or sets the unique identifier.
+    /// </summary>
+    public Guid Id { get; set; }
+
+    /// <summary>
+    /// Gets or sets the user identifier.
+    /// </summary>
+    public Guid UserId { get; set; }
+
+    /// <summary>
+    /// Gets or sets the recommended item identifier.
+    /// </summary>
+    public Guid ItemId { get; set; }
+
+    /// <summary>
+    /// Gets or sets the item kind name (<c>Movie</c> or <c>Series</c>).
+    /// </summary>
+    public string ItemType { get; set; } = string.Empty;
+
+    /// <summary>
+    /// Gets or sets the 0-based display rank when served.
+    /// </summary>
+    public int Rank { get; set; }
+
+    /// <summary>
+    /// Gets or sets when the impression was recorded (UTC).
+    /// </summary>
+    public DateTime ServedAt { get; set; }
+}
