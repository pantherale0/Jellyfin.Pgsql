+import type { BaseItemDto } from '@jellyfin/sdk/lib/generated-client/models/base-item-dto';
+import type { BaseItemDtoQueryResult } from '@jellyfin/sdk/lib/generated-client/models/base-item-dto-query-result';
+import { ImageType } from '@jellyfin/sdk/lib/generated-client/models/image-type';
+import { ItemFields } from '@jellyfin/sdk/lib/generated-client/models/item-fields';
+import type { ApiClient } from 'jellyfin-apiclient';
+
+import cardBuilder from 'components/cardbuilder/cardBuilder';
+import { getPortraitShape } from 'components/cardbuilder/utils/shape';
+import globalize from 'lib/globalize';
+
+import type { SectionContainerElement, SectionOptions } from './section';
+
+type ForYouItemType = 'Movie' | 'Series';
+
+type TasteRecItem = {
+    ItemId?: string
+    Tier?: string
+    Score?: number
+};
+
+type TasteRecResponse = {
+    Items?: TasteRecItem[]
+};
+
+type ItemWithTasteTier = BaseItemDto & { PgsqlTasteTier?: string };
+
+function emptyQueryResult(): BaseItemDtoQueryResult {
+    return {
+        Items: [],
+        TotalRecordCount: 0
+    };
+}
+
+function getFetchForYouFn(
+    apiClient: ApiClient,
+    includeItemTypes: ForYouItemType,
+    { enableOverflow }: SectionOptions
+) {
+    return async function (): Promise<BaseItemDtoQueryResult> {
+        const userId = apiClient.getCurrentUserId();
+        const limit = enableOverflow ? 24 : 16;
+        const url = apiClient.getUrl('Pgsql/Taste/Recommendations', {
+            userId,
+            includeItemTypes,
+            limit
+        });
+
+        try {
+            const result = await apiClient.getJSON(url) as TasteRecResponse;
+            const ranked = (result?.Items || []).filter((item) => item?.ItemId);
+            if (!ranked.length) {
+                return emptyQueryResult();
+            }
+
+            const ids = ranked.map((item) => item.ItemId as string);
+            const tierById = new Map(
+                ranked
+                    .filter((item) => item.ItemId && item.Tier)
+                    .map((item) => [item.ItemId as string, item.Tier as string])
+            );
+
+            const itemsResult = await apiClient.getItems(userId, {
+                Ids: ids.join(','),
+                Limit: ids.length,
+                Fields: [
+                    ItemFields.PrimaryImageAspectRatio,
+                    ItemFields.Path
+                ].join(','),
+                ImageTypeLimit: 1,
+                EnableImageTypes: [
+                    ImageType.Primary,
+                    ImageType.Backdrop,
+                    ImageType.Thumb
+                ].join(',')
+            }) as BaseItemDtoQueryResult;
+
+            const byId = new Map(
+                (itemsResult.Items || [])
+                    .filter((item): item is BaseItemDto & { Id: string } => !!item.Id)
+                    .map((item) => [item.Id, item as ItemWithTasteTier])
+            );
+
+            const ordered: ItemWithTasteTier[] = [];
+            for (const id of ids) {
+                const item = byId.get(id);
+                if (!item) {
+                    continue;
+                }
+
+                const tier = tierById.get(id);
+                if (tier) {
+                    item.PgsqlTasteTier = tier;
+                }
+
+                ordered.push(item);
+            }
+
+            return {
+                Items: ordered,
+                TotalRecordCount: ordered.length
+            };
+        } catch {
+            return emptyQueryResult();
+        }
+    };
+}
+
+function getForYouItemsHtmlFn({ enableOverflow }: SectionOptions) {
+    return function (items: BaseItemDto[]) {
+        return cardBuilder.getCardsHtml({
+            items,
+            shape: getPortraitShape(enableOverflow),
+            showUnplayedIndicator: false,
+            showChildCountIndicator: true,
+            context: 'home',
+            overlayText: false,
+            centerText: true,
+            overlayPlayButton: true,
+            allowBottomPadding: !enableOverflow,
+            cardLayout: false,
+            showTitle: true,
+            showYear: true,
+            lines: 2
+        });
+    };
+}
+
+function renderForYouRow(
+    elem: HTMLElement,
+    apiClient: ApiClient,
+    titleKey: string,
+    includeItemTypes: ForYouItemType,
+    options: SectionOptions
+) {
+    let html = '';
+
+    html += '<div class="sectionTitleContainer sectionTitleContainer-cards padded-left">';
+    html += '<h2 class="sectionTitle sectionTitle-cards">';
+    html += globalize.translate(titleKey);
+    html += '</h2>';
+    html += '</div>';
+
+    if (options.enableOverflow) {
+        html += '<div is="emby-scroller" class="padded-top-focusscale padded-bottom-focusscale" data-centerfocus="true">';
+        html += '<div is="emby-itemscontainer" class="itemsContainer scrollSlider focuscontainer-x" data-monitor="markplayed">';
+    } else {
+        html += '<div is="emby-itemscontainer" class="itemsContainer focuscontainer-x padded-left padded-right vertical-wrap" data-monitor="markplayed">';
+    }
+
+    if (options.enableOverflow) {
+        html += '</div>';
+    }
+
+    html += '</div>';
+
+    elem.innerHTML = html;
+
+    const itemsContainer: SectionContainerElement | null = elem.querySelector('.itemsContainer');
+    if (!itemsContainer) {
+        return;
+    }
+
+    itemsContainer.fetchData = getFetchForYouFn(apiClient, includeItemTypes, options);
+    itemsContainer.getItemsHtml = getForYouItemsHtmlFn(options);
+    itemsContainer.parentContainer = elem;
+}
+
+/**
+ * Loads For You Movies and For You Shows home rows.
+ */
+export function loadForYou(
+    elem: HTMLElement,
+    apiClient: ApiClient,
+    options: SectionOptions
+) {
+    elem.classList.remove('verticalSection');
+
+    const moviesFrag = document.createElement('div');
+    moviesFrag.classList.add('verticalSection', 'hide');
+    elem.appendChild(moviesFrag);
+    renderForYouRow(moviesFrag, apiClient, 'HeaderForYouMovies', 'Movie', options);
+
+    const showsFrag = document.createElement('div');
+    showsFrag.classList.add('verticalSection', 'hide');
+    elem.appendChild(showsFrag);
+    renderForYouRow(showsFrag, apiClient, 'HeaderForYouShows', 'Series', options);
+}
