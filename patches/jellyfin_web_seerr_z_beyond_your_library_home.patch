diff --git a/src/components/homesections/sections/beyondYourLibrary.ts b/src/components/homesections/sections/beyondYourLibrary.ts
new file mode 100644
index 0000000000..49e354cd16
--- /dev/null
+++ b/src/components/homesections/sections/beyondYourLibrary.ts
@@ -0,0 +1,272 @@
+import type { ApiClient } from 'jellyfin-apiclient';
+
+import toast from 'components/toast/toast';
+import {
+    CamelCaseAccept,
+    fetchSeerrDiscover,
+    fetchSeerrStatus,
+    requestSeerrMedia
+} from 'lib/seerr/seerrApi';
+import {
+    getSeerrSearchItems,
+    isSeerrEnabled,
+    type NormalizedSeerrSearchItem
+} from 'lib/seerr/seerrTypes';
+import { mapGenreLabelsToTmdbIds } from 'lib/seerr/tmdbGenres';
+import globalize from 'lib/globalize';
+
+import type { SectionOptions } from './section';
+
+import './beyondYourLibrary.scss';
+
+type DiscoverMediaType = 'movie' | 'tv';
+
+type TasteWeight = {
+    label?: string;
+    Label?: string;
+    weight?: number;
+    Weight?: number;
+};
+
+type TasteProfileResponse = {
+    hasProfile?: boolean;
+    HasProfile?: boolean;
+    genres?: TasteWeight[];
+    Genres?: TasteWeight[];
+    ratingP25?: number | null;
+    RatingP25?: number | null;
+};
+
+type Personalization = {
+    genreIds: number[];
+    voteAverageGte?: number;
+};
+
+function escapeHtml(value: string): string {
+    return value
+        .replace(/&/g, '&amp;')
+        .replace(/</g, '&lt;')
+        .replace(/>/g, '&gt;')
+        .replace(/"/g, '&quot;')
+        .replace(/'/g, '&#39;');
+}
+
+function itemKey(item: NormalizedSeerrSearchItem): string {
+    return `${item.mediaType}:${item.mediaId}`;
+}
+
+async function fetchTastePersonalization(apiClient: ApiClient): Promise<Personalization> {
+    const userId = apiClient.getCurrentUserId();
+    try {
+        const profile = await apiClient.ajax({
+            type: 'GET',
+            url: apiClient.getUrl(`Pgsql/Taste/Users/${userId}`),
+            dataType: 'json',
+            headers: { accept: CamelCaseAccept }
+        }) as TasteProfileResponse;
+
+        const hasProfile = !!(profile?.hasProfile ?? profile?.HasProfile);
+        if (!hasProfile) {
+            return { genreIds: [] };
+        }
+
+        const genres = [...(profile.genres ?? profile.Genres ?? [])]
+            .map((g) => ({
+                label: g.label ?? g.Label ?? '',
+                weight: g.weight ?? g.Weight ?? 0
+            }))
+            .filter((g) => g.label)
+            .sort((a, b) => b.weight - a.weight);
+
+        const genreIds = mapGenreLabelsToTmdbIds(genres.map((g) => g.label), 5);
+        const ratingP25 = profile.ratingP25 ?? profile.RatingP25;
+        const voteAverageGte = typeof ratingP25 === 'number' && ratingP25 > 0
+            ? Math.min(10, Math.max(0, ratingP25))
+            : undefined;
+
+        return { genreIds, voteAverageGte };
+    } catch {
+        return { genreIds: [] };
+    }
+}
+
+function renderCardHtml(item: NormalizedSeerrSearchItem): string {
+    const key = itemKey(item);
+    const mediaLabel = item.mediaType === 'tv'
+        ? globalize.translate('Series')
+        : globalize.translate('Movie');
+    const meta = [item.year, mediaLabel].filter(Boolean).join(' · ');
+    const poster = item.posterUrl
+        ? `<img src="${escapeHtml(item.posterUrl)}" alt="" loading="lazy" />`
+        : '<div class="beyondYourLibraryPosterPlaceholder"></div>';
+
+    return `
+        <div class="beyondYourLibraryCard" data-seerr-key="${escapeHtml(key)}" data-media-type="${escapeHtml(String(item.mediaType))}" data-media-id="${item.mediaId}">
+            <div class="beyondYourLibraryPoster">${poster}</div>
+            <div class="beyondYourLibraryTitle">${escapeHtml(item.title)}</div>
+            ${meta ? `<div class="beyondYourLibraryMeta secondaryText">${escapeHtml(meta)}</div>` : ''}
+            <button type="button" class="emby-button raised button-submit beyondYourLibraryRequest" data-title="${escapeHtml(item.title)}">
+                ${globalize.translate('ButtonRequest')}
+            </button>
+        </div>
+    `;
+}
+
+function wireRequestButtons(row: HTMLElement, apiClient: ApiClient) {
+    const buttons = row.querySelectorAll<HTMLButtonElement>('.beyondYourLibraryRequest');
+    for (const button of buttons) {
+        button.addEventListener('click', () => {
+            void onRequestClick(button, apiClient);
+        });
+    }
+}
+
+async function onRequestClick(button: HTMLButtonElement, apiClient: ApiClient) {
+    const card = button.closest<HTMLElement>('.beyondYourLibraryCard');
+    if (!card || button.disabled) {
+        return;
+    }
+
+    const mediaType = card.dataset.mediaType;
+    const mediaId = Number(card.dataset.mediaId);
+    const title = button.dataset.title || 'Untitled';
+    if (!mediaType || !Number.isFinite(mediaId) || mediaId <= 0) {
+        return;
+    }
+
+    button.disabled = true;
+    button.textContent = globalize.translate('SeerrRequesting');
+
+    try {
+        await requestSeerrMedia(apiClient, mediaType, mediaId);
+        button.textContent = globalize.translate('SeerrRequested');
+        toast(globalize.translate('SeerrRequestSuccess', title));
+    } catch (err: unknown) {
+        button.disabled = false;
+        button.textContent = globalize.translate('ButtonRequest');
+
+        let message = globalize.translate('SeerrRequestFailed');
+        const response = err as { responseText?: string };
+        if (response?.responseText) {
+            try {
+                const parsed = JSON.parse(response.responseText) as {
+                    message?: string;
+                    Message?: string;
+                };
+                message = parsed.message || parsed.Message || message;
+            } catch {
+                // Keep default message.
+            }
+        }
+
+        toast(message);
+    }
+}
+
+async function renderDiscoverRow(
+    elem: HTMLElement,
+    apiClient: ApiClient,
+    titleKey: string,
+    mediaType: DiscoverMediaType,
+    personalization: Personalization,
+    options: SectionOptions
+) {
+    const limit = options.enableOverflow ? 24 : 16;
+    let items: NormalizedSeerrSearchItem[] = [];
+
+    try {
+        const data = await fetchSeerrDiscover(apiClient, {
+            mediaType,
+            genreIds: personalization.genreIds,
+            voteAverageGte: personalization.voteAverageGte,
+            limit
+        });
+        items = getSeerrSearchItems(data).filter((item) => item.canRequest && item.mediaId > 0);
+    } catch {
+        items = [];
+    }
+
+    if (!items.length) {
+        elem.classList.add('hide');
+        elem.innerHTML = '';
+        return;
+    }
+
+    elem.classList.remove('hide');
+
+    let html = '';
+    html += '<div class="sectionTitleContainer sectionTitleContainer-cards padded-left">';
+    html += '<h2 class="sectionTitle sectionTitle-cards">';
+    html += globalize.translate(titleKey);
+    html += '</h2>';
+    html += '</div>';
+
+    const scrollerClass = options.enableOverflow
+        ? 'beyondYourLibraryScroller padded-left padded-right padded-top-focusscale padded-bottom-focusscale'
+        : 'beyondYourLibraryScroller padded-left padded-right vertical-wrap';
+
+    html += `<div class="${scrollerClass} focuscontainer-x">`;
+    html += items.map(renderCardHtml).join('');
+    html += '</div>';
+
+    elem.innerHTML = html;
+    wireRequestButtons(elem, apiClient);
+}
+
+/**
+ * Loads Beyond Your Library movie/show rows from Seerr discover + taste genres.
+ */
+export async function loadBeyondYourLibrary(
+    elem: HTMLElement,
+    apiClient: ApiClient,
+    options: SectionOptions
+) {
+    elem.classList.remove('verticalSection');
+    elem.innerHTML = '';
+
+    try {
+        const status = await fetchSeerrStatus(apiClient);
+        if (!isSeerrEnabled(status)) {
+            elem.classList.add('hide');
+            return;
+        }
+    } catch {
+        elem.classList.add('hide');
+        return;
+    }
+
+    elem.classList.remove('hide');
+
+    const moviesFrag = document.createElement('div');
+    moviesFrag.classList.add('verticalSection', 'hide');
+    elem.appendChild(moviesFrag);
+
+    const showsFrag = document.createElement('div');
+    showsFrag.classList.add('verticalSection', 'hide');
+    elem.appendChild(showsFrag);
+
+    const personalization = await fetchTastePersonalization(apiClient);
+
+    await Promise.all([
+        renderDiscoverRow(
+            moviesFrag,
+            apiClient,
+            'HeaderBeyondYourLibraryMovies',
+            'movie',
+            personalization,
+            options
+        ),
+        renderDiscoverRow(
+            showsFrag,
+            apiClient,
+            'HeaderBeyondYourLibraryShows',
+            'tv',
+            personalization,
+            options
+        )
+    ]);
+
+    if (moviesFrag.classList.contains('hide') && showsFrag.classList.contains('hide')) {
+        elem.classList.add('hide');
+    }
+}
