+        private static async Task<IDisposable> EnterAdministratorLockAsync()
+        {
+            await _administratorLock.WaitAsync().ConfigureAwait(false);
+            return new AdministratorLockRelease();
+        }
+
+        /// <summary>
+        /// Recounts enabled administrators from the database (not the user cache) while the administrator lock is held.
+        /// </summary>
+        private static async Task EnsureAnotherAdministratorAsync(JellyfinDbContext dbContext, Guid userId)
+        {
+            var others = await dbContext.Users
+                .CountAsync(u => !u.Id.Equals(userId)
+                    && u.Permissions.Any(p => p.Kind == PermissionKind.IsAdministrator && p.Value)
+                    && !u.Permissions.Any(p => p.Kind == PermissionKind.IsDisabled && p.Value))
+                .ConfigureAwait(false);
+            if (others == 0)
+            {
+                throw new LastAdministratorException();
+            }
+        }
+
+        private sealed class AdministratorLockRelease : IDisposable
+        {
+            private int _released;
+
+            public void Dispose()
+            {
+                if (Interlocked.Exchange(ref _released, 1) == 0)
+                {
+                    _administratorLock.Release();
+                }
+            }
+        }
+
         internal sealed class LockHelper : IDisposable
         {
             private readonly AsyncKeyedLocker<Guid> _userLock = new();
