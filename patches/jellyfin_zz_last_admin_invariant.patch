diff --git a/MediaBrowser.Controller/Library/LastAdministratorException.cs b/MediaBrowser.Controller/Library/LastAdministratorException.cs
new file mode 100644
index 0000000000..c7748d7de2
--- /dev/null
+++ b/MediaBrowser.Controller/Library/LastAdministratorException.cs
@@ -0,0 +1,37 @@
+using System;
+
+namespace MediaBrowser.Controller.Library
+{
+    /// <summary>
+    /// Thrown when a user change would leave the server without an enabled administrator.
+    /// </summary>
+    public class LastAdministratorException : InvalidOperationException
+    {
+        /// <summary>
+        /// Initializes a new instance of the <see cref="LastAdministratorException" /> class.
+        /// </summary>
+        public LastAdministratorException()
+            : base("There must be at least one user in the system with administrative access.")
+        {
+        }
+
+        /// <summary>
+        /// Initializes a new instance of the <see cref="LastAdministratorException" /> class.
+        /// </summary>
+        /// <param name="message">The message.</param>
+        public LastAdministratorException(string message)
+            : base(message)
+        {
+        }
+
+        /// <summary>
+        /// Initializes a new instance of the <see cref="LastAdministratorException" /> class.
+        /// </summary>
+        /// <param name="message">The message.</param>
+        /// <param name="innerException">The inner exception.</param>
+        public LastAdministratorException(string message, Exception innerException)
+            : base(message, innerException)
+        {
+        }
+    }
+}
diff --git a/tests/Jellyfin.Server.Implementations.Tests/Users/UserManagerLastAdministratorTests.cs b/tests/Jellyfin.Server.Implementations.Tests/Users/UserManagerLastAdministratorTests.cs
