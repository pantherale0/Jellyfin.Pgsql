+namespace MediaBrowser.Model.Session;
+
+/// <summary>
+/// A single stage in an active transcoding pipeline.
+/// </summary>
+public class TranscodingPipelineStage
+{
+    /// <summary>
+    /// Gets or sets the stage type.
+    /// </summary>
+    public TranscodingPipelineStageType Type { get; set; }
+
+    /// <summary>
+    /// Gets or sets the media type ("Video" or "Audio").
+    /// </summary>
+    public string? MediaType { get; set; }
+
+    /// <summary>
+    /// Gets or sets the hardware framework this stage runs on.
+    /// </summary>
+    public TranscodingHardwareFramework Framework { get; set; }
+
+    /// <summary>
+    /// Gets or sets a short stage name (e.g. "scale_vt", "Decode (hevc)").
+    /// </summary>
+    public string? Name { get; set; }
+
+    /// <summary>
+    /// Gets or sets a human-readable detail (e.g. "H.265 (HEVC)", "Burn-in").
+    /// </summary>
+    public string? Detail { get; set; }
+
+    /// <summary>
+    /// Gets or sets a value indicating whether this stage runs on hardware.
+    /// </summary>
+    public bool IsHardware { get; set; }
+
+    /// <summary>
+    /// Gets or sets the edge label describing pad format/size after this stage (e.g. "nv12 3840x1636").
+    /// </summary>
+    public string? EdgeLabel { get; set; }
+}
