+using MediaBrowser.MediaEncoding.Transcoding;
+using MediaBrowser.Model.Session;
+using Xunit;
+
+namespace Jellyfin.MediaEncoding.Tests.Transcoding;
+
+public class TranscodingPipelineClassifierTests
+{
+    [Theory]
+    [InlineData("hevc_qsv", TranscodingHardwareFramework.Qsv)]
+    [InlineData("h264_nvenc", TranscodingHardwareFramework.Cuda)]
+    [InlineData("scale_cuda", TranscodingHardwareFramework.Cuda)]
+    [InlineData("hevc_cuvid", TranscodingHardwareFramework.Cuda)]
+    [InlineData("scale_vaapi", TranscodingHardwareFramework.Vaapi)]
+    [InlineData("h264_amf", TranscodingHardwareFramework.Amf)]
+    [InlineData("scale_vt", TranscodingHardwareFramework.VideoToolbox)]
+    [InlineData("overlay_videotoolbox", TranscodingHardwareFramework.VideoToolbox)]
+    [InlineData("tonemap_opencl", TranscodingHardwareFramework.OpenCl)]
+    [InlineData("scale_vulkan", TranscodingHardwareFramework.Vulkan)]
+    [InlineData("h264_rkmpp", TranscodingHardwareFramework.Rkmpp)]
+    [InlineData("h264_v4l2m2m", TranscodingHardwareFramework.V4l2m2m)]
+    [InlineData("aac_at", TranscodingHardwareFramework.AudioToolbox)]
+    [InlineData("scale", TranscodingHardwareFramework.Software)]
+    [InlineData("libx264", TranscodingHardwareFramework.Software)]
+    public void ClassifyFramework_MapsKnownNames(string name, TranscodingHardwareFramework expected)
+    {
+        Assert.Equal(expected, TranscodingPipelineClassifier.ClassifyFramework(name));
+    }
+
+    [Theory]
+    [InlineData("scale_cuda", false, false, TranscodingPipelineStageType.Scale)]
+    [InlineData("tonemap_opencl", false, false, TranscodingPipelineStageType.ToneMap)]
+    [InlineData("yadif", false, false, TranscodingPipelineStageType.Deinterlace)]
+    [InlineData("bwdif_cuda", false, false, TranscodingPipelineStageType.Deinterlace)]
+    [InlineData("overlay_cuda", false, false, TranscodingPipelineStageType.Subtitle)]
+    [InlineData("subtitles", false, false, TranscodingPipelineStageType.Subtitle)]
+    [InlineData("format", false, false, TranscodingPipelineStageType.Format)]
+    [InlineData("hwupload_cuda", false, false, TranscodingPipelineStageType.Format)]
+    [InlineData("hevc", true, false, TranscodingPipelineStageType.Decode)]
+    [InlineData("h264_nvenc", false, true, TranscodingPipelineStageType.Encode)]
+    [InlineData("Parsed_scale_cuda_0", false, false, TranscodingPipelineStageType.Scale)]
+    public void ClassifyStageType_MapsKnownNames(
+        string name,
+        bool isDecoder,
+        bool isEncoder,
+        TranscodingPipelineStageType expected)
+    {
+        Assert.Equal(expected, TranscodingPipelineClassifier.ClassifyStageType(name, isDecoder, isEncoder));
+    }
+
+    [Fact]
+    public void ExtractFilterBaseName_StripsParsedPrefixAndIndex()
+    {
+        Assert.Equal("scale_cuda", TranscodingPipelineClassifier.ExtractFilterBaseName("Parsed_scale_cuda_0"));
+    }
+}
diff --git a/tests/Jellyfin.MediaEncoding.Tests/Transcoding/TranscodingPipelineGraphParserTests.cs b/tests/Jellyfin.MediaEncoding.Tests/Transcoding/TranscodingPipelineGraphParserTests.cs
new file mode 100644
index 0000000000..2a05a1cf44
--- /dev/null
+++ b/tests/Jellyfin.MediaEncoding.Tests/Transcoding/TranscodingPipelineGraphParserTests.cs
@@ -0,0 +1,109 @@
+using System.Linq;
+using MediaBrowser.MediaEncoding.Transcoding;
+using MediaBrowser.Model.Session;
+using Xunit;
+
+namespace Jellyfin.MediaEncoding.Tests.Transcoding;
+
+public class TranscodingPipelineGraphParserTests
+{
+    [Fact]
+    public void ParseCommandLine_ExtractsHwaccelFiltersAndEncoder()
+    {
+        const string Args =
+            "-hwaccel cuda -i input.mkv -vf scale_cuda=1920:1080,tonemap_cuda,hwdownload,format=nv12 -c:v h264_nvenc -c:a aac -y output.mp4";
+
+        var pipeline = TranscodingPipelineGraphParser.ParseCommandLine(Args);
+
+        Assert.NotNull(pipeline);
+        Assert.Contains(pipeline!.Stages, s => s.Type == TranscodingPipelineStageType.Decode && s.IsHardware);
+        Assert.Contains(pipeline.Stages, s => s.Type == TranscodingPipelineStageType.Scale);
+        Assert.Contains(pipeline.Stages, s => s.Type == TranscodingPipelineStageType.ToneMap);
+        Assert.Contains(pipeline.Stages, s => s.Type == TranscodingPipelineStageType.Encode && s.Framework == TranscodingHardwareFramework.Cuda);
+        Assert.Contains(pipeline.Stages, s => s.MediaType == "Audio" && s.Type == TranscodingPipelineStageType.Encode);
+    }
+
+    [Fact]
+    public void ParseCommandLine_IgnoresCopyCodec()
+    {
+        const string Args = "-i input.mkv -c:v copy -c:a copy -y out.mkv";
+
+        var pipeline = TranscodingPipelineGraphParser.ParseCommandLine(Args);
+
+        Assert.Null(pipeline);
+    }
+
+    [Fact]
+    public void ParseGraphJson_BuildsOrderedStages()
+    {
+        const string Json = """
+            {
+              "graphs": [
+                {
+                  "filters": [
+                    {
+                      "filter": "scale_cuda",
+                      "name": "Parsed_scale_cuda_0",
+                      "filter_outputs": [
+                        { "format": "nv12", "width": 1920, "height": 1080 }
+                      ]
+                    },
+                    {
+                      "filter": "tonemap_cuda",
+                      "name": "Parsed_tonemap_cuda_1",
+                      "filter_outputs": [
+                        { "format": "nv12", "width": 1920, "height": 1080 }
+                      ]
+                    },
+                    {
+                      "filter": "overlay_cuda",
+                      "name": "Parsed_overlay_cuda_2"
+                    }
+                  ]
+                }
+              ],
+              "decoder": { "name": "hevc_cuvid", "media_type": "video" },
+              "encoder": { "name": "h264_nvenc", "media_type": "video" }
+            }
+            """;
+
+        var pipeline = TranscodingPipelineGraphParser.ParseGraphJson(Json);
+
+        Assert.NotNull(pipeline);
+        Assert.True(pipeline!.Stages.Count >= 4);
+        Assert.Equal(TranscodingPipelineStageType.Decode, pipeline.Stages[0].Type);
+        Assert.Contains(pipeline.Stages, s => s.Type == TranscodingPipelineStageType.Scale && s.EdgeLabel == "nv12 1920x1080");
+        Assert.Contains(pipeline.Stages, s => s.Type == TranscodingPipelineStageType.ToneMap);
+        Assert.Contains(pipeline.Stages, s => s.Type == TranscodingPipelineStageType.Subtitle);
+        Assert.Equal(TranscodingPipelineStageType.Encode, pipeline.Stages[^1].Type);
+        Assert.All(
+            pipeline.Stages.Where(s => s.Type is TranscodingPipelineStageType.Decode
+                or TranscodingPipelineStageType.Scale
+                or TranscodingPipelineStageType.ToneMap
+                or TranscodingPipelineStageType.Subtitle
+                or TranscodingPipelineStageType.Encode),
+            s => Assert.True(s.IsHardware));
+    }
+
+    [Fact]
+    public void ParseGraphJson_InvalidJson_ReturnsNull()
+    {
+        Assert.Null(TranscodingPipelineGraphParser.ParseGraphJson("{ not json"));
+    }
+
+    [Fact]
+    public void BuildProbeArguments_AppendsPrintGraphsAndNullOutput()
+    {
+        var args = TranscodingPipelineProbe.BuildProbeArguments(
+            "-i in.mkv -c:v libx264 -y \"/tmp/out.mp4\"",
+            "/tmp/graph.json",
+            "/tmp/probe.null");
+
+        Assert.Contains("-t 0", args, System.StringComparison.Ordinal);
+        Assert.Contains("-print_graphs", args, System.StringComparison.Ordinal);
+        Assert.Contains("-print_graphs_format json", args, System.StringComparison.Ordinal);
+        Assert.Contains("/tmp/graph.json", args, System.StringComparison.Ordinal);
+        Assert.Contains("-f null", args, System.StringComparison.Ordinal);
+        Assert.DoesNotContain("/tmp/out.mp4", args, System.StringComparison.Ordinal);
+    }
+}
