@@ -0,0 +1,47 @@
+namespace MediaBrowser.Model.Session;
+
+/// <summary>
+/// Stage type within a transcoding pipeline.
+/// </summary>
+public enum TranscodingPipelineStageType
+{
+    /// <summary>
+    /// Unknown or unclassified stage.
+    /// </summary>
+    Unknown = 0,
+
+    /// <summary>
+    /// Video or audio decode.
+    /// </summary>
+    Decode = 1,
+
+    /// <summary>
+    /// Scaling / resize.
+    /// </summary>
+    Scale = 2,
+
+    /// <summary>
+    /// Deinterlace.
+    /// </summary>
+    Deinterlace = 3,
+
+    /// <summary>
+    /// Tone mapping / HDR→SDR.
+    /// </summary>
+    ToneMap = 4,
+
+    /// <summary>
+    /// Subtitle burn-in / overlay prep.
+    /// </summary>
+    Subtitle = 5,
+
+    /// <summary>
+    /// Pixel format conversion.
+    /// </summary>
+    Format = 6,
+
+    /// <summary>
+    /// Video or audio encode.
+    /// </summary>
+    Encode = 7
+}
