+namespace MediaBrowser.Model.Session;
+
+/// <summary>
+/// Hardware framework a transcoding stage runs on.
+/// </summary>
+public enum TranscodingHardwareFramework
+{
+    /// <summary>
+    /// Software (CPU) path.
+    /// </summary>
+    Software = 0,
+
+    /// <summary>
+    /// Intel Quick Sync Video.
+    /// </summary>
+    Qsv = 1,
+
+    /// <summary>
+    /// NVIDIA CUDA / NVENC / CUVID.
+    /// </summary>
+    Cuda = 2,
+
+    /// <summary>
+    /// VAAPI.
+    /// </summary>
+    Vaapi = 3,
+
+    /// <summary>
+    /// Direct3D 11 Video Acceleration.
+    /// </summary>
+    D3D11Va = 4,
+
+    /// <summary>
+    /// Apple VideoToolbox.
+    /// </summary>
+    VideoToolbox = 5,
+
+    /// <summary>
+    /// AMD AMF.
+    /// </summary>
+    Amf = 6,
+
+    /// <summary>
+    /// OpenCL filters.
+    /// </summary>
+    OpenCl = 7,
+
+    /// <summary>
+    /// Vulkan.
+    /// </summary>
+    Vulkan = 8,
+
+    /// <summary>
+    /// Rockchip MPP / RGA.
+    /// </summary>
+    Rkmpp = 9,
+
+    /// <summary>
+    /// Apple AudioToolbox.
+    /// </summary>
+    AudioToolbox = 10,
+
+    /// <summary>
+    /// Video4Linux2 M2M.
+    /// </summary>
+    V4l2m2m = 11
+}
