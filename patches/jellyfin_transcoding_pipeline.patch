@@ -0,0 +1,40 @@
+using System.Threading;
+using MediaBrowser.Model.Session;
+
+namespace MediaBrowser.Controller.MediaEncoding;
+
+/// <summary>
+/// Probes and caches structured transcoding pipeline descriptions.
+/// </summary>
+public interface ITranscodingPipelineProbe
+{
+    /// <summary>
+    /// Gets a cached pipeline for a play session, if available.
+    /// </summary>
+    /// <param name="playSessionId">Play session id.</param>
+    /// <returns>Cached pipeline, or null.</returns>
+    TranscodingPipelineInfo? GetCachedPipeline(string? playSessionId);
+
+    /// <summary>
+    /// Stores ffmpeg arguments for a play session without starting a probe.
+    /// Call <see cref="EnsureProbed"/> when an admin views sessions.
+    /// </summary>
+    /// <param name="playSessionId">Play session id.</param>
+    /// <param name="commandLineArguments">FFmpeg arguments used for the live transcode.</param>
+    void RegisterPending(string? playSessionId, string commandLineArguments);
+
+    /// <summary>
+    /// Ensures a pipeline is available for the play session: sync CLI parse for immediate
+    /// UI, then optionally starts an async <c>-print_graphs</c> upgrade (ffmpeg ≥ 8).
+    /// </summary>
+    /// <param name="playSessionId">Play session id.</param>
+    /// <param name="cancellationToken">Cancellation token for the async graph probe.</param>
+    /// <returns>Pipeline info if available.</returns>
+    TranscodingPipelineInfo? EnsureProbed(string? playSessionId, CancellationToken cancellationToken = default);
+
+    /// <summary>
+    /// Removes a cached pipeline when the job ends.
+    /// </summary>
+    /// <param name="playSessionId">Play session id.</param>
+    void Evict(string? playSessionId);
+}
