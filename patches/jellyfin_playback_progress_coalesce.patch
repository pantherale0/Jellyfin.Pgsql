         private readonly ConcurrentDictionary<string, ConcurrentDictionary<string, string>> _activeLiveStreamSessions
             = new(StringComparer.OrdinalIgnoreCase);
 
+        /// <summary>
+        /// Last persisted playback progress per user+item, used to coalesce UserData writes.
+        /// </summary>
+        private readonly ConcurrentDictionary<(Guid UserId, Guid ItemId), (DateTime Utc, long PositionTicks)> _lastProgressPersist
+            = new();
+
+        private static readonly TimeSpan ProgressPersistMinInterval = TimeSpan.FromSeconds(30);
+        private const long ProgressPersistSeekThresholdTicks = TimeSpan.TicksPerSecond * 30;
+
         private Timer _idleTimer;
         private Timer _inactiveTimer;
 
