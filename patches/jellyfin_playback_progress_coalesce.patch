-            if (changed)
+            if (!changed)
             {
-                _userDataManager.SaveUserData(user, item, data, UserDataSaveReason.PlaybackProgress, CancellationToken.None);
+                return;
             }
+
+            // Coalesce progress saves: client check-ins arrive ~every 10s; full-row UserData
+            // rewrites (plus preference reloads) are expensive. Persist at most every 30s unless
+            // the user seeks or track settings changed.
+            if (!tracksChanged && positionTicks.HasValue
+                && !ShouldPersistPlaybackProgress(user.Id, item.Id, positionTicks.Value))
+            {
+                return;
+            }
+
+            _userDataManager.SaveUserData(user, item, data, UserDataSaveReason.PlaybackProgress, CancellationToken.None);
+
+            if (positionTicks.HasValue)
+            {
+                _lastProgressPersist[(user.Id, item.Id)] = (DateTime.UtcNow, positionTicks.Value);
+            }
+        }
+
+        /// <summary>
+        /// Returns whether a playback progress position should be written to UserData.
+        /// </summary>
+        /// <param name="userId">The user id.</param>
+        /// <param name="itemId">The item id.</param>
+        /// <param name="positionTicks">The new position.</param>
+        /// <returns><c>true</c> when the position should be persisted.</returns>
+        private bool ShouldPersistPlaybackProgress(Guid userId, Guid itemId, long positionTicks)
+        {
+            if (!_lastProgressPersist.TryGetValue((userId, itemId), out var last))
+            {
+                return true;
+            }
+
+            if (DateTime.UtcNow - last.Utc >= ProgressPersistMinInterval)
+            {
+                return true;
+            }
+
+            var delta = Math.Abs(positionTicks - last.PositionTicks);
+            return delta >= ProgressPersistSeekThresholdTicks;
         }
 
