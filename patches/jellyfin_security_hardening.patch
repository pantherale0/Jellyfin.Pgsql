diff --git a/MediaBrowser.Controller/Security/IMediaShareLinkService.cs b/MediaBrowser.Controller/Security/IMediaShareLinkService.cs
new file mode 100644
index 0000000000..8f904f2ea3
--- /dev/null
+++ b/MediaBrowser.Controller/Security/IMediaShareLinkService.cs
@@ -0,0 +1,26 @@
+using System;
+
+namespace MediaBrowser.Controller.Security;
+
+/// <summary>
+/// Creates and validates item-scoped, time-limited media share links.
+/// </summary>
+public interface IMediaShareLinkService
+{
+    /// <summary>
+    /// Creates a share token for a single item.
+    /// </summary>
+    /// <param name="userId">The user minting the link.</param>
+    /// <param name="itemId">The item the link may access.</param>
+    /// <param name="expiresIn">How long the link remains valid.</param>
+    /// <returns>The opaque token string.</returns>
+    string CreateToken(Guid userId, Guid itemId, TimeSpan expiresIn);
+
+    /// <summary>
+    /// Tries to validate a share token.
+    /// </summary>
+    /// <param name="token">The token.</param>
+    /// <param name="info">The validated share info when successful.</param>
+    /// <returns><c>true</c> if the token is valid and not expired.</returns>
+    bool TryValidate(string token, out MediaShareLinkInfo info);
+}
diff --git a/MediaBrowser.Controller/Security/MediaShareLinkInfo.cs b/MediaBrowser.Controller/Security/MediaShareLinkInfo.cs
new file mode 100644
index 0000000000..3688abd4e3
--- /dev/null
+++ b/MediaBrowser.Controller/Security/MediaShareLinkInfo.cs
@@ -0,0 +1,37 @@
+using System;
+
+namespace MediaBrowser.Controller.Security;
+
+/// <summary>
+/// Validated media share link payload.
+/// </summary>
+public readonly struct MediaShareLinkInfo
+{
+    /// <summary>
+    /// Initializes a new instance of the <see cref="MediaShareLinkInfo"/> struct.
+    /// </summary>
+    /// <param name="userId">The user who minted the link.</param>
+    /// <param name="itemId">The item the link may access.</param>
+    /// <param name="expiresAt">UTC expiry.</param>
+    public MediaShareLinkInfo(Guid userId, Guid itemId, DateTime expiresAt)
+    {
+        UserId = userId;
+        ItemId = itemId;
+        ExpiresAt = expiresAt;
+    }
+
+    /// <summary>
+    /// Gets the minting user id.
+    /// </summary>
+    public Guid UserId { get; }
+
+    /// <summary>
+    /// Gets the allowed item id.
+    /// </summary>
+    public Guid ItemId { get; }
+
+    /// <summary>
+    /// Gets the UTC expiry timestamp.
+    /// </summary>
+    public DateTime ExpiresAt { get; }
+}
