diff --git a/Jellyfin.Api/Controllers/MediaShareLinkController.cs b/Jellyfin.Api/Controllers/MediaShareLinkController.cs
new file mode 100644
index 0000000000..38b7c51f99
--- /dev/null
+++ b/Jellyfin.Api/Controllers/MediaShareLinkController.cs
@@ -0,0 +1,101 @@
+using System;
+using System.ComponentModel.DataAnnotations;
+using System.Globalization;
+using Jellyfin.Api.Extensions;
+using Jellyfin.Api.Models.LibraryDtos;
+using Jellyfin.Extensions;
+using MediaBrowser.Common.Api;
+using MediaBrowser.Controller.Entities;
+using MediaBrowser.Controller.Library;
+using MediaBrowser.Controller.Security;
+using Microsoft.AspNetCore.Authorization;
+using Microsoft.AspNetCore.Http;
+using Microsoft.AspNetCore.Mvc;
+
+namespace Jellyfin.Api.Controllers;
+
+/// <summary>
+/// Creates item-scoped, expiring media share links.
+/// </summary>
+[Route("")]
+public class MediaShareLinkController : BaseJellyfinApiController
+{
+    private readonly IMediaShareLinkService _mediaShareLinkService;
+    private readonly ILibraryManager _libraryManager;
+    private readonly IUserManager _userManager;
+
+    /// <summary>
+    /// Initializes a new instance of the <see cref="MediaShareLinkController"/> class.
+    /// </summary>
+    /// <param name="mediaShareLinkService">Share link service.</param>
+    /// <param name="libraryManager">Library manager.</param>
+    /// <param name="userManager">User manager.</param>
+    public MediaShareLinkController(
+        IMediaShareLinkService mediaShareLinkService,
+        ILibraryManager libraryManager,
+        IUserManager userManager)
+    {
+        _mediaShareLinkService = mediaShareLinkService;
+        _libraryManager = libraryManager;
+        _userManager = userManager;
+    }
+
+    /// <summary>
+    /// Creates a time-limited share URL for an item that does not embed the user's session token.
+    /// </summary>
+    /// <param name="itemId">The item id.</param>
+    /// <param name="request">Share options.</param>
+    /// <response code="200">Share link created.</response>
+    /// <response code="403">User cannot download the item.</response>
+    /// <response code="404">Item not found.</response>
+    /// <returns>The share link DTO.</returns>
+    [HttpPost("Items/{itemId}/ShareLinks")]
+    [Authorize(Policy = Policies.Download)]
+    [ProducesResponseType(StatusCodes.Status200OK)]
+    [ProducesResponseType(StatusCodes.Status403Forbidden)]
+    [ProducesResponseType(StatusCodes.Status404NotFound)]
+    public ActionResult<MediaShareLinkDto> CreateShareLink(
+        [FromRoute, Required] Guid itemId,
+        [FromBody] CreateMediaShareLinkRequest? request)
+    {
+        request ??= new CreateMediaShareLinkRequest();
+        var userId = User.GetUserId();
+        if (userId.IsEmpty() || User.GetIsMediaShareLink())
+        {
+            return Forbid();
+        }
+
+        var user = _userManager.GetUserById(userId);
+        if (user is null)
+        {
+            return Forbid();
+        }
+
+        var item = _libraryManager.GetItemById<BaseItem>(itemId, user);
+        if (item is null)
+        {
+            return NotFound();
+        }
+
+        if (!item.CanDownload(user))
+        {
+            return StatusCode(StatusCodes.Status403Forbidden, "Item does not support downloading");
+        }
+
+        var expiresIn = TimeSpan.FromSeconds(request.ExpiresInSeconds);
+        var token = _mediaShareLinkService.CreateToken(userId, itemId, expiresIn);
+        var expiresAt = DateTime.UtcNow.Add(expiresIn);
+        var path = string.Format(
+            CultureInfo.InvariantCulture,
+            "Items/{0}/Download",
+            itemId.ToString("N", CultureInfo.InvariantCulture));
+        var url = $"{Request.Scheme}://{Request.Host}{Request.PathBase}/{path}?ApiKey={Uri.EscapeDataString(token)}";
+
+        return new MediaShareLinkDto
+        {
+            Url = url,
+            Token = token,
+            ExpiresAt = expiresAt
+        };
+    }
+}
