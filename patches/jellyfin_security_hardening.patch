+    /// <summary>
+    /// Gets a flag specifying whether the request is using a media share link.
+    /// </summary>
+    /// <param name="user">Current claims principal.</param>
+    /// <returns>Whether the request is a media share link.</returns>
+    public static bool GetIsMediaShareLink(this ClaimsPrincipal user)
+    {
+        var claimValue = GetClaimValue(user, InternalClaimTypes.IsMediaShareLink);
+        return bool.TryParse(claimValue, out var parsedClaimValue)
+               && parsedClaimValue;
+    }
+
+    /// <summary>
+    /// Gets the item id a media share link is restricted to.
+    /// </summary>
+    /// <param name="user">Current claims principal.</param>
+    /// <returns>Share item id, or empty when not a share link.</returns>
+    public static Guid GetShareItemId(this ClaimsPrincipal user)
+    {
+        var value = GetClaimValue(user, InternalClaimTypes.ShareItemId);
+        return string.IsNullOrEmpty(value)
+            ? default
+            : Guid.Parse(value);
+    }
+
     private static string? GetClaimValue(in ClaimsPrincipal user, string name)
         => user.Claims.FirstOrDefault(claim => claim.Type.Equals(name, StringComparison.OrdinalIgnoreCase))?.Value;
 }
