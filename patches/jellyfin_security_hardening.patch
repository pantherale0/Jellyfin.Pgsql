diff --git a/Jellyfin.Server.Implementations/Security/MediaShareLinkService.cs b/Jellyfin.Server.Implementations/Security/MediaShareLinkService.cs
new file mode 100644
index 0000000000..1e30352542
--- /dev/null
+++ b/Jellyfin.Server.Implementations/Security/MediaShareLinkService.cs
@@ -0,0 +1,146 @@
+using System;
+using System.Security.Cryptography;
+using System.Text;
+using System.Text.Json;
+using MediaBrowser.Controller;
+using MediaBrowser.Controller.Security;
+
+namespace Jellyfin.Server.Implementations.Security;
+
+/// <summary>
+/// HMAC-signed item-scoped share tokens (no database table required).
+/// </summary>
+public class MediaShareLinkService : IMediaShareLinkService
+{
+    private const string TokenPrefix = "jfs1.";
+    private static readonly JsonSerializerOptions JsonOptions = new()
+    {
+        PropertyNamingPolicy = JsonNamingPolicy.CamelCase
+    };
+
+    private readonly byte[] _signingKey;
+
+    /// <summary>
+    /// Initializes a new instance of the <see cref="MediaShareLinkService"/> class.
+    /// </summary>
+    /// <param name="appHost">Application host (provides a stable system id for the HMAC key).</param>
+    public MediaShareLinkService(IServerApplicationHost appHost)
+    {
+        // Derive a server-local HMAC key from the system id.
+        _signingKey = SHA256.HashData(Encoding.UTF8.GetBytes("jellyfin-media-share|" + appHost.SystemId));
+    }
+
+    /// <inheritdoc />
+    public string CreateToken(Guid userId, Guid itemId, TimeSpan expiresIn)
+    {
+        if (expiresIn <= TimeSpan.Zero || expiresIn > TimeSpan.FromDays(30))
+        {
+            throw new ArgumentOutOfRangeException(nameof(expiresIn), "Expiry must be between 1 second and 30 days.");
+        }
+
+        var payload = new SharePayload
+        {
+            UserId = userId,
+            ItemId = itemId,
+            ExpiresAtUnix = DateTimeOffset.UtcNow.Add(expiresIn).ToUnixTimeSeconds()
+        };
+
+        var payloadJson = JsonSerializer.Serialize(payload, JsonOptions);
+        var payloadB64 = Base64UrlEncode(Encoding.UTF8.GetBytes(payloadJson));
+        var signature = Base64UrlEncode(ComputeHmac(payloadB64));
+        return TokenPrefix + payloadB64 + "." + signature;
+    }
+
+    /// <inheritdoc />
+    public bool TryValidate(string token, out MediaShareLinkInfo info)
+    {
+        info = default;
+        if (string.IsNullOrEmpty(token) || !token.StartsWith(TokenPrefix, StringComparison.Ordinal))
+        {
+            return false;
+        }
+
+        var body = token.AsSpan(TokenPrefix.Length);
+        var dot = body.IndexOf('.');
+        if (dot <= 0 || dot >= body.Length - 1)
+        {
+            return false;
+        }
+
+        var payloadB64 = body[..dot].ToString();
+        var signatureB64 = body[(dot + 1)..].ToString();
+
+        byte[] expected;
+        byte[] actual;
+        try
+        {
+            expected = ComputeHmac(payloadB64);
+            actual = Base64UrlDecode(signatureB64);
+        }
+        catch (FormatException)
+        {
+            return false;
+        }
+
+        if (!CryptographicOperations.FixedTimeEquals(expected, actual))
+        {
+            return false;
+        }
+
+        SharePayload? payload;
+        try
+        {
+            var json = Encoding.UTF8.GetString(Base64UrlDecode(payloadB64));
+            payload = JsonSerializer.Deserialize<SharePayload>(json, JsonOptions);
+        }
+        catch (Exception)
+        {
+            return false;
+        }
+
+        if (payload is null || payload.UserId == Guid.Empty || payload.ItemId == Guid.Empty)
+        {
+            return false;
+        }
+
+        var expiresAt = DateTimeOffset.FromUnixTimeSeconds(payload.ExpiresAtUnix).UtcDateTime;
+        if (expiresAt <= DateTime.UtcNow)
+        {
+            return false;
+        }
+
+        info = new MediaShareLinkInfo(payload.UserId, payload.ItemId, expiresAt);
+        return true;
+    }
+
+    private byte[] ComputeHmac(string payloadB64)
+        => HMACSHA256.HashData(_signingKey, Encoding.UTF8.GetBytes(payloadB64));
+
+    private static string Base64UrlEncode(byte[] data)
+        => Convert.ToBase64String(data).TrimEnd('=').Replace('+', '-').Replace('/', '_');
+
+    private static byte[] Base64UrlDecode(string input)
+    {
+        var padded = input.Replace('-', '+').Replace('_', '/');
+        switch (padded.Length % 4)
+        {
+            case 2:
+                padded += "==";
+                break;
+            case 3:
+                padded += "=";
+                break;
+        }
+
+        return Convert.FromBase64String(padded);
+    }
+
+    private sealed class SharePayload
+    {
+        public Guid UserId { get; set; }
+
+        public Guid ItemId { get; set; }
+
+        public long ExpiresAtUnix { get; set; }
+    }
+}
