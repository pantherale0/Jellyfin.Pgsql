+    private static bool IsUserDataSortField(ItemSortBy sortBy) =>
+        sortBy is ItemSortBy.DatePlayed
+            or ItemSortBy.PlayCount
+            or ItemSortBy.IsFavoriteOrLiked
+            or ItemSortBy.IsPlayed
+            or ItemSortBy.IsUnplayed;
+
+    private bool TryApplyUserDataOrder(
+        IQueryable<BaseItemEntity> query,
+        InternalItemsQuery filter,
+        JellyfinDbContext context,
+        (ItemSortBy OrderBy, SortOrder SortOrder)[] orderBy,
+        out IQueryable<BaseItemEntity> orderedQuery)
+    {
+        var userId = filter.User!.Id;
+        var primaryUserData = context.UserData
+            .AsNoTracking()
+            .Where(ud => ud.UserId == userId)
+            .GroupBy(ud => ud.ItemId)
+            .Select(g => new UserDataOrderProjection
+            {
+                ItemId = g.Key,
+                LastPlayedDate = g.OrderBy(x => x.CustomDataKey).Select(x => x.LastPlayedDate).FirstOrDefault(),
+                PlayCount = g.OrderBy(x => x.CustomDataKey).Select(x => x.PlayCount).FirstOrDefault(),
+                Played = g.OrderBy(x => x.CustomDataKey).Select(x => x.Played).FirstOrDefault(),
+                IsFavorite = g.OrderBy(x => x.CustomDataKey).Select(x => x.IsFavorite).FirstOrDefault()
+            });
+
+        var joined = query.LeftJoin(
+            primaryUserData,
+            item => item.Id,
+            ud => ud.ItemId,
+            (item, ud) => new UserDataOrderJoinRow { Item = item, UserData = ud });
+
+        IOrderedQueryable<UserDataOrderJoinRow>? orderedJoined = null;
+        foreach (var (sortField, sortDirection) in orderBy)
+        {
+            orderedJoined = ApplyUserDataSortStep(orderedJoined, joined, sortField, sortDirection);
+            if (orderedJoined is null)
+            {
+                orderedQuery = query;
+                return false;
+            }
+        }
+
+        orderedQuery = orderedJoined!.ThenBy(x => x.Item.SortName).Select(x => x.Item);
+        return true;
+    }
+
+    private static IOrderedQueryable<UserDataOrderJoinRow>? ApplyUserDataSortStep(
+        IOrderedQueryable<UserDataOrderJoinRow>? orderedJoined,
+        IQueryable<UserDataOrderJoinRow> joined,
+        ItemSortBy sortField,
+        SortOrder sortDirection)
+    {
+        return (orderedJoined, sortField, sortDirection) switch
+        {
+            (null, ItemSortBy.DatePlayed, SortOrder.Ascending) =>
+                joined.OrderBy(x => x.UserData != null ? x.UserData.LastPlayedDate : null),
+            (null, ItemSortBy.DatePlayed, SortOrder.Descending) =>
+                joined.OrderByDescending(x => x.UserData != null ? x.UserData.LastPlayedDate : null),
+            (null, ItemSortBy.PlayCount, SortOrder.Ascending) =>
+                joined.OrderBy(x => x.UserData != null ? x.UserData.PlayCount : 0),
+            (null, ItemSortBy.PlayCount, SortOrder.Descending) =>
+                joined.OrderByDescending(x => x.UserData != null ? x.UserData.PlayCount : 0),
+            (null, ItemSortBy.IsFavoriteOrLiked, SortOrder.Ascending) =>
+                joined.OrderBy(x => x.UserData != null && x.UserData.IsFavorite),
+            (null, ItemSortBy.IsFavoriteOrLiked, SortOrder.Descending) =>
+                joined.OrderByDescending(x => x.UserData != null && x.UserData.IsFavorite),
+            (null, ItemSortBy.IsPlayed, SortOrder.Ascending) =>
+                joined.OrderBy(x => x.UserData != null && x.UserData.Played),
+            (null, ItemSortBy.IsPlayed, SortOrder.Descending) =>
+                joined.OrderByDescending(x => x.UserData != null && x.UserData.Played),
+            (null, ItemSortBy.IsUnplayed, SortOrder.Ascending) =>
+                joined.OrderBy(x => x.UserData == null || !x.UserData.Played),
+            (null, ItemSortBy.IsUnplayed, SortOrder.Descending) =>
+                joined.OrderByDescending(x => x.UserData == null || !x.UserData.Played),
+
+            (not null, ItemSortBy.DatePlayed, SortOrder.Ascending) =>
+                orderedJoined.ThenBy(x => x.UserData != null ? x.UserData.LastPlayedDate : null),
+            (not null, ItemSortBy.DatePlayed, SortOrder.Descending) =>
+                orderedJoined.ThenByDescending(x => x.UserData != null ? x.UserData.LastPlayedDate : null),
+            (not null, ItemSortBy.PlayCount, SortOrder.Ascending) =>
+                orderedJoined.ThenBy(x => x.UserData != null ? x.UserData.PlayCount : 0),
+            (not null, ItemSortBy.PlayCount, SortOrder.Descending) =>
+                orderedJoined.ThenByDescending(x => x.UserData != null ? x.UserData.PlayCount : 0),
+            (not null, ItemSortBy.IsFavoriteOrLiked, SortOrder.Ascending) =>
+                orderedJoined.ThenBy(x => x.UserData != null && x.UserData.IsFavorite),
+            (not null, ItemSortBy.IsFavoriteOrLiked, SortOrder.Descending) =>
+                orderedJoined.ThenByDescending(x => x.UserData != null && x.UserData.IsFavorite),
+            (not null, ItemSortBy.IsPlayed, SortOrder.Ascending) =>
+                orderedJoined.ThenBy(x => x.UserData != null && x.UserData.Played),
+            (not null, ItemSortBy.IsPlayed, SortOrder.Descending) =>
+                orderedJoined.ThenByDescending(x => x.UserData != null && x.UserData.Played),
+            (not null, ItemSortBy.IsUnplayed, SortOrder.Ascending) =>
+                orderedJoined.ThenBy(x => x.UserData == null || !x.UserData.Played),
+            (not null, ItemSortBy.IsUnplayed, SortOrder.Descending) =>
+                orderedJoined.ThenByDescending(x => x.UserData == null || !x.UserData.Played),
+            _ => null
+        };
