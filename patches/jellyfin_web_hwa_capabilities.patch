+import type { Api } from '@jellyfin/sdk';
+import { useQuery } from '@tanstack/react-query';
+import type { AxiosRequestConfig } from 'axios';
+import { useApi } from 'hooks/useApi';
+
+import type { MediaEncoderCapabilities } from '../types/mediaEncoderCapabilities';
+
+export const MEDIA_ENCODER_CAPABILITIES_QUERY_KEY = 'MediaEncoderCapabilities';
+
+const fetchMediaEncoderCapabilities = async (
+    api: Api,
+    options?: AxiosRequestConfig
+): Promise<MediaEncoderCapabilities> => {
+    const response = await api.axiosInstance.get<MediaEncoderCapabilities>(
+        '/System/MediaEncoder/Capabilities',
+        {
+            ...options,
+            baseURL: api.basePath,
+            headers: {
+                ...options?.headers,
+                Authorization: api.authorizationHeader
+            }
+        }
+    );
+
+    return response.data;
+};
+
+export const useMediaEncoderCapabilities = () => {
+    const { api } = useApi();
+
+    return useQuery({
+        queryKey: [MEDIA_ENCODER_CAPABILITIES_QUERY_KEY],
+        queryFn: ({ signal }) => fetchMediaEncoderCapabilities(api!, { signal }),
+        enabled: !!api,
+        refetchOnMount: false
+    });
+};
