diff --git a/MediaBrowser.Controller/Library/SearchQueryResult.cs b/MediaBrowser.Controller/Library/SearchQueryResult.cs
new file mode 100644
index 0000000000..f64af703b1
--- /dev/null
+++ b/MediaBrowser.Controller/Library/SearchQueryResult.cs
@@ -0,0 +1,35 @@
+using System.Collections.Generic;
+
+namespace MediaBrowser.Controller.Library;
+
+/// <summary>
+/// Paginated search results from a search provider or the search manager.
+/// </summary>
+public class SearchQueryResult
+{
+    /// <summary>
+    /// Initializes a new instance of the <see cref="SearchQueryResult"/> class.
+    /// </summary>
+    /// <param name="items">The page of search results.</param>
+    /// <param name="totalRecordCount">The total number of matching records.</param>
+    public SearchQueryResult(IReadOnlyList<SearchResult> items, int totalRecordCount)
+    {
+        Items = items;
+        TotalRecordCount = totalRecordCount;
+    }
+
+    /// <summary>
+    /// Gets an empty result.
+    /// </summary>
+    public static SearchQueryResult Empty { get; } = new([], 0);
+
+    /// <summary>
+    /// Gets the page of search results (item IDs and scores).
+    /// </summary>
+    public IReadOnlyList<SearchResult> Items { get; }
+
+    /// <summary>
+    /// Gets the total number of matching records before paging.
+    /// </summary>
+    public int TotalRecordCount { get; }
+}
