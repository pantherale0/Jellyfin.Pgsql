@@ -0,0 +1,18 @@
+namespace MediaBrowser.Model.MediaInfo
+{
+    /// <summary>
+    /// Structured playback error returned to API clients.
+    /// </summary>
+    public class PlaybackErrorResponse
+    {
+        /// <summary>
+        /// Gets or sets the stable playback error code.
+        /// </summary>
+        public string ErrorCode { get; set; } = string.Empty;
+
+        /// <summary>
+        /// Gets or sets an optional generic hint. Clients should prefer localizing <see cref="ErrorCode"/>.
+        /// </summary>
+        public string? Message { get; set; }
+    }
+}
