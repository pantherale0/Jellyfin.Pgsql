diff --git a/MediaBrowser.Common/Extensions/PlaybackFailedException.cs b/MediaBrowser.Common/Extensions/PlaybackFailedException.cs
new file mode 100644
index 0000000000..f0a4b267bf
--- /dev/null
+++ b/MediaBrowser.Common/Extensions/PlaybackFailedException.cs
@@ -0,0 +1,60 @@
+using System;
+using MediaBrowser.Model.Dlna;
+
+namespace MediaBrowser.Common.Extensions;
+
+/// <summary>
+/// Thrown when playback cannot continue and a structured error should be returned to clients.
+/// </summary>
+public class PlaybackFailedException : Exception
+{
+    /// <summary>
+    /// HTTP response header carrying <see cref="ErrorCode"/> for streaming clients.
+    /// </summary>
+    public const string ErrorCodeHeaderName = "X-Playback-Error-Code";
+
+    /// <summary>
+    /// Initializes a new instance of the <see cref="PlaybackFailedException"/> class.
+    /// </summary>
+    /// <param name="errorCode">The playback error code.</param>
+    public PlaybackFailedException(PlaybackErrorCode errorCode)
+        : this(errorCode, GetDefaultMessage(errorCode))
+    {
+    }
+
+    /// <summary>
+    /// Initializes a new instance of the <see cref="PlaybackFailedException"/> class.
+    /// </summary>
+    /// <param name="errorCode">The playback error code.</param>
+    /// <param name="message">An optional generic message.</param>
+    public PlaybackFailedException(PlaybackErrorCode errorCode, string message)
+        : base(message)
+    {
+        ErrorCode = errorCode;
+    }
+
+    /// <summary>
+    /// Gets the playback error code.
+    /// </summary>
+    public PlaybackErrorCode ErrorCode { get; }
+
+    /// <summary>
+    /// Gets the stable string form of <see cref="ErrorCode"/>.
+    /// </summary>
+    public string ErrorCodeString => ErrorCode.ToString();
+
+    private static string GetDefaultMessage(PlaybackErrorCode errorCode)
+    {
+        return errorCode switch
+        {
+            PlaybackErrorCode.NotAllowed => "Playback of this media is not allowed.",
+            PlaybackErrorCode.NoCompatibleStream => "No compatible stream was found for this client.",
+            PlaybackErrorCode.RateLimitExceeded => "Playback is temporarily rate limited.",
+            PlaybackErrorCode.TranscodeFailed => "The server could not prepare this media for playback.",
+            PlaybackErrorCode.TranscodeNotAllowed => "Your account is not allowed to use transcoding.",
+            PlaybackErrorCode.StreamUnavailable => "The requested stream is not available.",
+            PlaybackErrorCode.LiveStreamFenced => "Live TV was interrupted. Restart playback to reconnect.",
+            _ => "Playback could not continue."
+        };
+    }
+}
