+    private static Guid? CoalesceUserId(Guid? userId, HttpRequest? request)
+    {
+        if (!userId.IsNullOrEmpty() || request is null)
+        {
+            return userId;
+        }
+
+        if (TryParseUserId(request.Query["userId"], out var queryUserId)
+            || TryParseUserId(request.Query["UserId"], out queryUserId))
+        {
+            return queryUserId;
+        }
+
+        if (request.RouteValues.TryGetValue("userId", out var routeValue)
+            && TryParseUserId(routeValue, out var routeUserId))
+        {
+            return routeUserId;
+        }
+
+        return userId;
+    }
+
+    private static bool TryParseUserId(object? value, out Guid userId)
+    {
+        userId = default;
+        if (value is null)
+        {
+            return false;
+        }
+
+        return Guid.TryParse(Convert.ToString(value, CultureInfo.InvariantCulture), out userId)
+            && !userId.IsEmpty();
+    }
+
