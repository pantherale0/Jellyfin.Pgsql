diff --git a/src/components/QuickConnectDialog.tsx b/src/components/QuickConnectDialog.tsx
new file mode 100644
index 0000000000..4277f72e96
--- /dev/null
+++ b/src/components/QuickConnectDialog.tsx
@@ -0,0 +1,158 @@
+import { getAuthenticationApi } from '@jellyfin/sdk/lib/utils/api/authentication-api';
+import Alert from '@mui/material/Alert';
+import Button from '@mui/material/Button';
+import Dialog from '@mui/material/Dialog';
+import DialogActions from '@mui/material/DialogActions';
+import DialogContent from '@mui/material/DialogContent';
+import DialogContentText from '@mui/material/DialogContentText';
+import DialogTitle from '@mui/material/DialogTitle';
+import TextField from '@mui/material/TextField';
+import React, { type FC, FormEvent, useCallback, useEffect, useState } from 'react';
+
+import { useApi } from 'hooks/useApi';
+import globalize from 'lib/globalize';
+
+interface QuickConnectDialogProps {
+    open: boolean
+    onClose: () => void
+    initialCode?: string
+    userId?: string
+}
+
+const QuickConnectDialog: FC<QuickConnectDialogProps> = ({
+    open,
+    onClose,
+    initialCode = '',
+    userId
+}) => {
+    const { api, user } = useApi();
+    const [ code, setCode ] = useState(initialCode);
+    const [ error, setError ] = useState<string>();
+    const [ success, setSuccess ] = useState(false);
+    const [ isSubmitting, setIsSubmitting ] = useState(false);
+
+    useEffect(() => {
+        if (open) {
+            setCode(initialCode);
+            setError(undefined);
+            setSuccess(false);
+            setIsSubmitting(false);
+        }
+    }, [ open, initialCode ]);
+
+    const onCodeChange = useCallback((event: React.ChangeEvent<HTMLInputElement>) => {
+        setCode(event.currentTarget.value);
+        setError(undefined);
+    }, []);
+
+    const onSubmit = useCallback((e: FormEvent<HTMLFormElement>) => {
+        e.preventDefault();
+        setError(undefined);
+
+        const normalizedCode = code.replace(/\s/g, '');
+        if (!/^\d{6,}$/.test(normalizedCode)) {
+            setError('QuickConnectInvalidCode');
+            return;
+        }
+
+        if (!api) {
+            console.error('[QuickConnect] cannot authorize, missing api instance');
+            setError('UnknownError');
+            return;
+        }
+
+        const authorizeUserId = userId ?? user?.Id;
+        console.log('[QuickConnect] authorizing code %s as user %s', normalizedCode, authorizeUserId);
+        setIsSubmitting(true);
+
+        getAuthenticationApi(api)
+            .authorizeQuickConnect({
+                code: normalizedCode,
+                userId: authorizeUserId
+            })
+            .then(() => {
+                setSuccess(true);
+            })
+            .catch(() => {
+                setError('QuickConnectAuthorizeFail');
+            })
+            .finally(() => {
+                setIsSubmitting(false);
+            });
+    }, [ api, code, user?.Id, userId ]);
+
+    return (
+        <Dialog
+            open={open}
+            onClose={onClose}
+            maxWidth='xs'
+            fullWidth
+        >
+            <DialogTitle>
+                {globalize.translate('QuickConnect')}
+            </DialogTitle>
+            {success ? (
+                <>
+                    <DialogContent>
+                        <DialogContentText>
+                            {globalize.translate('QuickConnectAuthorizeSuccess')}
+                        </DialogContentText>
+                    </DialogContent>
+                    <DialogActions>
+                        <Button onClick={onClose}>
+                            {globalize.translate('ButtonClose')}
+                        </Button>
+                    </DialogActions>
+                </>
+            ) : (
+                <form onSubmit={onSubmit}>
+                    <DialogContent>
+                        <DialogContentText sx={{ mb: 2 }}>
+                            {globalize.translate('QuickConnectDescription')}
+                        </DialogContentText>
+                        {error && (
+                            <Alert severity='error' sx={{ mb: 2 }}>
+                                {globalize.translate(error)}
+                            </Alert>
+                        )}
+                        <TextField
+                            autoFocus
+                            fullWidth
+                            id='txtQuickConnectCode'
+                            label={globalize.translate('LabelQuickConnectCode')}
+                            value={code}
+                            onChange={onCodeChange}
+                            type='text'
+                            inputMode='numeric'
+                            autoComplete='off'
+                            required
+                            inputProps={{
+                                pattern: '[0-9\\s]*',
+                                minLength: 6
+                            }}
+                            variant='standard'
+                        />
+                    </DialogContent>
+                    <DialogActions>
+                        <Button
+                            variant='text'
+                            onClick={onClose}
+                            disabled={isSubmitting}
+                        >
+                            {globalize.translate('ButtonCancel')}
+                        </Button>
+                        <Button
+                            type='submit'
+                            color='primary'
+                            disabled={isSubmitting}
+                        >
+                            {globalize.translate('Authorize')}
+                        </Button>
+                    </DialogActions>
+                </form>
+            )}
+        </Dialog>
+    );
+};
+
+export default QuickConnectDialog;
