+import { useMutation } from '@tanstack/react-query';
+
+import { useApi } from 'hooks/useApi';
+
+import type { EmbyUploadProgress } from '../types';
+import {
+    discardEmbyImportSession,
+    executeEmbyImport,
+    previewEmbyImport,
+    uploadEmbyDatabases
+} from './embyImportApi';
+
+export const useUploadEmbyDatabases = () => {
+    const { api } = useApi();
+
+    return useMutation({
+        mutationFn: ({
+            libraryDb,
+            usersDb,
+            onProgress
+        }: {
+            libraryDb: File;
+            usersDb: File;
+            onProgress?: (progress: EmbyUploadProgress) => void;
+        }) => uploadEmbyDatabases(api!, libraryDb, usersDb, onProgress)
+    });
+};
+
+export const usePreviewEmbyImport = () => {
+    const { api } = useApi();
+
+    return useMutation({
+        mutationFn: ({
+            sessionId,
+            embyUserIds,
+            targetUserId
+        }: {
+            sessionId: string;
+            embyUserIds: number[];
+            targetUserId: string;
+        }) => previewEmbyImport(api!, sessionId, embyUserIds, targetUserId)
+    });
+};
+
+export const useExecuteEmbyImport = () => {
+    const { api } = useApi();
+
+    return useMutation({
+        mutationFn: ({
+            sessionId,
+            embyUserIds,
+            targetUserId
+        }: {
+            sessionId: string;
+            embyUserIds: number[];
+            targetUserId: string;
+        }) => executeEmbyImport(api!, sessionId, embyUserIds, targetUserId)
+    });
+};
+
+export const useDiscardEmbyImportSession = () => {
+    const { api } = useApi();
+
+    return useMutation({
+        mutationFn: (sessionId: string) => discardEmbyImportSession(api!, sessionId)
+    });
+};
