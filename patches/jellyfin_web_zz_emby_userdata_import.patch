+++ b/src/apps/dashboard/routes/users/import-emby.tsx
@@ -0,0 +1,423 @@
+import Alert from '@mui/material/Alert';
+import Box from '@mui/material/Box';
+import Button from '@mui/material/Button';
+import Checkbox from '@mui/material/Checkbox';
+import FormControl from '@mui/material/FormControl';
+import FormControlLabel from '@mui/material/FormControlLabel';
+import FormGroup from '@mui/material/FormGroup';
+import InputLabel from '@mui/material/InputLabel';
+import MenuItem from '@mui/material/MenuItem';
+import Select from '@mui/material/Select';
+import Stack from '@mui/material/Stack';
+import Table from '@mui/material/Table';
+import TableBody from '@mui/material/TableBody';
+import TableCell from '@mui/material/TableCell';
+import TableHead from '@mui/material/TableHead';
+import TableRow from '@mui/material/TableRow';
+import TextField from '@mui/material/TextField';
+import Typography from '@mui/material/Typography';
+import React, { useCallback, useMemo, useState } from 'react';
+import { useNavigate } from 'react-router-dom';
+
+import Page from 'components/Page';
+import Loading from 'components/loading/LoadingComponent';
+import {
+    useDiscardEmbyImportSession,
+    useExecuteEmbyImport,
+    usePreviewEmbyImport,
+    useUploadEmbyDatabases
+} from 'apps/dashboard/features/embyImport/api/useEmbyImport';
+import type {
+    EmbyImportCounts,
+    EmbyImportResponse,
+    EmbyUploadProgress,
+    EmbyUserInfo
+} from 'apps/dashboard/features/embyImport/types';
+import { useUsers } from 'hooks/useUsers';
+import globalize from 'lib/globalize';
+
+const countRows = (counts: EmbyImportCounts): { label: string; value: string }[] => [
+    { label: globalize.translate('EmbyImportCountSourceRows'), value: String(counts.sourceRows) },
+    { label: globalize.translate('EmbyImportCountMatchedKeys'), value: String(counts.matchedKeys) },
+    { label: globalize.translate('EmbyImportCountUnmatchedKeys'), value: String(counts.unmatchedKeys) },
+    { label: globalize.translate('EmbyImportCountMatchedItems'), value: String(counts.matchedItems) },
+    { label: globalize.translate('EmbyImportCountItemsNew'), value: String(counts.itemsNew) },
+    { label: globalize.translate('EmbyImportCountItemsMerged'), value: String(counts.itemsMerged) }
+];
+
+const EmbyImportPage = () => {
+    const navigate = useNavigate();
+    const { data: users, isPending } = useUsers(undefined, { forceRefresh: true });
+
+    const uploadMutation = useUploadEmbyDatabases();
+    const previewMutation = usePreviewEmbyImport();
+    const executeMutation = useExecuteEmbyImport();
+    const discardMutation = useDiscardEmbyImportSession();
+
+    const [ libraryFile, setLibraryFile ] = useState<File | null>(null);
+    const [ usersFile, setUsersFile ] = useState<File | null>(null);
+    const [ sessionId, setSessionId ] = useState('');
+    const [ embyUsers, setEmbyUsers ] = useState<EmbyUserInfo[]>([]);
+    const [ selectedEmbyUserIds, setSelectedEmbyUserIds ] = useState<number[]>([]);
+    const [ targetUserId, setTargetUserId ] = useState('');
+    const [ confirmName, setConfirmName ] = useState('');
+    const [ preview, setPreview ] = useState<EmbyImportResponse | null>(null);
+    const [ result, setResult ] = useState<EmbyImportResponse | null>(null);
+    const [ error, setError ] = useState<string | null>(null);
+    const [ uploadProgress, setUploadProgress ] = useState<EmbyUploadProgress | null>(null);
+
+    const targetUser = useMemo(
+        () => users?.find(u => u.Id === targetUserId),
+        [ users, targetUserId ]
+    );
+
+    const canUpload = !!libraryFile && !!usersFile && !uploadMutation.isPending;
+    const canPreview = !!sessionId
+        && selectedEmbyUserIds.length > 0
+        && !!targetUserId
+        && !previewMutation.isPending;
+    const confirmMatches = !!targetUser?.Name
+        && confirmName.trim().localeCompare(targetUser.Name, undefined, { sensitivity: 'accent' }) === 0;
+    const canExecute = canPreview && confirmMatches && !!preview && !executeMutation.isPending && !result;
+
+    const resetAfterUpload = useCallback(() => {
+        setSelectedEmbyUserIds([]);
+        setTargetUserId('');
+        setConfirmName('');
+        setPreview(null);
+        setResult(null);
+        setError(null);
+    }, []);
+
+    const extractError = (err: unknown, fallback: string) => {
+        const message = (err as { response?: { data?: string } })?.response?.data;
+        return typeof message === 'string' && message ? message : fallback;
+    };
+
+    const handleUpload = useCallback(() => {
+        if (!libraryFile || !usersFile) {
+            return;
+        }
+
+        setError(null);
+        setResult(null);
+        setPreview(null);
+        setUploadProgress(null);
+        uploadMutation.mutate(
+            {
+                libraryDb: libraryFile,
+                usersDb: usersFile,
+                onProgress: setUploadProgress
+            },
+            {
+                onSuccess: (data) => {
+                    setUploadProgress(null);
+                    if (!data.sessionId) {
+                        setError(globalize.translate('EmbyImportUploadFailed'));
+                        return;
+                    }
+
+                    if (sessionId) {
+                        discardMutation.mutate(sessionId);
+                    }
+
+                    resetAfterUpload();
+                    setSessionId(data.sessionId);
+                    setEmbyUsers(data.users || []);
+                    setSelectedEmbyUserIds(
+                        (data.users || [])
+                            .filter(u => u.userDataCount > 0)
+                            .map(u => u.id)
+                    );
+                },
+                onError: (err: unknown) => {
+                    setUploadProgress(null);
+                    setError(extractError(err, globalize.translate('EmbyImportUploadFailed')));
+                }
+            }
+        );
+    }, [
+        discardMutation,
+        libraryFile,
+        resetAfterUpload,
+        sessionId,
+        uploadMutation,
+        usersFile
+    ]);
+
+    const handlePreview = useCallback(() => {
+        if (!canPreview) {
+            return;
+        }
+
+        setError(null);
+        setResult(null);
+        previewMutation.mutate(
+            {
+                sessionId,
+                embyUserIds: selectedEmbyUserIds,
+                targetUserId
+            },
+            {
+                onSuccess: (data) => setPreview(data),
+                onError: (err: unknown) => {
+                    setError(extractError(err, globalize.translate('EmbyImportPreviewFailed')));
+                    setPreview(null);
+                }
+            }
+        );
+    }, [ canPreview, previewMutation, selectedEmbyUserIds, sessionId, targetUserId ]);
+
+    const handleExecute = useCallback(() => {
+        if (!canExecute) {
+            return;
+        }
+
+        setError(null);
+        executeMutation.mutate(
+            {
+                sessionId,
+                embyUserIds: selectedEmbyUserIds,
+                targetUserId
+            },
+            {
+                onSuccess: (data) => {
+                    setResult(data);
+                    setPreview(null);
+                    setSessionId('');
+                },
+                onError: (err: unknown) => {
+                    setError(extractError(err, globalize.translate('EmbyImportExecuteFailed')));
+                }
+            }
+        );
+    }, [ canExecute, executeMutation, selectedEmbyUserIds, sessionId, targetUserId ]);
+
+    const toggleEmbyUser = (id: number, checked: boolean) => {
+        setPreview(null);
+        setResult(null);
+        setConfirmName('');
+        setSelectedEmbyUserIds(prev => {
+            if (checked) {
+                return prev.includes(id) ? prev : [ ...prev, id ];
+            }
+            return prev.filter(x => x !== id);
+        });
+    };
+
+    if (isPending) {
+        return <Loading />;
+    }
+
+    const displayCounts = result?.counts || preview?.counts;
+
+    return (
+        <Page
+            id='embyImportPage'
+            className='mainAnimatedPage type-interior'
+            title={globalize.translate('HeaderEmbyImport')}
+        >
+            <Box className='content-primary' sx={{ maxWidth: 720 }}>
+                <Stack spacing={3}>
+                    <Typography variant='body1'>
+                        {globalize.translate('EmbyImportHelp')}
+                    </Typography>
+
+                    <Stack spacing={2}>
+                        <Typography variant='subtitle2'>
+                            {globalize.translate('EmbyImportUploadStep')}
+                        </Typography>
+                        <Button variant='outlined' component='label'>
+                            {libraryFile ?
+                                globalize.translate('EmbyImportLibrarySelected', libraryFile.name) :
+                                globalize.translate('EmbyImportSelectLibraryDb')}
+                            <input
+                                hidden
+                                type='file'
+                                accept='.db,application/x-sqlite3,application/octet-stream'
+                                onChange={(e) => {
+                                    setLibraryFile(e.target.files?.[0] || null);
+                                    setSessionId('');
+                                    setEmbyUsers([]);
+                                    resetAfterUpload();
+                                }}
+                            />
+                        </Button>
+                        <Button variant='outlined' component='label'>
+                            {usersFile ?
+                                globalize.translate('EmbyImportUsersSelected', usersFile.name) :
+                                globalize.translate('EmbyImportSelectUsersDb')}
+                            <input
+                                hidden
+                                type='file'
+                                accept='.db,application/x-sqlite3,application/octet-stream'
+                                onChange={(e) => {
+                                    setUsersFile(e.target.files?.[0] || null);
+                                    setSessionId('');
+                                    setEmbyUsers([]);
+                                    resetAfterUpload();
+                                }}
+                            />
+                        </Button>
+                        <Button
+                            variant='contained'
+                            disabled={!canUpload}
+                            onClick={handleUpload}
+                        >
+                            {uploadMutation.isPending
+                                ? (uploadProgress
+                                    ? globalize.translate(
+                                        'EmbyImportUploadingFile',
+                                        uploadProgress.file === 'libraryDb' ? 'library.db' : 'users.db',
+                                        String(uploadProgress.chunkIndex),
+                                        String(uploadProgress.totalChunks)
+                                    )
+                                    : globalize.translate('EmbyImportUploading'))
+                                : globalize.translate('EmbyImportUpload')}
+                        </Button>
+                    </Stack>
+
+                    {sessionId && (
+                        <Stack spacing={2}>
+                            <Typography variant='subtitle2'>
+                                {globalize.translate('EmbyImportSelectStep')}
+                            </Typography>
+                            <FormGroup>
+                                {embyUsers.map(user => (
+                                    <FormControlLabel
+                                        key={user.id}
+                                        control={
+                                            <Checkbox
+                                                checked={selectedEmbyUserIds.includes(user.id)}
+                                                onChange={(e) => toggleEmbyUser(user.id, e.target.checked)}
+                                            />
+                                        }
+                                        label={globalize.translate(
+                                            'EmbyImportUserOption',
+                                            user.name,
+                                            String(user.userDataCount)
+                                        )}
+                                    />
+                                ))}
+                            </FormGroup>
+
+                            <FormControl fullWidth>
+                                <InputLabel id='emby-target-user-label'>
+                                    {globalize.translate('EmbyImportTargetUser')}
+                                </InputLabel>
+                                <Select
+                                    labelId='emby-target-user-label'
+                                    label={globalize.translate('EmbyImportTargetUser')}
+                                    value={targetUserId}
+                                    onChange={(e) => {
+                                        setTargetUserId(e.target.value);
+                                        setPreview(null);
+                                        setResult(null);
+                                        setConfirmName('');
+                                    }}
+                                >
+                                    {(users || []).map(user => (
+                                        <MenuItem key={user.Id} value={user.Id || ''}>
+                                            {user.Name}
+                                        </MenuItem>
+                                    ))}
+                                </Select>
+                            </FormControl>
+
+                            <Stack direction='row' spacing={2}>
+                                <Button
+                                    variant='outlined'
+                                    disabled={!canPreview}
+                                    onClick={handlePreview}
+                                >
+                                    {globalize.translate('EmbyImportPreview')}
+                                </Button>
+                                <Button
+                                    variant='text'
+                                    onClick={() => {
+                                        if (sessionId) {
+                                            discardMutation.mutate(sessionId);
+                                        }
+                                        navigate('/dashboard/users');
+                                    }}
+                                >
+                                    {globalize.translate('ButtonCancel')}
+                                </Button>
+                            </Stack>
+                        </Stack>
+                    )}
+
+                    {error && <Alert severity='error'>{error}</Alert>}
+
+                    {displayCounts && (
+                        <Box>
+                            <Typography variant='h6' gutterBottom>
+                                {result
+                                    ? globalize.translate('EmbyImportResult')
+                                    : globalize.translate('EmbyImportPreviewResult')}
+                            </Typography>
+                            <Table size='small'>
+                                <TableHead>
+                                    <TableRow>
+                                        <TableCell>{globalize.translate('LabelType')}</TableCell>
+                                        <TableCell align='right'>
+                                            {globalize.translate('EmbyImportCount')}
+                                        </TableCell>
+                                    </TableRow>
+                                </TableHead>
+                                <TableBody>
+                                    {countRows(displayCounts).map(row => (
+                                        <TableRow key={row.label}>
+                                            <TableCell>{row.label}</TableCell>
+                                            <TableCell align='right'>{row.value}</TableCell>
+                                        </TableRow>
+                                    ))}
+                                </TableBody>
+                            </Table>
+                        </Box>
+                    )}
+
+                    {preview && !result && (
+                        <Stack spacing={2}>
+                            <Alert severity='warning'>
+                                {globalize.translate('EmbyImportConfirmWarning')}
+                            </Alert>
+                            <TextField
+                                fullWidth
+                                label={globalize.translate(
+                                    'EmbyImportConfirmUsername',
+                                    targetUser?.Name || ''
+                                )}
+                                value={confirmName}
+                                onChange={(e) => setConfirmName(e.target.value)}
+                                helperText={globalize.translate(
+                                    'EmbyImportConfirmHelp',
+                                    targetUser?.Name || ''
+                                )}
+                            />
+                            <Button
+                                variant='contained'
+                                color='error'
+                                disabled={!canExecute}
+                                onClick={handleExecute}
+                            >
+                                {globalize.translate('EmbyImportConfirm')}
+                            </Button>
+                        </Stack>
+                    )}
+
+                    {result && (
+                        <Button
+                            variant='contained'
+                            onClick={() => navigate(`/dashboard/users/${targetUserId}/profile`)}
+                        >
+                            {globalize.translate('ButtonOk')}
+                        </Button>
+                    )}
+                </Stack>
+            </Box>
+        </Page>
+    );
+};
+
+export default EmbyImportPage;
