diff --git a/src/apps/dashboard/features/embyImport/api/embyImportApi.ts b/src/apps/dashboard/features/embyImport/api/embyImportApi.ts
new file mode 100644
index 0000000000..3486f4b9b2
--- /dev/null
+++ b/src/apps/dashboard/features/embyImport/api/embyImportApi.ts
@@ -0,0 +1,275 @@
+import type { Api } from '@jellyfin/sdk';
+import type { AxiosRequestConfig } from 'axios';
+
+import type {
+    EmbyImportCounts,
+    EmbyImportResponse,
+    EmbyImportUploadInitResponse,
+    EmbyImportUploadResponse,
+    EmbyUploadFileKind,
+    EmbyUploadProgress,
+    EmbyUserInfo
+} from '../types';
+
+const camelCaseAccept =
+    'application/json; profile="CamelCase", application/json; profile=CamelCase, application/json';
+
+const jsonHeaders = (api: Api, options?: AxiosRequestConfig) => ({
+    ...options?.headers,
+    Accept: camelCaseAccept,
+    Authorization: api.authorizationHeader
+});
+
+const multipartHeaders = (api: Api, options?: AxiosRequestConfig) => {
+    const headers = {
+        ...jsonHeaders(api, options)
+    };
+    // Let the browser set multipart boundary; a JSON Content-Type breaks IFormFile binding.
+    delete (headers as Record<string, unknown>)['Content-Type'];
+    delete (headers as Record<string, unknown>)['content-type'];
+    return headers;
+};
+
+const asRecord = (value: unknown): Record<string, unknown> | null =>
+    value && typeof value === 'object' ? value as Record<string, unknown> : null;
+
+const pick = <T>(obj: Record<string, unknown>, ...keys: string[]): T | undefined => {
+    for (const key of keys) {
+        if (obj[key] !== undefined && obj[key] !== null) {
+            return obj[key] as T;
+        }
+    }
+    return undefined;
+};
+
+const normalizeUser = (raw: unknown): EmbyUserInfo | null => {
+    const obj = asRecord(raw);
+    if (!obj) {
+        return null;
+    }
+
+    const id = pick<number>(obj, 'id', 'Id');
+    const name = pick<string>(obj, 'name', 'Name');
+    const userDataCount = pick<number>(obj, 'userDataCount', 'UserDataCount') ?? 0;
+    if (typeof id !== 'number' || typeof name !== 'string') {
+        return null;
+    }
+
+    return { id, name, userDataCount };
+};
+
+const normalizeInitResponse = (raw: unknown): EmbyImportUploadInitResponse => {
+    const obj = asRecord(raw) || {};
+    return {
+        sessionId: pick<string>(obj, 'sessionId', 'SessionId') || '',
+        chunkSizeBytes: pick<number>(obj, 'chunkSizeBytes', 'ChunkSizeBytes') || 0
+    };
+};
+
+const normalizeUploadResponse = (raw: unknown): EmbyImportUploadResponse => {
+    const obj = asRecord(raw) || {};
+    const sessionId = pick<string>(obj, 'sessionId', 'SessionId') || '';
+    const usersRaw = pick<unknown[]>(obj, 'users', 'Users') || [];
+    const users = usersRaw.map(normalizeUser).filter((u): u is EmbyUserInfo => !!u);
+    return { sessionId, users };
+};
+
+const normalizeCounts = (raw: unknown): EmbyImportCounts => {
+    const obj = asRecord(raw) || {};
+    return {
+        matchedKeys: pick<number>(obj, 'matchedKeys', 'MatchedKeys') ?? 0,
+        unmatchedKeys: pick<number>(obj, 'unmatchedKeys', 'UnmatchedKeys') ?? 0,
+        matchedItems: pick<number>(obj, 'matchedItems', 'MatchedItems') ?? 0,
+        itemsNew: pick<number>(obj, 'itemsNew', 'ItemsNew') ?? 0,
+        itemsMerged: pick<number>(obj, 'itemsMerged', 'ItemsMerged') ?? 0,
+        sourceRows: pick<number>(obj, 'sourceRows', 'SourceRows') ?? 0
+    };
+};
+
+const normalizeImportResponse = (raw: unknown): EmbyImportResponse => {
+    const obj = asRecord(raw) || {};
+    return {
+        isPreview: !!pick<boolean>(obj, 'isPreview', 'IsPreview'),
+        counts: normalizeCounts(pick(obj, 'counts', 'Counts')),
+        warning: pick<string | null>(obj, 'warning', 'Warning') ?? null
+    };
+};
+
+const initEmbyUpload = async (
+    api: Api,
+    libraryDbBytes: number,
+    usersDbBytes: number,
+    options?: AxiosRequestConfig
+): Promise<EmbyImportUploadInitResponse> => {
+    const response = await api.axiosInstance.post(
+        '/Pgsql/Admin/EmbyImport/Upload/Init',
+        { libraryDbBytes, usersDbBytes },
+        {
+            ...options,
+            baseURL: api.basePath,
+            headers: jsonHeaders(api, options)
+        }
+    );
+    return normalizeInitResponse(response.data);
+};
+
+const uploadEmbyChunk = async (
+    api: Api,
+    sessionId: string,
+    file: EmbyUploadFileKind,
+    chunkIndex: number,
+    chunk: Blob,
+    options?: AxiosRequestConfig
+): Promise<void> => {
+    const form = new FormData();
+    form.append('sessionId', sessionId);
+    form.append('file', file);
+    form.append('chunkIndex', String(chunkIndex));
+    form.append('chunk', chunk, `${file}.part${chunkIndex}`);
+
+    await api.axiosInstance.put(
+        '/Pgsql/Admin/EmbyImport/Upload/Chunk',
+        form,
+        {
+            ...options,
+            baseURL: api.basePath,
+            headers: multipartHeaders(api, options)
+        }
+    );
+};
+
+const completeEmbyUpload = async (
+    api: Api,
+    sessionId: string,
+    options?: AxiosRequestConfig
+): Promise<EmbyImportUploadResponse> => {
+    const response = await api.axiosInstance.post(
+        '/Pgsql/Admin/EmbyImport/Upload/Complete',
+        { sessionId },
+        {
+            ...options,
+            baseURL: api.basePath,
+            headers: jsonHeaders(api, options)
+        }
+    );
+    return normalizeUploadResponse(response.data);
+};
+
+const uploadFileInChunks = async (
+    api: Api,
+    sessionId: string,
+    fileKind: EmbyUploadFileKind,
+    file: File,
+    chunkSizeBytes: number,
+    onProgress?: (progress: EmbyUploadProgress) => void,
+    options?: AxiosRequestConfig
+): Promise<void> => {
+    const totalChunks = Math.max(1, Math.ceil(file.size / chunkSizeBytes));
+    for (let chunkIndex = 0; chunkIndex < totalChunks; chunkIndex++) {
+        const start = chunkIndex * chunkSizeBytes;
+        const end = Math.min(start + chunkSizeBytes, file.size);
+        const blob = file.slice(start, end);
+        onProgress?.({ file: fileKind, chunkIndex: chunkIndex + 1, totalChunks });
+        await uploadEmbyChunk(api, sessionId, fileKind, chunkIndex, blob, options);
+    }
+};
+
+export const uploadEmbyDatabases = async (
+    api: Api,
+    libraryDb: File,
+    usersDb: File,
+    onProgress?: (progress: EmbyUploadProgress) => void,
+    options?: AxiosRequestConfig
+): Promise<EmbyImportUploadResponse> => {
+    let sessionId = '';
+    try {
+        const init = await initEmbyUpload(api, libraryDb.size, usersDb.size, options);
+        sessionId = init.sessionId;
+        if (!sessionId || init.chunkSizeBytes <= 0) {
+            throw new Error('Upload init failed.');
+        }
+
+        await uploadFileInChunks(
+            api,
+            sessionId,
+            'libraryDb',
+            libraryDb,
+            init.chunkSizeBytes,
+            onProgress,
+            options
+        );
+        await uploadFileInChunks(
+            api,
+            sessionId,
+            'usersDb',
+            usersDb,
+            init.chunkSizeBytes,
+            onProgress,
+            options
+        );
+
+        return await completeEmbyUpload(api, sessionId, options);
+    } catch (err) {
+        if (sessionId) {
+            try {
+                await discardEmbyImportSession(api, sessionId, options);
+            } catch {
+                // Best-effort cleanup; surface the original upload error.
+            }
+        }
+        throw err;
+    }
+};
+
+export const previewEmbyImport = async (
+    api: Api,
+    sessionId: string,
+    embyUserIds: number[],
+    targetUserId: string,
+    options?: AxiosRequestConfig
+): Promise<EmbyImportResponse> => {
+    const response = await api.axiosInstance.post(
+        '/Pgsql/Admin/EmbyImport/Preview',
+        { sessionId, embyUserIds, targetUserId },
+        {
+            ...options,
+            baseURL: api.basePath,
+            headers: jsonHeaders(api, options)
+        }
+    );
+    return normalizeImportResponse(response.data);
+};
+
+export const executeEmbyImport = async (
+    api: Api,
+    sessionId: string,
+    embyUserIds: number[],
+    targetUserId: string,
+    options?: AxiosRequestConfig
+): Promise<EmbyImportResponse> => {
+    const response = await api.axiosInstance.post(
+        '/Pgsql/Admin/EmbyImport/Execute',
+        { sessionId, embyUserIds, targetUserId },
+        {
+            ...options,
+            baseURL: api.basePath,
+            headers: jsonHeaders(api, options)
+        }
+    );
+    return normalizeImportResponse(response.data);
+};
+
+export const discardEmbyImportSession = async (
+    api: Api,
+    sessionId: string,
+    options?: AxiosRequestConfig
+): Promise<void> => {
+    await api.axiosInstance.delete(
+        `/Pgsql/Admin/EmbyImport/${encodeURIComponent(sessionId)}`,
+        {
+            ...options,
+            baseURL: api.basePath,
+            headers: jsonHeaders(api, options)
+        }
+    );
+};
