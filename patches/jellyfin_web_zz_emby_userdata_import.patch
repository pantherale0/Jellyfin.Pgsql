+export interface EmbyUserInfo {
+    id: number;
+    name: string;
+    userDataCount: number;
+}
+
+export interface EmbyImportUploadInitResponse {
+    sessionId: string;
+    chunkSizeBytes: number;
+}
+
+export interface EmbyImportUploadResponse {
+    sessionId: string;
+    users: EmbyUserInfo[];
+}
+
+export interface EmbyImportCounts {
+    matchedKeys: number;
+    unmatchedKeys: number;
+    matchedItems: number;
+    itemsNew: number;
+    itemsMerged: number;
+    sourceRows: number;
+}
+
+export interface EmbyImportResponse {
+    isPreview: boolean;
+    counts: EmbyImportCounts;
+    warning?: string | null;
+}
+
+export type EmbyUploadFileKind = 'libraryDb' | 'usersDb';
+
+export interface EmbyUploadProgress {
+    file: EmbyUploadFileKind;
+    chunkIndex: number;
+    totalChunks: number;
+}
