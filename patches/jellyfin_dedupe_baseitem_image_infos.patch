@@ -0,0 +1,99 @@
+using System;
+using System.Linq;
+using System.Text;
+using Jellyfin.Database.Implementations.Entities;
+using Jellyfin.Server.Implementations.Item;
+using MediaBrowser.Controller.Entities;
+using MediaBrowser.Model.Entities;
+using Xunit;
+
+namespace Jellyfin.Server.Implementations.Tests.Item;
+
+public class BaseItemMapperImageDedupeTests
+{
+    [Fact]
+    public void DeduplicateImageInfos_CollapsesSameTypeAndPath_PreferringPopulatedRow()
+    {
+        var blank = new ItemImageInfo
+        {
+            Type = ImageType.Primary,
+            Path = "/media/poster.jpg",
+            Width = 0,
+            Height = 0,
+            BlurHash = null
+        };
+        var populated = new ItemImageInfo
+        {
+            Type = ImageType.Primary,
+            Path = "/media/poster.jpg",
+            Width = 1920,
+            Height = 1080,
+            BlurHash = "LKO2?U%2Tw=w"
+        };
+        var backdrop = new ItemImageInfo
+        {
+            Type = ImageType.Backdrop,
+            Path = "/media/backdrop.jpg",
+            Width = 1280,
+            Height = 720
+        };
+
+        var result = BaseItemMapper.DeduplicateImageInfos([blank, populated, blank, backdrop]).ToArray();
+
+        Assert.Equal(2, result.Length);
+        var primary = Assert.Single(result, i => i.Type == ImageType.Primary);
+        Assert.Equal(1920, primary.Width);
+        Assert.Equal(1080, primary.Height);
+        Assert.Equal("LKO2?U%2Tw=w", primary.BlurHash);
+        Assert.Contains(result, i => i.Type == ImageType.Backdrop);
+    }
+
+    [Fact]
+    public void DeduplicateImageEntities_CollapsesSameTypeAndPath_PreferringPopulatedRow()
+    {
+        var itemId = Guid.NewGuid();
+        var blank = new BaseItemImageInfo
+        {
+            Id = Guid.NewGuid(),
+            ItemId = itemId,
+            Path = "/media/poster.jpg",
+            ImageType = ImageInfoImageType.Primary,
+            Width = 0,
+            Height = 0,
+            Blurhash = null,
+            Item = null!
+        };
+        var populated = new BaseItemImageInfo
+        {
+            Id = Guid.NewGuid(),
+            ItemId = itemId,
+            Path = "/media/poster.jpg",
+            ImageType = ImageInfoImageType.Primary,
+            Width = 600,
+            Height = 900,
+            Blurhash = Encoding.UTF8.GetBytes("hash"),
+            Item = null!
+        };
+
+        var result = BaseItemMapper.DeduplicateImageEntities([blank, populated, blank]).ToArray();
+
+        var kept = Assert.Single(result);
+        Assert.Equal(600, kept.Width);
+        Assert.Equal(900, kept.Height);
+        Assert.NotNull(kept.Blurhash);
+    }
+
+    [Fact]
+    public void DeduplicateImageInfos_AllowsSameTypeWithDifferentPaths()
+    {
+        var images = new[]
+        {
+            new ItemImageInfo { Type = ImageType.Backdrop, Path = "/a.jpg", Width = 1, Height = 1 },
+            new ItemImageInfo { Type = ImageType.Backdrop, Path = "/b.jpg", Width = 1, Height = 1 },
+        };
+
+        var result = BaseItemMapper.DeduplicateImageInfos(images).ToArray();
+
+        Assert.Equal(2, result.Length);
+    }
+}
