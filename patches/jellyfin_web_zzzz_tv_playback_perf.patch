index e1a6bb1bd2..7af9dcf8f4 100644
--- a/src/components/loading/loading.scss
+++ b/src/components/loading/loading.scss
@@ -277,3 +277,23 @@
     z-index: 9999999;
     contain: layout style size;
 }
+
+/* Single-layer spinner for TV / webOS — avoids MDL's multi-keyframe compositor cost. */
+.tvDocspinner {
+    display: none;
+    box-sizing: border-box;
+    border: 0.45vh solid rgba(255, 255, 255, 0.25);
+    border-top-color: #00a4dc;
+    border-radius: 50%;
+}
+
+.tvDocspinner.mdlSpinnerActive {
+    display: block;
+    animation: tv-docspinner-rotate 900ms linear infinite;
+}
+
+@keyframes tv-docspinner-rotate {
+    to {
+        transform: rotate(360deg);
+    }
+}
