 }
 
+function createLoader(): HTMLDivElement {
+    // Constrained TV / webOS clients choke on the multi-layer MDL keyframe stack.
+    return isTvClient() ? createTvLoader() : createMdlLoader();
+}
+
 export function show() {
     if (!loader) {
         loader = createLoader();
