+    private IQueryable<BaseItemEntity> ApplyDatePlayedOrder(
+        IQueryable<BaseItemEntity> query,
+        InternalItemsQuery filter,
+        JellyfinDbContext context,
+        (ItemSortBy OrderBy, SortOrder SortOrder)[] orderBy)
+    {
+        var userId = filter.User!.Id;
+
+        // Aggregate to one row per item so multi-key UserData does not fan out Continue Watching.
+        var resumableUserData = context.UserData
+            .AsNoTracking()
+            .Where(ud => ud.UserId == userId && ud.PlaybackPositionTicks > 0)
+            .GroupBy(ud => ud.ItemId)
+            .Select(g => new
+            {
+                ItemId = g.Key,
+                LastPlayedDate = g.Max(x => x.LastPlayedDate)
+            });
+
+        var joined = query.Join(
+            resumableUserData,
+            item => item.Id,
+            ud => ud.ItemId,
+            (item, ud) => new { Item = item, LastPlayedDate = ud.LastPlayedDate });
+
+        var dateSort = orderBy.First(o => o.OrderBy == ItemSortBy.DatePlayed);
+        var ordered = dateSort.SortOrder == SortOrder.Ascending
+            ? joined.OrderBy(x => x.LastPlayedDate)
+            : joined.OrderByDescending(x => x.LastPlayedDate);
+
+        return ordered.ThenBy(x => x.Item.SortName).Select(x => x.Item);
+    }
+
