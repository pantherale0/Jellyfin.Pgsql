+    /// <summary>
+    /// Removes tuner-origin Paths from client-facing media sources so players must use
+    /// <see cref="MediaSourceInfo.TranscodingUrl"/> or Jellyfin-hosted LiveStreamFiles URLs.
+    /// </summary>
+    /// <param name="mediaSource">The media source to sanitize in place.</param>
+    public void SanitizeLiveStreamClientPath(MediaSourceInfo mediaSource)
+    {
+        if (string.IsNullOrEmpty(mediaSource.LiveStreamId) || string.IsNullOrEmpty(mediaSource.Path))
+        {
+            return;
+        }
+
+        if (mediaSource.Path.Contains("/LiveTv/LiveStreamFiles/", StringComparison.OrdinalIgnoreCase))
+        {
+            return;
+        }
+
+        var pathHost = Uri.TryCreate(mediaSource.Path, UriKind.Absolute, out var uri) ? uri.Host : null;
+        _logger.LogInformation(
+            "Live stream path ClearedUnreachableOrigin PathHost={PathHost} MediaSourceId={MediaSourceId} LiveStreamId={LiveStreamId}",
+            pathHost,
+            mediaSource.Id,
+            mediaSource.LiveStreamId);
+        ClearUnreachableLiveStreamOriginPath(mediaSource);
+    }
+
+    private static void ClearUnreachableLiveStreamOriginPath(MediaSourceInfo mediaSource)
+    {
+        mediaSource.Path = null;
+        mediaSource.SupportsDirectPlay = false;
     }
 
