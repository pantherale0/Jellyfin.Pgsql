@@ -0,0 +1,44 @@
+using System;
+
+namespace Jellyfin.Database.Implementations.Entities;
+
+/// <summary>
+/// Precomputed similar-item row for Movies Recommendations (Because you watched / liked).
+/// </summary>
+public class UserTasteBecauseYouRecommendation
+{
+    /// <summary>
+    /// Gets or sets the user identifier.
+    /// </summary>
+    public Guid UserId { get; set; }
+
+    /// <summary>
+    /// Gets or sets the baseline item the category is based on.
+    /// </summary>
+    public Guid SourceItemId { get; set; }
+
+    /// <summary>
+    /// Gets or sets the 0-based rank within that source's similar list.
+    /// </summary>
+    public int Rank { get; set; }
+
+    /// <summary>
+    /// Gets or sets the source kind (<c>RecentlyPlayed</c> or <c>Liked</c>).
+    /// </summary>
+    public string SourceKind { get; set; } = string.Empty;
+
+    /// <summary>
+    /// Gets or sets the recommended item identifier.
+    /// </summary>
+    public Guid ItemId { get; set; }
+
+    /// <summary>
+    /// Gets or sets the similarity/taste score at materialization time.
+    /// </summary>
+    public int Score { get; set; }
+
+    /// <summary>
+    /// Gets or sets when this row was written (UTC).
+    /// </summary>
+    public DateTime UpdatedAt { get; set; }
+}
