--- /dev/null
+++ b/Emby.Server.Implementations/Images/LibraryImageParentalFilter.cs
@@ -0,0 +1,32 @@
+using System.Collections.Generic;
+using System.Linq;
+using MediaBrowser.Controller.Entities;
+using MediaBrowser.Controller.Library;
+
+namespace Emby.Server.Implementations.Images;
+
+/// <summary>
+/// Filters collage/splashscreen source items so shared library artwork never includes
+/// titles blocked by any user's parental controls (ratings and tags).
+/// </summary>
+public static class LibraryImageParentalFilter
+{
+    /// <summary>
+    /// Returns items that are parental-allowed for every user on the server.
+    /// </summary>
+    /// <param name="userManager">The user manager.</param>
+    /// <param name="items">Candidate items.</param>
+    /// <returns>Items safe for all users; unchanged when there are no users.</returns>
+    public static IReadOnlyList<BaseItem> FilterItemsSafeForAllUsers(IUserManager userManager, IEnumerable<BaseItem> items)
+    {
+        var users = userManager.GetUsers().ToArray();
+        if (users.Length == 0)
+        {
+            return items as IReadOnlyList<BaseItem> ?? items.ToList();
+        }
+
+        return items
+            .Where(item => users.All(user => item.IsParentalAllowed(user, skipAllowedTagsCheck: false)))
+            .ToList();
+    }
+}
