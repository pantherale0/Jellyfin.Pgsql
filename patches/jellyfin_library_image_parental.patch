diff --git a/Jellyfin.Server.Implementations/Events/Consumers/Library/LibraryImageParentalRefreshNotifier.cs b/Jellyfin.Server.Implementations/Events/Consumers/Library/LibraryImageParentalRefreshNotifier.cs
new file mode 100644
index 0000000000..452027ba63
--- /dev/null
+++ b/Jellyfin.Server.Implementations/Events/Consumers/Library/LibraryImageParentalRefreshNotifier.cs
@@ -0,0 +1,95 @@
+using System.Threading.Tasks;
+using Jellyfin.Data.Enums;
+using Jellyfin.Data.Events.Users;
+using MediaBrowser.Controller.Dto;
+using MediaBrowser.Controller.Entities;
+using MediaBrowser.Controller.Entities.Movies;
+using MediaBrowser.Controller.Events;
+using MediaBrowser.Controller.Library;
+using MediaBrowser.Controller.Providers;
+using MediaBrowser.Model.IO;
+using Microsoft.Extensions.Logging;
+
+namespace Jellyfin.Server.Implementations.Events.Consumers.Library;
+
+/// <summary>
+/// Regenerates shared library/collection images when parental controls change
+/// so My Media artwork does not keep restricted titles until the weekly refresh.
+/// </summary>
+public class LibraryImageParentalRefreshNotifier :
+    IEventConsumer<UserUpdatedEventArgs>,
+    IEventConsumer<UserDeletedEventArgs>
+{
+    private readonly ILibraryManager _libraryManager;
+    private readonly IProviderManager _providerManager;
+    private readonly IFileSystem _fileSystem;
+    private readonly ILogger<LibraryImageParentalRefreshNotifier> _logger;
+
+    /// <summary>
+    /// Initializes a new instance of the <see cref="LibraryImageParentalRefreshNotifier"/> class.
+    /// </summary>
+    /// <param name="libraryManager">The library manager.</param>
+    /// <param name="providerManager">The provider manager.</param>
+    /// <param name="fileSystem">The file system.</param>
+    /// <param name="logger">The logger.</param>
+    public LibraryImageParentalRefreshNotifier(
+        ILibraryManager libraryManager,
+        IProviderManager providerManager,
+        IFileSystem fileSystem,
+        ILogger<LibraryImageParentalRefreshNotifier> logger)
+    {
+        _libraryManager = libraryManager;
+        _providerManager = providerManager;
+        _fileSystem = fileSystem;
+        _logger = logger;
+    }
+
+    /// <inheritdoc />
+    public Task OnEvent(UserUpdatedEventArgs eventArgs)
+    {
+        QueueLibraryImageRefresh();
+        return Task.CompletedTask;
+    }
+
+    /// <inheritdoc />
+    public Task OnEvent(UserDeletedEventArgs eventArgs)
+    {
+        QueueLibraryImageRefresh();
+        return Task.CompletedTask;
+    }
+
+    private void QueueLibraryImageRefresh()
+    {
+        var refreshOptions = new MetadataRefreshOptions(new DirectoryService(_fileSystem))
+        {
+            MetadataRefreshMode = MetadataRefreshMode.FullRefresh,
+            ImageRefreshMode = MetadataRefreshMode.FullRefresh,
+            ForceSave = true
+        };
+
+        var items = _libraryManager.GetItemList(new InternalItemsQuery
+        {
+            IncludeItemTypes = [BaseItemKind.CollectionFolder, BaseItemKind.BoxSet],
+            Recursive = true,
+            DtoOptions = new DtoOptions(false)
+        });
+
+        var queued = 0;
+        foreach (var item in items)
+        {
+            // Only CollectionFolder and locked BoxSets use the dynamic parental-aware providers.
+            if (item is CollectionFolder || (item is BoxSet boxSet && boxSet.IsLocked))
+            {
+                _providerManager.QueueRefresh(item.Id, refreshOptions, RefreshPriority.Normal);
+                queued++;
+            }
+        }
+
+        if (queued > 0)
+        {
+            _logger.LogInformation(
+                "Queued image refresh for {Count} library/collection items after user parental-access change",
+                queued);
+        }
+    }
+}
