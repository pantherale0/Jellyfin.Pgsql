+import React, { useMemo, useState } from 'react';
+import Alert from '@mui/material/Alert';
+import Box from '@mui/material/Box';
+import Checkbox from '@mui/material/Checkbox';
+import CircularProgress from '@mui/material/CircularProgress';
+import FormControlLabel from '@mui/material/FormControlLabel';
+import MenuItem from '@mui/material/MenuItem';
+import Paper from '@mui/material/Paper';
+import Stack from '@mui/material/Stack';
+import TextField from '@mui/material/TextField';
+import Typography from '@mui/material/Typography';
+import { PieChart } from '@mui/x-charts/PieChart';
+import { useTheme } from '@mui/material/styles';
+import globalize from 'lib/globalize';
+
+import { usePlaybackDimensions, usePlaybackItems } from '../../api/usePlaybackStats';
+import { usePlaybackStatsFilters } from '../../context/PlaybackStatsFilterContext';
+import type { PlaybackItemGroupBy } from '../../types';
+import { formatTicks } from '../../utils/formatTicks';
+import RankedBarList from '../charts/RankedBarList';
+
+const BreakdownTab = () => {
+    const theme = useTheme();
+    const { apiFilters, filters } = usePlaybackStatsFilters();
+    const [ groupBy, setGroupBy ] = useState<PlaybackItemGroupBy>('Item');
+    const [ limit, setLimit ] = useState(10);
+    const [ includeOther, setIncludeOther ] = useState(true);
+    const items = usePlaybackItems({ ...apiFilters, groupBy, limit, includeOther });
+    const genres = usePlaybackDimensions('Genre', apiFilters);
+
+    const byMediaType = useMemo(() => {
+        const map = new Map<string, typeof items.data>();
+        for (const row of items.data ?? []) {
+            const list = map.get(row.MediaType) ?? [];
+            list.push(row);
+            map.set(row.MediaType, list);
+        }
+
+        return Array.from(map.entries()).sort(([ a ], [ b ]) => a.localeCompare(b));
+    }, [ items.data ]);
+
+    if (items.isLoading || genres.isLoading) {
+        return (
+            <Box display='flex' justifyContent='center' py={6}>
+                <CircularProgress />
+            </Box>
+        );
+    }
+
+    if (items.isError) {
+        return <Alert severity='error'>{globalize.translate('PlaybackStatsLoadError')}</Alert>;
+    }
+
+    return (
+        <Stack spacing={2}>
+            <Stack direction='row' spacing={2} flexWrap='wrap' useFlexGap alignItems='center'>
+                <TextField
+                    select
+                    size='small'
+                    label={globalize.translate('PlaybackStatsGroupBy')}
+                    value={groupBy}
+                    onChange={event => setGroupBy(event.target.value as PlaybackItemGroupBy)}
+                    sx={{ minWidth: 160 }}
+                >
+                    <MenuItem value='Item'>{globalize.translate('PlaybackStatsByItem')}</MenuItem>
+                    <MenuItem value='Series'>{globalize.translate('PlaybackStatsBySeries')}</MenuItem>
+                </TextField>
+                <TextField
+                    select
+                    size='small'
+                    label={globalize.translate('PlaybackStatsItemLimit')}
+                    value={limit}
+                    onChange={event => setLimit(Number(event.target.value))}
+                    sx={{ minWidth: 120 }}
+                >
+                    {[ 5, 10, 15, 20 ].map(value => (
+                        <MenuItem key={value} value={value}>{value}</MenuItem>
+                    ))}
+                </TextField>
+                <FormControlLabel
+                    control={(
+                        <Checkbox
+                            checked={includeOther}
+                            onChange={event => setIncludeOther(event.target.checked)}
+                        />
+                    )}
+                    label={globalize.translate('PlaybackStatsIncludeOther')}
+                />
+            </Stack>
+
+            {byMediaType.length === 0 && (
+                <Alert severity='info'>{globalize.translate('PlaybackStatsEmpty')}</Alert>
+            )}
+
+            {byMediaType.map(([ mediaType, rows ]) => {
+                const playSlices = (rows ?? []).map((row, index) => ({
+                    id: index,
+                    value: row.PlayCount,
+                    label: row.ItemName
+                }));
+                const timeItems = (rows ?? []).map(row => ({
+                    id: row.ItemId || row.ItemName,
+                    label: row.ItemName,
+                    value: filters.metric === 'PlayCount' ? row.PlayCount : row.TotalTicks,
+                    secondaryLabel: `${row.PlayCount} · ${formatTicks(row.TotalTicks)}`
+                }));
+
+                return (
+                    <Paper key={mediaType} sx={{ p: 2 }}>
+                        <Typography variant='h6' gutterBottom>{mediaType}</Typography>
+                        <Stack direction={{ xs: 'column', md: 'row' }} spacing={2}>
+                            <Box sx={{ flex: 1 }}>
+                                <Typography variant='subtitle2' gutterBottom>
+                                    {globalize.translate('LabelPlayCount')}
+                                </Typography>
+                                {playSlices.filter(s => s.value > 0).length >= 3 ? (
+                                    <PieChart
+                                        series={[{ data: playSlices }]}
+                                        height={240}
+                                        colors={[
+                                            theme.palette.primary.main,
+                                            theme.palette.secondary.main,
+                                            theme.palette.warning.main,
+                                            theme.palette.info.main,
+                                            theme.palette.success.main
+                                        ]}
+                                    />
+                                ) : (
+                                    <RankedBarList
+                                        items={timeItems}
+                                        valueFormatter={filters.metric === 'PlayCount' ? String : formatTicks}
+                                        height={240}
+                                    />
+                                )}
+                            </Box>
+                            <Box sx={{ flex: 1 }}>
+                                <Typography variant='subtitle2' gutterBottom>
+                                    {globalize.translate('LabelWatchTime')}
+                                </Typography>
+                                <RankedBarList
+                                    items={(rows ?? []).map(row => ({
+                                        id: `${row.ItemId || row.ItemName}-time`,
+                                        label: row.ItemName,
+                                        value: row.TotalTicks
+                                    }))}
+                                    valueFormatter={formatTicks}
+                                    height={240}
+                                />
+                            </Box>
+                        </Stack>
+                    </Paper>
+                );
+            })}
+
+            <Paper sx={{ p: 2 }}>
+                <Typography variant='subtitle1' gutterBottom>
+                    {globalize.translate('Genre')}
+                </Typography>
+                <RankedBarList
+                    items={(genres.data ?? []).slice(0, 15).map(row => ({
+                        id: row.Key,
+                        label: row.Key || 'Unknown',
+                        value: filters.metric === 'PlayCount' ? row.PlayCount : row.TotalTicks
+                    }))}
+                    valueFormatter={filters.metric === 'PlayCount' ? String : formatTicks}
+                    height={320}
+                />
+            </Paper>
+        </Stack>
+    );
+};
+
+export default BreakdownTab;
