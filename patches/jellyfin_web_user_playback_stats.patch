@@ -0,0 +1,174 @@
+import React, { useCallback, useMemo } from 'react';
+import Box from '@mui/material/Box';
+import Tab from '@mui/material/Tab';
+import Tabs from '@mui/material/Tabs';
+import Typography from '@mui/material/Typography';
+import Page from 'components/Page';
+import { useApi } from 'hooks/useApi';
+import { useUsersDetails } from 'hooks/useUsers';
+import globalize from 'lib/globalize';
+
+import {
+    fetchPlaybackDaily,
+    fetchPlaybackRecent
+} from 'apps/dashboard/features/playbackStatistics/api/playbackStatsApi';
+import {
+    usePlaybackDimensions,
+    useServerPlaybackStats
+} from 'apps/dashboard/features/playbackStatistics/api/usePlaybackStats';
+import PlaybackStatsFiltersBar from 'apps/dashboard/features/playbackStatistics/components/PlaybackStatsFilters';
+import BreakdownTab from 'apps/dashboard/features/playbackStatistics/components/tabs/BreakdownTab';
+import DeliveryTab from 'apps/dashboard/features/playbackStatistics/components/tabs/DeliveryTab';
+import OverviewTab from 'apps/dashboard/features/playbackStatistics/components/tabs/OverviewTab';
+import PatternsTab from 'apps/dashboard/features/playbackStatistics/components/tabs/PatternsTab';
+import RecentTab from 'apps/dashboard/features/playbackStatistics/components/tabs/RecentTab';
+import TrendsTab from 'apps/dashboard/features/playbackStatistics/components/tabs/TrendsTab';
+import UsersTab from 'apps/dashboard/features/playbackStatistics/components/tabs/UsersTab';
+import {
+    PlaybackStatsFilterProvider,
+    usePlaybackStatsFilters
+} from 'apps/dashboard/features/playbackStatistics/context/PlaybackStatsFilterContext';
+import type { PlaybackStatRow, PlaybackStatsTab } from 'apps/dashboard/features/playbackStatistics/types';
+import { exportCsv } from 'apps/dashboard/features/playbackStatistics/utils/exportCsv';
+import { formatTicks } from 'apps/dashboard/features/playbackStatistics/utils/formatTicks';
+
+const TAB_LABELS: Record<PlaybackStatsTab, string> = {
+    overview: 'PlaybackStatsTabOverview',
+    trends: 'PlaybackStatsTabTrends',
+    users: 'PlaybackStatsTabUsers',
+    breakdown: 'PlaybackStatsTabBreakdown',
+    patterns: 'PlaybackStatsTabPatterns',
+    delivery: 'PlaybackStatsTabDelivery',
+    recent: 'PlaybackStatsTabRecent'
+};
+
+const PlaybackStatisticsContent = () => {
+    const { api } = useApi();
+    const { tab, setTab, apiFilters, filters } = usePlaybackStatsFilters();
+    const { usersById: users } = useUsersDetails();
+    // Filter option sources only — export data is fetched on demand.
+    const mediaStats = useServerPlaybackStats(apiFilters);
+    const clients = usePlaybackDimensions('Client', apiFilters);
+
+    const userNameById = useMemo(() => {
+        const map: Record<string, string> = {};
+        for (const [ id, user ] of Object.entries(users)) {
+            if (user?.Name) {
+                map[id] = user.Name;
+            }
+        }
+
+        return map;
+    }, [ users ]);
+
+    const userOptions = useMemo(
+        () => Object.entries(users)
+            .map(([ id, user ]) => ({ id, name: user?.Name || id }))
+            .sort((a, b) => a.name.localeCompare(b.name)),
+        [ users ]
+    );
+
+    const availableMediaTypes = useMemo(
+        () => (mediaStats.data ?? []).map(row => row.MediaType).sort(),
+        [ mediaStats.data ]
+    );
+
+    const availableClients = useMemo(
+        () => (clients.data ?? []).map(row => row.Key).filter(Boolean).sort(),
+        [ clients.data ]
+    );
+
+    const onExport = useCallback(async () => {
+        if (!api) {
+            return;
+        }
+
+        if (tab === 'recent') {
+            const recent = await fetchPlaybackRecent(api, { ...apiFilters, startIndex: 0, limit: 200 });
+            exportCsv(
+                `playback-recent-${filters.startDate}-${filters.endDate}.csv`,
+                [ 'Date', 'User', 'Item', 'Series', 'MediaType', 'Ticks', 'PlayMethod', 'Client', 'Device' ],
+                (recent.Items ?? []).map(item => [
+                    item.DatePlayed,
+                    userNameById[item.UserId] || item.UserId,
+                    item.ItemName,
+                    item.SeriesName || '',
+                    item.MediaType,
+                    formatTicks(item.PlayedTicks),
+                    item.PlaybackMethod || '',
+                    item.ClientName || '',
+                    item.DeviceName || ''
+                ])
+            );
+            return;
+        }
+
+        const daily = await fetchPlaybackDaily(api, { ...apiFilters, groupBy: 'User' });
+        exportCsv(
+            `playback-daily-${filters.startDate}-${filters.endDate}.csv`,
+            [ 'Date', 'User', 'Ticks', 'PlayCount' ],
+            (daily ?? []).map(row => [
+                row.Date,
+                row.UserId ? (userNameById[row.UserId] || row.UserId) : '',
+                formatTicks(row.TotalTicks),
+                row.PlayCount
+            ])
+        );
+    }, [ api, apiFilters, filters.endDate, filters.startDate, tab, userNameById ]);
+
+    return (
+        <Page
+            id='playbackStatisticsPage'
+            title={globalize.translate('HeaderPlaybackStatistics')}
+            className='mainAnimatedPage type-interior'
+        >
+            <Box className='content-primary' sx={{ px: { xs: 1, md: 2 }, pb: 4 }}>
+                <Typography variant='h4' sx={{ mb: 2 }}>
+                    {globalize.translate('HeaderPlaybackStatistics')}
+                </Typography>
+
+                <PlaybackStatsFiltersBar
+                    availableMediaTypes={availableMediaTypes}
+                    availableClients={availableClients}
+                    userOptions={userOptions}
+                    onExport={() => {
+                        void onExport();
+                    }}
+                />
+
+                <Tabs
+                    value={tab}
+                    onChange={(_event, value: PlaybackStatsTab) => setTab(value)}
+                    variant='scrollable'
+                    scrollButtons='auto'
+                    sx={{ mb: 2, borderBottom: 1, borderColor: 'divider' }}
+                >
+                    {(Object.keys(TAB_LABELS) as PlaybackStatsTab[]).map(key => (
+                        <Tab key={key} value={key} label={globalize.translate(TAB_LABELS[key])} />
+                    ))}
+                </Tabs>
+
+                {tab === 'overview' && (
+                    <OverviewTab
+                        userNameById={userNameById}
+                        mediaStats={mediaStats.data as PlaybackStatRow[] | undefined}
+                    />
+                )}
+                {tab === 'trends' && <TrendsTab userNameById={userNameById} />}
+                {tab === 'users' && <UsersTab usersById={users} />}
+                {tab === 'breakdown' && <BreakdownTab />}
+                {tab === 'patterns' && <PatternsTab />}
+                {tab === 'delivery' && <DeliveryTab />}
+                {tab === 'recent' && <RecentTab usersById={users} />}
+            </Box>
+        </Page>
+    );
+};
+
+export const Component = () => (
+    <PlaybackStatsFilterProvider>
+        <PlaybackStatisticsContent />
+    </PlaybackStatsFilterProvider>
+);
+
+Component.displayName = 'PlaybackStatisticsPage';
