diff --git a/src/apps/dashboard/features/playbackStatistics/utils/formatTicks.ts b/src/apps/dashboard/features/playbackStatistics/utils/formatTicks.ts
new file mode 100644
index 0000000000..fb7a7ecf13
--- /dev/null
+++ b/src/apps/dashboard/features/playbackStatistics/utils/formatTicks.ts
@@ -0,0 +1,19 @@
+const TICKS_PER_SECOND = 10_000_000;
+
+export const ticksToSeconds = (ticks: number): number => ticks / TICKS_PER_SECOND;
+
+export const formatTicks = (ticks: number): string => {
+    const totalSeconds = Math.floor(ticksToSeconds(ticks));
+    const hours = Math.floor(totalSeconds / 3600);
+    const minutes = Math.floor((totalSeconds % 3600) / 60);
+
+    if (hours > 0) {
+        return `${hours}h ${minutes}m`;
+    }
+
+    if (minutes > 0) {
+        return `${minutes}m`;
+    }
+
+    return `${totalSeconds}s`;
+};
