@@ -0,0 +1,57 @@
+import { useQuery } from '@tanstack/react-query';
+
+import { useApi } from 'hooks/useApi';
+
+import {
+    fetchServerPlaybackStats,
+    fetchServerPlaybackStatsByUser,
+    fetchUserPlaybackStats,
+    fetchUserPlaybackStatsByType
+} from './playbackStatsApi';
+
+export const useUserPlaybackStats = (userId: string) => {
+    const { api } = useApi();
+
+    return useQuery({
+        queryKey: [ 'PlaybackStats', 'user', userId ],
+        queryFn: ({ signal }) => fetchUserPlaybackStats(api!, userId, { signal }),
+        enabled: !!api && !!userId,
+        refetchOnMount: false
+    });
+};
+
+export const useUserPlaybackStatsByType = (
+    userId: string,
+    mediaType: string | null
+) => {
+    const { api } = useApi();
+
+    return useQuery({
+        queryKey: [ 'PlaybackStats', 'user', userId, mediaType ],
+        queryFn: ({ signal }) => fetchUserPlaybackStatsByType(api!, userId, mediaType!, { signal }),
+        enabled: !!api && !!userId && !!mediaType,
+        refetchOnMount: false
+    });
+};
+
+export const useServerPlaybackStats = () => {
+    const { api } = useApi();
+
+    return useQuery({
+        queryKey: [ 'PlaybackStats', 'server' ],
+        queryFn: ({ signal }) => fetchServerPlaybackStats(api!, { signal }),
+        enabled: !!api,
+        refetchOnMount: false
+    });
+};
+
+export const useServerPlaybackStatsByUser = () => {
+    const { api } = useApi();
+
+    return useQuery({
+        queryKey: [ 'PlaybackStats', 'server', 'users' ],
+        queryFn: ({ signal }) => fetchServerPlaybackStatsByUser(api!, { signal }),
+        enabled: !!api,
+        refetchOnMount: false
+    });
+};
