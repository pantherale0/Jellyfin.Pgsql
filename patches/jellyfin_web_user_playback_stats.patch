+import React, { useMemo } from 'react';
+import Alert from '@mui/material/Alert';
+import Box from '@mui/material/Box';
+import CircularProgress from '@mui/material/CircularProgress';
+import Paper from '@mui/material/Paper';
+import Stack from '@mui/material/Stack';
+import Typography from '@mui/material/Typography';
+import { PieChart } from '@mui/x-charts/PieChart';
+import { useTheme } from '@mui/material/styles';
+import globalize from 'lib/globalize';
+
+import {
+    usePlaybackDaily,
+    usePlaybackOverview,
+    useServerPlaybackStatsByUser
+} from '../../api/usePlaybackStats';
+import { usePlaybackStatsFilters } from '../../context/PlaybackStatsFilterContext';
+import type { PlaybackStatRow } from '../../types';
+import { buildUserRows } from '../../utils/buildUserRows';
+import { formatTicks } from '../../utils/formatTicks';
+import CalendarHeatmap from '../charts/CalendarHeatmap';
+import MixAreaChart from '../charts/MixAreaChart';
+import RankedBarList from '../charts/RankedBarList';
+import KpiCard from '../KpiCard';
+
+interface OverviewTabProps {
+    userNameById: Record<string, string>;
+    mediaStats?: PlaybackStatRow[];
+}
+
+const OverviewTab = ({ userNameById, mediaStats }: OverviewTabProps) => {
+    const theme = useTheme();
+    const { apiFilters, filters, toggleUserId } = usePlaybackStatsFilters();
+    const overview = usePlaybackOverview(apiFilters);
+    const userStats = useServerPlaybackStatsByUser(apiFilters);
+    const daily = usePlaybackDaily({ ...apiFilters, groupBy: 'MediaType' });
+    const dailyForCalendar = usePlaybackDaily({ ...apiFilters, groupBy: 'None' });
+
+    const { userRows } = useMemo(() => buildUserRows(userStats.data), [ userStats.data ]);
+    const isLoading = overview.isLoading || userStats.isLoading || daily.isLoading;
+    const isError = overview.isError || userStats.isError || daily.isError;
+
+    if (isLoading) {
+        return (
+            <Box display='flex' justifyContent='center' py={6}>
+                <CircularProgress />
+            </Box>
+        );
+    }
+
+    if (isError || !overview.data) {
+        return <Alert severity='error'>{globalize.translate('PlaybackStatsLoadError')}</Alert>;
+    }
+
+    const { Current, Prior } = overview.data;
+    const pieData = (mediaStats ?? [])
+        .filter(row => row.TotalTicks > 0)
+        .map((row, index) => ({
+            id: index,
+            value: row.TotalTicks,
+            label: row.MediaType
+        }));
+
+    return (
+        <Stack spacing={2}>
+            <Stack direction='row' spacing={2} flexWrap='wrap' useFlexGap>
+                <KpiCard
+                    label={globalize.translate('LabelWatchTime')}
+                    value={formatTicks(Current.TotalTicks)}
+                    current={Current.TotalTicks}
+                    prior={Prior.TotalTicks}
+                    formatAbsolute={formatTicks}
+                />
+                <KpiCard
+                    label={globalize.translate('LabelPlayCount')}
+                    value={String(Current.PlayCount)}
+                    current={Current.PlayCount}
+                    prior={Prior.PlayCount}
+                />
+                <KpiCard
+                    label={globalize.translate('PlaybackStatsActiveUsers')}
+                    value={String(Current.ActiveUsers ?? 0)}
+                    current={Current.ActiveUsers ?? 0}
+                    prior={Prior.ActiveUsers ?? 0}
+                />
+                <KpiCard
+                    label={globalize.translate('PlaybackStatsAvgSession')}
+                    value={formatTicks(Current.AvgSessionTicks)}
+                    current={Current.AvgSessionTicks}
+                    prior={Prior.AvgSessionTicks}
+                    formatAbsolute={formatTicks}
+                />
+                <KpiCard
+                    label={globalize.translate('PlaybackStatsDirectPlay')}
+                    value={`${Current.DirectPlayPercent ?? 0}%`}
+                    current={Current.DirectPlayPercent ?? 0}
+                    prior={Prior.DirectPlayPercent ?? 0}
+                />
+                <KpiCard
+                    label={globalize.translate('PlaybackStatsDirectStream')}
+                    value={`${Current.DirectStreamPercent ?? 0}%`}
+                    current={Current.DirectStreamPercent ?? 0}
+                    prior={Prior.DirectStreamPercent ?? 0}
+                />
+            </Stack>
+
+            <Stack direction={{ xs: 'column', lg: 'row' }} spacing={2}>
+                <Paper sx={{ p: 2, flex: 2 }}>
+                    <Typography variant='subtitle1' gutterBottom>
+                        {globalize.translate('PlaybackStatsMediaMix')}
+                    </Typography>
+                    <MixAreaChart
+                        rows={daily.data ?? []}
+                        metric={filters.metric}
+                        activityOnly={filters.activityOnly}
+                    />
+                </Paper>
+                <Paper sx={{ p: 2, flex: 1 }}>
+                    <Typography variant='subtitle1' gutterBottom>
+                        {globalize.translate('LabelMediaType')}
+                    </Typography>
+                    {pieData.length >= 3 ? (
+                        <PieChart
+                            series={[{
+                                data: pieData,
+                                valueFormatter: item => formatTicks(Number(item.value))
+                            }]}
+                            height={260}
+                            colors={[
+                                theme.palette.primary.main,
+                                theme.palette.secondary.main,
+                                theme.palette.success.main,
+                                theme.palette.warning.main,
+                                theme.palette.info.main
+                            ]}
+                        />
+                    ) : (
+                        <RankedBarList
+                            items={(mediaStats ?? []).map(row => ({
+                                id: row.MediaType,
+                                label: row.MediaType,
+                                value: row.TotalTicks,
+                                secondaryLabel: `${row.PlayCount} plays`
+                            }))}
+                            valueFormatter={formatTicks}
+                            height={260}
+                        />
+                    )}
+                </Paper>
+            </Stack>
+
+            <Stack direction={{ xs: 'column', lg: 'row' }} spacing={2}>
+                <Paper sx={{ p: 2, flex: 2 }}>
+                    <Typography variant='subtitle1' gutterBottom>
+                        {globalize.translate('PlaybackStatsTopUsers')}
+                    </Typography>
+                    <RankedBarList
+                        items={userRows.slice(0, 10).map(row => ({
+                            id: row.userId,
+                            label: userNameById[row.userId] || row.userId.slice(0, 8),
+                            value: filters.metric === 'PlayCount' ? row.playCount : row.totalTicks
+                        }))}
+                        valueFormatter={filters.metric === 'PlayCount' ? String : formatTicks}
+                        onItemClick={toggleUserId}
+                        height={300}
+                    />
+                </Paper>
+                <Paper sx={{ p: 2, flex: 1 }}>
+                    <CalendarHeatmap
+                        rows={dailyForCalendar.data ?? []}
+                        startDate={filters.startDate}
+                        endDate={filters.endDate}
+                        metric={filters.metric === 'PlayCount' ? 'PlayCount' : 'TotalTicks'}
+                    />
+                </Paper>
+            </Stack>
+        </Stack>
+    );
+};
+
+export default OverviewTab;
