+import React from 'react';
+import Alert from '@mui/material/Alert';
+import Box from '@mui/material/Box';
+import CircularProgress from '@mui/material/CircularProgress';
+import Paper from '@mui/material/Paper';
+import Stack from '@mui/material/Stack';
+import Typography from '@mui/material/Typography';
+import globalize from 'lib/globalize';
+
+import { usePlaybackDimensions } from '../../api/usePlaybackStats';
+import { usePlaybackStatsFilters } from '../../context/PlaybackStatsFilterContext';
+import { formatTicks } from '../../utils/formatTicks';
+import RankedBarList from '../charts/RankedBarList';
+
+const DeliveryTab = () => {
+    const { apiFilters, filters, toggleClient, togglePlaybackMethod } = usePlaybackStatsFilters();
+    const methods = usePlaybackDimensions('Method', apiFilters);
+    const reasons = usePlaybackDimensions('TranscodeReason', apiFilters);
+    const clients = usePlaybackDimensions('Client', apiFilters);
+    const devices = usePlaybackDimensions('Device', apiFilters);
+
+    const isLoading = methods.isLoading || reasons.isLoading || clients.isLoading || devices.isLoading;
+    const isError = methods.isError || reasons.isError || clients.isError || devices.isError;
+
+    if (isLoading) {
+        return (
+            <Box display='flex' justifyContent='center' py={6}>
+                <CircularProgress />
+            </Box>
+        );
+    }
+
+    if (isError) {
+        return <Alert severity='error'>{globalize.translate('PlaybackStatsLoadError')}</Alert>;
+    }
+
+    const toItems = (rows: typeof methods.data) => (rows ?? []).map(row => ({
+        id: row.Key,
+        label: row.Key || 'Unknown',
+        value: filters.metric === 'PlayCount' ? row.PlayCount : row.TotalTicks,
+        secondaryLabel: `${row.PlayCount} · ${formatTicks(row.TotalTicks)}`
+    }));
+
+    return (
+        <Stack spacing={2}>
+            <Paper sx={{ p: 2 }}>
+                <Typography variant='subtitle1' gutterBottom>
+                    {globalize.translate('PlaybackStatsPlaybackMethod')}
+                </Typography>
+                <RankedBarList
+                    items={toItems(methods.data)}
+                    valueFormatter={filters.metric === 'PlayCount' ? String : formatTicks}
+                    onItemClick={togglePlaybackMethod}
+                    height={280}
+                />
+            </Paper>
+
+            <Paper sx={{ p: 2 }}>
+                <Typography variant='subtitle1' gutterBottom>
+                    {globalize.translate('PlaybackStatsTranscodeReasons')}
+                </Typography>
+                <Typography variant='body2' color='text.secondary' sx={{ mb: 1 }}>
+                    {globalize.translate('PlaybackStatsTranscodeReasonsHelp')}
+                </Typography>
+                <RankedBarList
+                    items={toItems(reasons.data)}
+                    valueFormatter={filters.metric === 'PlayCount' ? String : formatTicks}
+                    height={280}
+                />
+            </Paper>
+
+            <Stack direction={{ xs: 'column', md: 'row' }} spacing={2}>
+                <Paper sx={{ p: 2, flex: 1 }}>
+                    <Typography variant='subtitle1' gutterBottom>
+                        {globalize.translate('PlaybackStatsClients')}
+                    </Typography>
+                    <RankedBarList
+                        items={toItems(clients.data)}
+                        valueFormatter={filters.metric === 'PlayCount' ? String : formatTicks}
+                        onItemClick={toggleClient}
+                        height={300}
+                    />
+                </Paper>
+                <Paper sx={{ p: 2, flex: 1 }}>
+                    <Typography variant='subtitle1' gutterBottom>
+                        {globalize.translate('HeaderDevices')}
+                    </Typography>
+                    <RankedBarList
+                        items={toItems(devices.data)}
+                        valueFormatter={filters.metric === 'PlayCount' ? String : formatTicks}
+                        height={300}
+                    />
+                </Paper>
+            </Stack>
+        </Stack>
+    );
+};
+
+export default DeliveryTab;
