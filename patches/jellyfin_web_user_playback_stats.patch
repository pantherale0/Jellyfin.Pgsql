+    fetchPlaybackDaily,
+    fetchPlaybackDimensions,
+    fetchPlaybackHourly,
+    fetchPlaybackItems,
+    fetchPlaybackOverview,
+    fetchPlaybackRecent,
+    fetchPlaybackSessions,
+    fetchServerPlaybackStats,
+    fetchServerPlaybackStatsByUser,
+    fetchUserPlaybackHourly,
+    fetchUserPlaybackOverview,
+    fetchUserPlaybackStats,
+    fetchUserPlaybackStatsByType
+} from './playbackStatsApi';
+
+const filterKey = (filters?: Partial<PlaybackStatsFilters>) => ({
+    startDate: filters?.startDate,
+    endDate: filters?.endDate,
+    userIds: filters?.userIds,
+    mediaTypes: filters?.mediaTypes,
+    clients: filters?.clients,
+    playbackMethods: filters?.playbackMethods
+});
+
+export const useUserPlaybackStats = (
+    userId: string,
+    filters?: Pick<PlaybackStatsFilters, 'startDate' | 'endDate'>
+) => {
+    const { api } = useApi();
+
+    return useQuery({
+        queryKey: [ 'PlaybackStats', 'user', userId, filterKey(filters) ],
+        queryFn: ({ signal }) => fetchUserPlaybackStats(api!, userId, filters, { signal }),
+        enabled: !!api && !!userId,
+        refetchOnMount: false
+    });
+};
+
+export const useUserPlaybackStatsByType = (
+    userId: string,
