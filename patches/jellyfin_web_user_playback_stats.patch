+import React, { useMemo } from 'react';
+import Box from '@mui/material/Box';
+import Tooltip from '@mui/material/Tooltip';
+import Typography from '@mui/material/Typography';
+import { alpha, useTheme } from '@mui/material/styles';
+
+import type { PlaybackHourlyRow } from '../../types';
+import { formatTicks } from '../../utils/formatTicks';
+
+const DAY_LABELS = [ 'Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat' ];
+
+interface DayHourHeatmapProps {
+    rows: PlaybackHourlyRow[];
+    metric?: 'TotalTicks' | 'PlayCount';
+}
+
+const DayHourHeatmap = ({ rows, metric = 'TotalTicks' }: DayHourHeatmapProps) => {
+    const theme = useTheme();
+    const { grid, max } = useMemo(() => {
+        const map = new Map<string, number>();
+        let localMax = 0;
+        for (const row of rows) {
+            const value = metric === 'PlayCount' ? row.PlayCount : row.TotalTicks;
+            map.set(`${row.DayOfWeek}-${row.Hour}`, value);
+            localMax = Math.max(localMax, value);
+        }
+
+        return { grid: map, max: localMax };
+    }, [ metric, rows ]);
+
+    return (
+        <Box>
+            <Box
+                sx={{
+                    display: 'grid',
+                    gridTemplateColumns: '40px repeat(24, minmax(10px, 1fr))',
+                    gap: 0.4,
+                    alignItems: 'center'
+                }}
+            >
+                <Box />
+                {Array.from({ length: 24 }, (_, hour) => (
+                    <Typography
+                        key={`h-${hour}`}
+                        variant='caption'
+                        color='text.secondary'
+                        sx={{ textAlign: 'center', fontSize: '0.65rem' }}
+                    >
+                        {hour % 3 === 0 ? hour : ''}
+                    </Typography>
+                ))}
+                {DAY_LABELS.map((label, day) => (
+                    <React.Fragment key={label}>
+                        <Typography variant='caption' color='text.secondary'>
+                            {label}
+                        </Typography>
+                        {Array.from({ length: 24 }, (_, hour) => {
+                            const value = grid.get(`${day}-${hour}`) ?? 0;
+                            const intensity = max > 0 ? value / max : 0;
+                            const bg = intensity === 0
+                                ? alpha(theme.palette.action.hover, 0.35)
+                                : alpha(theme.palette.primary.main, 0.15 + intensity * 0.85);
+                            const title = metric === 'PlayCount'
+                                ? `${label} ${hour}:00 — ${value} plays`
+                                : `${label} ${hour}:00 — ${formatTicks(value)}`;
+
+                            return (
+                                <Tooltip key={`${day}-${hour}`} title={title}>
+                                    <Box
+                                        sx={{
+                                            aspectRatio: '1',
+                                            borderRadius: 0.5,
+                                            bgcolor: bg,
+                                            minHeight: 14
+                                        }}
+                                    />
+                                </Tooltip>
+                            );
+                        })}
+                    </React.Fragment>
+                ))}
+            </Box>
+        </Box>
+    );
+};
+
+export default DayHourHeatmap;
