@@ -0,0 +1,56 @@
+import type { ApiClient } from 'jellyfin-apiclient';
+
+import type {
+    PlaybackStatRow,
+    PlaybackSubGroupStatRow,
+    PlaybackUserStatRow
+} from '../types';
+
+const getAuthHeaders = (apiClient: ApiClient) => ({
+    'X-MediaBrowser-Token': apiClient.accessToken(),
+    'Content-Type': 'application/json'
+});
+
+const fetchJson = async <T>(url: string, apiClient: ApiClient): Promise<T> => {
+    const token = apiClient.accessToken();
+    const response = await fetch(`${url}?api_key=${token}`, {
+        headers: getAuthHeaders(apiClient)
+    });
+
+    if (!response.ok) {
+        throw new Error(`Request failed: ${response.status}`);
+    }
+
+    return response.json();
+};
+
+export const fetchUserPlaybackStats = (
+    apiClient: ApiClient,
+    userId: string
+): Promise<PlaybackStatRow[]> => fetchJson(
+    `${apiClient.serverAddress()}/Users/${userId}/PlaybackStats`,
+    apiClient
+);
+
+export const fetchUserPlaybackStatsByType = (
+    apiClient: ApiClient,
+    userId: string,
+    mediaType: string
+): Promise<PlaybackSubGroupStatRow[]> => fetchJson(
+    `${apiClient.serverAddress()}/Users/${userId}/PlaybackStats/${encodeURIComponent(mediaType)}`,
+    apiClient
+);
+
+export const fetchServerPlaybackStats = (
+    apiClient: ApiClient
+): Promise<PlaybackStatRow[]> => fetchJson(
+    `${apiClient.serverAddress()}/PlaybackStats`,
+    apiClient
+);
+
+export const fetchServerPlaybackStatsByUser = (
+    apiClient: ApiClient
+): Promise<PlaybackUserStatRow[]> => fetchJson(
+    `${apiClient.serverAddress()}/PlaybackStats/Users`,
+    apiClient
+);
diff --git a/src/apps/dashboard/features/playbackStatistics/api/usePlaybackStats.ts b/src/apps/dashboard/features/playbackStatistics/api/usePlaybackStats.ts
