@@ -0,0 +1,56 @@
+export interface PeriodDelta {
+    absolute: number;
+    percent: number | null;
+    direction: 'up' | 'down' | 'flat';
+}
+
+export const computeDelta = (current: number, prior: number): PeriodDelta => {
+    const absolute = current - prior;
+    if (prior === 0) {
+        return {
+            absolute,
+            percent: current === 0 ? 0 : null,
+            direction: absolute > 0 ? 'up' : absolute < 0 ? 'down' : 'flat'
+        };
+    }
+
+    const percent = (absolute / prior) * 100;
+    return {
+        absolute,
+        percent,
+        direction: absolute > 0 ? 'up' : absolute < 0 ? 'down' : 'flat'
+    };
+};
+
+export const formatDeltaPercent = (delta: PeriodDelta): string => {
+    if (delta.percent == null) {
+        return delta.absolute > 0 ? 'new' : '—';
+    }
+
+    const sign = delta.percent > 0 ? '+' : '';
+    return `${sign}${delta.percent.toFixed(0)}%`;
+};
+
+export const toDateInputValue = (date: Date): string => {
+    const y = date.getUTCFullYear();
+    const m = String(date.getUTCMonth() + 1).padStart(2, '0');
+    const d = String(date.getUTCDate()).padStart(2, '0');
+    return `${y}-${m}-${d}`;
+};
+
+export const defaultRange = (days = 28): { startDate: string; endDate: string } => {
+    const end = new Date();
+    end.setUTCHours(0, 0, 0, 0);
+    const start = new Date(end);
+    start.setUTCDate(start.getUTCDate() - (days - 1));
+    return {
+        startDate: toDateInputValue(start),
+        endDate: toDateInputValue(end)
+    };
+};
+
+export const dayCountInclusive = (startDate: string, endDate: string): number => {
+    const start = new Date(`${startDate}T00:00:00Z`);
+    const end = new Date(`${endDate}T00:00:00Z`);
+    return Math.max(1, Math.round((end.getTime() - start.getTime()) / 86_400_000) + 1);
+};
