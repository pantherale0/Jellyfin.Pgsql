+import React, { useMemo, useState } from 'react';
+import Alert from '@mui/material/Alert';
+import Box from '@mui/material/Box';
+import CircularProgress from '@mui/material/CircularProgress';
+import MenuItem from '@mui/material/MenuItem';
+import Paper from '@mui/material/Paper';
+import Stack from '@mui/material/Stack';
+import TextField from '@mui/material/TextField';
+import Typography from '@mui/material/Typography';
+import globalize from 'lib/globalize';
+
+import { usePlaybackDaily } from '../../api/usePlaybackStats';
+import { usePlaybackStatsFilters } from '../../context/PlaybackStatsFilterContext';
+import type { PlaybackDailyGroupBy } from '../../types';
+import MixAreaChart from '../charts/MixAreaChart';
+import StackedDailyChart from '../charts/StackedDailyChart';
+
+interface TrendsTabProps {
+    userNameById: Record<string, string>;
+}
+
+const TrendsTab = ({ userNameById }: TrendsTabProps) => {
+    const { apiFilters, filters, toggleUserId } = usePlaybackStatsFilters();
+    const [ groupBy, setGroupBy ] = useState<PlaybackDailyGroupBy>('User');
+    const daily = usePlaybackDaily({ ...apiFilters, groupBy });
+    const mix = usePlaybackDaily({ ...apiFilters, groupBy: 'MediaType' });
+
+    const labelResolver = useMemo(() => (
+        (key: string) => (groupBy === 'User' ? (userNameById[key] || key.slice(0, 8)) : key)
+    ), [ groupBy, userNameById ]);
+
+    if (daily.isLoading || mix.isLoading) {
+        return (
+            <Box display='flex' justifyContent='center' py={6}>
+                <CircularProgress />
+            </Box>
+        );
+    }
+
+    if (daily.isError) {
+        return <Alert severity='error'>{globalize.translate('PlaybackStatsLoadError')}</Alert>;
+    }
+
+    return (
+        <Stack spacing={2}>
+            <Stack direction='row' spacing={2} alignItems='center'>
+                <TextField
+                    select
+                    size='small'
+                    label={globalize.translate('PlaybackStatsGroupBy')}
+                    value={groupBy}
+                    onChange={event => setGroupBy(event.target.value as PlaybackDailyGroupBy)}
+                    sx={{ minWidth: 180 }}
+                >
+                    <MenuItem value='User'>{globalize.translate('LabelUser')}</MenuItem>
+                    <MenuItem value='MediaType'>{globalize.translate('LabelMediaType')}</MenuItem>
+                </TextField>
+            </Stack>
+
+            <Paper sx={{ p: 2 }}>
+                <Typography variant='subtitle1' gutterBottom>
+                    {globalize.translate('PlaybackStatsDailyTrend')}
+                </Typography>
+                <StackedDailyChart
+                    rows={daily.data ?? []}
+                    seriesKey={groupBy === 'User' ? 'UserId' : 'MediaType'}
+                    labelResolver={labelResolver}
+                    metric={filters.metric}
+                    activityOnly={filters.activityOnly}
+                    onSeriesClick={groupBy === 'User' ? toggleUserId : undefined}
+                />
+            </Paper>
+
+            <Paper sx={{ p: 2 }}>
+                <Typography variant='subtitle1' gutterBottom>
+                    {globalize.translate('PlaybackStatsMediaMix')}
+                </Typography>
+                <MixAreaChart
+                    rows={mix.data ?? []}
+                    metric={filters.metric}
+                    activityOnly={filters.activityOnly}
+                />
+            </Paper>
+        </Stack>
+    );
+};
+
+export default TrendsTab;
