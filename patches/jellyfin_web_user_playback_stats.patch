@@ -0,0 +1,196 @@
+import React, {
+    createContext,
+    useCallback,
+    useContext,
+    useMemo,
+    useState,
+    type ReactNode
+} from 'react';
+import { useSearchParams } from 'react-router-dom';
+
+import type { PlaybackMetric, PlaybackStatsFilters, PlaybackStatsTab } from '../types';
+import { defaultRange } from '../utils/periodCompare';
+
+interface PlaybackStatsFilterContextValue {
+    tab: PlaybackStatsTab;
+    setTab: (tab: PlaybackStatsTab) => void;
+    filters: PlaybackStatsFilters;
+    apiFilters: Omit<PlaybackStatsFilters, 'activityOnly' | 'metric'>;
+    setPresetDays: (days: number) => void;
+    setDateRange: (startDate: string, endDate: string) => void;
+    toggleUserId: (userId: string) => void;
+    setUserIds: (userIds: string[]) => void;
+    toggleMediaType: (mediaType: string) => void;
+    setMediaTypes: (mediaTypes: string[]) => void;
+    toggleClient: (client: string) => void;
+    togglePlaybackMethod: (method: string) => void;
+    setActivityOnly: (value: boolean) => void;
+    setMetric: (metric: PlaybackMetric) => void;
+    clearFilters: () => void;
+}
+
+const TAB_VALUES: PlaybackStatsTab[] = [
+    'overview',
+    'trends',
+    'users',
+    'breakdown',
+    'patterns',
+    'delivery',
+    'recent'
+];
+
+const PlaybackStatsFilterContext = createContext<PlaybackStatsFilterContextValue | null>(null);
+
+const parseList = (value: string | null): string[] => (
+    value ? value.split(',').map(part => part.trim()).filter(Boolean) : []
+);
+
+const isTab = (value: string | null): value is PlaybackStatsTab => (
+    !!value && TAB_VALUES.includes(value as PlaybackStatsTab)
+);
+
+export const PlaybackStatsFilterProvider = ({ children }: { children: ReactNode }) => {
+    const [ searchParams, setSearchParams ] = useSearchParams();
+    const defaults = useMemo(() => defaultRange(28), []);
+
+    const tab = isTab(searchParams.get('tab')) ? searchParams.get('tab') as PlaybackStatsTab : 'overview';
+    const [ activityOnly, setActivityOnlyState ] = useState(true);
+    const [ metric, setMetricState ] = useState<PlaybackMetric>(
+        searchParams.get('metric') === 'PlayCount' ? 'PlayCount' : 'PlayTime'
+    );
+
+    const filters: PlaybackStatsFilters = useMemo(() => ({
+        startDate: searchParams.get('start') || defaults.startDate,
+        endDate: searchParams.get('end') || defaults.endDate,
+        userIds: parseList(searchParams.get('users')),
+        mediaTypes: parseList(searchParams.get('mediaTypes')),
+        clients: parseList(searchParams.get('clients')),
+        playbackMethods: parseList(searchParams.get('methods')),
+        activityOnly,
+        metric
+    }), [ activityOnly, defaults.endDate, defaults.startDate, metric, searchParams ]);
+
+    const patchParams = useCallback((mutate: (params: URLSearchParams) => void) => {
+        setSearchParams(prev => {
+            const next = new URLSearchParams(prev);
+            mutate(next);
+            return next;
+        }, { replace: true });
+    }, [ setSearchParams ]);
+
+    const setTab = useCallback((next: PlaybackStatsTab) => {
+        patchParams(params => {
+            params.set('tab', next);
+        });
+    }, [ patchParams ]);
+
+    const setPresetDays = useCallback((days: number) => {
+        const range = defaultRange(days);
+        patchParams(params => {
+            params.set('start', range.startDate);
+            params.set('end', range.endDate);
+        });
+    }, [ patchParams ]);
+
+    const setDateRange = useCallback((startDate: string, endDate: string) => {
+        patchParams(params => {
+            params.set('start', startDate);
+            params.set('end', endDate);
+        });
+    }, [ patchParams ]);
+
+    const setListParam = useCallback((key: string, values: string[]) => {
+        patchParams(params => {
+            if (values.length === 0) {
+                params.delete(key);
+            } else {
+                params.set(key, values.join(','));
+            }
+        });
+    }, [ patchParams ]);
+
+    const toggleInList = useCallback((key: string, current: string[], value: string) => {
+        const next = current.includes(value)
+            ? current.filter(item => item !== value)
+            : [ ...current, value ];
+        setListParam(key, next);
+    }, [ setListParam ]);
+
+    const clearFilters = useCallback(() => {
+        const range = defaultRange(28);
+        setActivityOnlyState(true);
+        setMetricState('PlayTime');
+        setSearchParams(prev => {
+            const next = new URLSearchParams();
+            const currentTab = prev.get('tab');
+            if (currentTab) {
+                next.set('tab', currentTab);
+            }
+            next.set('start', range.startDate);
+            next.set('end', range.endDate);
+            return next;
+        }, { replace: true });
+    }, [ setSearchParams ]);
+
+    const apiFilters = useMemo(() => ({
+        startDate: filters.startDate,
+        endDate: filters.endDate,
+        userIds: filters.userIds,
+        mediaTypes: filters.mediaTypes,
+        clients: filters.clients,
+        playbackMethods: filters.playbackMethods
+    }), [ filters ]);
+
+    const value = useMemo<PlaybackStatsFilterContextValue>(() => ({
+        tab,
+        setTab,
+        filters,
+        apiFilters,
+        setPresetDays,
+        setDateRange,
+        toggleUserId: userId => toggleInList('users', filters.userIds, userId),
+        setUserIds: userIds => setListParam('users', userIds),
+        toggleMediaType: mediaType => toggleInList('mediaTypes', filters.mediaTypes, mediaType),
+        setMediaTypes: mediaTypes => setListParam('mediaTypes', mediaTypes),
+        toggleClient: client => toggleInList('clients', filters.clients, client),
+        togglePlaybackMethod: method => toggleInList('methods', filters.playbackMethods, method),
+        setActivityOnly: setActivityOnlyState,
+        setMetric: next => {
+            setMetricState(next);
+            patchParams(params => {
+                if (next === 'PlayTime') {
+                    params.delete('metric');
+                } else {
+                    params.set('metric', next);
+                }
+            });
+        },
+        clearFilters
+    }), [
+        apiFilters,
+        clearFilters,
+        filters,
+        patchParams,
+        setDateRange,
+        setListParam,
+        setPresetDays,
+        setTab,
+        tab,
+        toggleInList
+    ]);
+
+    return (
+        <PlaybackStatsFilterContext.Provider value={value}>
+            {children}
+        </PlaybackStatsFilterContext.Provider>
+    );
+};
+
+export const usePlaybackStatsFilters = (): PlaybackStatsFilterContextValue => {
+    const ctx = useContext(PlaybackStatsFilterContext);
+    if (!ctx) {
+        throw new Error('usePlaybackStatsFilters must be used within PlaybackStatsFilterProvider');
+    }
+
+    return ctx;
+};
