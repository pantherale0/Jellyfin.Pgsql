+import React from 'react';
+import Box from '@mui/material/Box';
+import Button from '@mui/material/Button';
+import ButtonGroup from '@mui/material/ButtonGroup';
+import Checkbox from '@mui/material/Checkbox';
+import Chip from '@mui/material/Chip';
+import FormControlLabel from '@mui/material/FormControlLabel';
+import MenuItem from '@mui/material/MenuItem';
+import Paper from '@mui/material/Paper';
+import Stack from '@mui/material/Stack';
+import TextField from '@mui/material/TextField';
+import Typography from '@mui/material/Typography';
+import globalize from 'lib/globalize';
+
+import { usePlaybackStatsFilters } from '../context/PlaybackStatsFilterContext';
+import { dayCountInclusive } from '../utils/periodCompare';
+
+interface PlaybackStatsFiltersProps {
+    availableMediaTypes: string[];
+    availableClients: string[];
+    userOptions: Array<{ id: string; name: string }>;
+    onExport?: () => void;
+}
+
+const PlaybackStatsFiltersBar = ({
+    availableMediaTypes,
+    availableClients,
+    userOptions,
+    onExport
+}: PlaybackStatsFiltersProps) => {
+    const {
+        filters,
+        setPresetDays,
+        setDateRange,
+        setUserIds,
+        toggleMediaType,
+        toggleClient,
+        setActivityOnly,
+        setMetric,
+        clearFilters
+    } = usePlaybackStatsFilters();
+
+    const days = dayCountInclusive(filters.startDate, filters.endDate);
+
+    return (
+        <Paper sx={{ p: 2, mb: 2 }}>
+            <Stack spacing={2}>
+                <Stack
+                    direction={{ xs: 'column', md: 'row' }}
+                    spacing={2}
+                    alignItems={{ md: 'center' }}
+                    flexWrap='wrap'
+                    useFlexGap
+                >
+                    <ButtonGroup size='small' variant='outlined'>
+                        <Button onClick={() => setPresetDays(7)}>7d</Button>
+                        <Button onClick={() => setPresetDays(28)}>28d</Button>
+                        <Button onClick={() => setPresetDays(90)}>90d</Button>
+                    </ButtonGroup>
+
+                    <TextField
+                        label={globalize.translate('PlaybackStatsStartDate')}
+                        type='date'
+                        size='small'
+                        value={filters.startDate}
+                        onChange={event => setDateRange(event.target.value, filters.endDate)}
+                        InputLabelProps={{ shrink: true }}
+                    />
+                    <TextField
+                        label={globalize.translate('LabelEndDate')}
+                        type='date'
+                        size='small'
+                        value={filters.endDate}
+                        onChange={event => setDateRange(filters.startDate, event.target.value)}
+                        InputLabelProps={{ shrink: true }}
+                    />
+                    <Typography variant='body2' color='text.secondary'>
+                        {days} {globalize.translate('PlaybackStatsDays')}
+                    </Typography>
+
+                    <TextField
+                        select
+                        size='small'
+                        label={globalize.translate('PlaybackStatsMetric')}
+                        value={filters.metric}
+                        onChange={event => setMetric(event.target.value as 'PlayTime' | 'PlayCount')}
+                        sx={{ minWidth: 140 }}
+                    >
+                        <MenuItem value='PlayTime'>
+                            {globalize.translate('LabelWatchTime')}
+                        </MenuItem>
+                        <MenuItem value='PlayCount'>
+                            {globalize.translate('LabelPlayCount')}
+                        </MenuItem>
+                    </TextField>
+
+                    <TextField
+                        select
+                        size='small'
+                        label={globalize.translate('LabelUser')}
+                        value={filters.userIds[0] || ''}
+                        onChange={event => {
+                            const value = event.target.value;
+                            setUserIds(value ? [ value ] : []);
+                        }}
+                        sx={{ minWidth: 180 }}
+                    >
+                        <MenuItem value=''>
+                            {globalize.translate('All')}
+                        </MenuItem>
+                        {userOptions.map(user => (
+                            <MenuItem key={user.id} value={user.id}>{user.name}</MenuItem>
+                        ))}
+                    </TextField>
+
+                    <FormControlLabel
+                        control={(
+                            <Checkbox
+                                checked={filters.activityOnly}
+                                onChange={event => setActivityOnly(event.target.checked)}
+                            />
+                        )}
+                        label={globalize.translate('PlaybackStatsActivityOnly')}
+                    />
+
+                    <Box sx={{ flexGrow: 1 }} />
+                    <Button size='small' onClick={clearFilters}>
+                        {globalize.translate('PlaybackStatsClearFilters')}
+                    </Button>
+                    {onExport && (
+                        <Button size='small' variant='contained' onClick={onExport}>
+                            {globalize.translate('PlaybackStatsExportCsv')}
+                        </Button>
+                    )}
+                </Stack>
+
+                {(availableMediaTypes.length > 0 || availableClients.length > 0) && (
+                    <Stack direction='row' spacing={1} flexWrap='wrap' useFlexGap>
+                        {availableMediaTypes.map(mediaType => (
+                            <Chip
+                                key={mediaType}
+                                label={mediaType}
+                                size='small'
+                                color={filters.mediaTypes.includes(mediaType) ? 'primary' : 'default'}
+                                variant={filters.mediaTypes.includes(mediaType) ? 'filled' : 'outlined'}
+                                onClick={() => toggleMediaType(mediaType)}
+                            />
+                        ))}
+                        {availableClients.map(client => (
+                            <Chip
+                                key={client}
+                                label={client}
+                                size='small'
+                                color={filters.clients.includes(client) ? 'secondary' : 'default'}
+                                variant={filters.clients.includes(client) ? 'filled' : 'outlined'}
+                                onClick={() => toggleClient(client)}
+                            />
+                        ))}
+                    </Stack>
+                )}
+            </Stack>
+        </Paper>
+    );
+};
+
+export default PlaybackStatsFiltersBar;
