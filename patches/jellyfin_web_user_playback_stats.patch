+import React, { useMemo } from 'react';
+import Box from '@mui/material/Box';
+import Typography from '@mui/material/Typography';
+import { useTheme } from '@mui/material/styles';
+import { LineChart } from '@mui/x-charts/LineChart';
+
+import type { PlaybackDailyRow } from '../../types';
+import { formatTicks, ticksToMinutes } from '../../utils/formatTicks';
+
+interface MixAreaChartProps {
+    rows: PlaybackDailyRow[];
+    metric?: 'PlayTime' | 'PlayCount';
+    activityOnly?: boolean;
+    height?: number;
+}
+
+const PALETTE = [ 'primary', 'secondary', 'success', 'warning', 'info', 'error' ] as const;
+
+const MixAreaChart = ({
+    rows,
+    metric = 'PlayTime',
+    activityOnly = true,
+    height = 320
+}: MixAreaChartProps) => {
+    const theme = useTheme();
+
+    const { dates, series } = useMemo(() => {
+        const mediaTypes = Array.from(new Set(rows.map(row => row.MediaType).filter(Boolean))) as string[];
+        const byDate = new Map<string, Map<string, number>>();
+
+        for (const row of rows) {
+            const date = row.Date.slice(0, 10);
+            const mediaType = row.MediaType || 'Unknown';
+            const value = metric === 'PlayCount' ? row.PlayCount : ticksToMinutes(row.TotalTicks);
+            if (!byDate.has(date)) {
+                byDate.set(date, new Map());
+            }
+
+            const dayMap = byDate.get(date)!;
+            dayMap.set(mediaType, (dayMap.get(mediaType) ?? 0) + value);
+        }
+
+        let dateKeys = Array.from(byDate.keys()).sort();
+        if (activityOnly) {
+            dateKeys = dateKeys.filter(date => {
+                const dayMap = byDate.get(date)!;
+                return Array.from(dayMap.values()).some(value => value > 0);
+            });
+        }
+
+        return {
+            dates: dateKeys,
+            series: mediaTypes.map((mediaType, index) => {
+                const colorKey = PALETTE[index % PALETTE.length];
+                return {
+                    id: mediaType,
+                    label: mediaType,
+                    data: dateKeys.map(date => byDate.get(date)?.get(mediaType) ?? 0),
+                    area: true,
+                    stack: 'total',
+                    color: theme.palette[colorKey].main,
+                    showMark: false
+                };
+            })
+        };
+    }, [ activityOnly, metric, rows, theme.palette ]);
+
+    if (dates.length === 0 || series.length === 0) {
+        return (
+            <Typography variant='body2' color='text.secondary'>
+                —
+            </Typography>
+        );
+    }
+
+    return (
+        <Box sx={{ width: '100%', height }}>
+            <LineChart
+                xAxis={[{ data: dates, scaleType: 'point' }]}
+                series={series.map(item => ({
+                    ...item,
+                    valueFormatter: (value: number | null) => (
+                        metric === 'PlayCount'
+                            ? String(value ?? 0)
+                            : formatTicks((value ?? 0) * 60 * 10_000_000)
+                    )
+                }))}
+                margin={{ left: 60, right: 16, top: 24, bottom: 40 }}
+            />
+        </Box>
+    );
+};
+
+export default MixAreaChart;
