+import React from 'react';
+import Paper from '@mui/material/Paper';
+import Stack from '@mui/material/Stack';
+import Typography from '@mui/material/Typography';
+import TrendingDownIcon from '@mui/icons-material/TrendingDown';
+import TrendingFlatIcon from '@mui/icons-material/TrendingFlat';
+import TrendingUpIcon from '@mui/icons-material/TrendingUp';
+
+import { computeDelta, formatDeltaPercent } from '../utils/periodCompare';
+
+interface KpiCardProps {
+    label: string;
+    value: string;
+    current: number;
+    prior: number;
+    formatAbsolute?: (value: number) => string;
+}
+
+const KpiCard = ({ label, value, current, prior, formatAbsolute }: KpiCardProps) => {
+    const delta = computeDelta(current, prior);
+    const color = delta.direction === 'up'
+        ? 'success.main'
+        : delta.direction === 'down'
+            ? 'error.main'
+            : 'text.secondary';
+    const Icon = delta.direction === 'up'
+        ? TrendingUpIcon
+        : delta.direction === 'down'
+            ? TrendingDownIcon
+            : TrendingFlatIcon;
+
+    return (
+        <Paper sx={{ p: 2, flex: '1 1 160px', minWidth: 140 }}>
+            <Typography variant='body2' color='text.secondary' gutterBottom>
+                {label}
+            </Typography>
+            <Typography variant='h5' sx={{ mb: 0.5 }}>{value}</Typography>
+            <Stack direction='row' spacing={0.5} alignItems='center' sx={{ color }}>
+                <Icon fontSize='small' />
+                <Typography variant='caption' sx={{ color: 'inherit' }}>
+                    {formatDeltaPercent(delta)}
+                    {formatAbsolute ? ` (${formatAbsolute(delta.absolute)})` : ''}
+                </Typography>
+            </Stack>
+        </Paper>
+    );
+};
+
+export default KpiCard;
