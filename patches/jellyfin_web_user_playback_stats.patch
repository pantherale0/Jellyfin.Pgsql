@@ -0,0 +1,217 @@
+import type { Api } from '@jellyfin/sdk';
+import type { AxiosRequestConfig } from 'axios';
+
+import type {
+    PlaybackDailyGroupBy,
+    PlaybackDailyRow,
+    PlaybackDimension,
+    PlaybackDimensionRow,
+    PlaybackHourlyRow,
+    PlaybackItemGroupBy,
+    PlaybackItemRow,
+    PlaybackOverviewResponse,
+    PlaybackRecentResponse,
+    PlaybackSessionBucketRow,
+    PlaybackStatRow,
+    PlaybackStatsFilters,
+    PlaybackSubGroupStatRow,
+    PlaybackUserStatRow
+} from '../types';
+
+type FilterInput = Partial<PlaybackStatsFilters> & {
+    groupBy?: string;
+    limit?: number;
+    includeOther?: boolean;
+    dimension?: string;
+    startIndex?: number;
+};
+
+const appendFilters = (params: URLSearchParams, filters?: FilterInput) => {
+    if (!filters) {
+        return;
+    }
+
+    if (filters.startDate) {
+        params.set('startDate', filters.startDate);
+    }
+
+    if (filters.endDate) {
+        params.set('endDate', filters.endDate);
+    }
+
+    for (const userId of filters.userIds ?? []) {
+        params.append('userIds', userId);
+    }
+
+    for (const mediaType of filters.mediaTypes ?? []) {
+        params.append('mediaTypes', mediaType);
+    }
+
+    for (const client of filters.clients ?? []) {
+        params.append('clients', client);
+    }
+
+    for (const method of filters.playbackMethods ?? []) {
+        params.append('playbackMethods', method);
+    }
+
+    if (filters.groupBy) {
+        params.set('groupBy', filters.groupBy);
+    }
+
+    if (filters.limit != null) {
+        params.set('limit', String(filters.limit));
+    }
+
+    if (filters.includeOther != null) {
+        params.set('includeOther', String(filters.includeOther));
+    }
+
+    if (filters.dimension) {
+        params.set('dimension', filters.dimension);
+    }
+
+    if (filters.startIndex != null) {
+        params.set('startIndex', String(filters.startIndex));
+    }
+};
+
+const fetchJson = async <T>(
+    api: Api,
+    path: string,
+    options?: AxiosRequestConfig
+): Promise<T> => {
+    const response = await api.axiosInstance.get<T>(path, {
+        ...options,
+        baseURL: api.basePath,
+        headers: {
+            ...options?.headers,
+            Authorization: api.authorizationHeader
+        }
+    });
+    return response.data;
+};
+
+const fetchJsonArray = async <T>(
+    api: Api,
+    path: string,
+    options?: AxiosRequestConfig
+): Promise<T[]> => {
+    const data = await fetchJson<T[] | null>(api, path, options);
+    return Array.isArray(data) ? data : [];
+};
+
+const withQuery = (path: string, filters?: FilterInput) => {
+    const params = new URLSearchParams();
+    appendFilters(params, filters);
+    const query = params.toString();
+    return query ? `${path}?${query}` : path;
+};
+
+export const fetchUserPlaybackStats = (
+    api: Api,
+    userId: string,
+    filters?: Pick<PlaybackStatsFilters, 'startDate' | 'endDate'>,
+    options?: AxiosRequestConfig
+): Promise<PlaybackStatRow[]> => fetchJsonArray(
+    api,
+    withQuery(`/Users/${userId}/PlaybackStats`, filters),
+    options
+);
+
+export const fetchUserPlaybackStatsByType = (
+    api: Api,
+    userId: string,
+    mediaType: string,
+    filters?: Pick<PlaybackStatsFilters, 'startDate' | 'endDate'>,
+    options?: AxiosRequestConfig
+): Promise<PlaybackSubGroupStatRow[]> => fetchJsonArray(
+    api,
+    withQuery(`/Users/${userId}/PlaybackStats/${encodeURIComponent(mediaType)}`, filters),
+    options
+);
+
+export const fetchUserPlaybackOverview = (
+    api: Api,
+    userId: string,
+    filters?: Pick<PlaybackStatsFilters, 'startDate' | 'endDate'>,
+    options?: AxiosRequestConfig
+): Promise<PlaybackOverviewResponse> => fetchJson(
+    api,
+    withQuery(`/Users/${userId}/PlaybackStats/Overview`, filters),
+    options
+);
+
+export const fetchUserPlaybackHourly = (
+    api: Api,
+    userId: string,
+    filters?: Pick<PlaybackStatsFilters, 'startDate' | 'endDate'>,
+    options?: AxiosRequestConfig
+): Promise<PlaybackHourlyRow[]> => fetchJsonArray(
+    api,
+    withQuery(`/Users/${userId}/PlaybackStats/Hourly`, filters),
+    options
+);
+
+export const fetchServerPlaybackStats = (
+    api: Api,
+    filters?: Partial<PlaybackStatsFilters>,
+    options?: AxiosRequestConfig
+): Promise<PlaybackStatRow[]> => fetchJsonArray(api, withQuery('/PlaybackStats', filters), options);
+
+export const fetchServerPlaybackStatsByUser = (
+    api: Api,
+    filters?: Partial<PlaybackStatsFilters>,
+    options?: AxiosRequestConfig
+): Promise<PlaybackUserStatRow[]> => fetchJsonArray(api, withQuery('/PlaybackStats/Users', filters), options);
+
+export const fetchPlaybackOverview = (
+    api: Api,
+    filters?: Partial<PlaybackStatsFilters>,
+    options?: AxiosRequestConfig
+): Promise<PlaybackOverviewResponse> => fetchJson(api, withQuery('/PlaybackStats/Overview', filters), options);
+
+export const fetchPlaybackDaily = (
+    api: Api,
+    filters?: Partial<PlaybackStatsFilters> & { groupBy?: PlaybackDailyGroupBy },
+    options?: AxiosRequestConfig
+): Promise<PlaybackDailyRow[]> => fetchJsonArray(api, withQuery('/PlaybackStats/Daily', filters), options);
+
+export const fetchPlaybackHourly = (
+    api: Api,
+    filters?: Partial<PlaybackStatsFilters>,
+    options?: AxiosRequestConfig
+): Promise<PlaybackHourlyRow[]> => fetchJsonArray(api, withQuery('/PlaybackStats/Hourly', filters), options);
+
+export const fetchPlaybackItems = (
+    api: Api,
+    filters?: Partial<PlaybackStatsFilters> & {
+        groupBy?: PlaybackItemGroupBy;
+        limit?: number;
+        includeOther?: boolean;
+    },
+    options?: AxiosRequestConfig
+): Promise<PlaybackItemRow[]> => fetchJsonArray(api, withQuery('/PlaybackStats/Items', filters), options);
+
+export const fetchPlaybackDimensions = (
+    api: Api,
+    dimension: PlaybackDimension,
+    filters?: Partial<PlaybackStatsFilters>,
+    options?: AxiosRequestConfig
+): Promise<PlaybackDimensionRow[]> => fetchJsonArray(
+    api,
+    withQuery('/PlaybackStats/Dimensions', { ...filters, dimension }),
+    options
+);
+
+export const fetchPlaybackSessions = (
+    api: Api,
+    filters?: Partial<PlaybackStatsFilters>,
+    options?: AxiosRequestConfig
+): Promise<PlaybackSessionBucketRow[]> => fetchJsonArray(api, withQuery('/PlaybackStats/Sessions', filters), options);
+
+export const fetchPlaybackRecent = (
+    api: Api,
+    filters?: Partial<PlaybackStatsFilters> & { startIndex?: number; limit?: number },
+    options?: AxiosRequestConfig
+): Promise<PlaybackRecentResponse> => fetchJson(api, withQuery('/PlaybackStats/Recent', filters), options);
