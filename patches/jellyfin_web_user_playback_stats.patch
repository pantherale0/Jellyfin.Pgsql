+import React, { useCallback, useMemo, useState } from 'react';
+import Alert from '@mui/material/Alert';
+import Box from '@mui/material/Box';
+import CircularProgress from '@mui/material/CircularProgress';
+import Collapse from '@mui/material/Collapse';
+import Paper from '@mui/material/Paper';
+import Stack from '@mui/material/Stack';
+import Table from '@mui/material/Table';
+import TableBody from '@mui/material/TableBody';
+import TableCell from '@mui/material/TableCell';
+import TableContainer from '@mui/material/TableContainer';
+import TableHead from '@mui/material/TableHead';
+import TableRow from '@mui/material/TableRow';
+import ToggleButton from '@mui/material/ToggleButton';
+import ToggleButtonGroup from '@mui/material/ToggleButtonGroup';
+import Typography from '@mui/material/Typography';
+import { PieChart } from '@mui/x-charts/PieChart';
+import { useTheme } from '@mui/material/styles';
+import globalize from 'lib/globalize';
+
+import {
+    useUserPlaybackHourly,
+    useUserPlaybackOverview,
+    useUserPlaybackStats,
+    useUserPlaybackStatsByType
+} from 'apps/dashboard/features/playbackStatistics/api/usePlaybackStats';
+import DayHourHeatmap from 'apps/dashboard/features/playbackStatistics/components/charts/DayHourHeatmap';
+import RankedBarList from 'apps/dashboard/features/playbackStatistics/components/charts/RankedBarList';
+import KpiCard from 'apps/dashboard/features/playbackStatistics/components/KpiCard';
+import { formatTicks } from 'apps/dashboard/features/playbackStatistics/utils/formatTicks';
+import { defaultRange } from 'apps/dashboard/features/playbackStatistics/utils/periodCompare';
+
+interface UserPlaybackStatsProps {
+    userId: string;
+}
+
+type RangeMode = '28d' | 'all';
+
+const UserPlaybackStats = ({ userId }: UserPlaybackStatsProps) => {
+    const theme = useTheme();
+    const [ rangeMode, setRangeMode ] = useState<RangeMode>('28d');
+    const [ expandedMediaType, setExpandedMediaType ] = useState<string | null>(null);
+    const range = useMemo(() => (rangeMode === '28d' ? defaultRange(28) : undefined), [ rangeMode ]);
+
+    const { data: stats, isLoading, isError, error } = useUserPlaybackStats(userId, range);
+    const overview = useUserPlaybackOverview(userId, range, rangeMode === '28d');
+    const hourly = useUserPlaybackHourly(userId, range);
+    const {
+        data: subGroupStats,
+        isLoading: isSubGroupLoading,
+        isError: isSubGroupError,
+        error: subGroupError
+    } = useUserPlaybackStatsByType(userId, expandedMediaType, range);
+
+    const totals = useMemo(() => (stats ?? []).reduce((acc, row) => ({
+        totalTicks: acc.totalTicks + row.TotalTicks,
+        playCount: acc.playCount + row.PlayCount
+    }), { totalTicks: 0, playCount: 0 }), [ stats ]);
+
+    const onRowClick = useCallback((mediaType: string) => {
+        setExpandedMediaType(current => current === mediaType ? null : mediaType);
+    }, []);
+
+    if (isLoading) {
+        return (
+            <Box display='flex' justifyContent='center' py={4}>
+                <CircularProgress />
+            </Box>
+        );
+    }
+
+    if (isError) {
+        return <Alert severity='error'>{error?.message}</Alert>;
+    }
+
+    if ((stats?.length ?? 0) === 0) {
+        return (
+            <Stack spacing={2}>
+                <ToggleButtonGroup
+                    exclusive
+                    size='small'
+                    value={rangeMode}
+                    onChange={(_event, value: RangeMode | null) => {
+                        if (value) {
+                            setRangeMode(value);
+                        }
+                    }}
+                >
+                    <ToggleButton value='28d'>{globalize.translate('PlaybackStatsLast28Days')}</ToggleButton>
+                    <ToggleButton value='all'>{globalize.translate('PlaybackStatsAllTime')}</ToggleButton>
+                </ToggleButtonGroup>
+                <Alert severity='info'>{globalize.translate('PlaybackStatsEmpty')}</Alert>
+            </Stack>
+        );
+    }
+
+    const pieData = (stats ?? [])
+        .filter(row => row.TotalTicks > 0)
+        .map((row, index) => ({
+            id: index,
+            value: row.TotalTicks,
+            label: row.MediaType
+        }));
+
+    return (
+        <Stack spacing={2}>
+            <ToggleButtonGroup
+                exclusive
+                size='small'
+                value={rangeMode}
+                onChange={(_event, value: RangeMode | null) => {
+                    if (value) {
+                        setRangeMode(value);
+                    }
+                }}
+            >
+                <ToggleButton value='28d'>{globalize.translate('PlaybackStatsLast28Days')}</ToggleButton>
+                <ToggleButton value='all'>{globalize.translate('PlaybackStatsAllTime')}</ToggleButton>
+            </ToggleButtonGroup>
+
+            {rangeMode === '28d' && overview.data ? (
+                <Stack direction='row' spacing={2} flexWrap='wrap' useFlexGap>
+                    <KpiCard
+                        label={globalize.translate('LabelWatchTime')}
+                        value={formatTicks(overview.data.Current.TotalTicks)}
+                        current={overview.data.Current.TotalTicks}
+                        prior={overview.data.Prior.TotalTicks}
+                        formatAbsolute={formatTicks}
+                    />
+                    <KpiCard
+                        label={globalize.translate('LabelPlayCount')}
+                        value={String(overview.data.Current.PlayCount)}
+                        current={overview.data.Current.PlayCount}
+                        prior={overview.data.Prior.PlayCount}
+                    />
+                    <KpiCard
+                        label={globalize.translate('PlaybackStatsAvgSession')}
+                        value={formatTicks(overview.data.Current.AvgSessionTicks)}
+                        current={overview.data.Current.AvgSessionTicks}
+                        prior={overview.data.Prior.AvgSessionTicks}
+                        formatAbsolute={formatTicks}
+                    />
+                </Stack>
+            ) : (
+                <Stack direction='row' spacing={2}>
+                    <Paper sx={{ p: 2, flex: 1 }}>
+                        <Typography variant='body2' color='text.secondary'>
+                            {globalize.translate('LabelWatchTime')}
+                        </Typography>
+                        <Typography variant='h5'>{formatTicks(totals.totalTicks)}</Typography>
+                    </Paper>
+                    <Paper sx={{ p: 2, flex: 1 }}>
+                        <Typography variant='body2' color='text.secondary'>
+                            {globalize.translate('LabelPlayCount')}
+                        </Typography>
+                        <Typography variant='h5'>{totals.playCount}</Typography>
+                    </Paper>
+                </Stack>
+            )}
+
+            <Stack direction={{ xs: 'column', md: 'row' }} spacing={2}>
+                <Paper sx={{ p: 2, flex: 1 }}>
+                    <Typography variant='subtitle2' gutterBottom>
+                        {globalize.translate('LabelWatchTime')}
+                    </Typography>
+                    {pieData.length >= 3 ? (
+                        <PieChart
+                            series={[{
+                                data: pieData,
+                                valueFormatter: item => formatTicks(Number(item.value))
+                            }]}
+                            height={220}
+                            colors={[
+                                theme.palette.primary.main,
+                                theme.palette.secondary.main,
+                                theme.palette.success.main,
+                                theme.palette.warning.main
+                            ]}
+                        />
+                    ) : (
+                        <RankedBarList
+                            items={(stats ?? []).map(row => ({
+                                id: row.MediaType,
+                                label: row.MediaType,
+                                value: row.TotalTicks
+                            }))}
+                            valueFormatter={formatTicks}
+                            height={220}
+                        />
+                    )}
+                </Paper>
+                <Paper sx={{ p: 2, flex: 1 }}>
+                    <Typography variant='subtitle2' gutterBottom>
+                        {globalize.translate('LabelPlayCount')}
+                    </Typography>
+                    <RankedBarList
+                        items={(stats ?? []).map(row => ({
+                            id: `${row.MediaType}-plays`,
+                            label: row.MediaType,
+                            value: row.PlayCount
+                        }))}
+                        layout='vertical'
+                        height={220}
+                    />
+                </Paper>
+            </Stack>
+
+            <Paper sx={{ p: 2 }}>
+                <Typography variant='subtitle2' gutterBottom>
+                    {globalize.translate('PlaybackStatsHourlyHeatmap')}
+                </Typography>
+                {hourly.isLoading ? (
+                    <CircularProgress size={24} />
+                ) : (
+                    <DayHourHeatmap rows={hourly.data ?? []} />
+                )}
+            </Paper>
+
+            <TableContainer component={Paper}>
+                <Table size='small'>
+                    <TableHead>
+                        <TableRow>
+                            <TableCell>{globalize.translate('LabelMediaType')}</TableCell>
+                            <TableCell align='right'>{globalize.translate('LabelPlayCount')}</TableCell>
+                            <TableCell align='right'>{globalize.translate('LabelWatchTime')}</TableCell>
+                        </TableRow>
+                    </TableHead>
+                    <TableBody>
+                        {(stats ?? []).map(row => (
+                            <React.Fragment key={row.MediaType}>
+                                <TableRow
+                                    hover
+                                    sx={{ cursor: 'pointer' }}
+                                    onClick={() => onRowClick(row.MediaType)}
+                                    selected={expandedMediaType === row.MediaType}
+                                >
+                                    <TableCell>{row.MediaType}</TableCell>
+                                    <TableCell align='right'>{row.PlayCount}</TableCell>
+                                    <TableCell align='right'>{formatTicks(row.TotalTicks)}</TableCell>
+                                </TableRow>
+                                <TableRow>
+                                    <TableCell colSpan={3} sx={{ py: 0, borderBottom: expandedMediaType === row.MediaType ? undefined : 0 }}>
+                                        <Collapse in={expandedMediaType === row.MediaType} timeout='auto' unmountOnExit>
+                                            <Box py={2} pl={2}>
+                                                {isSubGroupLoading && <CircularProgress size={24} />}
+                                                {isSubGroupError && <Alert severity='error'>{subGroupError?.message}</Alert>}
+                                                {!isSubGroupLoading && !isSubGroupError && (subGroupStats?.length ?? 0) === 0 && (
+                                                    <Typography variant='body2' color='text.secondary'>
+                                                        {globalize.translate('PlaybackStatsEmpty')}
+                                                    </Typography>
+                                                )}
+                                                {!isSubGroupLoading && !isSubGroupError && (subGroupStats?.length ?? 0) > 0 && (
+                                                    <Stack spacing={2}>
+                                                        <RankedBarList
+                                                            items={(subGroupStats ?? []).map(subRow => ({
+                                                                id: subRow.SubGroup,
+                                                                label: subRow.SubGroup || 'Unknown',
+                                                                value: subRow.TotalTicks
+                                                            }))}
+                                                            valueFormatter={formatTicks}
+                                                            height={220}
+                                                        />
+                                                        <Table size='small'>
+                                                            <TableHead>
+                                                                <TableRow>
+                                                                    <TableCell>{globalize.translate('Genre')}</TableCell>
+                                                                    <TableCell align='right'>{globalize.translate('LabelPlayCount')}</TableCell>
+                                                                    <TableCell align='right'>{globalize.translate('LabelWatchTime')}</TableCell>
+                                                                </TableRow>
+                                                            </TableHead>
+                                                            <TableBody>
+                                                                {(subGroupStats ?? []).map(subRow => (
+                                                                    <TableRow key={subRow.SubGroup}>
+                                                                        <TableCell>{subRow.SubGroup}</TableCell>
+                                                                        <TableCell align='right'>{subRow.PlayCount}</TableCell>
+                                                                        <TableCell align='right'>{formatTicks(subRow.TotalTicks)}</TableCell>
+                                                                    </TableRow>
+                                                                ))}
+                                                            </TableBody>
+                                                        </Table>
+                                                    </Stack>
+                                                )}
+                                            </Box>
+                                        </Collapse>
+                                    </TableCell>
+                                </TableRow>
+                            </React.Fragment>
+                        ))}
+                    </TableBody>
+                </Table>
+            </TableContainer>
+        </Stack>
+    );
+};
+
+export default UserPlaybackStats;
