+import React, { useMemo } from 'react';
+import Box from '@mui/material/Box';
+import Typography from '@mui/material/Typography';
+import { useTheme } from '@mui/material/styles';
+import { BarChart } from '@mui/x-charts/BarChart';
+
+import type { PlaybackDailyRow } from '../../types';
+import { formatTicks, ticksToMinutes } from '../../utils/formatTicks';
+
+interface StackedDailyChartProps {
+    rows: PlaybackDailyRow[];
+    seriesKey: 'UserId' | 'MediaType';
+    labelResolver: (key: string) => string;
+    metric?: 'PlayTime' | 'PlayCount';
+    activityOnly?: boolean;
+    height?: number;
+    onSeriesClick?: (key: string) => void;
+}
+
+const PALETTE = [ 'primary', 'secondary', 'success', 'warning', 'info', 'error' ] as const;
+
+const StackedDailyChart = ({
+    rows,
+    seriesKey,
+    labelResolver,
+    metric = 'PlayTime',
+    activityOnly = true,
+    height = 360,
+    onSeriesClick
+}: StackedDailyChartProps) => {
+    const theme = useTheme();
+
+    const { dates, series } = useMemo(() => {
+        const keys = Array.from(new Set(
+            rows.map(row => (seriesKey === 'UserId' ? row.UserId : row.MediaType)).filter(Boolean)
+        )) as string[];
+        const byDate = new Map<string, Map<string, number>>();
+
+        for (const row of rows) {
+            const date = row.Date.slice(0, 10);
+            const key = (seriesKey === 'UserId' ? row.UserId : row.MediaType) || 'Unknown';
+            const value = metric === 'PlayCount' ? row.PlayCount : ticksToMinutes(row.TotalTicks);
+            if (!byDate.has(date)) {
+                byDate.set(date, new Map());
+            }
+
+            const dayMap = byDate.get(date)!;
+            dayMap.set(key, (dayMap.get(key) ?? 0) + value);
+        }
+
+        let dateKeys = Array.from(byDate.keys()).sort();
+        if (activityOnly) {
+            dateKeys = dateKeys.filter(date => {
+                const dayMap = byDate.get(date)!;
+                return Array.from(dayMap.values()).some(value => value > 0);
+            });
+        }
+
+        return {
+            dates: dateKeys,
+            series: keys.slice(0, 12).map((key, index) => {
+                const colorKey = PALETTE[index % PALETTE.length];
+                return {
+                    id: key,
+                    label: labelResolver(key),
+                    data: dateKeys.map(date => byDate.get(date)?.get(key) ?? 0),
+                    stack: 'total',
+                    color: theme.palette[colorKey].main,
+                    valueFormatter: (value: number | null) => (
+                        metric === 'PlayCount'
+                            ? String(value ?? 0)
+                            : formatTicks((value ?? 0) * 60 * 10_000_000)
+                    )
+                };
+            })
+        };
+    }, [ activityOnly, labelResolver, metric, rows, seriesKey, theme.palette ]);
+
+    if (dates.length === 0 || series.length === 0) {
+        return (
+            <Typography variant='body2' color='text.secondary'>
+                —
+            </Typography>
+        );
+    }
+
+    return (
+        <Box sx={{ width: '100%', height }}>
+            <BarChart
+                xAxis={[{ data: dates, scaleType: 'band' }]}
+                series={series}
+                margin={{ left: 60, right: 16, top: 24, bottom: 50 }}
+                onItemClick={onSeriesClick ? (_event, item) => {
+                    const selected = series.find(entry => entry.id === String(item.seriesId))
+                        ?? series[item.dataIndex];
+                    if (selected) {
+                        onSeriesClick(selected.id);
+                    }
+                } : undefined}
+            />
+        </Box>
+    );
+};
+
+export default StackedDailyChart;
