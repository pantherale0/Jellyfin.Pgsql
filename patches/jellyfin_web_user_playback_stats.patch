+++ b/src/apps/dashboard/routes/reports/playback.tsx
@@ -0,0 +1,217 @@
+import React, { useMemo } from 'react';
+import Alert from '@mui/material/Alert';
+import Box from '@mui/material/Box';
+import CircularProgress from '@mui/material/CircularProgress';
+import Link from '@mui/material/Link';
+import Paper from '@mui/material/Paper';
+import Stack from '@mui/material/Stack';
+import Typography from '@mui/material/Typography';
+import { type MRT_ColumnDef, type MRT_TableOptions, useMaterialReactTable } from 'material-react-table';
+import { Link as RouterLink } from 'react-router-dom';
+import { useUsersDetails } from 'hooks/useUsers';
+import globalize from 'lib/globalize';
+
+import TablePage, { DEFAULT_TABLE_OPTIONS } from 'apps/dashboard/components/table/TablePage';
+import UserAvatarButton from 'apps/dashboard/components/UserAvatarButton';
+import {
+    useServerPlaybackStats,
+    useServerPlaybackStatsByUser
+} from 'apps/dashboard/features/playbackStatistics/api/usePlaybackStats';
+import type { PlaybackUserStatRow, PlaybackUserTableRow } from 'apps/dashboard/features/playbackStatistics/types';
+import { formatTicks } from 'apps/dashboard/features/playbackStatistics/utils/formatTicks';
+
+const buildUserRows = (
+    rows: PlaybackUserStatRow[] | null | undefined
+): { userRows: PlaybackUserTableRow[]; mediaTypes: string[] } => {
+    const mediaTypeSet = new Set<string>();
+    const byUser = new Map<string, PlaybackUserTableRow>();
+
+    for (const row of rows ?? []) {
+        mediaTypeSet.add(row.MediaType);
+
+        const existing = byUser.get(row.UserId) ?? {
+            userId: row.UserId,
+            totalTicks: 0,
+            playCount: 0,
+            byMediaType: {}
+        };
+
+        existing.totalTicks += row.TotalTicks;
+        existing.playCount += row.PlayCount;
+        existing.byMediaType[row.MediaType] = {
+            totalTicks: row.TotalTicks,
+            playCount: row.PlayCount
+        };
+
+        byUser.set(row.UserId, existing);
+    }
+
+    return {
+        userRows: Array.from(byUser.values()).sort((a, b) => b.totalTicks - a.totalTicks),
+        mediaTypes: Array.from(mediaTypeSet).sort()
+    };
+};
+
+export const Component = () => {
+    const {
+        data: serverStats,
+        isLoading: isServerStatsLoading,
+        isError: isServerStatsError,
+        error: serverStatsError
+    } = useServerPlaybackStats();
+    const {
+        data: userStats,
+        isLoading: isUserStatsLoading,
+        isError: isUserStatsError,
+        error: userStatsError
+    } = useServerPlaybackStatsByUser();
+    const {
+        usersById: users,
+        isLoading: isUsersLoading,
+        isError: isUsersError,
+        error: usersError
+    } = useUsersDetails();
+
+    const { userRows, mediaTypes } = useMemo(
+        () => buildUserRows(userStats),
+        [ userStats ]
+    );
+
+    const serverTotals = useMemo(() => (serverStats ?? []).reduce((acc, row) => ({
+        totalTicks: acc.totalTicks + row.TotalTicks,
+        playCount: acc.playCount + row.PlayCount
+    }), { totalTicks: 0, playCount: 0 }), [ serverStats ]);
+
+    const columns = useMemo<MRT_ColumnDef<PlaybackUserTableRow>[]>(() => [
+        {
+            id: 'User',
+            header: globalize.translate('LabelUser'),
+            size: 240,
+            minSize: 180,
+            grow: true,
+            Cell: ({ row }) => {
+                const user = users[row.original.userId];
+
+                return (
+                    <Stack direction='row' spacing={1} alignItems='center'>
+                        <UserAvatarButton user={user} />
+                        <Link
+                            component={RouterLink}
+                            to={`/dashboard/users/${row.original.userId}/playbackstats`}
+                            underline='hover'
+                        >
+                            {user?.Name || row.original.userId}
+                        </Link>
+                    </Stack>
+                );
+            }
+        },
+        ...mediaTypes.map(mediaType => ({
+            id: mediaType,
+            header: mediaType,
+            size: 140,
+            minSize: 120,
+            grow: true,
+            accessorFn: (row: PlaybackUserTableRow) => row.byMediaType[mediaType]?.totalTicks ?? 0,
+            Cell: ({ row }: { row: { original: PlaybackUserTableRow } }) => {
+                const stat = row.original.byMediaType[mediaType];
+                return stat ? formatTicks(stat.totalTicks) : '—';
+            }
+        })),
+        {
+            id: 'TotalWatchTime',
+            header: globalize.translate('LabelWatchTime'),
+            size: 140,
+            minSize: 120,
+            grow: true,
+            accessorFn: row => row.totalTicks,
+            Cell: ({ row }) => formatTicks(row.original.totalTicks)
+        },
+        {
+            id: 'PlayCount',
+            header: globalize.translate('LabelPlayCount'),
+            size: 140,
+            minSize: 120,
+            grow: true,
+            accessorKey: 'playCount'
+        }
+    ], [ mediaTypes, users ]);
+
+    const isLoading = isServerStatsLoading || isUserStatsLoading || isUsersLoading;
+    const isError = isServerStatsError || isUserStatsError || isUsersError;
+    const errorMessage = serverStatsError?.message
+        || userStatsError?.message
+        || usersError?.message
+        || globalize.translate('PlaybackStatsLoadError');
+
+    const useStickyTableShell = userRows.length > 25;
+
+    const table = useMaterialReactTable<PlaybackUserTableRow>({
+        ...(DEFAULT_TABLE_OPTIONS as Partial<MRT_TableOptions<PlaybackUserTableRow>>),
+        columns,
+        data: userRows,
+        layoutMode: 'grid',
+        enableColumnResizing: false,
+        enableStickyHeader: useStickyTableShell,
+        enableStickyFooter: useStickyTableShell,
+        muiTableContainerProps: {
+            sx: {
+                maxHeight: useStickyTableShell ? 'calc(100% - 7rem)' : 'none'
+            }
+        },
+        initialState: {
+            density: 'compact',
+            sorting: [{ id: 'TotalWatchTime', desc: true }]
+        },
+        state: {
+            isLoading
+        },
+        enableColumnFilters: false,
+        enableGlobalFilter: true,
+        enablePagination: useStickyTableShell,
+        enableBottomToolbar: useStickyTableShell
+    });
+
+    if (isLoading) {
+        return (
+            <Box display='flex' justifyContent='center' py={8}>
+                <CircularProgress />
+            </Box>
+        );
+    }
+
+    return (
+        <TablePage
+            id='playbackStatisticsPage'
+            title={globalize.translate('HeaderPlaybackStatistics')}
+            className='mainAnimatedPage type-interior'
+            table={table}
+            isError={isError}
+            errorMessage={errorMessage}
+        >
+            {!isError && (serverStats?.length ?? 0) === 0 && userRows.length === 0 && (
+                <Alert severity='info' sx={{ mb: 2 }}>
+                    {globalize.translate('PlaybackStatsEmpty')}
+                </Alert>
+            )}
+            {!isError && (serverStats?.length ?? 0) > 0 && (
+                <Stack direction='row' spacing={2} sx={{ mb: 2 }}>
+                    <Paper sx={{ p: 2, flex: 1 }}>
+                        <Typography variant='body2' color='text.secondary'>
+                            {globalize.translate('LabelWatchTime')}
+                        </Typography>
+                        <Typography variant='h5'>{formatTicks(serverTotals.totalTicks)}</Typography>
+                    </Paper>
+                    <Paper sx={{ p: 2, flex: 1 }}>
+                        <Typography variant='body2' color='text.secondary'>
