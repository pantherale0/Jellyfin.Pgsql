+import React, { useMemo } from 'react';
+import Alert from '@mui/material/Alert';
+import Box from '@mui/material/Box';
+import CircularProgress from '@mui/material/CircularProgress';
+import Link from '@mui/material/Link';
+import Paper from '@mui/material/Paper';
+import Stack from '@mui/material/Stack';
+import Typography from '@mui/material/Typography';
+import { type MRT_ColumnDef, type MRT_TableOptions, useMaterialReactTable, MaterialReactTable } from 'material-react-table';
+import { Link as RouterLink } from 'react-router-dom';
+import globalize from 'lib/globalize';
+
+import UserAvatarButton from 'apps/dashboard/components/UserAvatarButton';
+import { DEFAULT_TABLE_OPTIONS } from 'apps/dashboard/components/table/TablePage';
+import { useServerPlaybackStatsByUser } from '../../api/usePlaybackStats';
+import { usePlaybackStatsFilters } from '../../context/PlaybackStatsFilterContext';
+import type { PlaybackUserTableRow } from '../../types';
+import { buildUserRows } from '../../utils/buildUserRows';
+import { formatTicks } from '../../utils/formatTicks';
+import RankedBarList from '../charts/RankedBarList';
+
+interface UsersTabProps {
+    usersById: Record<string, { Name?: string | null } | undefined>;
+}
+
+const UsersTab = ({ usersById }: UsersTabProps) => {
+    const { apiFilters, filters, toggleUserId } = usePlaybackStatsFilters();
+    const userStats = useServerPlaybackStatsByUser(apiFilters);
+    const { userRows, mediaTypes } = useMemo(() => buildUserRows(userStats.data), [ userStats.data ]);
+
+    const columns = useMemo<MRT_ColumnDef<PlaybackUserTableRow>[]>(() => [
+        {
+            id: 'User',
+            header: globalize.translate('LabelUser'),
+            size: 220,
+            Cell: ({ row }) => {
+                const user = usersById[row.original.userId];
+                return (
+                    <Stack direction='row' spacing={1} alignItems='center'>
+                        <UserAvatarButton user={user as never} />
+                        <Link
+                            component={RouterLink}
+                            to={`/dashboard/users/${row.original.userId}/playbackstats`}
+                            underline='hover'
+                            onClick={event => {
+                                if (event.metaKey || event.ctrlKey) {
+                                    return;
+                                }
+
+                                event.preventDefault();
+                                toggleUserId(row.original.userId);
+                            }}
+                        >
+                            {user?.Name || row.original.userId}
+                        </Link>
+                    </Stack>
+                );
+            }
+        },
+        ...mediaTypes.map(mediaType => ({
+            id: mediaType,
+            header: mediaType,
+            size: 120,
+            accessorFn: (row: PlaybackUserTableRow) => row.byMediaType[mediaType]?.totalTicks ?? 0,
+            Cell: ({ row }: { row: { original: PlaybackUserTableRow } }) => {
+                const stat = row.original.byMediaType[mediaType];
+                return stat ? formatTicks(stat.totalTicks) : '—';
+            }
+        })),
+        {
+            id: 'TotalWatchTime',
+            header: globalize.translate('LabelWatchTime'),
+            size: 130,
+            accessorFn: row => row.totalTicks,
+            Cell: ({ row }) => formatTicks(row.original.totalTicks)
+        },
+        {
+            id: 'PlayCount',
+            header: globalize.translate('LabelPlayCount'),
+            size: 110,
+            accessorKey: 'playCount'
+        }
+    ], [ mediaTypes, toggleUserId, usersById ]);
+
+    const table = useMaterialReactTable<PlaybackUserTableRow>({
+        ...(DEFAULT_TABLE_OPTIONS as Partial<MRT_TableOptions<PlaybackUserTableRow>>),
+        columns,
+        data: userRows,
+        layoutMode: 'grid',
+        enableColumnFilters: false,
+        enableGlobalFilter: true,
+        initialState: {
+            density: 'compact',
+            sorting: [{ id: 'TotalWatchTime', desc: true }]
+        },
+        state: { isLoading: userStats.isLoading }
+    });
+
+    if (userStats.isLoading) {
+        return (
+            <Box display='flex' justifyContent='center' py={6}>
+                <CircularProgress />
+            </Box>
+        );
+    }
+
+    if (userStats.isError) {
+        return <Alert severity='error'>{globalize.translate('PlaybackStatsLoadError')}</Alert>;
+    }
+
+    return (
+        <Stack spacing={2}>
+            <Paper sx={{ p: 2 }}>
+                <Typography variant='subtitle1' gutterBottom>
+                    {globalize.translate('PlaybackStatsTopUsers')}
+                </Typography>
+                <RankedBarList
+                    items={userRows.slice(0, 12).map(row => ({
+                        id: row.userId,
+                        label: usersById[row.userId]?.Name || row.userId.slice(0, 8),
+                        value: filters.metric === 'PlayCount' ? row.playCount : row.totalTicks
+                    }))}
+                    valueFormatter={filters.metric === 'PlayCount' ? String : formatTicks}
+                    onItemClick={toggleUserId}
+                    height={320}
+                />
+            </Paper>
+            <Paper sx={{ p: 1 }}>
+                <MaterialReactTable table={table} />
+            </Paper>
+        </Stack>
+    );
+};
+
+export default UsersTab;
diff --git a/src/apps/dashboard/features/playbackStatistics/context/PlaybackStatsFilterContext.tsx b/src/apps/dashboard/features/playbackStatistics/context/PlaybackStatsFilterContext.tsx
