+import React, { useMemo } from 'react';
+import Box from '@mui/material/Box';
+import Tooltip from '@mui/material/Tooltip';
+import Typography from '@mui/material/Typography';
+import { alpha, useTheme } from '@mui/material/styles';
+
+import type { PlaybackDailyRow } from '../../types';
+import { formatTicks } from '../../utils/formatTicks';
+
+interface CalendarHeatmapProps {
+    rows: PlaybackDailyRow[];
+    startDate: string;
+    endDate: string;
+    metric?: 'TotalTicks' | 'PlayCount';
+}
+
+const toUtcDate = (value: string) => new Date(`${value.slice(0, 10)}T00:00:00Z`);
+
+const CalendarHeatmap = ({
+    rows,
+    startDate,
+    endDate,
+    metric = 'TotalTicks'
+}: CalendarHeatmapProps) => {
+    const theme = useTheme();
+    const { days, max } = useMemo(() => {
+        const totals = new Map<string, number>();
+        for (const row of rows) {
+            const key = row.Date.slice(0, 10);
+            const value = metric === 'PlayCount' ? row.PlayCount : row.TotalTicks;
+            totals.set(key, (totals.get(key) ?? 0) + value);
+        }
+
+        const start = toUtcDate(startDate);
+        const end = toUtcDate(endDate);
+        const list: Array<{ date: string; value: number }> = [];
+        let localMax = 0;
+        for (let cursor = new Date(start); cursor <= end; cursor.setUTCDate(cursor.getUTCDate() + 1)) {
+            const key = cursor.toISOString().slice(0, 10);
+            const value = totals.get(key) ?? 0;
+            localMax = Math.max(localMax, value);
+            list.push({ date: key, value });
+        }
+
+        return { days: list, max: localMax };
+    }, [ endDate, metric, rows, startDate ]);
+
+    const startDow = toUtcDate(startDate).getUTCDay();
+
+    return (
+        <Box>
+            <Typography variant='subtitle2' gutterBottom>
+                Activity calendar
+            </Typography>
+            <Box
+                sx={{
+                    display: 'grid',
+                    gridTemplateColumns: 'repeat(7, 16px)',
+                    gap: 0.5
+                }}
+            >
+                {Array.from({ length: startDow }, (_, i) => (
+                    <Box key={`pad-${i}`} />
+                ))}
+                {days.map(day => {
+                    const intensity = max > 0 ? day.value / max : 0;
+                    const bg = intensity === 0
+                        ? alpha(theme.palette.action.hover, 0.35)
+                        : alpha(theme.palette.secondary.main, 0.2 + intensity * 0.8);
+                    const title = metric === 'PlayCount'
+                        ? `${day.date}: ${day.value} plays`
+                        : `${day.date}: ${formatTicks(day.value)}`;
+
+                    return (
+                        <Tooltip key={day.date} title={title}>
+                            <Box
+                                sx={{
+                                    width: 16,
+                                    height: 16,
+                                    borderRadius: 0.5,
+                                    bgcolor: bg
+                                }}
+                            />
+                        </Tooltip>
+                    );
+                })}
+            </Box>
+        </Box>
+    );
+};
+
+export default CalendarHeatmap;
