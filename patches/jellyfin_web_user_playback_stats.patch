+import React, { useMemo } from 'react';
+import Alert from '@mui/material/Alert';
+import Box from '@mui/material/Box';
+import CircularProgress from '@mui/material/CircularProgress';
+import Paper from '@mui/material/Paper';
+import Stack from '@mui/material/Stack';
+import Typography from '@mui/material/Typography';
+import globalize from 'lib/globalize';
+
+import { usePlaybackHourly, usePlaybackSessions } from '../../api/usePlaybackStats';
+import { usePlaybackStatsFilters } from '../../context/PlaybackStatsFilterContext';
+import { formatTicks } from '../../utils/formatTicks';
+import DayHourHeatmap from '../charts/DayHourHeatmap';
+import RankedBarList from '../charts/RankedBarList';
+
+const DAY_LABELS = [ 'Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat' ];
+
+const PatternsTab = () => {
+    const { apiFilters, filters } = usePlaybackStatsFilters();
+    const hourly = usePlaybackHourly(apiFilters);
+    const sessions = usePlaybackSessions(apiFilters);
+
+    const dayTotals = useMemo(() => {
+        const totals = Array.from({ length: 7 }, (_, day) => ({
+            id: String(day),
+            label: DAY_LABELS[day],
+            value: 0
+        }));
+
+        for (const row of hourly.data ?? []) {
+            const bucket = totals[row.DayOfWeek];
+            if (!bucket) {
+                continue;
+            }
+
+            bucket.value += filters.metric === 'PlayCount' ? row.PlayCount : row.TotalTicks;
+        }
+
+        return totals;
+    }, [ filters.metric, hourly.data ]);
+
+    if (hourly.isLoading || sessions.isLoading) {
+        return (
+            <Box display='flex' justifyContent='center' py={6}>
+                <CircularProgress />
+            </Box>
+        );
+    }
+
+    if (hourly.isError || sessions.isError) {
+        return <Alert severity='error'>{globalize.translate('PlaybackStatsLoadError')}</Alert>;
+    }
+
+    return (
+        <Stack spacing={2}>
+            <Paper sx={{ p: 2 }}>
+                <Typography variant='subtitle1' gutterBottom>
+                    {globalize.translate('PlaybackStatsHourlyHeatmap')}
+                </Typography>
+                <DayHourHeatmap
+                    rows={hourly.data ?? []}
+                    metric={filters.metric === 'PlayCount' ? 'PlayCount' : 'TotalTicks'}
+                />
+            </Paper>
+
+            <Stack direction={{ xs: 'column', md: 'row' }} spacing={2}>
+                <Paper sx={{ p: 2, flex: 1 }}>
+                    <Typography variant='subtitle1' gutterBottom>
+                        {globalize.translate('PlaybackStatsDayOfWeek')}
+                    </Typography>
+                    <RankedBarList
+                        items={dayTotals}
+                        valueFormatter={filters.metric === 'PlayCount' ? String : formatTicks}
+                        layout='vertical'
+                        height={280}
+                    />
+                </Paper>
+                <Paper sx={{ p: 2, flex: 1 }}>
+                    <Typography variant='subtitle1' gutterBottom>
+                        {globalize.translate('PlaybackStatsSessionLength')}
+                    </Typography>
+                    <RankedBarList
+                        items={(sessions.data ?? []).map(row => ({
+                            id: row.Bucket,
+                            label: row.Bucket,
+                            value: row.PlayCount
+                        }))}
+                        layout='vertical'
+                        height={280}
+                    />
+                </Paper>
+            </Stack>
+        </Stack>
+    );
+};
+
+export default PatternsTab;
