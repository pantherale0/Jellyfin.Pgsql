@@ -0,0 +1,55 @@
+import type { Api } from '@jellyfin/sdk';
+import type { AxiosRequestConfig } from 'axios';
+
+import type {
+    PlaybackStatRow,
+    PlaybackSubGroupStatRow,
+    PlaybackUserStatRow
+} from '../types';
+
+const fetchJsonArray = async <T>(
+    api: Api,
+    path: string,
+    options?: AxiosRequestConfig
+): Promise<T[]> => {
+    const response = await api.axiosInstance.get<T[] | null>(path, {
+        ...options,
+        baseURL: api.basePath,
+        headers: {
+            ...options?.headers,
+            Authorization: api.authorizationHeader
+        }
+    });
+    return Array.isArray(response.data) ? response.data : [];
+};
+
+export const fetchUserPlaybackStats = (
+    api: Api,
+    userId: string,
+    options?: AxiosRequestConfig
+): Promise<PlaybackStatRow[]> => fetchJsonArray(
+    api,
+    `/Users/${userId}/PlaybackStats`,
+    options
+);
+
+export const fetchUserPlaybackStatsByType = (
+    api: Api,
+    userId: string,
+    mediaType: string,
+    options?: AxiosRequestConfig
+): Promise<PlaybackSubGroupStatRow[]> => fetchJsonArray(
+    api,
+    `/Users/${userId}/PlaybackStats/${encodeURIComponent(mediaType)}`,
+    options
+);
+
+export const fetchServerPlaybackStats = (
+    api: Api,
+    options?: AxiosRequestConfig
+): Promise<PlaybackStatRow[]> => fetchJsonArray(api, '/PlaybackStats', options);
+
+export const fetchServerPlaybackStatsByUser = (
+    api: Api,
+    options?: AxiosRequestConfig
+): Promise<PlaybackUserStatRow[]> => fetchJsonArray(api, '/PlaybackStats/Users', options);
diff --git a/src/apps/dashboard/features/playbackStatistics/api/usePlaybackStats.ts b/src/apps/dashboard/features/playbackStatistics/api/usePlaybackStats.ts
