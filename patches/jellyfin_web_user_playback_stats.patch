+import React, { useMemo } from 'react';
+import Box from '@mui/material/Box';
+import Stack from '@mui/material/Stack';
+import Typography from '@mui/material/Typography';
+import { useTheme } from '@mui/material/styles';
+import { BarChart } from '@mui/x-charts/BarChart';
+
+export interface RankedBarItem {
+    id: string;
+    label: string;
+    value: number;
+    secondaryLabel?: string;
+}
+
+interface RankedBarListProps {
+    items: RankedBarItem[];
+    height?: number;
+    valueFormatter?: (value: number) => string;
+    onItemClick?: (id: string) => void;
+    layout?: 'horizontal' | 'vertical';
+}
+
+const RankedBarList = ({
+    items,
+    height = 280,
+    valueFormatter,
+    onItemClick,
+    layout = 'horizontal'
+}: RankedBarListProps) => {
+    const theme = useTheme();
+    const chartItems = useMemo(() => items.slice(0, 12), [ items ]);
+
+    if (chartItems.length === 0) {
+        return (
+            <Typography variant='body2' color='text.secondary'>
+                —
+            </Typography>
+        );
+    }
+
+    return (
+        <Box sx={{ width: '100%', height }}>
+            <BarChart
+                layout={layout}
+                margin={{ left: layout === 'horizontal' ? 120 : 40, right: 16, top: 16, bottom: 40 }}
+                series={[{
+                    data: chartItems.map(item => item.value),
+                    color: theme.palette.primary.main,
+                    valueFormatter: valueFormatter
+                        ? (value: number | null) => valueFormatter(value ?? 0)
+                        : undefined
+                }]}
+                {...(layout === 'horizontal'
+                    ? {
+                        yAxis: [{
+                            data: chartItems.map(item => item.label),
+                            scaleType: 'band' as const
+                        }]
+                    }
+                    : {
+                        xAxis: [{
+                            data: chartItems.map(item => item.label),
+                            scaleType: 'band' as const
+                        }]
+                    })}
+                onItemClick={onItemClick ? (_event, item) => {
+                    const row = chartItems[item.dataIndex];
+                    if (row) {
+                        onItemClick(row.id);
+                    }
+                } : undefined}
+                slotProps={{
+                    legend: { hidden: true }
+                }}
+            />
+            {chartItems.some(item => item.secondaryLabel) && (
+                <Stack spacing={0.5} sx={{ mt: 1 }}>
+                    {chartItems.map(item => (
+                        <Typography key={item.id} variant='caption' color='text.secondary'>
+                            {item.label}: {item.secondaryLabel}
+                        </Typography>
+                    ))}
+                </Stack>
+            )}
+        </Box>
+    );
+};
+
+export default RankedBarList;
