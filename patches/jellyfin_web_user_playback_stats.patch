@@ -0,0 +1,30 @@
+const TICKS_PER_SECOND = 10_000_000;
+
+export const ticksToSeconds = (ticks: number): number => ticks / TICKS_PER_SECOND;
+
+export const ticksToMinutes = (ticks: number): number => ticksToSeconds(ticks) / 60;
+
+export const formatTicks = (ticks: number): string => {
+    const totalSeconds = Math.floor(ticksToSeconds(ticks));
+    const hours = Math.floor(totalSeconds / 3600);
+    const minutes = Math.floor((totalSeconds % 3600) / 60);
+
+    if (hours > 0) {
+        return `${hours}h ${minutes}m`;
+    }
+
+    if (minutes > 0) {
+        return `${minutes}m`;
+    }
+
+    return `${totalSeconds}s`;
+};
+
+export const formatTicksClock = (ticks: number): string => {
+    const totalSeconds = Math.max(0, Math.floor(ticksToSeconds(ticks)));
+    const hours = Math.floor(totalSeconds / 3600);
+    const minutes = Math.floor((totalSeconds % 3600) / 60);
+    const seconds = totalSeconds % 60;
+    const pad = (n: number) => n.toString().padStart(2, '0');
+    return `${pad(hours)}:${pad(minutes)}:${pad(seconds)}`;
+};
