+namespace Jellyfin.Data.Dtos;
+
+/// <summary>
+/// Sparse playback policy for an exact registered device. Null values inherit server defaults.
+/// </summary>
+public sealed class DevicePlaybackOptionsDto
+{
+    /// <summary>Gets or sets the maximum streaming bitrate in bits per second.</summary>
+    public int? MaxStreamingBitrate { get; set; }
+
+    /// <summary>Gets or sets whether direct play is allowed.</summary>
+    public bool? AllowDirectPlay { get; set; }
+
+    /// <summary>Gets or sets whether direct streaming is allowed.</summary>
+    public bool? AllowDirectStream { get; set; }
+
+    /// <summary>Gets or sets whether video transcoding is allowed.</summary>
+    public bool? AllowVideoTranscoding { get; set; }
+
+    /// <summary>Gets or sets whether audio transcoding is allowed.</summary>
+    public bool? AllowAudioTranscoding { get; set; }
+
+    /// <summary>Gets or sets a preferred advertised output video codec.</summary>
+    public string? PreferredVideoCodec { get; set; }
+
+    /// <summary>Gets or sets whether variable bitrate audio encoding is enabled.</summary>
+    public bool? EnableAudioVbr { get; set; }
+
+    /// <summary>Gets or sets audio downmix boost.</summary>
+    public double? DownMixAudioBoost { get; set; }
+
+    /// <summary>Gets or sets the downmix algorithm.</summary>
+    public string? DownMixStereoAlgorithm { get; set; }
+
+    /// <summary>Gets or sets whether tone mapping is enabled.</summary>
+    public bool? EnableTonemapping { get; set; }
+
+    /// <summary>Gets or sets whether VPP tone mapping is enabled.</summary>
+    public bool? EnableVppTonemapping { get; set; }
+
+    /// <summary>Gets or sets whether VideoToolbox tone mapping is enabled.</summary>
+    public bool? EnableVideoToolboxTonemapping { get; set; }
+
+    /// <summary>Gets or sets the tone-mapping algorithm.</summary>
+    public string? TonemappingAlgorithm { get; set; }
+
+    /// <summary>Gets or sets the tone-mapping mode.</summary>
+    public string? TonemappingMode { get; set; }
+
+    /// <summary>Gets or sets the tone-mapping range.</summary>
+    public string? TonemappingRange { get; set; }
+
+    /// <summary>Gets or sets tone-mapping desaturation.</summary>
+    public double? TonemappingDesat { get; set; }
+
+    /// <summary>Gets or sets tone-mapping peak.</summary>
+    public double? TonemappingPeak { get; set; }
+
+    /// <summary>Gets or sets tone-mapping parameter.</summary>
+    public double? TonemappingParam { get; set; }
+
+    /// <summary>Gets or sets VPP brightness.</summary>
+    public double? VppTonemappingBrightness { get; set; }
+
+    /// <summary>Gets or sets VPP contrast.</summary>
+    public double? VppTonemappingContrast { get; set; }
+
+    /// <summary>Gets or sets H.264 CRF.</summary>
+    public int? H264Crf { get; set; }
+
+    /// <summary>Gets or sets HEVC CRF.</summary>
+    public int? H265Crf { get; set; }
+
+    /// <summary>Gets or sets the encoder preset.</summary>
+    public string? EncoderPreset { get; set; }
+
+    /// <summary>Gets or sets whether double-rate deinterlacing is enabled.</summary>
+    public bool? DeinterlaceDoubleRate { get; set; }
+
+    /// <summary>Gets or sets the deinterlacing method.</summary>
+    public string? DeinterlaceMethod { get; set; }
+
+    /// <summary>Gets or sets whether hardware encoding is enabled.</summary>
+    public bool? EnableHardwareEncoding { get; set; }
+
+    /// <summary>Gets or sets whether HEVC encoding is allowed.</summary>
+    public bool? AllowHevcEncoding { get; set; }
+
+    /// <summary>Gets or sets whether AV1 encoding is allowed.</summary>
+    public bool? AllowAv1Encoding { get; set; }
+
+    /// <summary>Gets or sets whether codec fallback is enabled.</summary>
+    public bool? EnableTranscodeCodecFallback { get; set; }
+
+    /// <summary>Gets or sets whether parallel codec races are enabled.</summary>
+    public bool? EnableParallelCodecRace { get; set; }
+
+    /// <summary>Gets or sets the HLS audio seek strategy.</summary>
+    public string? HlsAudioSeekStrategy { get; set; }
+
+    /// <summary>Gets or sets the allowed hardware decoding codecs.</summary>
+    public string[]? HardwareDecodingCodecs { get; set; }
+
+    /// <summary>Gets or sets whether 10-bit HEVC hardware decoding is enabled.</summary>
+    public bool? EnableDecodingColorDepth10Hevc { get; set; }
+
+    /// <summary>Gets or sets whether 10-bit VP9 hardware decoding is enabled.</summary>
+    public bool? EnableDecodingColorDepth10Vp9 { get; set; }
+
+    /// <summary>Gets or sets whether 10-bit HEVC RExt hardware decoding is enabled.</summary>
+    public bool? EnableDecodingColorDepth10HevcRext { get; set; }
+
+    /// <summary>Gets or sets whether 12-bit HEVC RExt hardware decoding is enabled.</summary>
+    public bool? EnableDecodingColorDepth12HevcRext { get; set; }
+
+    /// <summary>Gets or sets whether enhanced NVDEC is enabled.</summary>
+    public bool? EnableEnhancedNvdecDecoder { get; set; }
+
+    /// <summary>Gets or sets whether the native hardware decoder is preferred.</summary>
+    public bool? PreferSystemNativeHwDecoder { get; set; }
+
+    /// <summary>Gets or sets whether low-power H.264 encoding is enabled.</summary>
+    public bool? EnableIntelLowPowerH264HwEncoder { get; set; }
+
+    /// <summary>Gets or sets whether low-power HEVC encoding is enabled.</summary>
+    public bool? EnableIntelLowPowerHevcHwEncoder { get; set; }
+}
