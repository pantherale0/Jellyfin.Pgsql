diff --git a/Jellyfin.Api/Helpers/DevicePlaybackOptionsHelper.cs b/Jellyfin.Api/Helpers/DevicePlaybackOptionsHelper.cs
new file mode 100644
index 0000000000..9477e5fb80
--- /dev/null
+++ b/Jellyfin.Api/Helpers/DevicePlaybackOptionsHelper.cs
@@ -0,0 +1,197 @@
+using System;
+using System.Collections.Generic;
+using System.Linq;
+using System.Security.Claims;
+using Jellyfin.Api.Extensions;
+using Jellyfin.Data.Dtos;
+using Jellyfin.Data.Queries;
+using MediaBrowser.Controller.Devices;
+using MediaBrowser.Model.Configuration;
+using MediaBrowser.Model.Entities;
+using Microsoft.AspNetCore.Http;
+using Microsoft.Extensions.DependencyInjection;
+
+namespace Jellyfin.Api.Helpers;
+
+/// <summary>
+/// Resolves a playback policy using the authenticated token's registered device, never a client-supplied device id.
+/// </summary>
+public static class DevicePlaybackOptionsHelper
+{
+    private static readonly HashSet<string> KnownHardwareCodecs = new(StringComparer.OrdinalIgnoreCase)
+    {
+        "av1", "h264", "hevc", "mpeg1video", "mpeg2video", "mpeg4", "vc1", "vp8", "vp9"
+    };
+
+    /// <summary>Gets overrides owned by the current request's registered access token.</summary>
+    /// <param name="context">The request context.</param>
+    /// <returns>Sparse options, or null for API keys and unregistered tokens.</returns>
+    public static DevicePlaybackOptionsDto? GetAuthenticatedOptions(HttpContext context)
+        => GetAuthenticatedOptions(context.RequestServices.GetRequiredService<IDeviceManager>(), context.User);
+
+    /// <summary>Gets overrides owned by an authenticated registered access token.</summary>
+    /// <param name="deviceManager">The device manager.</param>
+    /// <param name="user">The authenticated principal.</param>
+    /// <returns>Sparse options, or null for API keys and unregistered tokens.</returns>
+    public static DevicePlaybackOptionsDto? GetAuthenticatedOptions(IDeviceManager deviceManager, ClaimsPrincipal user)
+    {
+        var token = user.GetToken();
+        if (user.GetIsApiKey() || string.IsNullOrWhiteSpace(token))
+        {
+            return null;
+        }
+
+        var deviceId = deviceManager.GetDevices(new DeviceQuery { AccessToken = token }).Items.FirstOrDefault()?.DeviceId;
+        return string.IsNullOrEmpty(deviceId) ? null : deviceManager.GetDeviceOptions(deviceId)?.PlaybackOptions;
+    }
+
+    /// <summary>Clones the global configuration and applies the device's sparse overrides.</summary>
+    /// <param name="global">Server-wide encoding options.</param>
+    /// <param name="overrides">Token-owned overrides.</param>
+    /// <returns>An isolated effective configuration.</returns>
+    public static EncodingOptions CreateEffectiveOptions(EncodingOptions global, DevicePlaybackOptionsDto? overrides)
+    {
+        var options = global.Clone();
+        if (overrides is null)
+        {
+            return options;
+        }
+
+        // Hardware and codec permissions can only narrow server-wide capabilities.
+        options.EnableHardwareEncoding &= overrides.EnableHardwareEncoding ?? true;
+        options.AllowHevcEncoding &= overrides.AllowHevcEncoding ?? true;
+        options.AllowAv1Encoding &= overrides.AllowAv1Encoding ?? true;
+        options.EnableTranscodeCodecFallback &= overrides.EnableTranscodeCodecFallback ?? true;
+        options.EnableParallelCodecRace &= overrides.EnableParallelCodecRace ?? true;
+        options.EnableDecodingColorDepth10Hevc &= overrides.EnableDecodingColorDepth10Hevc ?? true;
+        options.EnableDecodingColorDepth10Vp9 &= overrides.EnableDecodingColorDepth10Vp9 ?? true;
+        options.EnableDecodingColorDepth10HevcRext &= overrides.EnableDecodingColorDepth10HevcRext ?? true;
+        options.EnableDecodingColorDepth12HevcRext &= overrides.EnableDecodingColorDepth12HevcRext ?? true;
+        options.EnableEnhancedNvdecDecoder &= overrides.EnableEnhancedNvdecDecoder ?? true;
+        options.EnableIntelLowPowerH264HwEncoder &= overrides.EnableIntelLowPowerH264HwEncoder ?? true;
+        options.EnableIntelLowPowerHevcHwEncoder &= overrides.EnableIntelLowPowerHevcHwEncoder ?? true;
+        if (overrides.HardwareDecodingCodecs is not null)
+        {
+            var allowed = overrides.HardwareDecodingCodecs.ToHashSet(StringComparer.OrdinalIgnoreCase);
+            options.HardwareDecodingCodecs = (options.HardwareDecodingCodecs ?? []).Where(allowed.Contains).ToArray();
+        }
+
+        Apply(overrides.EnableAudioVbr, value => options.EnableAudioVbr = value);
+        Apply(overrides.DownMixAudioBoost, value => options.DownMixAudioBoost = value);
+        ApplyEnum<DownMixStereoAlgorithms>(overrides.DownMixStereoAlgorithm, value => options.DownMixStereoAlgorithm = value);
+        Apply(overrides.EnableTonemapping, value => options.EnableTonemapping = value);
+        Apply(overrides.EnableVppTonemapping, value => options.EnableVppTonemapping = value);
+        Apply(overrides.EnableVideoToolboxTonemapping, value => options.EnableVideoToolboxTonemapping = value);
+        ApplyEnum<TonemappingAlgorithm>(overrides.TonemappingAlgorithm, value => options.TonemappingAlgorithm = value);
+        ApplyEnum<TonemappingMode>(overrides.TonemappingMode, value => options.TonemappingMode = value);
+        ApplyEnum<TonemappingRange>(overrides.TonemappingRange, value => options.TonemappingRange = value);
+        Apply(overrides.TonemappingDesat, value => options.TonemappingDesat = value);
+        Apply(overrides.TonemappingPeak, value => options.TonemappingPeak = value);
+        Apply(overrides.TonemappingParam, value => options.TonemappingParam = value);
+        Apply(overrides.VppTonemappingBrightness, value => options.VppTonemappingBrightness = value);
+        Apply(overrides.VppTonemappingContrast, value => options.VppTonemappingContrast = value);
+        Apply(overrides.H264Crf, value => options.H264Crf = value);
+        Apply(overrides.H265Crf, value => options.H265Crf = value);
+        ApplyEnum<EncoderPreset>(overrides.EncoderPreset, value => options.EncoderPreset = value);
+        Apply(overrides.DeinterlaceDoubleRate, value => options.DeinterlaceDoubleRate = value);
+        ApplyEnum<DeinterlaceMethod>(overrides.DeinterlaceMethod, value => options.DeinterlaceMethod = value);
+        ApplyEnum<HlsAudioSeekStrategy>(overrides.HlsAudioSeekStrategy, value => options.HlsAudioSeekStrategy = value);
+        Apply(overrides.PreferSystemNativeHwDecoder, value => options.PreferSystemNativeHwDecoder = value);
+        return options;
+    }
+
+    /// <summary>Validates administrator-supplied playback options before persistence.</summary>
+    /// <param name="options">Sparse options.</param>
+    /// <returns>An error message or null for valid settings.</returns>
+    public static string? Validate(DevicePlaybackOptionsDto options)
+    {
+        if (options.MaxStreamingBitrate is <= 0 or > 1_000_000_000)
+        {
+            return "MaxStreamingBitrate must be between 1 and 1000000000.";
+        }
+
+        if (options.H264Crf is < 0 or > 51 || options.H265Crf is < 0 or > 51)
+        {
+            return "CRF must be between 0 and 51.";
+        }
+
+        if (!InRange(options.DownMixAudioBoost, 0, 10)
+            || !InRange(options.TonemappingDesat, 0, 1)
+            || !InRange(options.TonemappingPeak, 0, 1000)
+            || !InRange(options.TonemappingParam, 0, 10)
+            || !InRange(options.VppTonemappingBrightness, -100, 100)
+            || !InRange(options.VppTonemappingContrast, 0, 10))
+        {
+            return "A numeric playback setting is out of range.";
+        }
+
+        if (!ValidEnum<DownMixStereoAlgorithms>(options.DownMixStereoAlgorithm)
+            || !ValidEnum<TonemappingAlgorithm>(options.TonemappingAlgorithm)
+            || !ValidEnum<TonemappingMode>(options.TonemappingMode)
+            || !ValidEnum<TonemappingRange>(options.TonemappingRange)
+            || !ValidEnum<EncoderPreset>(options.EncoderPreset)
+            || !ValidEnum<DeinterlaceMethod>(options.DeinterlaceMethod)
+            || !ValidEnum<HlsAudioSeekStrategy>(options.HlsAudioSeekStrategy))
+        {
+            return "Unknown playback setting enum value.";
+        }
+
+        if (options.PreferredVideoCodec is not null && NormalizeCodec(options.PreferredVideoCodec) is null)
+        {
+            return "PreferredVideoCodec must be h264, hevc, or av1.";
+        }
+
+        if (options.HardwareDecodingCodecs is { Length: > 32 }
+            || options.HardwareDecodingCodecs?.Any(codec => codec is null || !KnownHardwareCodecs.Contains(codec)) == true)
+        {
+            return "HardwareDecodingCodecs contains an unsupported codec.";
+        }
+
+        return null;
+    }
+
+    /// <summary>Promotes a codec only if the client already advertised it.</summary>
+    /// <param name="codecs">Client-advertised codecs.</param>
+    /// <param name="preferredCodec">Preferred codec.</param>
+    /// <returns>The reordered advertised codecs.</returns>
+    public static string[] ReorderVideoCodecs(IEnumerable<string> codecs, string? preferredCodec)
+    {
+        var values = codecs.ToArray();
+        var preferred = NormalizeCodec(preferredCodec);
+        return preferred is null ? values : values.OrderByDescending(codec => NormalizeCodec(codec) == preferred).ToArray();
+    }
+
+    private static string? NormalizeCodec(string? codec)
+        => codec?.Trim().ToLowerInvariant() switch
+        {
+            "h264" or "avc" or "avc1" => "h264",
+            "hevc" or "h265" or "hvc1" => "hevc",
+            "av1" or "av01" => "av1",
+            _ => null
+        };
+
+    private static bool InRange(double? value, double min, double max)
+        => value is null || (double.IsFinite(value.Value) && value >= min && value <= max);
+
+    private static bool ValidEnum<T>(string? value)
+        where T : struct, Enum
+        => value is null || (Enum.TryParse<T>(value, true, out var parsed) && Enum.IsDefined(parsed));
+
+    private static void Apply<T>(T? value, Action<T> setter)
+        where T : struct
+    {
+        if (value.HasValue)
+        {
+            setter(value.Value);
+        }
+    }
+
+    private static void ApplyEnum<T>(string? value, Action<T> setter)
+        where T : struct, Enum
+    {
+        if (Enum.TryParse<T>(value, true, out var parsed) && Enum.IsDefined(parsed))
+        {
+            setter(parsed);
+        }
+    }
+}
