+using System;
+using System.Security.Claims;
+using Jellyfin.Api.Constants;
+using Jellyfin.Api.Helpers;
+using Jellyfin.Data.Dtos;
+using Jellyfin.Data.Queries;
+using Jellyfin.Database.Implementations.Entities.Security;
+using MediaBrowser.Controller.Devices;
+using MediaBrowser.Model.Configuration;
+using MediaBrowser.Model.Querying;
+using Moq;
+using Xunit;
+
+namespace Jellyfin.Api.Tests.Helpers;
+
+/// <summary>
+/// Tests device identity and effective encoding policy isolation.
+/// </summary>
+public class DevicePlaybackOptionsHelperTests
+{
+    /// <summary>
+    /// Client-supplied device claims do not override the registered token owner.
+    /// </summary>
+    [Fact]
+    public void GetAuthenticatedOptions_UsesRegisteredTokenInsteadOfDeviceClaim()
+    {
+        var device = new Device(Guid.NewGuid(), "client", "1", "Own TV", "own-device") { AccessToken = "own-token" };
+        var manager = new Mock<IDeviceManager>();
+        manager.Setup(m => m.GetDevices(It.IsAny<DeviceQuery>()))
+            .Returns((DeviceQuery query) => query.AccessToken == device.AccessToken
