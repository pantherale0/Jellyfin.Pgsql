+    /// <summary>
+    /// Clones mutable settings and intersects hardware/codec permissions with the server.
+    /// </summary>
+    [Fact]
+    public void CreateEffectiveOptions_NeverMutatesOrExpandsGlobalCapabilities()
+    {
+        var global = new EncodingOptions
+        {
+            AllowHevcEncoding = false,
+            EnableParallelCodecRace = false,
+            HardwareDecodingCodecs = ["h264", "hevc"],
+            TonemappingAlgorithm = MediaBrowser.Model.Entities.TonemappingAlgorithm.hable
+        };
+        var overrides = new DevicePlaybackOptionsDto
+        {
+            AllowHevcEncoding = true,
+            EnableParallelCodecRace = true,
+            HardwareDecodingCodecs = ["av1", "hevc"],
+            TonemappingAlgorithm = "bt2390",
+            TonemappingRange = "tv"
+        };
+
+        var effective = DevicePlaybackOptionsHelper.CreateEffectiveOptions(global, overrides);
+        Assert.False(effective.AllowHevcEncoding);
+        Assert.False(effective.EnableParallelCodecRace);
+        Assert.Equal(["hevc"], effective.HardwareDecodingCodecs);
+        Assert.Equal(MediaBrowser.Model.Entities.TonemappingAlgorithm.bt2390, effective.TonemappingAlgorithm);
+        Assert.Equal(MediaBrowser.Model.Entities.TonemappingRange.tv, effective.TonemappingRange);
+        effective.HardwareDecodingCodecs[0] = "av1";
+        Assert.Equal(["h264", "hevc"], global.HardwareDecodingCodecs);
+    }
