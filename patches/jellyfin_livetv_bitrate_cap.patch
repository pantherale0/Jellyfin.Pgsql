+    [Fact]
+    public void GetVideoBitrateParamValue_LiveTvHevcToH264_DoesNotExceedSourceBitrate()
+    {
+        var helper = CreateHelper();
+        var videoStream = new MediaStream
+        {
+            Type = MediaStreamType.Video,
+            Codec = "hevc",
+            BitRate = 20_000_000,
+            Width = 1920,
+            Height = 1080
+        };
+        var request = new StreamingRequestDto
+        {
+            LiveStreamId = "live-1",
+            VideoBitRate = 30_000_000
+        };
+
+        var bitrate = helper.GetVideoBitrateParamValue(request, videoStream, "h264");
+
+        Assert.Equal(20_000_000, bitrate);
+    }
+
+    [Fact]
+    public void GetVideoBitrateParamValue_VodHevcToH264_StillAppliesCodecScaleUp()
+    {
+        var helper = CreateHelper();
+        var videoStream = new MediaStream
+        {
+            Type = MediaStreamType.Video,
+            Codec = "hevc",
+            BitRate = 20_000_000,
+            Width = 1920,
+            Height = 1080
+        };
+        var request = new StreamingRequestDto
+        {
+            VideoBitRate = 30_000_000
+        };
+
+        var bitrate = helper.GetVideoBitrateParamValue(request, videoStream, "h264");
+
+        // ScaleBitrate raises HEVC→H.264 (~1.67×) then caps at the requested max.
+        Assert.Equal(30_000_000, bitrate);
+    }
