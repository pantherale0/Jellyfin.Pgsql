# Cap Live TV transcode target bitrate with codec-aware soft ceiling.
# Same-efficiency codecs stay at source; cross-codec (e.g. HEVC→H.264) allows
# ScaleBitrate but soft-caps at 1.4× source to avoid ~30 Mbps realtime overload.
#
diff --git a/MediaBrowser.Controller/MediaEncoding/EncodingHelper.cs b/MediaBrowser.Controller/MediaEncoding/EncodingHelper.cs
index 847f4cf187..ccbd7f9b1a 100644
--- a/MediaBrowser.Controller/MediaEncoding/EncodingHelper.cs
+++ b/MediaBrowser.Controller/MediaEncoding/EncodingHelper.cs
@@ -2714,6 +2714,22 @@ namespace MediaBrowser.Controller.MediaEncoding
                     {
                         bitrate = Math.Min(bitrate.Value, request.VideoBitRate.Value);
                     }
+
+                    // Live TV bitrate ceiling when not upscaling:
+                    // - Same codec-efficiency class → never exceed source (no quality gain from more bits).
+                    // - Cross-codec (e.g. HEVC→H.264) → allow ScaleBitrate, but soft-cap at 1.4× source
+                    //   so we don't push full ~1.67× (often ~30 Mbps) and starve realtime encode.
+                    if (!isUpscaling
+                        && !string.IsNullOrWhiteSpace(request.LiveStreamId)
+                        && videoStream.BitRate.HasValue)
+                    {
+                        var inputScale = GetVideoBitrateScaleFactor(inputVideoCodec);
+                        var outputScale = GetVideoBitrateScaleFactor(outputVideoCodec);
+                        var ceiling = inputScale == outputScale
+                            ? videoStream.BitRate.Value
+                            : Convert.ToInt32(videoStream.BitRate.Value * 1.4);
+                        bitrate = Math.Min(bitrate.Value, ceiling);
+                    }
                 }
             }
 
