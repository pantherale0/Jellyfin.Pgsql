# Cap Live TV transcode target bitrate at source bitrate.
# Codec-efficiency scaling (HEVC→H.264) was raising Live TV targets above source
# (e.g. 20 Mbps → ~30 Mbps via FallbackMaxStreamingBitrate), hurting realtime encode.
#
diff --git a/MediaBrowser.Controller/MediaEncoding/EncodingHelper.cs b/MediaBrowser.Controller/MediaEncoding/EncodingHelper.cs
index 847f4cf187..21fd2df67e 100644
--- a/MediaBrowser.Controller/MediaEncoding/EncodingHelper.cs
+++ b/MediaBrowser.Controller/MediaEncoding/EncodingHelper.cs
@@ -2714,6 +2714,17 @@ namespace MediaBrowser.Controller.MediaEncoding
                     {
                         bitrate = Math.Min(bitrate.Value, request.VideoBitRate.Value);
                     }
+
+                    // Live TV: never target above the known source bitrate when not upscaling.
+                    // Codec-efficiency scaling (e.g. HEVC→H.264 ≈1.67×) can push the target above
+                    // source. That does not recover quality from an already-lossy live encode and
+                    // makes realtime software/hardware encode harder — often dropping below 1.0×.
+                    if (!isUpscaling
+                        && !string.IsNullOrWhiteSpace(request.LiveStreamId)
+                        && videoStream.BitRate.HasValue)
+                    {
+                        bitrate = Math.Min(bitrate.Value, videoStream.BitRate.Value);
+                    }
                 }
             }
 
