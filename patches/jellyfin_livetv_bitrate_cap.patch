+    [Fact]
+    public void GetVideoBitrateParamValue_LiveTvHevcToH264_SoftCapsAt1_4xSource()
+    {
+        var helper = CreateHelper();
+        var videoStream = new MediaStream
+        {
+            Type = MediaStreamType.Video,
+            Codec = "hevc",
+            BitRate = 20_000_000,
+            Width = 1920,
+            Height = 1080
+        };
+        var request = new StreamingRequestDto
+        {
+            LiveStreamId = "live-1",
+            VideoBitRate = 30_000_000
+        };
+
+        var bitrate = helper.GetVideoBitrateParamValue(request, videoStream, "h264");
+
+        // Cross-codec Live TV: ScaleBitrate (~1.67×) then soft-cap at 1.4× source.
+        Assert.Equal(28_000_000, bitrate);
+    }
+
