+
+    /// <summary>
+    /// Appends a query string to every media URI in an HLS playlist.
+    /// </summary>
+    /// <param name="playlistText">The playlist body.</param>
+    /// <param name="queryString">Query string including leading '?', or empty.</param>
+    /// <returns>Playlist text with query string on each URI.</returns>
+    internal static string AppendQueryStringToPlaylistUris(string playlistText, string queryString)
+    {
+        if (string.IsNullOrEmpty(queryString))
+        {
+            return playlistText;
+        }
+
+        if (queryString[0] != '?')
+        {
+            queryString = "?" + queryString;
+        }
+
+        var lines = playlistText.Split('\n');
+        for (var i = 0; i < lines.Length; i++)
+        {
+            var line = lines[i];
+            var ending = string.Empty;
+            if (line.EndsWith('\r'))
+            {
+                ending = "\r";
+                line = line[..^1];
+            }
+
+            if (line.Length == 0)
+            {
+                continue;
+            }
+
+            if (line[0] == '#')
+            {
+                // #EXT-X-MAP:URI="path" — inject query before the closing quote.
+                const string MapUriPrefix = "URI=\"";
+                var mapUriIndex = line.IndexOf(MapUriPrefix, StringComparison.Ordinal);
+                if (mapUriIndex >= 0)
+                {
+                    var uriStart = mapUriIndex + MapUriPrefix.Length;
+                    var uriEnd = line.IndexOf('"', uriStart);
+                    if (uriEnd > uriStart)
+                    {
+                        var uri = line[uriStart..uriEnd];
+                        if (!uri.Contains('?', StringComparison.Ordinal))
+                        {
+                            lines[i] = string.Concat(line.AsSpan(0, uriEnd), queryString, line.AsSpan(uriEnd), ending);
+                        }
+                    }
+                }
+
+                continue;
+            }
+
+            // Media segment URI line.
+            if (!line.Contains('?', StringComparison.Ordinal))
+            {
+                lines[i] = line + queryString + ending;
+            }
+        }
+
+        return string.Join('\n', lines);
     }
