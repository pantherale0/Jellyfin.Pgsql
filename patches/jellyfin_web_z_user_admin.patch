diff --git a/src/apps/dashboard/routes/users/merge.tsx b/src/apps/dashboard/routes/users/merge.tsx
new file mode 100644
index 0000000000..48c6a805a7
--- /dev/null
+++ b/src/apps/dashboard/routes/users/merge.tsx
@@ -0,0 +1,343 @@
+import Alert from '@mui/material/Alert';
+import Box from '@mui/material/Box';
+import Button from '@mui/material/Button';
+import FormControl from '@mui/material/FormControl';
+import FormControlLabel from '@mui/material/FormControlLabel';
+import InputLabel from '@mui/material/InputLabel';
+import MenuItem from '@mui/material/MenuItem';
+import Radio from '@mui/material/Radio';
+import RadioGroup from '@mui/material/RadioGroup';
+import Select from '@mui/material/Select';
+import Stack from '@mui/material/Stack';
+import Table from '@mui/material/Table';
+import TableBody from '@mui/material/TableBody';
+import TableCell from '@mui/material/TableCell';
+import TableHead from '@mui/material/TableHead';
+import TableRow from '@mui/material/TableRow';
+import TextField from '@mui/material/TextField';
+import Typography from '@mui/material/Typography';
+import React, { useCallback, useMemo, useState } from 'react';
+import { useNavigate, useSearchParams } from 'react-router-dom';
+
+import Page from 'components/Page';
+import Loading from 'components/loading/LoadingComponent';
+import {
+    useExecuteUserTransfer,
+    usePreviewUserTransfer
+} from 'apps/dashboard/features/userAdmin/api/useUserAdmin';
+import type {
+    UserAdminMode,
+    UserAdminTransferResponse,
+    UserMergeCounts
+} from 'apps/dashboard/features/userAdmin/types';
+import { QUERY_KEY, useUsers } from 'hooks/useUsers';
+import globalize from 'lib/globalize';
+import { queryClient } from 'utils/query/queryClient';
+
+const countRows = (counts: UserMergeCounts, mode: UserAdminMode): { label: string; value: string }[] => {
+    const rows = [
+        { label: globalize.translate('UserAdminCountUserDataMoved'), value: String(counts.userDataMoved) },
+        { label: globalize.translate('UserAdminCountUserDataMerged'), value: String(counts.userDataMerged) }
+    ];
+
+    if (mode === 'merge') {
+        rows.push(
+            { label: globalize.translate('UserAdminCountPlaybackActivity'), value: String(counts.playbackActivityMoved) },
+            { label: globalize.translate('UserAdminCountDisplayPreferencesMoved'), value: String(counts.displayPreferencesMoved) },
+            { label: globalize.translate('UserAdminCountDisplayPreferencesDropped'), value: String(counts.displayPreferencesDropped) },
+            { label: globalize.translate('UserAdminCountItemDisplayPreferencesMoved'), value: String(counts.itemDisplayPreferencesMoved) },
+            { label: globalize.translate('UserAdminCountItemDisplayPreferencesDropped'), value: String(counts.itemDisplayPreferencesDropped) },
+            { label: globalize.translate('UserAdminCountCustomItemDisplayPreferencesMoved'), value: String(counts.customItemDisplayPreferencesMoved) },
+            { label: globalize.translate('UserAdminCountCustomItemDisplayPreferencesDropped'), value: String(counts.customItemDisplayPreferencesDropped) },
+            { label: globalize.translate('UserAdminCountDevicesMoved'), value: String(counts.devicesMoved) },
+            { label: globalize.translate('UserAdminCountDevicesDeactivated'), value: String(counts.devicesDeactivated) },
+            { label: globalize.translate('UserAdminCountPermissionsDropped'), value: String(counts.permissionsDropped) },
+            { label: globalize.translate('UserAdminCountPreferencesUnioned'), value: String(counts.preferencesUnioned) },
+            { label: globalize.translate('UserAdminCountPreferencesDropped'), value: String(counts.preferencesDropped) },
+            { label: globalize.translate('UserAdminCountAccessSchedulesDropped'), value: String(counts.accessSchedulesDropped) },
+            { label: globalize.translate('UserAdminCountImageInfosDropped'), value: String(counts.imageInfosDropped) },
+            { label: globalize.translate('UserAdminCountActivityLogsMoved'), value: String(counts.activityLogsMoved) },
+            {
+                label: globalize.translate('UserAdminCountTasteProfileSourceRemoved'),
+                value: counts.tasteProfileSourceRemoved ? globalize.translate('Yes') : globalize.translate('No')
+            },
+            {
+                label: globalize.translate('UserAdminCountSourceUserDeleted'),
+                value: counts.sourceUserDeleted ? globalize.translate('Yes') : globalize.translate('No')
+            }
+        );
+    }
+
+    if (counts.tasteProfileTargetRebuilt) {
+        rows.push({
+            label: globalize.translate('UserAdminCountTasteProfileTargetRebuilt'),
+            value: globalize.translate('Yes')
+        });
+    }
+
+    return rows;
+};
+
+const UserMergePage = () => {
+    const navigate = useNavigate();
+    const [ searchParams ] = useSearchParams();
+    const initialSource = searchParams.get('source') || '';
+
+    const { data: users, isPending } = useUsers(undefined, { forceRefresh: true });
+    const previewMutation = usePreviewUserTransfer();
+    const executeMutation = useExecuteUserTransfer();
+
+    const [ mode, setMode ] = useState<UserAdminMode>('merge');
+    const [ sourceUserId, setSourceUserId ] = useState(initialSource);
+    const [ targetUserId, setTargetUserId ] = useState('');
+    const [ confirmName, setConfirmName ] = useState('');
+    const [ preview, setPreview ] = useState<UserAdminTransferResponse | null>(null);
+    const [ result, setResult ] = useState<UserAdminTransferResponse | null>(null);
+    const [ error, setError ] = useState<string | null>(null);
+
+    const sourceUser = useMemo(
+        () => users?.find(u => u.Id === sourceUserId),
+        [ users, sourceUserId ]
+    );
+    const targetUser = useMemo(
+        () => users?.find(u => u.Id === targetUserId),
+        [ users, targetUserId ]
+    );
+
+    const canPreview = !!sourceUserId && !!targetUserId && sourceUserId !== targetUserId;
+    const confirmMatches = !!sourceUser?.Name
+        && confirmName.trim().localeCompare(sourceUser.Name, undefined, { sensitivity: 'accent' }) === 0;
+    const canExecute = canPreview && confirmMatches && !!preview && !executeMutation.isPending;
+
+    const resetDownstream = useCallback(() => {
+        setPreview(null);
+        setResult(null);
+        setConfirmName('');
+        setError(null);
+    }, []);
+
+    const handlePreview = useCallback(() => {
+        if (!canPreview) {
+            return;
+        }
+
+        setError(null);
+        setResult(null);
+        previewMutation.mutate(
+            { mode, sourceUserId, targetUserId },
+            {
+                onSuccess: (data) => setPreview(data),
+                onError: (err: unknown) => {
+                    const message = (err as { response?: { data?: string } })?.response?.data
+                        || globalize.translate('UserAdminPreviewFailed');
+                    setError(typeof message === 'string' ? message : globalize.translate('UserAdminPreviewFailed'));
+                    setPreview(null);
+                }
+            }
+        );
+    }, [ canPreview, mode, previewMutation, sourceUserId, targetUserId ]);
+
+    const handleExecute = useCallback(() => {
+        if (!canExecute) {
+            return;
+        }
+
+        setError(null);
+        executeMutation.mutate(
+            { mode, sourceUserId, targetUserId },
+            {
+                onSuccess: (data) => {
+                    setResult(data);
+                    setPreview(null);
+                    void queryClient.invalidateQueries({ queryKey: [ QUERY_KEY ] });
+                },
+                onError: (err: unknown) => {
+                    const message = (err as { response?: { data?: string } })?.response?.data
+                        || globalize.translate('UserAdminExecuteFailed');
+                    setError(typeof message === 'string' ? message : globalize.translate('UserAdminExecuteFailed'));
+                }
+            }
+        );
+    }, [ canExecute, executeMutation, mode, sourceUserId, targetUserId ]);
+
+    if (isPending) {
+        return <Loading />;
+    }
+
+    const displayCounts = result?.counts || preview?.counts;
+
+    return (
+        <Page
+            id='userMergePage'
+            className='mainAnimatedPage type-interior'
+            title={globalize.translate('HeaderUserAdminMerge')}
+        >
+            <Box className='content-primary' sx={{ maxWidth: 720 }}>
+                <Stack spacing={3}>
+                    <Typography variant='body1'>
+                        {globalize.translate('UserAdminMergeHelp')}
+                    </Typography>
+
+                    <FormControl>
+                        <Typography variant='subtitle2' gutterBottom>
+                            {globalize.translate('UserAdminMode')}
+                        </Typography>
+                        <RadioGroup
+                            row
+                            value={mode}
+                            onChange={(e) => {
+                                setMode(e.target.value as UserAdminMode);
+                                resetDownstream();
+                            }}
+                        >
+                            <FormControlLabel
+                                value='merge'
+                                control={<Radio />}
+                                label={globalize.translate('UserAdminModeMerge')}
+                            />
+                            <FormControlLabel
+                                value='moveUserData'
+                                control={<Radio />}
+                                label={globalize.translate('UserAdminModeMoveUserData')}
+                            />
+                        </RadioGroup>
+                    </FormControl>
+
+                    <FormControl fullWidth>
+                        <InputLabel id='source-user-label'>
+                            {globalize.translate('UserAdminSourceUser')}
+                        </InputLabel>
+                        <Select
+                            labelId='source-user-label'
+                            label={globalize.translate('UserAdminSourceUser')}
+                            value={sourceUserId}
+                            onChange={(e) => {
+                                setSourceUserId(e.target.value);
+                                resetDownstream();
+                            }}
+                        >
+                            {(users || []).map(user => (
+                                <MenuItem key={user.Id} value={user.Id || ''} disabled={user.Id === targetUserId}>
+                                    {user.Name}
+                                </MenuItem>
+                            ))}
+                        </Select>
+                    </FormControl>
+
+                    <FormControl fullWidth>
+                        <InputLabel id='target-user-label'>
+                            {globalize.translate('UserAdminTargetUser')}
+                        </InputLabel>
+                        <Select
+                            labelId='target-user-label'
+                            label={globalize.translate('UserAdminTargetUser')}
+                            value={targetUserId}
+                            onChange={(e) => {
+                                setTargetUserId(e.target.value);
+                                resetDownstream();
+                            }}
+                        >
+                            {(users || []).map(user => (
+                                <MenuItem key={user.Id} value={user.Id || ''} disabled={user.Id === sourceUserId}>
+                                    {user.Name}
+                                </MenuItem>
+                            ))}
+                        </Select>
+                    </FormControl>
+
+                    {mode === 'merge' && (
+                        <Alert severity='warning'>
+                            {globalize.translate('UserAdminMergeWarning')}
+                        </Alert>
+                    )}
+
+                    <Stack direction='row' spacing={2}>
+                        <Button
+                            variant='outlined'
+                            disabled={!canPreview || previewMutation.isPending}
+                            onClick={handlePreview}
+                        >
+                            {globalize.translate('UserAdminPreview')}
+                        </Button>
+                        <Button variant='text' onClick={() => navigate('/dashboard/users')}>
+                            {globalize.translate('ButtonCancel')}
+                        </Button>
+                    </Stack>
+
+                    {error && <Alert severity='error'>{error}</Alert>}
+
+                    {displayCounts && (
+                        <Box>
+                            <Typography variant='h6' gutterBottom>
+                                {result
+                                    ? globalize.translate('UserAdminResult')
+                                    : globalize.translate('UserAdminPreviewResult')}
+                            </Typography>
+                            <Table size='small'>
+                                <TableHead>
+                                    <TableRow>
+                                        <TableCell>{globalize.translate('LabelType')}</TableCell>
+                                        <TableCell align='right'>{globalize.translate('UserAdminCount')}</TableCell>
+                                    </TableRow>
+                                </TableHead>
+                                <TableBody>
+                                    {countRows(displayCounts, mode).map(row => (
+                                        <TableRow key={row.label}>
+                                            <TableCell>{row.label}</TableCell>
+                                            <TableCell align='right'>{row.value}</TableCell>
+                                        </TableRow>
+                                    ))}
+                                </TableBody>
+                            </Table>
+                        </Box>
+                    )}
+
+                    {preview && !result && (
+                        <Stack spacing={2}>
+                            <TextField
+                                fullWidth
+                                label={globalize.translate('UserAdminConfirmUsername', sourceUser?.Name || '')}
+                                value={confirmName}
+                                onChange={(e) => setConfirmName(e.target.value)}
+                                helperText={globalize.translate(
+                                    'UserAdminConfirmHelp',
+                                    sourceUser?.Name || '',
+                                    targetUser?.Name || ''
+                                )}
+                            />
+                            <Button
+                                variant='contained'
+                                color='error'
+                                disabled={!canExecute}
+                                onClick={handleExecute}
+                            >
+                                {mode === 'merge'
+                                    ? globalize.translate('UserAdminConfirmMerge')
+                                    : globalize.translate('UserAdminConfirmMove')}
+                            </Button>
+                        </Stack>
+                    )}
+
+                    {result?.warning && (
+                        <Alert severity='info'>{result.warning}</Alert>
+                    )}
+
+                    {result && (
+                        <Button
+                            variant='contained'
+                            onClick={() => navigate(
+                                mode === 'merge'
+                                    ? `/dashboard/users/${targetUserId}/profile`
+                                    : '/dashboard/users'
+                            )}
+                        >
+                            {globalize.translate('ButtonOk')}
+                        </Button>
+                    )}
+                </Stack>
+            </Box>
+        </Page>
+    );
+};
+
+export default UserMergePage;
