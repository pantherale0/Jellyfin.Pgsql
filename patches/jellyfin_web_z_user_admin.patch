@@ -0,0 +1,38 @@
+import { useMutation } from '@tanstack/react-query';
+
+import { useApi } from 'hooks/useApi';
+
+import type { UserAdminMode } from '../types';
+import { executeUserTransfer, previewUserTransfer } from './userAdminApi';
+
+export const usePreviewUserTransfer = () => {
+    const { api } = useApi();
+
+    return useMutation({
+        mutationFn: ({
+            mode,
+            sourceUserId,
+            targetUserId
+        }: {
+            mode: UserAdminMode;
+            sourceUserId: string;
+            targetUserId: string;
+        }) => previewUserTransfer(api!, mode, sourceUserId, targetUserId)
+    });
+};
+
+export const useExecuteUserTransfer = () => {
+    const { api } = useApi();
+
+    return useMutation({
+        mutationFn: ({
+            mode,
+            sourceUserId,
+            targetUserId
+        }: {
+            mode: UserAdminMode;
+            sourceUserId: string;
+            targetUserId: string;
+        }) => executeUserTransfer(api!, mode, sourceUserId, targetUserId)
+    });
+};
diff --git a/src/apps/dashboard/features/userAdmin/api/userAdminApi.ts b/src/apps/dashboard/features/userAdmin/api/userAdminApi.ts
