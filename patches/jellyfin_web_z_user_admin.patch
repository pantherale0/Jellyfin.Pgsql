+export interface UserMergeCounts {
+    userDataMoved: number;
+    userDataMerged: number;
+    playbackActivityMoved: number;
+    displayPreferencesMoved: number;
+    displayPreferencesDropped: number;
+    itemDisplayPreferencesMoved: number;
+    itemDisplayPreferencesDropped: number;
+    customItemDisplayPreferencesMoved: number;
+    customItemDisplayPreferencesDropped: number;
+    devicesMoved: number;
+    devicesDeactivated: number;
+    permissionsDropped: number;
+    preferencesUnioned: number;
+    preferencesDropped: number;
+    accessSchedulesDropped: number;
+    imageInfosDropped: number;
+    activityLogsMoved: number;
+    tasteProfileSourceRemoved: boolean;
+    tasteProfileTargetRebuilt: boolean;
+    sourceUserDeleted: boolean;
+}
+
+export interface UserAdminTransferResponse {
+    isPreview: boolean;
+    counts: UserMergeCounts;
+    warning?: string | null;
+}
+
+export type UserAdminMode = 'merge' | 'moveUserData';
