@@ -0,0 +1,50 @@
+import type { Api } from '@jellyfin/sdk';
+import type { AxiosRequestConfig } from 'axios';
+
+import type { UserAdminMode, UserAdminTransferResponse } from '../types';
+
+const postTransfer = async (
+    api: Api,
+    path: string,
+    sourceUserId: string,
+    targetUserId: string,
+    options?: AxiosRequestConfig
+): Promise<UserAdminTransferResponse> => {
+    const response = await api.axiosInstance.post<UserAdminTransferResponse>(
+        path,
+        { sourceUserId, targetUserId },
+        {
+            ...options,
+            baseURL: api.basePath,
+            headers: {
+                ...options?.headers,
+                Authorization: api.authorizationHeader
+            }
+        }
+    );
+    return response.data;
+};
+
+const previewPath = (mode: UserAdminMode) =>
+    mode === 'merge' ? '/Pgsql/Admin/Users/Merge/Preview' : '/Pgsql/Admin/Users/MoveUserData/Preview';
+
+const executePath = (mode: UserAdminMode) =>
+    mode === 'merge' ? '/Pgsql/Admin/Users/Merge' : '/Pgsql/Admin/Users/MoveUserData';
+
+export const previewUserTransfer = (
+    api: Api,
+    mode: UserAdminMode,
+    sourceUserId: string,
+    targetUserId: string,
+    options?: AxiosRequestConfig
+): Promise<UserAdminTransferResponse> =>
+    postTransfer(api, previewPath(mode), sourceUserId, targetUserId, options);
+
+export const executeUserTransfer = (
+    api: Api,
+    mode: UserAdminMode,
+    sourceUserId: string,
+    targetUserId: string,
+    options?: AxiosRequestConfig
+): Promise<UserAdminTransferResponse> =>
+    postTransfer(api, executePath(mode), sourceUserId, targetUserId, options);
