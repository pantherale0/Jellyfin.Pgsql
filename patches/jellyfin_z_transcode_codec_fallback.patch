+namespace MediaBrowser.Controller.MediaEncoding;
+
+/// <summary>
+/// Result of launching a single ffmpeg transcode attempt.
+/// </summary>
+public sealed class TranscodeAttemptResult
+{
+    /// <summary>
+    /// Gets the transcoding job.
+    /// </summary>
+    public TranscodingJob? Job { get; init; }
+
+    /// <summary>
+    /// Gets a value indicating whether the wait target was created before exit.
+    /// </summary>
+    public bool Succeeded { get; init; }
+
+    /// <summary>
+    /// Gets the process exit code when the attempt failed early.
+    /// </summary>
+    public int? ExitCode { get; init; }
+}
diff --git a/MediaBrowser.MediaEncoding/Transcoding/ITranscodeCodecRaceCoordinator.cs b/MediaBrowser.MediaEncoding/Transcoding/ITranscodeCodecRaceCoordinator.cs
