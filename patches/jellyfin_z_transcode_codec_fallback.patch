+    private string ResolvePlaylistPath(StreamingRequestDto streamingRequest, StreamState state)
+    {
+        if (!string.IsNullOrWhiteSpace(streamingRequest.PlaySessionId)
+            && _sessionBinding.TryGet(streamingRequest.PlaySessionId, out var binding))
+        {
+            return binding.PlaylistPath;
+        }
+
+        return Path.ChangeExtension(state.OutputFilePath, ".m3u8");
+    }
+
+    private ActionResult? TryRedirectToBoundCodec(StreamingRequestDto streamingRequest)
+    {
+        if (streamingRequest is not VideoRequestDto videoRequest
+            || string.IsNullOrWhiteSpace(streamingRequest.PlaySessionId)
+            || string.IsNullOrWhiteSpace(videoRequest.VideoCodec)
+            || !_sessionBinding.TryGet(streamingRequest.PlaySessionId, out var binding))
+        {
+            return null;
+        }
+
+        if (string.Equals(videoRequest.VideoCodec, binding.WinningCodec, StringComparison.OrdinalIgnoreCase))
+        {
+            return null;
+        }
+
+        return Redirect(BuildSegmentRedirectUrl(videoRequest.VideoCodec, binding.WinningCodec));
+    }
+
+    private string BuildSegmentRedirectUrl(string? fromCodec, string toCodec)
+    {
+        var query = QueryHelpers.ParseQuery(Request.QueryString.Value ?? string.Empty);
+        var values = new Dictionary<string, StringValues>(StringComparer.OrdinalIgnoreCase);
+        foreach (var pair in query)
+        {
+            values[pair.Key] = pair.Value;
+        }
+
+        values["VideoCodec"] = toCodec;
+        return Request.Path + QueryString.Create(values).ToUriComponent();
+    }
+
