@@ -0,0 +1,79 @@
+using System;
+using System.Threading;
+using System.Threading.Tasks;
+using MediaBrowser.Controller.MediaEncoding;
+using MediaBrowser.Controller.Streaming;
+
+namespace MediaBrowser.MediaEncoding.Transcoding;
+
+/// <summary>
+/// Coordinates parallel codec races and sequential fallback for HLS init transcodes.
+/// </summary>
+public interface ITranscodeCodecRaceCoordinator
+{
+    /// <summary>
+    /// Starts a parallel race or sequential fallback chain for HLS init transcodes.
+    /// </summary>
+    /// <param name="context">The fallback context.</param>
+    /// <param name="cancellationToken">The cancellation token.</param>
+    /// <returns>The fallback result.</returns>
+    Task<TranscodeCodecFallbackResult> StartWithFallbackAsync(
+        TranscodeCodecFallbackContext context,
+        CancellationToken cancellationToken);
+}
+
+/// <summary>
+/// Context required to start codec fallback.
+/// </summary>
+public sealed class TranscodeCodecFallbackContext
+{
+    /// <summary>
+    /// Gets the primary stream state.
+    /// </summary>
+    public required StreamState State { get; init; }
+
+    /// <summary>
+    /// Gets the user id.
+    /// </summary>
+    public required Guid UserId { get; init; }
+
+    /// <summary>
+    /// Gets the item display name.
+    /// </summary>
+    public string? ItemName { get; init; }
+
+    /// <summary>
+    /// Gets the item id.
+    /// </summary>
+    public Guid? ItemId { get; init; }
+
+    /// <summary>
+    /// Gets the init segment path for the primary state.
+    /// </summary>
+    public required string InitSegmentPath { get; init; }
+
+    /// <summary>
+    /// Gets the init segment index (-1 for fMP4 init segments).
+    /// </summary>
+    public required int InitSegmentIndex { get; init; }
+
+    /// <summary>
+    /// Gets the segment index used when building ffmpeg arguments.
+    /// </summary>
+    public required int SegmentIndex { get; init; }
+
+    /// <summary>
+    /// Gets a value indicating whether this is an init segment request.
+    /// </summary>
+    public required bool IsInitSegmentRequest { get; init; }
+
+    /// <summary>
+    /// Gets the factory that rebuilds stream state for a target codec.
+    /// </summary>
+    public required Func<string, CancellationToken, Task<StreamState>> CreateStateForCodecAsync { get; init; }
+
+    /// <summary>
+    /// Gets the factory that builds ffmpeg command line arguments.
+    /// </summary>
+    public required Func<StreamState, string, int, string> BuildCommandLineArguments { get; init; }
+}
