diff --git a/MediaBrowser.MediaEncoding/Transcoding/TranscodeSessionBinding.cs b/MediaBrowser.MediaEncoding/Transcoding/TranscodeSessionBinding.cs
new file mode 100644
index 0000000000..1dfa06a50b
--- /dev/null
+++ b/MediaBrowser.MediaEncoding/Transcoding/TranscodeSessionBinding.cs
@@ -0,0 +1,64 @@
+using System;
+using System.Collections.Concurrent;
+
+namespace MediaBrowser.MediaEncoding.Transcoding;
+
+/// <summary>
+/// Tracks the winning codec playlist per play session after a race or fallback.
+/// </summary>
+public sealed class TranscodeSessionBinding
+{
+    private readonly ConcurrentDictionary<string, TranscodeSessionEntry> _entries = new(StringComparer.OrdinalIgnoreCase);
+
+    /// <summary>
+    /// Binds a play session to the winning transcode output.
+    /// </summary>
+    /// <param name="playSessionId">The play session id.</param>
+    /// <param name="winningCodec">The winning logical video codec.</param>
+    /// <param name="playlistPath">The winning playlist path.</param>
+    public void Bind(string playSessionId, string winningCodec, string playlistPath)
+    {
+        if (string.IsNullOrWhiteSpace(playSessionId))
+        {
+            return;
+        }
+
+        _entries[playSessionId] = new TranscodeSessionEntry(winningCodec, playlistPath);
+    }
+
+    /// <summary>
+    /// Tries to get the binding for a play session.
+    /// </summary>
+    /// <param name="playSessionId">The play session id.</param>
+    /// <param name="entry">The binding entry.</param>
+    /// <returns><c>true</c> when a binding exists.</returns>
+    public bool TryGet(string playSessionId, out TranscodeSessionEntry entry)
+    {
+        if (string.IsNullOrWhiteSpace(playSessionId))
+        {
+            entry = default!;
+            return false;
+        }
+
+        return _entries.TryGetValue(playSessionId, out entry!);
+    }
+
+    /// <summary>
+    /// Removes a play session binding.
+    /// </summary>
+    /// <param name="playSessionId">The play session id.</param>
+    public void Remove(string playSessionId)
+    {
+        if (!string.IsNullOrWhiteSpace(playSessionId))
+        {
+            _entries.TryRemove(playSessionId, out _);
+        }
+    }
+
+    /// <summary>
+    /// A bound play session entry.
+    /// </summary>
+    /// <param name="WinningCodec">The winning codec.</param>
+    /// <param name="PlaylistPath">The winning playlist path.</param>
+    public readonly record struct TranscodeSessionEntry(string WinningCodec, string PlaylistPath);
+}
