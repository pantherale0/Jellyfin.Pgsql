+    /// <param name="state">The stream state.</param>
+    /// <param name="encodingOptions">Encoding options.</param>
+    /// <param name="isInitSegmentRequest">Whether the init segment is being requested.</param>
+    /// <returns><c>true</c> when parallel race is allowed.</returns>
+    public static bool IsRaceEligible(StreamState state, EncodingOptions encodingOptions, bool isInitSegmentRequest)
+    {
+        if (!isInitSegmentRequest
+            || !encodingOptions.EnableTranscodeCodecFallback
+            || !encodingOptions.EnableParallelCodecRace
+            || state.VideoRequest is null
+            || EncodingHelper.IsCopyCodec(state.OutputVideoCodec)
+            || state.InputProtocol != MediaProtocol.File
+            || state.IsSegmentedLiveStream)
+        {
+            return false;
+        }
+
+        var raceCandidates = GetRaceCandidates(state, encodingOptions);
+        return raceCandidates.Count >= 2;
+    }
+
+    /// <summary>
+    /// Gets codecs to run in parallel at init.
+    /// </summary>
+    /// <param name="state">The stream state.</param>
+    /// <param name="encodingOptions">Encoding options.</param>
+    /// <returns>Distinct codec names.</returns>
+    public static IReadOnlyList<string> GetRaceCandidates(StreamState state, EncodingOptions encodingOptions)
+    {
+        if (!encodingOptions.EnableTranscodeCodecFallback)
+        {
+            return [];
+        }
+
+        var supported = GetSupportedCodecs(state);
+        var candidates = new List<string>();
+
+        foreach (var codec in _raceCodecs)
+        {
+            if (!IsCodecAllowed(codec, encodingOptions))
+            {
+                continue;
+            }
+
+            if (supported.Contains(codec, StringComparer.OrdinalIgnoreCase)
+                || string.Equals(state.OutputVideoCodec, codec, StringComparison.OrdinalIgnoreCase))
+            {
+                candidates.Add(NormalizeCodec(codec));
+            }
+        }
+
+        if (candidates.Count < 2 && encodingOptions.AllowAv1Encoding)
+        {
+            if (IsCodecAllowed("h264", encodingOptions) && !candidates.Contains("h264", StringComparer.OrdinalIgnoreCase))
+            {
+                candidates.Add("h264");
+            }
+
+            if (IsCodecAllowed("av1", encodingOptions) && !candidates.Contains("av1", StringComparer.OrdinalIgnoreCase))
+            {
+                candidates.Add("av1");
+            }
+        }
+
+        return candidates
+            .Distinct(StringComparer.OrdinalIgnoreCase)
+            .ToList();
+    }
+
+    /// <summary>
+    /// Gets the sequential fallback chain starting from the requested codec.
+    /// </summary>
+    /// <param name="state">The stream state.</param>
+    /// <param name="encodingOptions">Encoding options.</param>
+    /// <returns>Ordered codec names.</returns>
+    public static IReadOnlyList<string> GetSequentialChain(StreamState state, EncodingOptions encodingOptions)
+    {
+        if (!encodingOptions.EnableTranscodeCodecFallback)
+        {
+            var requested = NormalizeCodec(state.OutputVideoCodec);
+            return string.IsNullOrEmpty(requested) ? [] : [requested];
+        }
+
+        var supported = GetSupportedCodecs(state);
+        var ordered = new List<string>();
+        var requestedCodec = NormalizeCodec(state.Request.VideoCodec ?? state.OutputVideoCodec);
+
+        if (!string.IsNullOrEmpty(requestedCodec)
+            && IsCodecAllowed(requestedCodec, encodingOptions)
+            && (supported.Count == 0 || supported.Contains(requestedCodec, StringComparer.OrdinalIgnoreCase)))
+        {
+            ordered.Add(requestedCodec);
+        }
+
+        foreach (var codec in _sequentialCodecs)
+        {
+            var normalized = NormalizeCodec(codec);
+            if (ordered.Contains(normalized, StringComparer.OrdinalIgnoreCase))
+            {
+                continue;
+            }
+
+            if (!IsCodecAllowed(normalized, encodingOptions))
+            {
+                continue;
+            }
+
+            if (ordered.Count == 0
+                && supported.Count > 0
+                && !supported.Contains(normalized, StringComparer.OrdinalIgnoreCase))
+            {
+                continue;
+            }
+
+            ordered.Add(normalized);
+        }
+
+        return ordered;
+    }
+
+    /// <summary>
+    /// Builds a race-specific output path so parallel attempts do not collide.
+    /// </summary>
+    /// <param name="baseOutputFilePath">The default output file path.</param>
+    /// <param name="codec">The codec attempt name.</param>
+    /// <returns>A unique output path per codec attempt.</returns>
+    public static string GetRaceOutputFilePath(string baseOutputFilePath, string codec)
+    {
+        var directory = Path.GetDirectoryName(baseOutputFilePath)
+                        ?? throw new ArgumentException("Invalid output path.", nameof(baseOutputFilePath));
+        var extension = Path.GetExtension(baseOutputFilePath);
+        var filename = Path.GetFileNameWithoutExtension(baseOutputFilePath);
+        return Path.Combine(directory, filename + "_" + NormalizeCodec(codec) + extension);
+    }
+
+    private static HashSet<string> GetSupportedCodecs(StreamState state)
+    {
+        var supported = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
+
+        if (state.SupportedVideoCodecs is { Length: > 0 })
+        {
+            foreach (var codec in state.SupportedVideoCodecs)
+            {
+                if (!string.IsNullOrWhiteSpace(codec))
+                {
+                    supported.Add(NormalizeCodec(codec));
+                }
+            }
+        }
+
+        if (!string.IsNullOrWhiteSpace(state.OutputVideoCodec))
+        {
+            supported.Add(NormalizeCodec(state.OutputVideoCodec));
+        }
+
+        return supported;
+    }
+
+    private static bool IsCodecAllowed(string codec, EncodingOptions encodingOptions)
+    {
+        var normalized = NormalizeCodec(codec);
+        return normalized switch
+        {
+            "av1" => encodingOptions.AllowAv1Encoding,
+            "hevc" or "h265" => encodingOptions.AllowHevcEncoding,
+            "h264" => true,
+            _ => false
+        };
+    }
+
+    private static string NormalizeCodec(string codec)
+    {
+        if (string.Equals(codec, "h265", StringComparison.OrdinalIgnoreCase))
+        {
+            return "hevc";
+        }
+
+        return codec.ToLowerInvariant();
+    }
+}
diff --git a/MediaBrowser.MediaEncoding/Transcoding/TranscodeCodecFallbackResult.cs b/MediaBrowser.MediaEncoding/Transcoding/TranscodeCodecFallbackResult.cs
new file mode 100644
index 0000000000..de5c0a16dd
--- /dev/null
+++ b/MediaBrowser.MediaEncoding/Transcoding/TranscodeCodecFallbackResult.cs
@@ -0,0 +1,45 @@
+using MediaBrowser.Controller.MediaEncoding;
+using MediaBrowser.Controller.Streaming;
+
+namespace MediaBrowser.MediaEncoding.Transcoding;
+
+/// <summary>
+/// Result of a codec race or sequential fallback attempt.
+/// </summary>
+public sealed class TranscodeCodecFallbackResult
+{
+    /// <summary>
+    /// Gets the winning transcoding job, if any.
+    /// </summary>
+    public TranscodingJob? Job { get; init; }
+
+    /// <summary>
+    /// Gets the stream state for the winning attempt.
+    /// </summary>
+    public StreamState? State { get; init; }
+
+    /// <summary>
+    /// Gets the winning video codec logical name (av1, h264, hevc).
+    /// </summary>
+    public string? WinningCodec { get; init; }
+
+    /// <summary>
+    /// Gets the codec originally requested by the client.
+    /// </summary>
+    public string? RequestedCodec { get; init; }
+
+    /// <summary>
+    /// Gets the playlist path for the winning transcode.
+    /// </summary>
+    public string? PlaylistPath { get; init; }
+
+    /// <summary>
+    /// Gets a value indicating whether a parallel race was used.
+    /// </summary>
+    public bool UsedParallelRace { get; init; }
+
+    /// <summary>
+    /// Gets a value indicating whether fallback occurred.
+    /// </summary>
+    public bool UsedFallback { get; init; }
+}
diff --git a/MediaBrowser.MediaEncoding/Transcoding/TranscodeCodecRaceCoordinator.cs b/MediaBrowser.MediaEncoding/Transcoding/TranscodeCodecRaceCoordinator.cs
new file mode 100644
index 0000000000..5af1bd2d60
--- /dev/null
+++ b/MediaBrowser.MediaEncoding/Transcoding/TranscodeCodecRaceCoordinator.cs
@@ -0,0 +1,423 @@
+using System;
+using System.Collections.Generic;
+using System.Globalization;
+using System.IO;
+using System.Linq;
+using System.Threading;
+using System.Threading.Tasks;
+using MediaBrowser.Common;
+using MediaBrowser.Common.Configuration;
+using MediaBrowser.Common.Extensions;
+using MediaBrowser.Controller.Configuration;
+using MediaBrowser.Controller.MediaEncoding;
+using MediaBrowser.Controller.Streaming;
+using MediaBrowser.Model.Configuration;
+using Microsoft.Extensions.Logging;
+
+namespace MediaBrowser.MediaEncoding.Transcoding;
+
+/// <inheritdoc />
+#pragma warning disable CA1001 // Semaphore is process-lifetime singleton
+public sealed class TranscodeCodecRaceCoordinator : ITranscodeCodecRaceCoordinator
+#pragma warning restore CA1001
+{
+    private const int MaxConcurrentRaces = 2;
+
+    private readonly ITranscodeManager _transcodeManager;
+    private readonly IServerConfigurationManager _serverConfigurationManager;
+    private readonly TranscodeSessionBinding _sessionBinding;
+    private readonly TranscodeFallbackNotifier _notifier;
+    private readonly ILogger<TranscodeCodecRaceCoordinator> _logger;
+    private readonly SemaphoreSlim _raceSemaphore = new(MaxConcurrentRaces, MaxConcurrentRaces);
+
+    /// <summary>
+    /// Initializes a new instance of the <see cref="TranscodeCodecRaceCoordinator"/> class.
+    /// </summary>
+    /// <param name="transcodeManager">The transcode manager.</param>
+    /// <param name="serverConfigurationManager">The server configuration manager.</param>
+    /// <param name="sessionBinding">The session binding store.</param>
+    /// <param name="notifier">The fallback notifier.</param>
+    /// <param name="logger">The logger.</param>
+    public TranscodeCodecRaceCoordinator(
+        ITranscodeManager transcodeManager,
+        IServerConfigurationManager serverConfigurationManager,
+        TranscodeSessionBinding sessionBinding,
+        TranscodeFallbackNotifier notifier,
+        ILogger<TranscodeCodecRaceCoordinator> logger)
+    {
+        _transcodeManager = transcodeManager;
+        _serverConfigurationManager = serverConfigurationManager;
+        _sessionBinding = sessionBinding;
+        _notifier = notifier;
+        _logger = logger;
+    }
+
+    /// <inheritdoc />
+    public async Task<TranscodeCodecFallbackResult> StartWithFallbackAsync(
+        TranscodeCodecFallbackContext context,
+        CancellationToken cancellationToken)
+    {
+        var encodingOptions = _serverConfigurationManager.GetEncodingOptions();
+        var requestedCodec = context.State.OutputVideoCodec ?? context.State.Request.VideoCodec ?? string.Empty;
+
+        if (TranscodeCodecFallbackChain.IsRaceEligible(context.State, encodingOptions, context.IsInitSegmentRequest))
+        {
+            await _raceSemaphore.WaitAsync(cancellationToken).ConfigureAwait(false);
+            try
+            {
+                var raceResult = await RunParallelRaceAsync(context, encodingOptions, requestedCodec, cancellationToken)
+                    .ConfigureAwait(false);
+                if (raceResult.Job is not null)
+                {
+                    return raceResult;
+                }
+            }
+            finally
+            {
+                _raceSemaphore.Release();
+            }
+        }
+
+        return await RunSequentialFallbackAsync(context, encodingOptions, requestedCodec, cancellationToken)
+            .ConfigureAwait(false);
+    }
+
+    private async Task<TranscodeCodecFallbackResult> RunParallelRaceAsync(
+        TranscodeCodecFallbackContext context,
+        EncodingOptions encodingOptions,
+        string requestedCodec,
+        CancellationToken cancellationToken)
+    {
+        var playSessionId = context.State.Request.PlaySessionId ?? string.Empty;
+        var candidates = TranscodeCodecFallbackChain.GetRaceCandidates(context.State, encodingOptions);
+        if (candidates.Count < 2)
+        {
+            return new TranscodeCodecFallbackResult();
+        }
+
+        _logger.LogInformation(
+            "Starting parallel transcode codec race for play session {PlaySessionId}: {Codecs}",
+            context.State.Request.PlaySessionId,
+            string.Join(", ", candidates));
+
+        var attemptTasks = candidates
+            .Select(codec => RunRaceAttemptAsync(context, codec, cancellationToken))
+            .ToList();
+
+        var pending = new List<Task<RaceAttempt?>>(attemptTasks);
+        RaceAttempt? winningAttempt = null;
+
+        while (pending.Count > 0 && winningAttempt is null)
+        {
+            var completedTask = await Task.WhenAny(pending).ConfigureAwait(false);
+            pending.Remove(completedTask);
+
+            var attempt = await completedTask.ConfigureAwait(false);
+            if (attempt?.Result.Succeeded == true && attempt.Result.Job is not null)
+            {
+                winningAttempt = attempt;
+            }
+        }
+
+        foreach (var task in attemptTasks)
+        {
+            if (!task.IsCompleted)
+            {
+                continue;
+            }
+
+            var attempt = await task.ConfigureAwait(false);
+            if (!ReferenceEquals(attempt, winningAttempt))
+            {
+                await CleanupAttemptAsync(attempt).ConfigureAwait(false);
+            }
+        }
+
+        if (winningAttempt?.Result.Succeeded == true && winningAttempt.Result.Job is not null)
+        {
+            _transcodeManager.CompleteFfMpegAttempt(winningAttempt.State, winningAttempt.Result.Job);
+
+            _sessionBinding.Bind(
+                playSessionId,
+                winningAttempt.Codec,
+                winningAttempt.PlaylistPath);
+
+            ApplyFallbackMetadata(winningAttempt.State, requestedCodec, winningAttempt.Codec, usedParallelRace: true);
+
+            await _notifier.NotifyRaceResultAsync(
+                playSessionId,
+                context.UserId,
+                context.ItemName,
+                context.ItemId,
+                requestedCodec,
+                winningAttempt.Codec).ConfigureAwait(false);
+
+            _logger.LogInformation(
+                "Parallel transcode codec race selected {WinningCodec} for play session {PlaySessionId}",
+                winningAttempt.Codec,
+                context.State.Request.PlaySessionId);
+
+            return BuildResult(
+                winningAttempt.Codec,
+                requestedCodec,
+                winningAttempt.State,
+                winningAttempt.Result.Job,
+                winningAttempt.PlaylistPath,
+                usedParallelRace: true,
+                usedFallback: !string.Equals(winningAttempt.Codec, requestedCodec, StringComparison.OrdinalIgnoreCase));
+        }
+
+        return new TranscodeCodecFallbackResult();
+    }
+
+    private async Task<RaceAttempt?> RunRaceAttemptAsync(
+        TranscodeCodecFallbackContext context,
+        string codec,
+        CancellationToken cancellationToken)
+    {
+        StreamState? attemptState = null;
+        CancellationTokenSource? attemptCts = null;
+
+        try
+        {
+            attemptState = await context.CreateStateForCodecAsync(codec, cancellationToken).ConfigureAwait(false);
+            var raceOutputPath = TranscodeCodecFallbackChain.GetRaceOutputFilePath(attemptState.OutputFilePath, codec);
+            attemptState.OutputFilePath = raceOutputPath;
+            attemptState.CodecRaceActive = true;
+
+            var playlistPath = Path.ChangeExtension(raceOutputPath, ".m3u8");
+            attemptState.WaitForPath = BuildInitSegmentPath(playlistPath, attemptState, context.InitSegmentIndex);
+
+            attemptCts = CancellationTokenSource.CreateLinkedTokenSource(cancellationToken);
+            var commandLine = context.BuildCommandLineArguments(attemptState, playlistPath, context.SegmentIndex);
+            var attemptResult = await _transcodeManager.StartFfMpegAttempt(
+                attemptState,
+                playlistPath,
+                commandLine,
+                context.UserId,
+                TranscodingJobType.Hls,
+                attemptCts,
+                skipPostStartSetup: true).ConfigureAwait(false);
+
+            return new RaceAttempt(codec, attemptState, playlistPath, attemptCts, attemptResult);
+        }
+        catch (Exception ex) when (ex is not OperationCanceledException)
+        {
+            _logger.LogDebug(ex, "Parallel transcode attempt failed to start for codec {Codec}", codec);
+            if (attemptState is not null && !ReferenceEquals(attemptState, context.State))
+            {
+                attemptState.Dispose();
+            }
+
+            attemptCts?.Dispose();
+            return null;
+        }
+    }
+
+    private async Task CleanupAttemptAsync(RaceAttempt? attempt)
+    {
+        if (attempt is null)
+        {
+            return;
+        }
+
+        if (attempt.Result.Job is not null)
+        {
+            await _transcodeManager.KillTranscodingJobAndCleanupAsync(attempt.Result.Job, deleteArtifacts: true)
+                .ConfigureAwait(false);
+        }
+
+        attempt.CancellationTokenSource.Dispose();
+        attempt.State.Dispose();
+    }
+
+    private async Task<TranscodeCodecFallbackResult> RunSequentialFallbackAsync(
+        TranscodeCodecFallbackContext context,
+        EncodingOptions encodingOptions,
+        string requestedCodec,
+        CancellationToken cancellationToken)
+    {
+        var chain = TranscodeCodecFallbackChain.GetSequentialChain(context.State, encodingOptions);
+        if (chain.Count == 0)
+        {
+            throw new FfmpegException("No allowed transcode codecs are available for fallback.");
+        }
+
+        string? previousCodec = null;
+        int? previousExitCode = null;
+        var attempted = new List<string>();
+
+        var playSessionId = context.State.Request.PlaySessionId ?? string.Empty;
+
+        foreach (var codec in chain)
+        {
+            attempted.Add(codec);
+            StreamState? attemptState = null;
+            CancellationTokenSource? attemptCts = null;
+
+            try
+            {
+                attemptState = string.Equals(codec, context.State.OutputVideoCodec, StringComparison.OrdinalIgnoreCase)
+                    ? context.State
+                    : await context.CreateStateForCodecAsync(codec, cancellationToken).ConfigureAwait(false);
+
+                var playlistPath = Path.ChangeExtension(attemptState.OutputFilePath, ".m3u8");
+                attemptState.WaitForPath = BuildInitSegmentPath(playlistPath, attemptState, context.InitSegmentIndex);
+
+                attemptCts = CancellationTokenSource.CreateLinkedTokenSource(cancellationToken);
+                var commandLine = context.BuildCommandLineArguments(attemptState, playlistPath, context.SegmentIndex);
+
+                var result = await _transcodeManager.StartFfMpegAttempt(
+                    attemptState,
+                    playlistPath,
+                    commandLine,
+                    context.UserId,
+                    TranscodingJobType.Hls,
+                    attemptCts,
+                    skipPostStartSetup: false).ConfigureAwait(false);
+
+                if (result.Succeeded && result.Job is not null)
+                {
+                    if (previousCodec is not null)
+                    {
+                        await _notifier.NotifySequentialFallbackAsync(
+                            playSessionId,
+                            context.UserId,
+                            context.ItemName,
+                            context.ItemId,
+                            previousCodec,
+                            codec,
+                            previousExitCode).ConfigureAwait(false);
+                    }
+
+                    _sessionBinding.Bind(playSessionId, codec, playlistPath);
+                    ApplyFallbackMetadata(
+                        attemptState,
+                        requestedCodec,
+                        codec,
+                        usedParallelRace: false,
+                        fallbackFrom: previousCodec);
+
+                    return BuildResult(
+                        codec,
+                        requestedCodec,
+                        attemptState,
+                        result.Job,
+                        playlistPath,
+                        usedParallelRace: false,
+                        usedFallback: !string.Equals(codec, requestedCodec, StringComparison.OrdinalIgnoreCase));
+                }
+
+                previousCodec = codec;
+                previousExitCode = result.ExitCode;
+
+                if (result.Job is not null)
+                {
+                    await _transcodeManager.KillTranscodingJobAndCleanupAsync(result.Job, deleteArtifacts: true)
+                        .ConfigureAwait(false);
+                }
+
+                attemptCts.Dispose();
+                attemptCts = null;
+
+                if (!ReferenceEquals(attemptState, context.State))
+                {
+                    attemptState.Dispose();
+                    attemptState = null;
+                }
+            }
+            catch (Exception ex) when (ex is not OperationCanceledException)
+            {
+                _logger.LogDebug(ex, "Sequential transcode attempt failed for codec {Codec}", codec);
+                previousCodec = codec;
+                if (attemptState is not null && !ReferenceEquals(attemptState, context.State))
+                {
+                    attemptState.Dispose();
+                    attemptState = null;
+                }
+
+                attemptCts?.Dispose();
+                attemptCts = null;
+            }
+        }
+
+        await _notifier.NotifyAllAttemptsFailedAsync(
+            playSessionId,
+            context.UserId,
+            context.ItemName,
+            context.ItemId,
+            attempted).ConfigureAwait(false);
+
+        throw new FfmpegException("FFmpeg exited before producing output for all codec fallback attempts.");
+    }
+
+    private static void ApplyFallbackMetadata(
+        StreamState state,
+        string requestedCodec,
+        string winningCodec,
+        bool usedParallelRace,
+        string? fallbackFrom = null)
+    {
+        state.RequestedOutputVideoCodec = requestedCodec;
+        state.CodecRaceActive = usedParallelRace && string.Equals(winningCodec, requestedCodec, StringComparison.OrdinalIgnoreCase);
+
+        if (!string.IsNullOrEmpty(fallbackFrom))
+        {
+            state.CodecFallbackFrom = fallbackFrom;
+        }
+        else if (!string.Equals(winningCodec, requestedCodec, StringComparison.OrdinalIgnoreCase))
+        {
+            state.CodecFallbackFrom = requestedCodec;
+        }
+    }
+
+    private static TranscodeCodecFallbackResult BuildResult(
+        string winningCodec,
+        string requestedCodec,
+        StreamState state,
+        TranscodingJob job,
+        string playlistPath,
+        bool usedParallelRace,
+        bool usedFallback)
+    {
+        return new TranscodeCodecFallbackResult
+        {
+            Job = job,
+            State = state,
+            WinningCodec = winningCodec,
+            RequestedCodec = requestedCodec,
+            PlaylistPath = playlistPath,
+            UsedParallelRace = usedParallelRace,
+            UsedFallback = usedFallback
+        };
+    }
+
+    private static string BuildInitSegmentPath(string playlistPath, StreamState state, int initSegmentIndex)
+    {
+        var folder = Path.GetDirectoryName(playlistPath)
+                     ?? throw new ArgumentException("Invalid playlist path.", nameof(playlistPath));
+        var filename = Path.GetFileNameWithoutExtension(playlistPath);
+        return Path.Combine(
+            folder,
+            filename + initSegmentIndex.ToString(CultureInfo.InvariantCulture) + EncodingHelper.GetSegmentFileExtension(state.Request.SegmentContainer));
+    }
+
+    private sealed class RaceAttempt
+    {
+        public RaceAttempt(
+            string codec,
+            StreamState state,
+            string playlistPath,
+            CancellationTokenSource cancellationTokenSource,
+            TranscodeAttemptResult result)
+        {
+            Codec = codec;
+            State = state;
+            PlaylistPath = playlistPath;
+            CancellationTokenSource = cancellationTokenSource;
+            Result = result;
+        }
+
+        public string Codec { get; }
+
+        public StreamState State { get; }
+
+        public string PlaylistPath { get; }
+
+        public CancellationTokenSource CancellationTokenSource { get; }
+
+        public TranscodeAttemptResult Result { get; }
+    }
+}
diff --git a/MediaBrowser.MediaEncoding/Transcoding/TranscodeFallbackNotifier.cs b/MediaBrowser.MediaEncoding/Transcoding/TranscodeFallbackNotifier.cs
new file mode 100644
index 0000000000..60aa92989b
--- /dev/null
+++ b/MediaBrowser.MediaEncoding/Transcoding/TranscodeFallbackNotifier.cs
@@ -0,0 +1,185 @@
+using System;
+using System.Collections.Concurrent;
+using System.Collections.Generic;
+using System.Globalization;
+using System.Threading.Tasks;
+using Jellyfin.Database.Implementations.Entities;
+using MediaBrowser.Model.Activity;
+using Microsoft.Extensions.Logging;
+
+namespace MediaBrowser.MediaEncoding.Transcoding;
+
+/// <summary>
+/// Writes deduplicated admin activity log entries for codec fallback events.
+/// </summary>
+public sealed class TranscodeFallbackNotifier
+{
+    private readonly IActivityManager _activityManager;
+    private readonly ILogger<TranscodeFallbackNotifier> _logger;
+    private readonly ConcurrentDictionary<string, byte> _dedupeKeys = new(StringComparer.OrdinalIgnoreCase);
+
+    /// <summary>
+    /// Initializes a new instance of the <see cref="TranscodeFallbackNotifier"/> class.
+    /// </summary>
+    /// <param name="activityManager">The activity manager.</param>
+    /// <param name="logger">The logger.</param>
+    public TranscodeFallbackNotifier(IActivityManager activityManager, ILogger<TranscodeFallbackNotifier> logger)
+    {
+        _activityManager = activityManager;
+        _logger = logger;
+    }
+
+    /// <summary>
+    /// Logs a parallel race result.
+    /// </summary>
+    /// <param name="playSessionId">The play session id.</param>
+    /// <param name="userId">The user id.</param>
+    /// <param name="itemName">The item name.</param>
+    /// <param name="itemId">The item id.</param>
+    /// <param name="requestedCodec">The requested codec.</param>
+    /// <param name="winningCodec">The winning codec.</param>
+    /// <returns>A task.</returns>
+    public Task NotifyRaceResultAsync(
+        string playSessionId,
+        Guid userId,
+        string? itemName,
+        Guid? itemId,
+        string requestedCodec,
+        string winningCodec)
+    {
+        if (string.Equals(requestedCodec, winningCodec, StringComparison.OrdinalIgnoreCase))
+        {
+            return Task.CompletedTask;
+        }
+
+        var dedupeKey = $"{playSessionId}:race:{requestedCodec}:{winningCodec}";
+        if (!_dedupeKeys.TryAdd(dedupeKey, 0))
+        {
+            return Task.CompletedTask;
+        }
+
+        var overview = string.Format(
+            CultureInfo.InvariantCulture,
+            "Item \"{0}\" play session {1}: parallel transcode race selected {2} over {3}.",
+            itemName ?? "Unknown",
+            playSessionId,
+            winningCodec.ToUpperInvariant(),
+            requestedCodec.ToUpperInvariant());
+
+        return CreateEntryAsync(
+            "Transcode codec race selected fallback codec",
+            "TranscodeCodecRace",
+            userId,
+            overview,
+            itemId,
+            LogLevel.Information);
+    }
+
+    /// <summary>
+    /// Logs a sequential fallback.
+    /// </summary>
+    /// <param name="playSessionId">The play session id.</param>
+    /// <param name="userId">The user id.</param>
+    /// <param name="itemName">The item name.</param>
+    /// <param name="itemId">The item id.</param>
+    /// <param name="fromCodec">The failed codec.</param>
+    /// <param name="toCodec">The fallback codec.</param>
+    /// <param name="exitCode">The ffmpeg exit code.</param>
+    /// <returns>A task.</returns>
+    public Task NotifySequentialFallbackAsync(
+        string playSessionId,
+        Guid userId,
+        string? itemName,
+        Guid? itemId,
+        string fromCodec,
+        string toCodec,
+        int? exitCode)
+    {
+        var dedupeKey = $"{playSessionId}:fallback:{fromCodec}:{toCodec}";
+        if (!_dedupeKeys.TryAdd(dedupeKey, 0))
+        {
+            return Task.CompletedTask;
+        }
+
+        var overview = string.Format(
+            CultureInfo.InvariantCulture,
+            "Item \"{0}\" play session {1}: {2} transcode failed (exit {3}); falling back to {4}.",
+            itemName ?? "Unknown",
+            playSessionId,
+            fromCodec.ToUpperInvariant(),
+            exitCode?.ToString(CultureInfo.InvariantCulture) ?? "unknown",
+            toCodec.ToUpperInvariant());
+
+        return CreateEntryAsync(
+            "Transcode codec fallback",
+            "TranscodeCodecFallback",
+            userId,
+            overview,
+            itemId,
+            LogLevel.Warning);
+    }
+
+    /// <summary>
+    /// Logs when all codec attempts failed.
+    /// </summary>
+    /// <param name="playSessionId">The play session id.</param>
+    /// <param name="userId">The user id.</param>
+    /// <param name="itemName">The item name.</param>
+    /// <param name="itemId">The item id.</param>
+    /// <param name="attemptedCodecs">Codecs attempted.</param>
+    /// <returns>A task.</returns>
+    public Task NotifyAllAttemptsFailedAsync(
+        string playSessionId,
+        Guid userId,
+        string? itemName,
+        Guid? itemId,
+        IReadOnlyList<string> attemptedCodecs)
+    {
+        var dedupeKey = $"{playSessionId}:failed:all";
+        if (!_dedupeKeys.TryAdd(dedupeKey, 0))
+        {
+            return Task.CompletedTask;
+        }
+
+        var overview = string.Format(
+            CultureInfo.InvariantCulture,
+            "Item \"{0}\" play session {1}: all transcode codec attempts failed ({2}).",
+            itemName ?? "Unknown",
+            playSessionId,
+            string.Join(", ", attemptedCodecs));
+
+        return CreateEntryAsync(
+            "All transcode codec attempts failed",
+            "TranscodeCodecFailure",
+            userId,
+            overview,
+            itemId,
+            LogLevel.Error);
+    }
+
+    private async Task CreateEntryAsync(
+        string name,
+        string type,
+        Guid userId,
+        string overview,
+        Guid? itemId,
+        LogLevel severity)
+    {
+        try
+        {
+            var entry = new ActivityLog(name, type, userId)
+            {
+                Overview = overview,
+                ShortOverview = overview,
+                LogSeverity = severity,
+                ItemId = itemId?.ToString("N", CultureInfo.InvariantCulture)
+            };
+
+            await _activityManager.CreateAsync(entry).ConfigureAwait(false);
+        }
+        catch (Exception ex)
+        {
+            _logger.LogWarning(ex, "Failed to write transcode fallback activity log entry");
+        }
+    }
+}
