@@ -0,0 +1,157 @@
+using System;
+using System.IO;
+using System.Net;
+using System.Net.Http;
+using System.Text;
+using System.Threading;
+using System.Threading.Tasks;
+using Jellyfin.Api.Auth;
+using Jellyfin.Api.Controllers;
+using Jellyfin.Database.Implementations.Entities;
+using MediaBrowser.Controller.Configuration;
+using MediaBrowser.Controller.Entities;
+using MediaBrowser.Controller.Entities.Movies;
+using MediaBrowser.Controller.Library;
+using MediaBrowser.Controller.MediaEncoding;
+using MediaBrowser.Controller.Net;
+using MediaBrowser.Controller.Providers;
+using MediaBrowser.Controller.Subtitles;
+using MediaBrowser.Model.Entities;
+using MediaBrowser.Model.IO;
+using Microsoft.AspNetCore.Authentication;
+using Microsoft.AspNetCore.Builder;
+using Microsoft.AspNetCore.Hosting;
+using Microsoft.AspNetCore.TestHost;
+using Microsoft.Extensions.DependencyInjection;
+using Microsoft.Extensions.Hosting;
+using Moq;
+using Xunit;
+
+namespace Jellyfin.Api.Tests.Controllers;
+
+public sealed class MediaResourceSecurityTests : IAsyncLifetime
+{
+    private const string SourceId = "22222222222222222222222222222222";
+    private const string SubtitleBody = "WEBVTT\n\n00:00.000 --> 00:01.000\nCaption\n";
+    private const string AttachmentBody = "<!doctype html><title>Untrusted attachment</title>";
+    private static readonly Guid _itemId = Guid.Parse("11111111-1111-1111-1111-111111111111");
+    private readonly Mock<ILibraryManager> _library = new();
+    private readonly IHost _host;
+
+    public MediaResourceSecurityTests()
+    {
+        var user = new User("reader", "authentication", "reset");
+        var movie = new Movie { Id = _itemId };
+        _library.Setup(l => l.GetItemById<BaseItem>(_itemId)).Returns(movie);
+        _library.Setup(l => l.GetItemById<Video>(_itemId)).Returns(movie);
+        _library.Setup(l => l.GetItemById<BaseItem>(_itemId, It.IsAny<Guid>())).Returns(movie);
+        _library.Setup(l => l.GetItemById<Video>(_itemId, It.IsAny<Guid>())).Returns(movie);
+
+        var encoder = new Mock<ISubtitleEncoder>();
+        encoder.Setup(e => e.GetSubtitles(
+                It.IsAny<BaseItem>(), SourceId, 0, "vtt", It.IsAny<long>(), It.IsAny<long>(), It.IsAny<bool>(), It.IsAny<CancellationToken>()))
+            .Returns(() => Task.FromResult<Stream>(new MemoryStream(Encoding.UTF8.GetBytes(SubtitleBody))));
+        var extractor = new Mock<IAttachmentExtractor>();
+        extractor.Setup(e => e.GetAttachment(It.IsAny<BaseItem>(), SourceId, 0, It.IsAny<CancellationToken>()))
+            .Returns(() => Task.FromResult((
+                new MediaAttachment { MimeType = "text/html", FileName = "untrusted.html", Index = 0 },
+                (Stream)new MemoryStream(Encoding.UTF8.GetBytes(AttachmentBody)))));
+
+        var auth = new Mock<IAuthService>();
+        auth.Setup(a => a.Authenticate(It.IsAny<Microsoft.AspNetCore.Http.HttpRequest>()))
+            .Returns((Microsoft.AspNetCore.Http.HttpRequest request) =>
+                Task.FromResult(request.Query["api_key"] == "reader-token"
+                    ? new AuthorizationInfo { Token = "reader-token", User = user, IsAuthenticated = true }
+                    : new AuthorizationInfo()));
+
+        _host = new HostBuilder().ConfigureWebHost(web => web.UseTestServer()
+            .ConfigureServices(services =>
+            {
+                services.AddSingleton(_library.Object);
+                services.AddSingleton(encoder.Object);
+                services.AddSingleton(extractor.Object);
+                services.AddSingleton(auth.Object);
+                services.AddSingleton(Mock.Of<IServerConfigurationManager>());
+                services.AddSingleton(Mock.Of<ISubtitleManager>());
+                services.AddSingleton(Mock.Of<IMediaSourceManager>());
+                services.AddSingleton(Mock.Of<IProviderManager>());
+                services.AddSingleton(Mock.Of<IFileSystem>());
+                services.AddAuthentication("Test")
+                    .AddScheme<AuthenticationSchemeOptions, CustomAuthenticationHandler>("Test", _ => { });
+                services.AddAuthorization();
+                services.AddControllers().AddApplicationPart(typeof(SubtitleController).Assembly);
+            })
+            .Configure(app =>
+            {
+                app.UseRouting();
+                app.UseAuthentication();
+                app.UseAuthorization();
+                app.UseEndpoints(endpoints => endpoints.MapControllers());
+            })).Build();
+    }
+
+    public async ValueTask InitializeAsync() => await _host.StartAsync(TestContext.Current.CancellationToken);
+
+    [Theory]
+    [InlineData("Subtitles/0/Stream.vtt")]
+    [InlineData("Subtitles/0/0/Stream.vtt")]
+    [InlineData("Attachments/0")]
+    public async Task MediaResource_AnonymousRequest_IsUnauthorized(string resource)
+    {
+        using var client = _host.GetTestClient();
+        using var response = await client.GetAsync($"/Videos/{_itemId}/{SourceId}/{resource}", TestContext.Current.CancellationToken);
+        Assert.Equal(HttpStatusCode.Unauthorized, response.StatusCode);
+    }
+
+    [Theory]
+    [InlineData("Subtitles/0/Stream.vtt")]
+    [InlineData("Subtitles/0/0/Stream.vtt")]
+    [InlineData("Attachments/0")]
+    public async Task MediaResource_JunkToken_IsUnauthorized(string resource)
+    {
+        using var client = _host.GetTestClient();
+        using var response = await client.GetAsync($"/Videos/{_itemId}/{SourceId}/{resource}?api_key=junk", TestContext.Current.CancellationToken);
+        Assert.Equal(HttpStatusCode.Unauthorized, response.StatusCode);
+    }
+
+    [Theory]
+    [InlineData("Subtitles/0/Stream.vtt")]
+    [InlineData("Subtitles/0/0/Stream.vtt")]
+    public async Task Subtitle_VisibleItem_ReturnsCaptionsWithQueryToken(string resource)
+    {
+        using var client = _host.GetTestClient();
+        using var response = await client.GetAsync($"/Videos/{_itemId}/{SourceId}/{resource}?api_key=reader-token", TestContext.Current.CancellationToken);
+        Assert.Equal(HttpStatusCode.OK, response.StatusCode);
+        Assert.Equal(SubtitleBody, await response.Content.ReadAsStringAsync(TestContext.Current.CancellationToken));
+    }
+
+    [Theory]
+    [InlineData("Subtitles/0/Stream.vtt")]
+    [InlineData("Subtitles/0/0/Stream.vtt")]
+    [InlineData("Attachments/0")]
+    public async Task MediaResource_HiddenItem_IsNotFound(string resource)
+    {
+        _library.Setup(l => l.GetItemById<BaseItem>(_itemId, It.IsAny<Guid>())).Returns((BaseItem?)null);
+        _library.Setup(l => l.GetItemById<Video>(_itemId, It.IsAny<Guid>())).Returns((Video?)null);
+        using var client = _host.GetTestClient();
+        using var response = await client.GetAsync($"/Videos/{_itemId}/{SourceId}/{resource}?api_key=reader-token", TestContext.Current.CancellationToken);
+        Assert.Equal(HttpStatusCode.NotFound, response.StatusCode);
+    }
+
+    [Fact]
+    public async Task Attachment_MediaSuppliedHtml_IsDownloadOnly()
+    {
+        using var client = _host.GetTestClient();
+        using var response = await client.GetAsync($"/Videos/{_itemId}/{SourceId}/Attachments/0?api_key=reader-token", TestContext.Current.CancellationToken);
+        Assert.Equal(HttpStatusCode.OK, response.StatusCode);
+        Assert.Equal(AttachmentBody, await response.Content.ReadAsStringAsync(TestContext.Current.CancellationToken));
+        Assert.Equal("attachment", response.Content.Headers.ContentDisposition?.DispositionType);
+        Assert.Equal("nosniff", Assert.Single(response.Headers.GetValues("X-Content-Type-Options")));
+    }
+
+    public async ValueTask DisposeAsync()
+    {
+        await _host.StopAsync(TestContext.Current.CancellationToken);
+        _host.Dispose();
+    }
+}
