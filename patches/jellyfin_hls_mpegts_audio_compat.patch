+
+        /// <summary>
+        /// When video must be transcoded to HLS MPEG-TS, keep source AC3/EAC3 eligible for remux if
+        /// the client DirectPlay profile already claims to support that codec. TranscodingProfiles
+        /// sometimes list only AAC as an encode target even though the device can play Dolby in TS
+        /// (Wholphin/ExoPlayer); without this, surround is re-encoded to multichannel AAC and goes silent.
+        /// </summary>
+        private static void PreferHlsTsRemuxableSourceAudio(
+            MediaOptions options,
+            MediaStream? audioStream,
+            List<string> audioCodecs)
+        {
+            if (audioStream is null
+                || (audioStream.Channels ?? 0) <= 2
+                || string.IsNullOrEmpty(audioStream.Codec))
+            {
+                return;
+            }
+
+            if (!string.Equals(audioStream.Codec, "ac3", StringComparison.OrdinalIgnoreCase)
+                && !string.Equals(audioStream.Codec, "eac3", StringComparison.OrdinalIgnoreCase))
+            {
+                return;
+            }
+
+            if (!_supportedHlsAudioCodecsTs.Contains(audioStream.Codec, StringComparison.OrdinalIgnoreCase))
+            {
+                return;
+            }
+
+            var directPlaySupports = options.Profile.DirectPlayProfiles.Any(profile =>
+                profile.Type == DlnaProfileType.Video
+                && profile.SupportsAudioCodec(audioStream.Codec));
+
+            if (!directPlaySupports)
+            {
+                return;
+            }
+
+            var sourceCodec = audioStream.Codec;
+            audioCodecs.RemoveAll(codec => string.Equals(codec, sourceCodec, StringComparison.OrdinalIgnoreCase));
+            audioCodecs.Insert(0, sourceCodec);
+        }
     }
