+        /// <summary>
+        /// Whether the encoding job remuxes into MPEG-TS (progressive TS/M2TS or HLS mpegts segments).
+        /// HLS uses <see cref="StreamingRequestDto.SegmentContainer"/>; progressive uses <see cref="EncodingJobInfo.OutputContainer"/>.
+        /// </summary>
+        private static bool IsMpegTsRemuxOutput(EncodingJobInfo state)
+        {
+            if (state.TranscodingType == TranscodingJobType.Progressive)
+            {
+                return string.Equals(state.OutputContainer, "ts", StringComparison.OrdinalIgnoreCase)
+                       || string.Equals(state.OutputContainer, "m2ts", StringComparison.OrdinalIgnoreCase);
+            }
+
+            // HLS / LiveHLS: segment container selects mpegts vs fmp4 (default .ts).
+            var segmentContainer = state.BaseRequest is StreamingRequestDto streamingRequest
+                ? streamingRequest.SegmentContainer
+                : null;
+
+            return string.Equals(
+                GetSegmentFileExtension(segmentContainer).TrimStart('.'),
+                "ts",
+                StringComparison.OrdinalIgnoreCase);
+        }
+
