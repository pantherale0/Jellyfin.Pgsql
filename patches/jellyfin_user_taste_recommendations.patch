@@ -0,0 +1,44 @@
+using System;
+
+namespace Jellyfin.Database.Implementations.Entities;
+
+/// <summary>
+/// Precomputed taste recommendation row for the home For You feed.
+/// </summary>
+public class UserTasteRecommendation
+{
+    /// <summary>
+    /// Gets or sets the user identifier.
+    /// </summary>
+    public Guid UserId { get; set; }
+
+    /// <summary>
+    /// Gets or sets the item kind name (<c>Movie</c> or <c>Series</c>).
+    /// </summary>
+    public string ItemType { get; set; } = string.Empty;
+
+    /// <summary>
+    /// Gets or sets the 0-based display rank within the feed.
+    /// </summary>
+    public int Rank { get; set; }
+
+    /// <summary>
+    /// Gets or sets the recommended item identifier.
+    /// </summary>
+    public Guid ItemId { get; set; }
+
+    /// <summary>
+    /// Gets or sets the taste score at materialization time.
+    /// </summary>
+    public int Score { get; set; }
+
+    /// <summary>
+    /// Gets or sets the sparse badge tier (<c>high</c>, <c>mid</c>, or empty).
+    /// </summary>
+    public string Tier { get; set; } = string.Empty;
+
+    /// <summary>
+    /// Gets or sets when this feed row was written (UTC).
+    /// </summary>
+    public DateTime UpdatedAt { get; set; }
+}
