diff --git a/src/scripts/tasteMatch.js b/src/scripts/tasteMatch.js
new file mode 100644
index 0000000000..63f7bca665
--- /dev/null
+++ b/src/scripts/tasteMatch.js
@@ -0,0 +1,58 @@
+/**
+ * Sparse taste match API helpers for recommendation / similar card badges.
+ */
+
+/**
+ * Fetches match tiers for item ids. Failures return an empty map.
+ * @param {string} userId - Jellyfin user id.
+ * @param {string[]} itemIds - Candidate item ids.
+ * @returns {Promise<Map<string, string>>} Map of itemId → tier ("high"|"mid").
+ */
+export function fetchTasteMatches(userId, itemIds) {
+    if (!userId || !itemIds?.length || typeof ApiClient === 'undefined') {
+        return Promise.resolve(new Map());
+    }
+
+    const unique = [...new Set(itemIds.filter(Boolean))].slice(0, 64);
+    if (!unique.length) {
+        return Promise.resolve(new Map());
+    }
+
+    const url = ApiClient.getUrl('Pgsql/Taste/Match');
+    return ApiClient.ajax({
+        type: 'POST',
+        url,
+        data: JSON.stringify({
+            UserId: userId,
+            ItemIds: unique
+        }),
+        contentType: 'application/json',
+        dataType: 'json'
+    }).then((result) => {
+        const map = new Map();
+        for (const match of result?.Matches || []) {
+            if (match?.ItemId && match?.Tier) {
+                map.set(match.ItemId, match.Tier);
+            }
+        }
+        return map;
+    }).catch(() => new Map());
+}
+
+/**
+ * Stamps PgsqlTasteTier onto items from a match map.
+ * @param {Array<object>} items - Item DTOs.
+ * @param {Map<string, string>} matchMap - itemId → tier.
+ */
+export function applyTasteTiers(items, matchMap) {
+    if (!items?.length || !matchMap?.size) {
+        return;
+    }
+
+    for (const item of items) {
+        const tier = matchMap.get(item.Id);
+        if (tier) {
+            item.PgsqlTasteTier = tier;
+        }
+    }
+}
