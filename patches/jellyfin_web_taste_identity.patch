diff --git a/src/apps/legacy/controllers/user/taste/index.js b/src/apps/legacy/controllers/user/taste/index.js
new file mode 100644
index 0000000000..9500912571
--- /dev/null
+++ b/src/apps/legacy/controllers/user/taste/index.js
@@ -0,0 +1,183 @@
+import escapeHtml from 'escape-html';
+
+import './taste.scss';
+
+function formatUpdatedAt(value) {
+    if (!value) {
+        return '';
+    }
+
+    try {
+        return `Updated ${new Date(value).toLocaleString()}`;
+    } catch {
+        return '';
+    }
+}
+
+function ratingBandLabel(profile) {
+    if (profile.Persona?.Bar === 'selective') {
+        return 'Selective ratings';
+    }
+
+    if (profile.Persona?.Bar === 'wildcard') {
+        return 'Wide rating mix';
+    }
+
+    if (profile.RatingMean != null) {
+        return 'Mainstream ratings';
+    }
+
+    return 'Rating band unknown';
+}
+
+function focusLabel(focus) {
+    if (focus === 'specialist') {
+        return 'Specialist';
+    }
+
+    if (focus === 'omnivore') {
+        return 'Omnivore';
+    }
+
+    return 'Calibrating';
+}
+
+function buildRadarSvg(genres) {
+    const size = 280;
+    const cx = size / 2;
+    const cy = size / 2;
+    const radius = 100;
+    const levels = 4;
+    const n = Math.max(genres.length, 3);
+    const angleStep = (Math.PI * 2) / n;
+    const maxWeight = Math.max(...genres.map((g) => g.Weight || 0), 0.01);
+
+    const polar = (i, r) => {
+        const angle = (-Math.PI / 2) + (i * angleStep);
+        return {
+            x: cx + (r * Math.cos(angle)),
+            y: cy + (r * Math.sin(angle))
+        };
+    };
+
+    let grid = '';
+    for (let level = 1; level <= levels; level++) {
+        const r = (radius * level) / levels;
+        const pts = [];
+        for (let i = 0; i < n; i++) {
+            const p = polar(i, r);
+            pts.push(`${p.x.toFixed(1)},${p.y.toFixed(1)}`);
+        }
+        grid += `<polygon class="tasteRadarGrid" points="${pts.join(' ')}" />`;
+    }
+
+    let axes = '';
+    let labels = '';
+    let dataPts = [];
+    for (let i = 0; i < n; i++) {
+        const tip = polar(i, radius);
+        axes += `<line class="tasteRadarAxis" x1="${cx}" y1="${cy}" x2="${tip.x.toFixed(1)}" y2="${tip.y.toFixed(1)}" />`;
+        const genre = genres[i] || { Label: '', Weight: 0 };
+        const labelPos = polar(i, radius + 22);
+        labels += `<text class="tasteRadarLabel" x="${labelPos.x.toFixed(1)}" y="${labelPos.y.toFixed(1)}" text-anchor="middle" dominant-baseline="middle">${escapeHtml(genre.Label || '')}</text>`;
+        const wr = radius * ((genre.Weight || 0) / maxWeight);
+        const dp = polar(i, wr);
+        dataPts.push(`${dp.x.toFixed(1)},${dp.y.toFixed(1)}`);
+    }
+
+    return `<svg class="tasteRadar" viewBox="0 0 ${size} ${size}" role="img" aria-label="Genre affinity radar">${grid}${axes}<polygon class="tasteRadarData" points="${dataPts.join(' ')}" />${labels}</svg>`;
+}
+
+function buildAffinityBars(items) {
+    if (!items?.length) {
+        return '<p class="secondaryText">No tag or studio affinities yet.</p>';
+    }
+
+    const max = Math.max(...items.map((i) => i.Weight || 0), 0.01);
+    return items.map((item) => {
+        const pct = Math.round(((item.Weight || 0) / max) * 100);
+        return `<div class="tasteBarRow"><div class="tasteBarLabel">${escapeHtml(item.Label)}</div><div class="tasteBarTrack"><div class="tasteBarFill" style="width:${pct}%"></div></div></div>`;
+    }).join('');
+}
+
+function buildPeopleList(people) {
+    if (!people?.length) {
+        return '';
+    }
+
+    return people.map((p) => {
+        const role = p.Role === 'director' ? 'Director' : 'Actor';
+        return `<li class="listItem listItem-border"><div class="listItemBody"><div class="listItemBodyText">${escapeHtml(p.Name)}</div><div class="listItemBodyText secondary">${escapeHtml(role)}</div></div></li>`;
+    }).join('');
+}
+
+function buildSignalStrip(profile) {
+    const chips = [
+        `${profile.SampleCount || 0} films`,
+        focusLabel(profile.Persona?.Focus),
+        ratingBandLabel(profile)
+    ];
+    return chips.map((c) => `<span class="tasteSignalChip">${escapeHtml(c)}</span>`).join('');
+}
+
+function renderProfile(view, profile) {
+    const titleEl = view.querySelector('.tastePersonaTitle');
+    const blurbEl = view.querySelector('.tastePersonaBlurb');
+    const updatedEl = view.querySelector('.tasteUpdatedAt');
+    const chartsEl = view.querySelector('.tasteCharts');
+
+    titleEl.textContent = profile.Persona?.Title || 'Still Calibrating';
+    blurbEl.textContent = profile.Persona?.Blurb || '';
+
+    const updated = formatUpdatedAt(profile.UpdatedAt);
+    if (updated) {
+        updatedEl.textContent = updated;
+        updatedEl.classList.remove('hide');
+    } else {
+        updatedEl.classList.add('hide');
+    }
+
+    if (!profile.HasProfile || !(profile.Genres?.length)) {
+        chartsEl.classList.add('hide');
+        return;
+    }
+
+    chartsEl.classList.remove('hide');
+    view.querySelector('.tasteRadarHost').innerHTML = buildRadarSvg(profile.Genres.slice(0, 8));
+    view.querySelector('.tasteSignalStrip').innerHTML = buildSignalStrip(profile);
+
+    const affinityItems = [
+        ...(profile.Tags || []).slice(0, 6).map((t) => ({ ...t, Label: t.Label })),
+        ...(profile.Studios || []).slice(0, 4).map((s) => ({ ...s, Label: `Studio · ${s.Label}` }))
+    ];
+    view.querySelector('.tasteAffinityBars').innerHTML = buildAffinityBars(affinityItems);
+    view.querySelector('.tastePeopleList').innerHTML = buildPeopleList(profile.People);
+
+    const evalEl = view.querySelector('.tasteShadowEval');
+    if (profile.ShadowEval?.Auc != null) {
+        const when = formatUpdatedAt(profile.ShadowEval.CreatedAt);
+        evalEl.textContent = `Shadow model AUC ${profile.ShadowEval.Auc.toFixed(3)}${when ? ` · ${when}` : ''}`;
+        evalEl.classList.remove('hide');
+    } else {
+        evalEl.classList.add('hide');
+    }
+}
+
+export default function (view, params) {
+    const userId = params.userId || ApiClient.getCurrentUserId();
+
+    view.addEventListener('viewshow', function () {
+        const url = ApiClient.getUrl('Pgsql/Taste/Users/' + userId);
+        ApiClient.getJSON(url).then(function (profile) {
+            renderProfile(view, profile || {});
+        }).catch(function () {
+            renderProfile(view, {
+                HasProfile: false,
+                Persona: {
+                    Title: 'Still Calibrating',
+                    Blurb: 'Taste profiles are unavailable right now.'
+                }
+            });
+        });
+    });
+}
diff --git a/src/apps/legacy/controllers/user/taste/taste.scss b/src/apps/legacy/controllers/user/taste/taste.scss
new file mode 100644
index 0000000000..fc49f8055e
--- /dev/null
+++ b/src/apps/legacy/controllers/user/taste/taste.scss
@@ -0,0 +1,110 @@
+.tasteHero {
+    margin: 0 auto 1.75em;
+    max-width: 46em;
+}
+
+.tastePersonaTitle {
+    margin: 0 0 0.35em;
+    font-size: 2em;
+    font-weight: 600;
+    letter-spacing: 0.01em;
+}
+
+.tastePersonaBlurb {
+    margin: 0;
+    font-size: 1.05em;
+    line-height: 1.45;
+    max-width: 40em;
+}
+
+.tasteUpdatedAt {
+    margin: 0.65em 0 0;
+    font-size: 0.9em;
+}
+
+.tasteCharts {
+    margin: 0 auto;
+    max-width: 46em;
+}
+
+.tasteRadarHost {
+    display: flex;
+    justify-content: center;
+    margin: 0.5em 0 1em;
+}
+
+.tasteRadar {
+    width: min(100%, 20em);
+    height: auto;
+}
+
+.tasteRadarGrid,
+.tasteRadarAxis {
+    fill: none;
+    stroke: rgba(255, 255, 255, 0.14);
+    stroke-width: 1;
+}
+
+.tasteRadarData {
+    fill: rgba(0, 164, 220, 0.28);
+    stroke: #00a4dc;
+    stroke-width: 2;
+}
+
+.tasteRadarLabel {
+    fill: rgba(255, 255, 255, 0.78);
+    font-size: 11px;
+}
+
+.tasteSignalStrip {
+    display: flex;
+    flex-wrap: wrap;
+    gap: 0.5em;
+    margin-bottom: 1.25em;
+}
+
+.tasteSignalChip {
+    display: inline-flex;
+    align-items: center;
+    padding: 0.35em 0.75em;
+    border: 1px solid rgba(255, 255, 255, 0.16);
+    border-radius: 0.35em;
+    font-size: 0.92em;
+    color: rgba(255, 255, 255, 0.88);
+}
+
+.tasteBarRow {
+    display: grid;
+    grid-template-columns: minmax(6em, 10em) 1fr;
+    gap: 0.75em;
+    align-items: center;
+    margin: 0.45em 0;
+}
+
+.tasteBarLabel {
+    font-size: 0.92em;
+    color: rgba(255, 255, 255, 0.82);
+}
+
+.tasteBarTrack {
+    height: 0.45em;
+    border-radius: 0.25em;
+    background: rgba(255, 255, 255, 0.1);
+    overflow: hidden;
+}
+
+.tasteBarFill {
+    height: 100%;
+    background: #00a4dc;
+}
+
+.tastePeopleList {
+    margin: 1em 0 0;
+    padding: 0;
+    list-style: none;
+}
+
+.tasteShadowEval {
+    margin-top: 1.5em;
+    font-size: 0.85em;
+}
