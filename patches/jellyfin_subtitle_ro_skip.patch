@@ -0,0 +1,97 @@
+using System;
+using System.Collections.Concurrent;
+using System.IO;
+
+namespace MediaBrowser.Providers.Subtitles;
+
+/// <summary>
+/// Probes whether a media folder can accept subtitle files written beside media.
+/// Results are cached for the process lifetime so library scans do not hammer the filesystem.
+/// </summary>
+internal static class SubtitleMediaFolderWritability
+{
+    private static readonly ConcurrentDictionary<string, bool> WritableCache = new(StringComparer.Ordinal);
+    private static readonly ConcurrentDictionary<string, byte> LoggedFolders = new(StringComparer.Ordinal);
+
+    /// <summary>
+    /// Returns whether <paramref name="directoryPath"/> is writable for creating a new file.
+    /// Missing paths and access errors are treated as not writable.
+    /// </summary>
+    public static bool CanWrite(string? directoryPath)
+    {
+        if (string.IsNullOrWhiteSpace(directoryPath))
+        {
+            return false;
+        }
+
+        string fullPath;
+        try
+        {
+            fullPath = Path.GetFullPath(directoryPath);
+        }
+        catch (Exception)
+        {
+            return false;
+        }
+
+        return WritableCache.GetOrAdd(fullPath, ProbeWritable);
+    }
+
+    /// <summary>
+    /// Returns true the first time a non-writable folder should be logged, then false for subsequent calls.
+    /// </summary>
+    public static bool ShouldLogSkip(string? directoryPath)
+    {
+        if (string.IsNullOrWhiteSpace(directoryPath))
+        {
+            return false;
+        }
+
+        string fullPath;
+        try
+        {
+            fullPath = Path.GetFullPath(directoryPath);
+        }
+        catch (Exception)
+        {
+            return false;
+        }
+
+        return LoggedFolders.TryAdd(fullPath, 0);
+    }
+
+    private static bool ProbeWritable(string directoryPath)
+    {
+        if (!Directory.Exists(directoryPath))
+        {
+            return false;
+        }
+
+        var probePath = Path.Combine(directoryPath, $".jellyfin-write-probe-{Guid.NewGuid():N}");
+        try
+        {
+            using (var stream = new FileStream(probePath, FileMode.CreateNew, FileAccess.Write, FileShare.None, 1, FileOptions.DeleteOnClose))
+            {
+                stream.WriteByte(0);
+            }
+
+            return true;
+        }
+        catch (Exception)
+        {
+            try
+            {
+                if (File.Exists(probePath))
+                {
+                    File.Delete(probePath);
+                }
+            }
+            catch
+            {
+                // Best-effort cleanup if DeleteOnClose did not run.
+            }
+
+            return false;
+        }
+    }
+}
