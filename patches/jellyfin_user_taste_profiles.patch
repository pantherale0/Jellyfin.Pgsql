+using Jellyfin.Database.Implementations.Entities;
+using Microsoft.EntityFrameworkCore;
+using Microsoft.EntityFrameworkCore.Metadata.Builders;
+
+namespace Jellyfin.Database.Implementations.ModelConfiguration;
+
+/// <summary>
+/// FluentAPI configuration for the <see cref="UserTasteRecommendation"/> entity.
+/// </summary>
+public class UserTasteRecommendationConfiguration : IEntityTypeConfiguration<UserTasteRecommendation>
+{
+    /// <inheritdoc/>
+    public void Configure(EntityTypeBuilder<UserTasteRecommendation> builder)
+    {
+        builder.HasKey(e => new { e.UserId, e.ItemType, e.Rank });
+        builder.Property(e => e.ItemType).IsRequired();
+        builder.Property(e => e.Tier).IsRequired();
+        builder.HasIndex(e => new { e.UserId, e.ItemType });
+    }
+}
