+using System;
+using Jellyfin.Database.Implementations.Entities.Security;
+
+namespace Jellyfin.Database.Implementations.Entities;
+
+/// <summary>
+/// Represents a single playback session record.
+/// </summary>
+public class PlaybackActivity
+{
+    /// <summary>
+    /// Gets or sets the unique identifier.
+    /// </summary>
+    public Guid Id { get; set; }
+
+    /// <summary>
+    /// Gets or sets the user identifier.
+    /// </summary>
+    public Guid UserId { get; set; }
+
+    /// <summary>
+    /// Gets or sets the user.
+    /// </summary>
+    public User? User { get; set; }
+
+    /// <summary>
+    /// Gets or sets the optional device identifier.
+    /// </summary>
+    public int? DeviceId { get; set; }
+
+    /// <summary>
+    /// Gets or sets the device.
+    /// </summary>
+    public Device? Device { get; set; }
+
+    /// <summary>
+    /// Gets or sets the item identifier.
+    /// </summary>
+    public Guid ItemId { get; set; }
+
+    /// <summary>
+    /// Gets or sets the name of the item.
+    /// </summary>
+    public string ItemName { get; set; } = string.Empty;
+
+    /// <summary>
+    /// Gets or sets the series identifier when the item is an episode.
+    /// </summary>
+    public Guid? SeriesId { get; set; }
+
+    /// <summary>
+    /// Gets or sets the series name when the item is an episode.
+    /// </summary>
+    public string? SeriesName { get; set; }
+
+    /// <summary>
+    /// Gets or sets the media type (Movie, Episode, Book, Music Video, etc).
+    /// </summary>
+    public string MediaType { get; set; } = string.Empty;
+
+    /// <summary>
+    /// Gets or sets the playback duration in ticks.
+    /// </summary>
+    public long PlayedTicks { get; set; }
+
+    /// <summary>
+    /// Gets or sets the date the playback occurred.
+    /// </summary>
+    public DateTime DatePlayed { get; set; }
+
+    /// <summary>
+    /// Gets or sets the subgroup of the item (e.g. genre).
+    /// </summary>
+    public string ItemSubGroup { get; set; } = string.Empty;
+
+    /// <summary>
+    /// Gets or sets the playback method snapshot (e.g. DirectPlay, Transcode).
+    /// </summary>
+    public string? PlaybackMethod { get; set; }
+
+    /// <summary>
+    /// Gets or sets the client name snapshot.
+    /// </summary>
+    public string? ClientName { get; set; }
+
+    /// <summary>
+    /// Gets or sets the device name snapshot.
+    /// </summary>
+    public string? DeviceName { get; set; }
+}
