+                    TotalTicks = other.Sum(r => r.TotalTicks),
+                    PlayCount = other.Sum(r => r.PlayCount),
+                    IsOther = true
+                });
+            }
+        }
+
+        return new OkObjectResult(result);
+    }
+
+    /// <summary>
