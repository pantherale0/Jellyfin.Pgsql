+        private static string FormatPlaybackMethod(SessionInfo session)
+        {
+            var playMethod = "na";
+            if (session.PlayState?.PlayMethod is not null)
+            {
+                playMethod = session.PlayState.PlayMethod.Value.ToString();
+            }
+
+            if (session.PlayState?.PlayMethod == PlayMethod.Transcode && session.TranscodingInfo is not null)
+            {
+                var videoCodec = session.TranscodingInfo.IsVideoDirect ? "direct" : session.TranscodingInfo.VideoCodec;
+                var audioCodec = session.TranscodingInfo.IsAudioDirect ? "direct" : session.TranscodingInfo.AudioCodec;
+                playMethod += string.Create(CultureInfo.InvariantCulture, $" (v:{videoCodec} a:{audioCodec})");
+            }
+
+            return playMethod;
+        }
+
+        private static string FormatTranscodeReasons(SessionInfo session)
+        {
+            if (session.PlayState?.PlayMethod != PlayMethod.Transcode
+                || session.TranscodingInfo is null
+                || session.TranscodingInfo.TranscodeReasons == default)
+            {
+                return null;
+            }
+
+            return session.TranscodingInfo.TranscodeReasons.ToString();
+        }
+
+        private async Task TrackLiveTvPlaybackSegmentAsync(
+            SessionInfo session,
+            BaseItem channelItem,
+            List<User> users,
+            long positionTicks,
+            bool forceLookup,
+            bool isStop)
+        {
+            if (users.Count == 0)
+            {
+                if (isStop)
+                {
+                    _liveTvPlaybackSegments.TryRemove(session.Id, out _);
+                }
+
+                return;
+            }
+
+            var now = DateTime.UtcNow;
+            var state = _liveTvPlaybackSegments.GetOrAdd(session.Id, _ => new LiveTvPlaybackSegmentState
+            {
+                ChannelId = channelItem.Id,
+                ChannelName = channelItem.Name ?? string.Empty,
+                SegmentStartPositionTicks = 0,
+                LastLookupUtc = DateTime.MinValue
+            });
+
+            state.ChannelId = channelItem.Id;
+            state.ChannelName = channelItem.Name ?? string.Empty;
+
+            var shouldLookup = forceLookup
+                || isStop
+                || !state.HasSnapshot
+                || (state.ProgramEndDate.HasValue && state.ProgramEndDate.Value <= now)
+                || (!state.ProgramEndDate.HasValue && now - state.LastLookupUtc >= LiveTvProgramLookupMinInterval);
+
+            LiveTvProgramSnapshot snapshot = state.HasSnapshot
+                ? state.ToSnapshot()
+                : CreateChannelOnlySnapshot(channelItem);
+
+            if (shouldLookup)
+            {
+                snapshot = ResolveCurrentLiveTvProgram(channelItem) ?? CreateChannelOnlySnapshot(channelItem);
+                state.LastLookupUtc = now;
+            }
+
+            var programChanged = state.HasSnapshot && !SnapshotsEqual(state.ToSnapshot(), snapshot);
+            if (programChanged)
+            {
+                var deltaTicks = positionTicks - state.SegmentStartPositionTicks;
+                if (deltaTicks >= LiveTvMinSegmentTicks)
+                {
+                    await WriteLiveTvPlaybackSegmentsAsync(
+                            session,
+                            users,
+                            state.ToSnapshot(),
+                            deltaTicks)
+                        .ConfigureAwait(false);
+                }
+
+                state.ApplySnapshot(snapshot);
+                state.SegmentStartPositionTicks = positionTicks;
+            }
+            else if (!state.HasSnapshot)
+            {
+                state.ApplySnapshot(snapshot);
+                // Stop without prior progress: attribute the whole session. Otherwise start
+                // the segment at the current stream position so reconnects do not overcount.
+                state.SegmentStartPositionTicks = isStop ? 0 : positionTicks;
+            }
+            else if (shouldLookup)
+            {
+                // Refresh cached metadata (e.g. end date) without resetting the segment.
+                state.ApplySnapshot(snapshot);
+            }
+
+            if (isStop)
+            {
+                var finalDelta = positionTicks - state.SegmentStartPositionTicks;
+                if (finalDelta >= LiveTvMinSegmentTicks)
+                {
+                    await WriteLiveTvPlaybackSegmentsAsync(
+                            session,
+                            users,
+                            state.ToSnapshot(),
+                            finalDelta)
+                        .ConfigureAwait(false);
+                }
+
+                _liveTvPlaybackSegments.TryRemove(session.Id, out _);
+            }
+        }
+
+        private LiveTvProgramSnapshot ResolveCurrentLiveTvProgram(BaseItem channelItem)
+        {
+            var now = DateTime.UtcNow;
+            var programs = _libraryManager.GetItemList(new InternalItemsQuery
+            {
+                IncludeItemTypes = [BaseItemKind.LiveTvProgram],
+                ChannelIds = [channelItem.Id],
+                MaxStartDate = now,
+                MinEndDate = now,
+                Limit = 1,
+                OrderBy = [(ItemSortBy.StartDate, SortOrder.Ascending)]
+            });
+
+            if (programs.Count == 0 || programs[0] is not LiveTvProgram program)
+            {
+                return null;
+            }
+
+            var genres = program.Genres ?? Array.Empty<string>();
+            return new LiveTvProgramSnapshot
+            {
+                ItemId = program.Id,
+                ItemName = program.Name ?? string.Empty,
+                MediaType = nameof(LiveTvProgram),
+                SeriesName = string.IsNullOrWhiteSpace(program.SeriesName) ? null : program.SeriesName,
+                ShowId = string.IsNullOrWhiteSpace(program.ShowId) ? null : program.ShowId,
+                EpisodeTitle = string.IsNullOrWhiteSpace(program.EpisodeTitle) ? null : program.EpisodeTitle,
+                Genres = genres.Length > 0 ? string.Join('|', genres) : null,
+                ItemSubGroup = genres.FirstOrDefault() ?? "Unknown",
+                ChannelId = channelItem.Id,
+                ChannelName = channelItem.Name ?? string.Empty,
+                ProgramEndDate = program.EndDate
+            };
+        }
+
+        private static LiveTvProgramSnapshot CreateChannelOnlySnapshot(BaseItem channelItem)
+        {
+            var genres = channelItem.Genres ?? Array.Empty<string>();
+            return new LiveTvProgramSnapshot
+            {
+                ItemId = channelItem.Id,
+                ItemName = channelItem.Name ?? string.Empty,
+                MediaType = channelItem.GetType().Name,
+                SeriesName = null,
+                ShowId = null,
+                EpisodeTitle = null,
+                Genres = genres.Length > 0 ? string.Join('|', genres) : null,
+                ItemSubGroup = genres.FirstOrDefault() ?? "Unknown",
+                ChannelId = channelItem.Id,
+                ChannelName = channelItem.Name ?? string.Empty,
+                ProgramEndDate = null
+            };
+        }
+
+        private static bool SnapshotsEqual(LiveTvProgramSnapshot left, LiveTvProgramSnapshot right)
+        {
+            return left.ItemId.Equals(right.ItemId)
+                && string.Equals(left.MediaType, right.MediaType, StringComparison.Ordinal);
+        }
+
