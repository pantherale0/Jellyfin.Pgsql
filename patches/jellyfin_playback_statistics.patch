diff --git a/Jellyfin.Api/Controllers/PlaybackActivityController.cs b/Jellyfin.Api/Controllers/PlaybackActivityController.cs
new file mode 100644
index 0000000000..58f3b0ae88
--- /dev/null
+++ b/Jellyfin.Api/Controllers/PlaybackActivityController.cs
@@ -0,0 +1,216 @@
+using System;
+using System.Linq;
+using System.Threading;
+using System.Threading.Tasks;
+using Jellyfin.Database.Implementations;
+using Jellyfin.Database.Implementations.Entities;
+using Microsoft.AspNetCore.Http;
+using Microsoft.AspNetCore.Mvc;
+using Microsoft.EntityFrameworkCore;
+
+namespace Jellyfin.Api.Controllers;
+
+/// <summary>
+/// Playback activity controller.
+/// </summary>
+[ApiController]
+[Route("Users/{userId}/PlaybackStats")]
+public class PlaybackActivityController : BaseJellyfinApiController
+{
+    private readonly IDbContextFactory<JellyfinDbContext> _dbProvider;
+
+    /// <summary>
+    /// Initializes a new instance of the <see cref="PlaybackActivityController"/> class.
+    /// </summary>
+    /// <param name="dbProvider">The database context factory.</param>
+    public PlaybackActivityController(IDbContextFactory<JellyfinDbContext> dbProvider)
+    {
+        _dbProvider = dbProvider;
+    }
+
+    /// <summary>
+    /// Gets playback statistics for a user, grouped by media type.
+    /// </summary>
+    /// <param name="userId">The user id.</param>
+    /// <param name="startDate">Optional inclusive start date (UTC).</param>
+    /// <param name="endDate">Optional inclusive end date (UTC).</param>
+    /// <response code="200">Playback stats returned.</response>
+    /// <returns>Playback stats grouped by media type.</returns>
+    [HttpGet]
+    [ProducesResponseType(StatusCodes.Status200OK)]
+    public async Task<IActionResult> GetPlaybackStats(
+        [FromRoute] Guid userId,
+        [FromQuery] DateTime? startDate,
+        [FromQuery] DateTime? endDate)
+    {
+        using var dbContext = await _dbProvider.CreateDbContextAsync(CancellationToken.None).ConfigureAwait(false);
+
+        var stats = await ApplyDateFilter(dbContext.PlaybackActivity.AsNoTracking().Where(p => p.UserId.Equals(userId)), startDate, endDate)
+            .GroupBy(p => p.MediaType)
+            .Select(g => new
+            {
+                MediaType = g.Key,
+                TotalTicks = g.Sum(p => p.PlayedTicks),
+                PlayCount = g.Count()
+            })
+            .ToListAsync()
+            .ConfigureAwait(false);
+
+        return new OkObjectResult(stats);
+    }
+
+    /// <summary>
+    /// Gets day-of-week and hour aggregates for a user.
+    /// </summary>
+    /// <param name="userId">The user id.</param>
+    /// <param name="startDate">Optional inclusive start date (UTC).</param>
+    /// <param name="endDate">Optional inclusive end date (UTC).</param>
+    /// <response code="200">Hourly stats returned.</response>
+    /// <returns>Hourly playback stats.</returns>
+    [HttpGet("Hourly")]
+    [ProducesResponseType(StatusCodes.Status200OK)]
+    public async Task<IActionResult> GetHourly(
+        [FromRoute] Guid userId,
+        [FromQuery] DateTime? startDate,
+        [FromQuery] DateTime? endDate)
+    {
+        using var dbContext = await _dbProvider.CreateDbContextAsync(CancellationToken.None).ConfigureAwait(false);
+
+        var stats = await ApplyDateFilter(dbContext.PlaybackActivity.AsNoTracking().Where(p => p.UserId.Equals(userId)), startDate, endDate)
+            .GroupBy(p => new { DayOfWeek = (int)p.DatePlayed.DayOfWeek, Hour = p.DatePlayed.Hour })
+            .Select(g => new
+            {
+                DayOfWeek = g.Key.DayOfWeek,
+                Hour = g.Key.Hour,
+                TotalTicks = g.Sum(p => p.PlayedTicks),
+                PlayCount = g.Count()
+            })
+            .ToListAsync()
+            .ConfigureAwait(false);
+
+        return new OkObjectResult(stats);
+    }
+
+    /// <summary>
+    /// Gets overview KPIs for a user for the selected period and prior period.
+    /// </summary>
+    /// <param name="userId">The user id.</param>
+    /// <param name="startDate">Optional inclusive start date (UTC).</param>
+    /// <param name="endDate">Optional inclusive end date (UTC).</param>
+    /// <response code="200">Overview returned.</response>
+    /// <returns>User overview KPIs.</returns>
+    [HttpGet("Overview")]
+    [ProducesResponseType(StatusCodes.Status200OK)]
+    public async Task<IActionResult> GetOverview(
+        [FromRoute] Guid userId,
+        [FromQuery] DateTime? startDate,
+        [FromQuery] DateTime? endDate)
+    {
+        using var dbContext = await _dbProvider.CreateDbContextAsync(CancellationToken.None).ConfigureAwait(false);
+        var endExclusive = endDate.HasValue
+            ? DateTime.SpecifyKind(endDate.Value.Date.AddDays(1), DateTimeKind.Utc)
+            : DateTime.UtcNow.Date.AddDays(1);
+        var start = startDate.HasValue
+            ? DateTime.SpecifyKind(startDate.Value.Date, DateTimeKind.Utc)
+            : endExclusive.AddDays(-28);
+        var duration = endExclusive - start;
+        var priorStart = start - duration;
+
+        var current = await AggregateUserPeriodAsync(dbContext, userId, start, endExclusive).ConfigureAwait(false);
+        var prior = await AggregateUserPeriodAsync(dbContext, userId, priorStart, start).ConfigureAwait(false);
+
+        return new OkObjectResult(new
+        {
+            StartDate = start,
+            EndDate = endExclusive.AddTicks(-1),
+            Current = current,
+            Prior = prior
+        });
+    }
+
+    /// <summary>
+    /// Gets playback statistics for a user, filtered by media type.
+    /// </summary>
+    /// <param name="userId">The user id.</param>
+    /// <param name="mediaType">The media type to filter by.</param>
+    /// <param name="startDate">Optional inclusive start date (UTC).</param>
+    /// <param name="endDate">Optional inclusive end date (UTC).</param>
+    /// <response code="200">Playback stats returned.</response>
+    /// <returns>Playback stats filtered by media type.</returns>
+    [HttpGet("{mediaType}")]
+    [ProducesResponseType(StatusCodes.Status200OK)]
+    public async Task<IActionResult> GetPlaybackStatsByType(
+        [FromRoute] Guid userId,
+        [FromRoute] string mediaType,
+        [FromQuery] DateTime? startDate,
+        [FromQuery] DateTime? endDate)
+    {
+        using var dbContext = await _dbProvider.CreateDbContextAsync(CancellationToken.None).ConfigureAwait(false);
+
+        var stats = await ApplyDateFilter(
+                dbContext.PlaybackActivity.AsNoTracking().Where(p => p.UserId.Equals(userId) && p.MediaType == mediaType),
+                startDate,
+                endDate)
+            .GroupBy(p => p.ItemSubGroup)
+            .Select(g => new
+            {
+                SubGroup = g.Key,
+                TotalTicks = g.Sum(p => p.PlayedTicks),
+                PlayCount = g.Count()
+            })
+            .ToListAsync(CancellationToken.None)
+            .ConfigureAwait(false);
+
+        return new OkObjectResult(stats);
+    }
+
+    private static async Task<object> AggregateUserPeriodAsync(
+        JellyfinDbContext dbContext,
+        Guid userId,
+        DateTime start,
+        DateTime endExclusive)
+    {
+        var query = dbContext.PlaybackActivity.AsNoTracking()
+            .Where(p => p.UserId.Equals(userId) && p.DatePlayed >= start && p.DatePlayed < endExclusive);
+
+        var totals = await query
+            .GroupBy(_ => 1)
+            .Select(g => new
+            {
+                TotalTicks = g.Sum(p => p.PlayedTicks),
+                PlayCount = g.Count()
+            })
+            .FirstOrDefaultAsync()
+            .ConfigureAwait(false);
+
+        var playCount = totals?.PlayCount ?? 0;
+        var totalTicks = totals?.TotalTicks ?? 0L;
+
+        return new
+        {
+            TotalTicks = totalTicks,
+            PlayCount = playCount,
+            AvgSessionTicks = playCount > 0 ? totalTicks / playCount : 0L
+        };
+    }
+
+    private static IQueryable<PlaybackActivity> ApplyDateFilter(
+        IQueryable<PlaybackActivity> query,
+        DateTime? startDate,
+        DateTime? endDate)
+    {
+        if (startDate.HasValue)
+        {
+            var start = DateTime.SpecifyKind(startDate.Value.Date, DateTimeKind.Utc);
+            query = query.Where(p => p.DatePlayed >= start);
+        }
+
+        if (endDate.HasValue)
+        {
+            var endExclusive = DateTime.SpecifyKind(endDate.Value.Date.AddDays(1), DateTimeKind.Utc);
+            query = query.Where(p => p.DatePlayed < endExclusive);
+        }
+
+        return query;
+    }
+}
