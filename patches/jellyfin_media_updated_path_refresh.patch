+        /// <summary>
+        /// Resolves and optionally creates the library item for a path under a library folder,
+        /// avoiding a full-folder ValidateChildren refresh.
+        /// </summary>
+        private BaseItem? TryImportPathUnderFolder(string path, Folder libraryFolder)
+        {
+            var topLevelChild = GetTopLevelChildPath(path, libraryFolder.Path);
+            if (string.IsNullOrEmpty(topLevelChild))
+            {
+                return null;
+            }
+
+            try
+            {
+                var fileInfo = _fileSystem.GetFileSystemInfo(topLevelChild);
+                if (!fileInfo.Exists)
+                {
+                    return null;
+                }
+
+                var resolved = _libraryManager.ResolvePath(fileInfo, libraryFolder);
+                if (resolved is null)
+                {
+                    return null;
+                }
+
+                var existing = _libraryManager.FindByPath(resolved.Path, null)
+                    ?? _libraryManager.GetItemById(resolved.Id);
+                if (existing is not null)
+                {
+                    return existing;
+                }
+
+                resolved.SetParent(libraryFolder);
+                _libraryManager.CreateItem(resolved, libraryFolder);
+                _logger.LogInformation("Imported new item {Name} ({Path}) from path-scoped refresh.", resolved.Name, resolved.Path);
+                return resolved;
+            }
+            catch (Exception ex)
+            {
+                _logger.LogDebug(ex, "Error importing path {Path} under {Folder}", path, libraryFolder.Path);
+                return null;
+            }
+        }
+
+        /// <summary>
+        /// Returns the path segment that is a direct child of <paramref name="libraryFolderPath"/>.
+        /// </summary>
+        private string? GetTopLevelChildPath(string path, string libraryFolderPath)
+        {
+            var current = path;
+            while (!string.IsNullOrEmpty(current))
+            {
+                var parent = System.IO.Path.GetDirectoryName(current);
+                if (string.IsNullOrEmpty(parent))
+                {
+                    return null;
+                }
+
+                if (_fileSystem.AreEqual(parent, libraryFolderPath))
+                {
+                    return current;
+                }
+
+                // Stop if we've walked above the library folder
+                if (!_fileSystem.ContainsSubPath(libraryFolderPath, current)
+                    && !_fileSystem.AreEqual(current, libraryFolderPath))
+                {
+                    return null;
+                }
+
+                current = parent;
+            }
+
+            return null;
+        }
