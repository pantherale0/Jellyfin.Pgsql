diff --git a/MediaBrowser.MediaEncoding/Encoder/HardwareCapabilityResolver.cs b/MediaBrowser.MediaEncoding/Encoder/HardwareCapabilityResolver.cs
new file mode 100644
index 0000000000..7da04dcc9e
--- /dev/null
+++ b/MediaBrowser.MediaEncoding/Encoder/HardwareCapabilityResolver.cs
@@ -0,0 +1,198 @@
+using System;
+using System.Collections.Generic;
+using System.Linq;
+using MediaBrowser.Controller.MediaEncoding;
+using MediaBrowser.Model.Entities;
+using MediaBrowser.Model.MediaEncoding;
+
+namespace MediaBrowser.MediaEncoding.Encoder;
+
+/// <summary>
+/// Derives UI-facing hardware capability matrices from FFmpeg probe results.
+/// </summary>
+public static class HardwareCapabilityResolver
+{
+    // Mirrors jellyfin-web codecs.ts for which codecs each HWA type may expose in the UI.
+    private static readonly Dictionary<HardwareAccelerationType, string[]> DecodeCodecsByType = new()
+    {
+        [HardwareAccelerationType.amf] =
+        [
+            "h264", "hevc", "mpeg2video", "vc1", "vp9", "av1"
+        ],
+        [HardwareAccelerationType.nvenc] =
+        [
+            "h264", "hevc", "mpeg2video", "mpeg4", "vc1", "vp8", "vp9", "av1"
+        ],
+        [HardwareAccelerationType.qsv] =
+        [
+            "h264", "hevc", "mpeg2video", "vc1", "vp8", "vp9", "av1"
+        ],
+        [HardwareAccelerationType.vaapi] =
+        [
+            "h264", "hevc", "mpeg2video", "vc1", "vp8", "vp9", "av1"
+        ],
+        [HardwareAccelerationType.rkmpp] =
+        [
+            "h264", "hevc", "mpeg1video", "mpeg2video", "mpeg4", "vp8", "vp9", "av1"
+        ],
+        [HardwareAccelerationType.videotoolbox] =
+        [
+            "h264", "hevc", "vp8", "vp9", "av1"
+        ],
+        [HardwareAccelerationType.v4l2m2m] =
+        [
+            "h264"
+        ]
+    };
+
+    /// <summary>
+    /// Builds a <see cref="MediaEncoderCapabilities"/> snapshot from an <see cref="IMediaEncoder"/>.
+    /// </summary>
+    /// <param name="mediaEncoder">The media encoder.</param>
+    /// <returns>Derived capabilities.</returns>
+    public static MediaEncoderCapabilities Resolve(IMediaEncoder mediaEncoder)
+    {
+        ArgumentNullException.ThrowIfNull(mediaEncoder);
+
+        var result = new MediaEncoderCapabilities
+        {
+            Hwaccels = mediaEncoder.SupportedHwaccels.ToArray(),
+            Decoders = mediaEncoder.SupportedDecoders.ToArray(),
+            Encoders = mediaEncoder.SupportedEncoders.ToArray()
+        };
+
+        var availableTypes = new List<string>();
+
+        foreach (HardwareAccelerationType type in Enum.GetValues<HardwareAccelerationType>())
+        {
+            if (type == HardwareAccelerationType.none)
+            {
+                continue;
+            }
+
+            var typeKey = type.ToString();
+            var encoding = ResolveEncoding(mediaEncoder, type);
+            result.HardwareEncoding[typeKey] = encoding;
+
+            if (!IsTypeAvailable(mediaEncoder, type, encoding))
+            {
+                result.HardwareDecodingCodecs[typeKey] = [];
+                continue;
+            }
+
+            availableTypes.Add(typeKey);
+            result.HardwareDecodingCodecs[typeKey] = ResolveDecodingCodecs(mediaEncoder, type);
+        }
+
+        result.AvailableAccelerationTypes = availableTypes;
+        return result;
+    }
+
+    private static bool IsTypeAvailable(
+        IMediaEncoder mediaEncoder,
+        HardwareAccelerationType type,
+        HardwareEncodingCapabilities encoding)
+    {
+        return type switch
+        {
+            HardwareAccelerationType.nvenc =>
+                mediaEncoder.SupportsHwaccel("cuda") && encoding.H264,
+            HardwareAccelerationType.qsv =>
+                mediaEncoder.SupportsHwaccel("qsv") && encoding.H264,
+            HardwareAccelerationType.vaapi =>
+                mediaEncoder.SupportsHwaccel("vaapi") && encoding.H264,
+            HardwareAccelerationType.amf =>
+                mediaEncoder.SupportsHwaccel("d3d11va") && encoding.H264,
+            HardwareAccelerationType.rkmpp =>
+                mediaEncoder.SupportsHwaccel("rkmpp") && encoding.H264,
+            HardwareAccelerationType.videotoolbox =>
+                mediaEncoder.SupportsHwaccel("videotoolbox") && encoding.H264,
+            HardwareAccelerationType.v4l2m2m =>
+                encoding.H264,
+            _ => false
+        };
+    }
+
+    private static HardwareEncodingCapabilities ResolveEncoding(
+        IMediaEncoder mediaEncoder,
+        HardwareAccelerationType type)
+    {
+        var suffix = type switch
+        {
+            HardwareAccelerationType.nvenc => "nvenc",
+            HardwareAccelerationType.qsv => "qsv",
+            HardwareAccelerationType.vaapi => "vaapi",
+            HardwareAccelerationType.amf => "amf",
+            HardwareAccelerationType.rkmpp => "rkmpp",
+            HardwareAccelerationType.videotoolbox => "videotoolbox",
+            HardwareAccelerationType.v4l2m2m => "v4l2m2m",
+            _ => string.Empty
+        };
+
+        if (string.IsNullOrEmpty(suffix))
+        {
+            return new HardwareEncodingCapabilities();
+        }
+
+        return new HardwareEncodingCapabilities
+        {
+            H264 = mediaEncoder.SupportsEncoder("h264_" + suffix),
+            Hevc = mediaEncoder.SupportsEncoder("hevc_" + suffix),
+            Av1 = mediaEncoder.SupportsEncoder("av1_" + suffix)
+        };
+    }
+
+    private static string[] ResolveDecodingCodecs(
+        IMediaEncoder mediaEncoder,
+        HardwareAccelerationType type)
+    {
+        if (!DecodeCodecsByType.TryGetValue(type, out var candidates))
+        {
+            return [];
+        }
+
+        return candidates
+            .Where(codec => IsDecodingCodecAvailable(mediaEncoder, type, codec))
+            .ToArray();
+    }
+
+    private static bool IsDecodingCodecAvailable(
+        IMediaEncoder mediaEncoder,
+        HardwareAccelerationType type,
+        string codec)
+    {
+        return type switch
+        {
+            HardwareAccelerationType.nvenc =>
+                mediaEncoder.SupportsHwaccel("cuda")
+                && mediaEncoder.SupportsDecoder(GetNamedDecoder(codec, "cuvid")),
+            HardwareAccelerationType.qsv =>
+                mediaEncoder.SupportsDecoder(GetNamedDecoder(codec, "qsv")),
+            HardwareAccelerationType.rkmpp =>
+                mediaEncoder.SupportsDecoder(GetNamedDecoder(codec, "rkmpp")),
+            HardwareAccelerationType.vaapi =>
+                mediaEncoder.SupportsHwaccel("vaapi"),
+            HardwareAccelerationType.amf =>
+                mediaEncoder.SupportsHwaccel("d3d11va"),
+            HardwareAccelerationType.videotoolbox =>
+                mediaEncoder.SupportsHwaccel("videotoolbox")
+                && (codec != "av1" || mediaEncoder.IsVideoToolboxAv1DecodeAvailable),
+            // Jellyfin has no V4L2M2M hardware decode path today.
+            HardwareAccelerationType.v4l2m2m => false,
+            _ => false
+        };
+    }
+
+    private static string GetNamedDecoder(string codec, string suffix)
+    {
+        // FFmpeg decoder names use shortened prefixes for some codecs.
+        var prefix = codec switch
+        {
+            "mpeg1video" => "mpeg1",
+            "mpeg2video" => "mpeg2",
+            _ => codec
+        };
+
+        return prefix + '_' + suffix;
+    }
+}
