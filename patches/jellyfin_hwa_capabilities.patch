@@ -0,0 +1,22 @@
+namespace MediaBrowser.Model.MediaEncoding;
+
+/// <summary>
+/// Hardware encoding availability for a single acceleration type.
+/// </summary>
+public class HardwareEncodingCapabilities
+{
+    /// <summary>
+    /// Gets or sets a value indicating whether H.264 hardware encoding is available.
+    /// </summary>
+    public bool H264 { get; set; }
+
+    /// <summary>
+    /// Gets or sets a value indicating whether HEVC hardware encoding is available.
+    /// </summary>
+    public bool Hevc { get; set; }
+
+    /// <summary>
+    /// Gets or sets a value indicating whether AV1 hardware encoding is available.
+    /// </summary>
+    public bool Av1 { get; set; }
+}
