+using MediaBrowser.Common.Api;
+using MediaBrowser.Controller.MediaEncoding;
+using MediaBrowser.Model.MediaEncoding;
+using Microsoft.AspNetCore.Authorization;
+using Microsoft.AspNetCore.Http;
+using Microsoft.AspNetCore.Mvc;
+
+namespace Jellyfin.Api.Controllers;
+
+/// <summary>
+/// Media encoder capabilities controller.
+/// </summary>
+[Route("System/MediaEncoder")]
+[Authorize]
+[Tags("System")]
+public class MediaEncoderController : BaseJellyfinApiController
+{
+    private readonly IMediaEncoder _mediaEncoder;
+
+    /// <summary>
+    /// Initializes a new instance of the <see cref="MediaEncoderController"/> class.
+    /// </summary>
+    /// <param name="mediaEncoder">Instance of the <see cref="IMediaEncoder"/> interface.</param>
+    public MediaEncoderController(IMediaEncoder mediaEncoder)
+    {
+        _mediaEncoder = mediaEncoder;
+    }
+
+    /// <summary>
+    /// Gets probed FFmpeg hardware capabilities for the Transcoding admin UI.
+    /// </summary>
+    /// <response code="200">Capabilities returned.</response>
+    /// <returns>Media encoder capabilities.</returns>
+    [HttpGet("Capabilities")]
+    [Authorize(Policy = Policies.RequiresElevation)]
+    [ProducesResponseType(StatusCodes.Status200OK)]
+    public ActionResult<MediaEncoderCapabilities> GetCapabilities()
+    {
+        return _mediaEncoder.GetCapabilities();
+    }
+}
