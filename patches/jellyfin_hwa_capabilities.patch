+using System;
+using System.Collections.Generic;
+
+namespace MediaBrowser.Model.MediaEncoding;
+
+/// <summary>
+/// FFmpeg-probed media encoder capabilities for the admin Transcoding UI.
+/// </summary>
+public class MediaEncoderCapabilities
+{
+    /// <summary>
+    /// Gets or sets the raw hardware acceleration names reported by FFmpeg.
+    /// </summary>
+    public IReadOnlyList<string> Hwaccels { get; set; } = Array.Empty<string>();
+
+    /// <summary>
+    /// Gets or sets the raw decoder names reported by FFmpeg.
+    /// </summary>
+    public IReadOnlyList<string> Decoders { get; set; } = Array.Empty<string>();
+
+    /// <summary>
+    /// Gets or sets the raw encoder names reported by FFmpeg.
+    /// </summary>
+    public IReadOnlyList<string> Encoders { get; set; } = Array.Empty<string>();
+
+    /// <summary>
+    /// Gets or sets the hardware acceleration types that appear usable on this host.
+    /// Values match <see cref="Entities.HardwareAccelerationType"/> names (e.g. "nvenc").
+    /// </summary>
+    public IReadOnlyList<string> AvailableAccelerationTypes { get; set; } = Array.Empty<string>();
+
+    /// <summary>
+    /// Gets or sets hardware decoding codec ids keyed by acceleration type name.
+    /// Codec ids match EncodingOptions.HardwareDecodingCodecs (e.g. "h264", "hevc").
+    /// </summary>
+    public Dictionary<string, string[]> HardwareDecodingCodecs { get; set; }
+        = new(StringComparer.OrdinalIgnoreCase);
+
+    /// <summary>
+    /// Gets or sets hardware encoding availability keyed by acceleration type name.
+    /// </summary>
+    public Dictionary<string, HardwareEncodingCapabilities> HardwareEncoding { get; set; }
+        = new(StringComparer.OrdinalIgnoreCase);
+}
