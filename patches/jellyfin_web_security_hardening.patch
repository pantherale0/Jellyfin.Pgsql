@@ -118,7 +118,29 @@ export function getPluginUrl(name) {
 
 export function getConfigurationResourceUrl(name) {
     return ApiClient.getUrl('web/ConfigurationPage', {
-        name: name
+        name: name,
+        ApiKey: ApiClient.accessToken()
+    });
+}
+
+/**
+ * Plugin config HTML embeds relative configurationpage script/css URLs without auth.
+ * Browsers and jQuery fetch those without Authorization headers, so append ApiKey.
+ * @param {string} html - Plugin page HTML from the server.
+ * @returns {string}
+ */
+export function appendConfigurationPageApiKey(html) {
+    const token = ApiClient.accessToken();
+    if (!token || !html) {
+        return html;
+    }
+
+    return String(html).replace(/configurationpage\?name=[^"'>\s]+/gi, (url) => {
+        if (/[?&]ApiKey=/i.test(url)) {
+            return url;
+        }
+
+        return `${url}&ApiKey=${encodeURIComponent(token)}`;
     });
 }
 
