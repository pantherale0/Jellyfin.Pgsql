+    /// <inheritdoc />
+    public IReadOnlySet<Guid> GetItemIdsWithSegments(IReadOnlyCollection<Guid> itemIds)
+    {
+        if (itemIds.Count == 0)
+        {
+            return new HashSet<Guid>();
+        }
+
+        using var db = _dbProvider.CreateDbContext();
+        return db.MediaSegments
+            .Where(e => itemIds.Contains(e.ItemId))
+            .Select(e => e.ItemId)
+            .Distinct()
+            .ToHashSet();
+    }
