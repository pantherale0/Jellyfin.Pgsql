diff --git a/MediaBrowser.Controller/Library/IBackgroundMediaWorkGate.cs b/MediaBrowser.Controller/Library/IBackgroundMediaWorkGate.cs
new file mode 100644
index 0000000000..70afc2db7c
--- /dev/null
+++ b/MediaBrowser.Controller/Library/IBackgroundMediaWorkGate.cs
@@ -0,0 +1,20 @@
+using System;
+using System.Threading;
+using System.Threading.Tasks;
+
+namespace MediaBrowser.Controller.Library;
+
+/// <summary>
+/// Limits concurrent background media work (segment extraction, chapter images)
+/// and yields while clients are actively playing.
+/// </summary>
+public interface IBackgroundMediaWorkGate
+{
+    /// <summary>
+    /// Waits until no session is playing (or the wait is cancelled), then acquires a
+    /// background work slot. Dispose the returned lease to release the slot.
+    /// </summary>
+    /// <param name="cancellationToken">Cancellation token.</param>
+    /// <returns>A lease that must be disposed to release the slot.</returns>
+    Task<IAsyncDisposable> AcquireAsync(CancellationToken cancellationToken);
+}
