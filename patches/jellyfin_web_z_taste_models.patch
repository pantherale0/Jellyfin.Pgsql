+}
+
+export interface TasteModelEvalRun {
+    Id: string;
+    CreatedAt: string;
+    TrainDurationMs: number;
+    PositiveCount: number;
+    NegativeCount: number;
+    HoldoutCount: number;
+    Accuracy: number | null;
+    Auc: number | null;
