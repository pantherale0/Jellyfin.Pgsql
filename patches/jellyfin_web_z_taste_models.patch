+import React, { useMemo } from 'react';
+import Box from '@mui/material/Box';
+import Paper from '@mui/material/Paper';
+import Typography from '@mui/material/Typography';
+import { useTheme } from '@mui/material/styles';
+import { LineChart } from '@mui/x-charts/LineChart';
+
+import globalize from 'lib/globalize';
+
+import type { TasteModelEvalRun } from '../types';
+
+interface TasteAucChartProps {
+    runs: TasteModelEvalRun[];
+}
+
+const TasteAucChart = ({ runs }: TasteAucChartProps) => {
+    const theme = useTheme();
+
+    const { labels, values } = useMemo(() => {
+        const successful = runs
+            .filter(run => run.Succeeded && run.Auc != null)
+            .slice()
+            .reverse();
+
+        return {
+            labels: successful.map(run => {
+                const date = new Date(run.CreatedAt);
+                return Number.isNaN(date.getTime())
+                    ? run.CreatedAt
+                    : date.toLocaleDateString(undefined, { month: 'short', day: 'numeric' });
+            }),
+            values: successful.map(run => run.Auc as number)
+        };
+    }, [ runs ]);
+
+    return (
+        <Paper sx={{ p: 2 }}>
+            <Typography variant='subtitle2' gutterBottom>
+                {globalize.translate('TasteModelsAucTrend')}
+            </Typography>
+            {labels.length === 0 ? (
+                <Typography variant='body2' color='text.secondary'>
+                    {globalize.translate('TasteModelsNoSuccessfulRuns')}
+                </Typography>
+            ) : (
+                <Box sx={{ width: '100%', height: 280 }}>
+                    <LineChart
+                        xAxis={[{ data: labels, scaleType: 'point' }]}
+                        yAxis={[{ min: 0.5, max: 1 }]}
+                        series={[{
+                            id: 'auc',
+                            label: globalize.translate('TasteModelsLabelAuc'),
+                            data: values,
+                            color: theme.palette.primary.main,
+                            showMark: true,
+                            valueFormatter: (value: number | null) => (
+                                value == null ? '—' : value.toFixed(3)
+                            )
+                        }]}
+                        margin={{ left: 50, right: 16, top: 24, bottom: 40 }}
+                    />
+                </Box>
+            )}
+        </Paper>
+    );
+};
+
+export default TasteAucChart;
