@@ -0,0 +1,59 @@
+import type { AucQualityBand } from '../types';
+
+export const getAucQualityBand = (auc: number | null | undefined): AucQualityBand => {
+    if (auc == null || Number.isNaN(auc)) {
+        return 'unknown';
+    }
+
+    if (auc >= 0.9) {
+        return 'excellent';
+    }
+
+    if (auc >= 0.8) {
+        return 'good';
+    }
+
+    if (auc >= 0.7) {
+        return 'fair';
+    }
+
+    return 'weak';
+};
+
+export const formatMetric = (value: number | null | undefined, digits = 3): string => {
+    if (value == null || Number.isNaN(value)) {
+        return '—';
+    }
+
+    return value.toFixed(digits);
+};
+
+export const formatPercent = (value: number | null | undefined, digits = 1): string => {
+    if (value == null || Number.isNaN(value)) {
+        return '—';
+    }
+
+    return `${(value * 100).toFixed(digits)}%`;
+};
+
+export const formatDurationMs = (ms: number | null | undefined): string => {
+    if (ms == null || Number.isNaN(ms) || ms < 0) {
+        return '—';
+    }
+
+    if (ms < 1000) {
+        return `${ms} ms`;
+    }
+
+    return `${(ms / 1000).toFixed(1)} s`;
+};
+
+export const formatDelta = (current: number | null | undefined, prior: number | null | undefined): string | null => {
+    if (current == null || prior == null || Number.isNaN(current) || Number.isNaN(prior)) {
+        return null;
+    }
+
+    const delta = current - prior;
+    const sign = delta > 0 ? '+' : '';
+    return `${sign}${delta.toFixed(3)}`;
+};
