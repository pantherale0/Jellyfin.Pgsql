+import React from 'react';
+import Alert from '@mui/material/Alert';
+import Box from '@mui/material/Box';
+import CircularProgress from '@mui/material/CircularProgress';
+import Stack from '@mui/material/Stack';
+import Typography from '@mui/material/Typography';
+import Page from 'components/Page';
+import globalize from 'lib/globalize';
+
+import { useTasteShadowEval } from 'apps/dashboard/features/tasteModels/api/useTasteShadowEval';
+import TasteAucChart from 'apps/dashboard/features/tasteModels/components/TasteAucChart';
+import TasteEvalHistoryTable from 'apps/dashboard/features/tasteModels/components/TasteEvalHistoryTable';
+import TasteKpiCards from 'apps/dashboard/features/tasteModels/components/TasteKpiCards';
+import TasteStatusChips from 'apps/dashboard/features/tasteModels/components/TasteStatusChips';
+
+export const Component = () => {
+    const query = useTasteShadowEval(50);
+
+    return (
+        <Page
+            id='tasteModelsPage'
+            title={globalize.translate('HeaderTasteModels')}
+            className='mainAnimatedPage type-interior'
+        >
+            <Box className='content-primary' sx={{ p: 2 }}>
+                <Stack spacing={2}>
+                    <Box>
+                        <Typography variant='h5' gutterBottom>
+                            {globalize.translate('HeaderTasteModels')}
+                        </Typography>
+                        <Typography variant='body2' color='text.secondary'>
+                            {globalize.translate('TasteModelsHelp')}
+                        </Typography>
+                    </Box>
+
+                    {query.isLoading ? (
+                        <Box sx={{ display: 'flex', justifyContent: 'center', py: 6 }}>
+                            <CircularProgress />
+                        </Box>
+                    ) : null}
+
+                    {query.isError ? (
+                        <Alert severity='error'>
+                            {globalize.translate('TasteModelsLoadError')}
+                        </Alert>
+                    ) : null}
+
+                    {query.data ? (
+                        <>
+                            <TasteStatusChips status={query.data.Status} />
+                            <TasteKpiCards latest={query.data.Latest} runs={query.data.Runs} />
+                            <TasteAucChart runs={query.data.Runs} />
+                            <TasteEvalHistoryTable runs={query.data.Runs} />
+                        </>
+                    ) : null}
+                </Stack>
+            </Box>
+        </Page>
+    );
+};
+
+Component.displayName = 'TasteModelsPage';
