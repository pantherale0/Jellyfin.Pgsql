+import React from 'react';
+import Chip from '@mui/material/Chip';
+import Paper from '@mui/material/Paper';
+import Table from '@mui/material/Table';
+import TableBody from '@mui/material/TableBody';
+import TableCell from '@mui/material/TableCell';
+import TableContainer from '@mui/material/TableContainer';
+import TableHead from '@mui/material/TableHead';
+import TableRow from '@mui/material/TableRow';
+import Typography from '@mui/material/Typography';
+
+import globalize from 'lib/globalize';
+
+import type { TasteModelEvalRun } from '../types';
+import { formatDurationMs, formatMetric, formatPercent } from '../utils/aucQuality';
+
+interface TasteEvalHistoryTableProps {
+    runs: TasteModelEvalRun[];
+}
+
+const formatWhen = (value: string) => {
+    const date = new Date(value);
+    if (Number.isNaN(date.getTime())) {
+        return value;
+    }
+
+    return date.toLocaleString();
+};
+
+const TasteEvalHistoryTable = ({ runs }: TasteEvalHistoryTableProps) => {
+    return (
+        <Paper sx={{ p: 2 }}>
+            <Typography variant='subtitle2' gutterBottom>
+                {globalize.translate('TasteModelsHistory')}
+            </Typography>
+            {runs.length === 0 ? (
+                <Typography variant='body2' color='text.secondary'>
+                    {globalize.translate('TasteModelsNoRuns')}
+                </Typography>
+            ) : (
+                <TableContainer>
+                    <Table size='small'>
+                        <TableHead>
+                            <TableRow>
+                                <TableCell>{globalize.translate('TasteModelsColWhen')}</TableCell>
+                                <TableCell>{globalize.translate('TasteModelsColStatus')}</TableCell>
+                                <TableCell align='right'>{globalize.translate('TasteModelsLabelAuc')}</TableCell>
+                                <TableCell align='right'>{globalize.translate('TasteModelsLabelAccuracy')}</TableCell>
+                                <TableCell align='right'>{globalize.translate('TasteModelsLabelPrecisionAt10')}</TableCell>
+                                <TableCell align='right'>{globalize.translate('TasteModelsLabelTrainingPairs')}</TableCell>
+                                <TableCell align='right'>{globalize.translate('TasteModelsLabelHoldout')}</TableCell>
+                                <TableCell align='right'>{globalize.translate('TasteModelsLabelDuration')}</TableCell>
+                                <TableCell>{globalize.translate('TasteModelsColModel')}</TableCell>
+                            </TableRow>
+                        </TableHead>
+                        <TableBody>
+                            {runs.map(run => (
+                                <TableRow key={run.Id} hover>
+                                    <TableCell>{formatWhen(run.CreatedAt)}</TableCell>
+                                    <TableCell>
+                                        {run.Succeeded ? (
+                                            <Chip
+                                                size='small'
+                                                color='success'
+                                                label={globalize.translate('TasteModelsStatusSucceeded')}
+                                            />
+                                        ) : (
+                                            <Chip
+                                                size='small'
+                                                color='warning'
+                                                label={run.Notes || globalize.translate('TasteModelsStatusSkipped')}
+                                            />
+                                        )}
+                                    </TableCell>
+                                    <TableCell align='right'>{formatMetric(run.Auc)}</TableCell>
+                                    <TableCell align='right'>{formatPercent(run.Accuracy)}</TableCell>
+                                    <TableCell align='right'>{formatPercent(run.PrecisionAt10, 0)}</TableCell>
+                                    <TableCell align='right'>
+                                        {run.Succeeded ? `${run.PositiveCount} / ${run.NegativeCount}` : '—'}
+                                    </TableCell>
+                                    <TableCell align='right'>
+                                        {run.Succeeded ? run.HoldoutCount : '—'}
+                                    </TableCell>
+                                    <TableCell align='right'>
+                                        {formatDurationMs(run.TrainDurationMs)}
+                                    </TableCell>
+                                    <TableCell>
+                                        <Typography variant='body2' noWrap sx={{ maxWidth: 220 }}>
+                                            {run.ModelPath || '—'}
+                                        </Typography>
+                                    </TableCell>
+                                </TableRow>
+                            ))}
+                        </TableBody>
+                    </Table>
+                </TableContainer>
+            )}
+        </Paper>
+    );
+};
+
+export default TasteEvalHistoryTable;
