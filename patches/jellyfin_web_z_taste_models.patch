+import { useQuery } from '@tanstack/react-query';
+
+import { useApi } from 'hooks/useApi';
+
+import { fetchTasteShadowEval } from './tasteModelsApi';
+
+export const useTasteShadowEval = (limit = 50) => {
+    const { api } = useApi();
+
+    return useQuery({
+        queryKey: [ 'TasteShadowEval', limit ],
+        queryFn: ({ signal }) => fetchTasteShadowEval(api!, limit, { signal }),
+        enabled: !!api,
+        refetchOnMount: false
+    });
+};
