+import type { Api } from '@jellyfin/sdk';
+import type { AxiosRequestConfig } from 'axios';
+
+import type { TasteShadowEvalResponse } from '../types';
+
+const fetchJson = async <T>(
+    api: Api,
+    path: string,
+    options?: AxiosRequestConfig
+): Promise<T> => {
+    const response = await api.axiosInstance.get<T>(path, {
+        ...options,
+        baseURL: api.basePath,
+        headers: {
+            ...options?.headers,
+            Authorization: api.authorizationHeader
+        }
+    });
+    return response.data;
+};
+
+export const fetchTasteShadowEval = (
+    api: Api,
+    limit = 50,
+    options?: AxiosRequestConfig
+): Promise<TasteShadowEvalResponse> => {
+    const params = new URLSearchParams();
+    params.set('limit', String(limit));
+    return fetchJson(api, `/Pgsql/Admin/Taste/ShadowEval?${params.toString()}`, options);
+};
