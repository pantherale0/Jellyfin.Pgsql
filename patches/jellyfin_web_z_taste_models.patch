+import React, { useMemo } from 'react';
+import Chip from '@mui/material/Chip';
+import Paper from '@mui/material/Paper';
+import Stack from '@mui/material/Stack';
+import Typography from '@mui/material/Typography';
+
+import globalize from 'lib/globalize';
+
+import type { TasteModelEvalRun } from '../types';
+import {
+    formatDelta,
+    formatDurationMs,
+    formatMetric,
+    formatPercent,
+    getAucQualityBand
+} from '../utils/aucQuality';
+
+interface TasteKpiCardsProps {
+    latest: TasteModelEvalRun | null;
+    runs: TasteModelEvalRun[];
+}
+
+const QUALITY_LABEL: Record<string, string> = {
+    excellent: 'TasteModelsQualityExcellent',
+    good: 'TasteModelsQualityGood',
+    fair: 'TasteModelsQualityFair',
+    weak: 'TasteModelsQualityWeak',
+    unknown: 'TasteModelsQualityUnknown'
+};
+
+const QUALITY_COLOR: Record<string, 'success' | 'info' | 'warning' | 'error' | 'default'> = {
+    excellent: 'success',
+    good: 'info',
+    fair: 'warning',
+    weak: 'error',
+    unknown: 'default'
+};
+
+interface KpiProps {
+    label: string;
+    value: string;
+    hint?: string | null;
+}
+
+const Kpi = ({ label, value, hint }: KpiProps) => (
+    <Paper sx={{ p: 2, flex: '1 1 140px', minWidth: 130 }}>
+        <Typography variant='body2' color='text.secondary' gutterBottom>
+            {label}
+        </Typography>
+        <Typography variant='h5' sx={{ mb: 0.5 }}>{value}</Typography>
+        {hint ? (
+            <Typography variant='caption' color='text.secondary'>
+                {hint}
+            </Typography>
+        ) : null}
+    </Paper>
+);
+
+const TasteKpiCards = ({ latest, runs }: TasteKpiCardsProps) => {
+    const prior = useMemo(
+        () => runs.find(run => run.Succeeded && run.Id !== latest?.Id) ?? null,
+        [ latest?.Id, runs ]
+    );
+
+    if (!latest) {
+        return (
+            <Paper sx={{ p: 2 }}>
+                <Typography variant='body2' color='text.secondary'>
+                    {globalize.translate('TasteModelsNoRuns')}
+                </Typography>
+            </Paper>
+        );
+    }
+
+    if (!latest.Succeeded) {
+        return (
+            <Paper sx={{ p: 2 }}>
+                <Typography variant='subtitle2' gutterBottom>
+                    {globalize.translate('TasteModelsLatestSkipped')}
+                </Typography>
+                <Typography variant='body2' color='text.secondary'>
+                    {latest.Notes || globalize.translate('TasteModelsQualityUnknown')}
+                </Typography>
+            </Paper>
+        );
+    }
+
+    const band = getAucQualityBand(latest.Auc);
+    const aucDelta = formatDelta(latest.Auc, prior?.Auc);
+    const accDelta = formatDelta(latest.Accuracy, prior?.Accuracy);
+
+    return (
+        <Stack spacing={2}>
+            <Stack direction='row' spacing={1} alignItems='center' useFlexGap flexWrap='wrap'>
+                <Typography variant='subtitle1'>
+                    {globalize.translate('TasteModelsLatestRun')}
+                </Typography>
+                <Chip
+                    size='small'
+                    color={QUALITY_COLOR[band]}
+                    label={globalize.translate(QUALITY_LABEL[band])}
+                />
+            </Stack>
+            <Stack direction='row' spacing={2} useFlexGap flexWrap='wrap'>
+                <Kpi
+                    label={globalize.translate('TasteModelsLabelAuc')}
+                    value={formatMetric(latest.Auc)}
+                    hint={aucDelta ? globalize.translate('TasteModelsDeltaVsPrior', aucDelta) : null}
+                />
+                <Kpi
+                    label={globalize.translate('TasteModelsLabelAccuracy')}
+                    value={formatPercent(latest.Accuracy)}
+                    hint={accDelta ? globalize.translate('TasteModelsDeltaVsPrior', accDelta) : null}
+                />
+                <Kpi
+                    label={globalize.translate('TasteModelsLabelPrecisionAt10')}
+                    value={formatPercent(latest.PrecisionAt10, 0)}
+                />
+                <Kpi
+                    label={globalize.translate('TasteModelsLabelTrainingPairs')}
+                    value={`${latest.PositiveCount} / ${latest.NegativeCount}`}
+                    hint={globalize.translate('TasteModelsLabelPosNeg')}
+                />
+                <Kpi
+                    label={globalize.translate('TasteModelsLabelHoldout')}
+                    value={String(latest.HoldoutCount)}
+                />
+                <Kpi
+                    label={globalize.translate('TasteModelsLabelDuration')}
+                    value={formatDurationMs(latest.TrainDurationMs)}
+                />
+            </Stack>
+        </Stack>
+    );
+};
+
+export default TasteKpiCards;
